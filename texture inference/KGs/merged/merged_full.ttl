ns1:BFO_0000015 a owl:Class ;
    rdfs:label "process"@en ;
    ns1:IAO_0000115 "p is a process = Def. p is an occurrent that has temporal proper parts and for some time t, p s-depends_on some material entity at t. (axiom label in BFO2 Reference: [083-003])"@en ;
    rdfs:subClassOf ns1:BFO_0000003 ;
    skos:altLabel "event"@en ;
    skos:definition "(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant"@en ;
    skos:example "An act of selling; the life of an organism; a process of sleeping; a process of cell-division; a beating of the heart; a process of meiosis; the taxiing of an aircraft; the programming of a computer"@en .

ns1:BFO_0000147 a owl:Class ;
    rdfs:label "fiat point"@en ;
    rdfs:subClassOf ns1:BFO_0000140 ;
    skos:definition "(Elucidation) A fiat point is a zero-dimensional continuant fiat boundary that consists of a single point"@en ;
    skos:example "The geographic North Pole; the quadripoint where the boundaries of Colorado, Utah, New Mexico and Arizona meet; the point of origin of some spatial coordinate system"@en .

ns1:CHEBI_24431 a owl:Class ;
    rdfs:label "chemical entity" ;
    ns1:IAO_0000115 "A chemical entity is a physical entity of interest in chemistry including molecular entities, parts thereof, and chemical substances." ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns1:IAO_0000002 a owl:NamedIndividual ;
    rdfs:label "example to be eventually removed"@en .

ns1:IAO_0000009 a owl:Class ;
    rdfs:label "datum label"@en ;
    ns1:IAO_0000115 "A label is a symbol that is part of some other datum and is used to either partially define  the denotation of that datum or to provide a means for identifying the datum as a member of the set of data with the same label"@en ;
    ns1:IAO_0000116 "http://www.golovchenko.org/cgi-bin/wnsearch?q=label#4n"@en ;
    ns1:IAO_0000232 """9/22/11 BP: changed the rdfs:label for this class from 'label' to 'datum label' to convey that this class is not intended to cover all kinds of labels (stickers, radiolabels, etc.), and not even all kind of textual labels, but rather the kind of labels occuring in a datum. 
""" ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:IAO_0000103 a owl:NamedIndividual ;
    rdfs:label "failed exploratory term"@en ;
    ns1:IAO_0000115 "The term was initially used in an attempt to structure part of the ontology, but in retrospect failed to do a good job."@en,
        "The term was used in an attempt to structure part of the ontology but in retrospect failed to do a good job"@en ;
    ns1:IAO_0000116 "Terms created as placeholders with the expectation of being permanent should instead be deprecated using the \"placeholder removed\" (obo:IAO_0000226) justification."@en .

ns1:IAO_0000115 a owl:AnnotationProperty .

ns1:IAO_0000121 a owl:NamedIndividual ;
    rdfs:label "organizational term"@en ;
    ns1:IAO_0000115 "Term created to ease viewing/sort terms for development purpose, and will not be included in a release"@en,
        "The term was created to ease viewing/sorting terms for development purposes, but will not be included in a release."@en .

ns1:IAO_0000124 a owl:NamedIndividual ;
    rdfs:label "uncurated"@en ;
    ns1:IAO_0000115 "Nothing done yet beyond assigning a unique class ID and proposing a preferred term."@en .

ns1:IAO_0000125 a owl:NamedIndividual ;
    rdfs:label "pending final vetting"@en ;
    ns1:IAO_0000115 "All definitions, placement in the asserted IS_A hierarchy and required minimal metadata are complete. The class is awaiting a final review by someone other than the term editor."@en .

ns1:IAO_0000226 a owl:NamedIndividual ;
    rdfs:label "placeholder removed"@en ;
    ns1:IAO_0000115 "The term was created to temporarily stand in for a semantic purpose, but is no longer needed, typically due to another permanent term being defined."@en ;
    ns1:IAO_0000116 "This reason is appropriate for a temporary term even if no permanent term is defined; for example if the need for the term no longer exists. If a permanent (replacement) term is defined, the deprecated term should reference the replacement with IAO:0100001. If no replacement is defined, it may be appropriate to reference alternative terms with oboInOwl:consider."@en .

ns1:IAO_0000227 a owl:NamedIndividual ;
    rdfs:label "terms merged"@en ;
    ns1:IAO_0000115 "The term has been combined with one or more other terms to create a more encompassing (merged) term."@en ;
    ns1:IAO_0000116 "An editor note should explain what were the merged terms and the reason for the merge."@en,
        "The deprecated term should reference the merged term with obo:IAO_0100001. The replacement term should reference the original terms as sources using obo:RO_0001000 (derives_from). An editor note should explain what were the merged terms and the reason for the merge."@en .

ns1:IAO_0000228 a owl:NamedIndividual ;
    rdfs:label "term imported"@en ;
    ns1:IAO_0000115 "The term has been replaced by a term imported from another ontology."@en ;
    ns1:IAO_0000116 "This is to be used when the original term has been replaced by a term imported from an other ontology. An editor note should indicate what is the URI of the new term to use."@en,
        "This is to be used when the original term has been replaced by a term imported from an other ontology. The deprecated term should reference the imported term with obo:IAO_0100001."@en .

ns1:IAO_0000229 a owl:NamedIndividual ;
    rdfs:label "term split"@en ;
    ns1:IAO_0000115 "The term has been split into two or more new terms."@en ;
    ns1:IAO_0000116 "This is to be used when a term has been split in two or more new terms. An editor note should indicate the reason for the split and indicate the URIs of the new terms created."@en,
        "This is to be used when a term has been split in two or more new terms. An editor note should indicate the reason for the split. The deprecated term should reference the replacement terms with obo:IAO_0100001."@en .

ns1:IAO_0000235 a owl:ObjectProperty ;
    rdfs:label "denoted by"@en ;
    ns1:IAO_0000115 "inverse of the relation 'denotes'"@en ;
    ns1:IAO_0000233 <https://github.com/information-artifact-ontology/IAO/issues/206> ;
    rdfs:domain ns1:BFO_0000001 ;
    rdfs:range ns1:IAO_0000030 .

ns1:IAO_0000410 a owl:NamedIndividual ;
    rdfs:label "universal"@en ;
    ns1:IAO_0000116 "Hard to give a definition for. Intuitively a \"natural kind\" rather than a collection of any old things, which a class is able to be, formally. At the meta level, universals are defined as positives, are disjoint with their siblings, have single asserted parents."@en ;
    ns1:IAO_0000119 "A Formal Theory of Substances, Qualities, and Universals, http://ontology.buffalo.edu/bfo/SQU.pdf"@en .

ns1:IAO_0000420 a owl:NamedIndividual ;
    rdfs:label "defined class"@en ;
    ns1:IAO_0000115 "A defined class is a class that is defined by a set of logically necessary and sufficient conditions but is not a universal"@en ;
    ns1:IAO_0000116 "\"definitions\", in some readings, always are given by necessary and sufficient conditions. So one must be careful (and this is difficult sometimes) to distinguish between defined classes and universal."@en .

ns1:IAO_0000421 a owl:NamedIndividual ;
    rdfs:label "named class expression"@en ;
    ns1:IAO_0000115 "A named class expression is a logical expression that is given a name. The name can be used in place of the expression."@en ;
    ns1:IAO_0000116 "named class expressions are used in order to have more concise logical definition but their extensions may not be interesting classes on their own. In languages such as OWL, with no provisions for macros, these show up as actuall classes. Tools may with to not show them as such, and to replace uses of the macros with their expansions"@en .

ns1:IAO_0000423 a owl:NamedIndividual ;
    rdfs:label "to be replaced with external ontology term"@en ;
    ns1:IAO_0000115 "Terms with this status should eventually replaced with a term from another ontology."@en ;
    ns1:IAO_0000119 "group:OBI"@en .

ns1:IAO_0000428 a owl:NamedIndividual ;
    rdfs:label "requires discussion"@en ;
    ns1:IAO_0000115 "A term that is metadata complete, has been reviewed, and problems have been identified that require discussion before release. Such a term requires editor note(s) to identify the outstanding issues."@en ;
    ns1:IAO_0000119 "group:OBI"@en .

ns1:OBI_0002135 a owl:DatatypeProperty ;
    rdfs:label "has specified value"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A relation between a value specification and a literal."@en ;
    ns1:IAO_0000116 "This is not an RDF/OWL object property. It is intended to link a value found in e.g. a database column of 'M' (the literal) to an instance of a value specification class, which can then be linked to indicate that this is about the biological gender of a human subject." ;
    ns1:IAO_0000119 "OBI" ;
    rdfs:domain ns1:OBI_0001933 .

ns1:OMO_0001000 a owl:NamedIndividual ;
    rdfs:label "out of scope" ;
    ns1:IAO_0000115 "The term was added to the ontology on the assumption it was in scope, but it turned out later that it was not."@en ;
    ns1:IAO_0000116 "This obsolesence reason should be used conservatively. Typical valid examples are: un-necessary grouping classes in disease ontologies, a phenotype term added on the assumption it was a disease."@en,
        "This obsolesence reason should be used conservatively. Typical valid examples in disease ontologies are: unnecessary class grouping; mistaked creation of a disease associated to a phenotype."@en ;
    ns1:IAO_0000233 "https://github.com/information-artifact-ontology/ontology-metadata/issues/77" .

ns1:RO_0000056 a owl:ObjectProperty ;
    rdfs:label "participates in"@en ;
    ns1:IAO_0000112 "this blood clot participates in this blood coagulation"@en,
        "this input material (or this output material) participates in this process"@en,
        "this investigator participates in this investigation"@en ;
    ns1:IAO_0000115 "a relation between a continuant and a process, in which the continuant is somehow involved in the process"@en ;
    rdfs:domain ns1:BFO_0000002 ;
    rdfs:range ns1:BFO_0000003 ;
    owl:inverseOf ns1:RO_0000057 .

ns1:RO_0000091 a owl:ObjectProperty ;
    rdfs:label "has disposition"@en ;
    ns1:IAO_0000115 "a relation between an independent continuant (the bearer) and a disposition, in which the disposition specifically depends on the bearer for its existence"@en ;
    rdfs:domain ns1:BFO_0000004 ;
    rdfs:range ns1:BFO_0000016 ;
    rdfs:subPropertyOf ns1:RO_0000053 ;
    owl:inverseOf ns1:RO_0000092 .

ns1:RO_0000092 a owl:ObjectProperty ;
    rdfs:label "disposition of"@en ;
    ns1:IAO_0000115 "inverse of has disposition" ;
    rdfs:comment "This relation is modeled after the BFO relation of the same name which was in BFO2, but is used in a more restricted sense - specifically, we model this relation as functional (inherited from characteristic-of). Note that this relation is now removed from BFO2020." ;
    rdfs:subPropertyOf ns1:RO_0000052 .

ns1:RO_0002350 a owl:ObjectProperty ;
    rdfs:label "member of"@en ;
    ns1:IAO_0000112 "An organism that is a member of a population of organisms" ;
    ns1:IAO_0000115 "is member of is a mereological relation between a item and a collection." ;
    ns1:IAO_0000119 "SIO" ;
    rdfs:subPropertyOf ns1:BFO_0000050 ;
    owl:inverseOf ns1:RO_0002351 .

ns1:RO_0002502 a owl:ObjectProperty ;
    rdfs:label "depends on" ;
    ns1:IAO_0000117 <https://orcid.org/0000-0002-6601-2165> ;
    rdfs:seeAlso ns1:BFO_0000169 .

qudt:Unit a owl:Class ;
    rdfs:label "Unit" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> ;
    skos:definition """A unit of measure, or unit, is a particular quantity value that has been chosen as a scale for measuring other quantities the same kind (more generally of equivalent dimension). 
For example, the meter is a quantity of length that has been rigorously defined and standardized by the BIPM (International Board of Weights and Measures).  Any measurement of the length can be expressed as a number multiplied by the unit meter. 
More formally, the value of a physical quantity Q with respect to a unit (U) is expressed as the scalar multiple of a real number (n) and U, as  $Q = nU$."""@en .

<http://qudt.org/vocab/unit/PER-MOL> a qudt:Unit,
        owl:NamedIndividual .

xsd:string a rdfs:Datatype .

<https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000226> a owl:ObjectProperty ;
    rdfs:label "is subject of"@en ;
    rdfs:comment "inverse of the relation 'is about'" ;
    skos:altLabel "is described by" .

ns2:PMD_0000553 a owl:Class ;
    rdfs:label "chemisches Potential"@de,
        "chemical potential"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf ns2:PMD_0080116 ;
    skos:definition "eine intensive Qualität eines thermodynamischen Systems, die die Energieänderung beschreibt, die mit der Zugabe einer kleinen Menge einer Substanz zu einem System bei konstanter Temperatur und konstantem Druck verbunden ist."@de,
        "a quality of a thermodynamic system describing the energy change associated with the addition of a small quantity of a substance to a system at constant temperature and pressure."@en ;
    ns2:PMD_0000060 true .

ns2:PMD_0000591 a owl:Class ;
    rdfs:label "Kristallstruktur"@de,
        "OBSOLETE crystal structure"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000116 "will move to CryO" ;
    ns1:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    ns1:IAO_0100001 "Obsolete by Kamilla: replaced with defines crystal lattices with fancy axioms an SWRL rules in CryO https://github.com/materialdigital/crystallography-subdomain-ontology"@en ;
    rdfs:comment "The finite set of periodic geometric arrangements is described e.g. by the 14 possible Bravais Lattices in three-dimensional space."@en ;
    owl:deprecated true ;
    skos:definition "eine intensive Kristallqualität, die die periodische geometrische Anordnung von Einheiten in einem Kristallgitter verkörpert."@de,
        "an intensive quality of a crystal that embodies the periodic geometric arrangement of entities in a crystal lattice."@en ;
    ns2:PMD_0000060 true .

ns2:PMD_0000619 a owl:Class ;
    rdfs:label "electric potential"@en ;
    ns1:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0002328 ;
            owl:someValuesFrom ns2:PMD_0080022 ],
        ns2:PMD_0080116 ;
    skos:definition "an extensvie quality describing the amount of work needed to move a unit charge from a reference point to a specific location in an electric field."@en .

ns2:PMD_0001035 a owl:Class ;
    rdfs:label "angle"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf ns2:PMD_0025018 ;
    skos:definition "A property that represents the measure of rotation or inclination between two intersecting lines or planes, independent of the size of the object." ;
    ns2:PMD_0001032 <https://github.com/materialdigital/core-ontology/issues/278> .

ns2:PMD_0020151 a owl:Class ;
    rdfs:label "innere Energie"@de,
        "internal energy"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf ns2:PMD_0020142,
        ns2:PMD_0023000 ;
    skos:definition "Innere Energie ist eine universelle umfassende Qualität, die das Potenzial des Trägers zur Arbeit festlegt."@de,
        "Internal energy is a universal extensive quality that specifies the bearers potential to do work."@en ;
    ns2:PMD_0000060 true .

ns2:PMD_0020161 a owl:Class ;
    rdfs:label "thermodynamische Aktivität"@de,
        "activity (thermodynamic)"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    ns1:IAO_0000119 """old defintion: 
Activity (a_X) is a relational property between a chemical species X and a non-ideal solution. a_X is a measure of the effective concentration of a chemical species X in the non-ideal solution, accounting for interactions between particles. It is defined as the product of the concentration and an activity coefficient, where the activity coefficient corrects for non-ideal behavior.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000080 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:CHEBI_60003 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000087 ;
                                owl:someValuesFrom ns2:PMD_0020227 ] [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0002350 ;
                                owl:someValuesFrom ns2:PMD_0020229 ] ) ] ],
        ns1:BFO_0000019,
        ns2:PMD_0020313,
        ns2:PMD_0023004 ;
    skos:definition "Thermodynamische Aktivität ist eine Beziehungsqualität, die zwischen einer chemischen Spezies und einer nicht idealen Lösung innewohnt und die effektive Konzentration der Spezies darstellt, die für Partikelwechselwirkungen verantwortlich ist."@de,
        "Thermodynamic activity is a relational quality that inheres between a chemical species and a non-ideal solution and represents the effective concentration of the species accounting for particle interactions."@en .

ns2:PMD_0020312 a owl:Class ;
    rdfs:label "electromagnetic property"@en ;
    rdfs:subClassOf ns2:PMD_0020265 ;
    skos:definition "a property that is commonly associated with the domain of electricity and magnetics"@en .

ns2:PMD_0020319 a owl:Class ;
    rdfs:label "extensive property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0002328 ;
            owl:someValuesFrom ns2:PMD_0023000 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:BFO_0000024 ns1:BFO_0000027 ns1:BFO_0000029 ns1:BFO_0000030 ns1:BFO_0000140 ) ] ],
        ns2:PMD_0023002 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000052 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( ns1:BFO_0000024 ns1:BFO_0000027 ns1:BFO_0000029 ns1:BFO_0000030 ns1:BFO_0000140 ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0002328 ;
                        owl:someValuesFrom ns2:PMD_0023000 ] ) ] ;
    skos:definition "a facetted property that is characteristic of some object or object aggregate or fiat object part and that changes with bearers makeup."@en .

ns2:PMD_0020353 a owl:Class ;
    rdfs:label "unclassified property"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000116 "Do not use this class directly. It will be deprecated in future releases." ;
    ns1:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf ns2:PMD_0020265 ;
    skos:definition "a collection of to-be classifed SDCs"@en .

ns2:PMD_0023004 a owl:Class ;
    rdfs:label "a portions property"@en ;
    rdfs:subClassOf ns2:PMD_0023003 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000052 ;
                        owl:someValuesFrom ns2:PMD_0000001 ] [ a owl:Restriction ;
                        owl:onProperty ns2:PMD_0025999 ;
                        owl:someValuesFrom ns2:PMD_0000001 ] ) ] ;
    skos:definition "a 'property by bearer' that indicates that its bearer is a portion of matter"@en .

ns2:PMD_0023035 a owl:Class ;
    rdfs:label "aggregated property"@en ;
    ns1:IAO_0000116 "the axioms do not allow for differentiation of the subclasses, see comment in 'functionally related to'"@en ;
    rdfs:subClassOf ns2:PMD_0023002 ;
    skos:definition "a facetted property that aggregates/condenses multiple values of members of an object aggregate"@en .

ns2:PMD_0023041 a owl:Class ;
    rdfs:label "a sites property"@en ;
    rdfs:subClassOf ns2:PMD_0023003 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000052 ;
                        owl:someValuesFrom ns1:BFO_0000029 ] [ a owl:Restriction ;
                        owl:onProperty ns2:PMD_0025999 ;
                        owl:someValuesFrom ns1:BFO_0000029 ] ) ] ;
    skos:definition "a 'property by bearer' that indicates that its bearer is a site"@en .

ns2:PMD_0025018 a owl:Class ;
    rdfs:label "geometrische relationale Qualität"@de,
        "geometric relational quality"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf ns1:BFO_0000145 ;
    skos:definition "Geometrische Beziehungsqualität ist eine Beziehungsqualität, die die geometrische Beziehung zwischen zwei oder mehr unabhängigen Kontinuen beschreibt."@de,
        "Geometric relational quality is a relational quality describing the geometric relation between two or more independent continuants."@en ;
    skos:example "Elongation of a specimen after a tensile step, i.e., the specimen before and after the test. Angle between a rolling direction of a rolled material and the longitudinal side of a specimen."@en .

ns2:PMD_0080022 a owl:Class ;
    rdfs:label "elektrische Ladung"@de,
        "electric charge"@en ;
    ns1:IAO_0000117 "PERSON: Thomas Hanke" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( ns2:PMD_0020312 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000080 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( ns1:BFO_0000027 ns1:BFO_0000030 ) ] ] ) ],
        ns1:BFO_0000019 ;
    skos:definition "Electric charge refers to the physical property of matter causing it to experience a force when placed in an electromagnetic field"@en ;
    skos:example "A capacitor stores 10 µC of electric charge at a voltage of 5 V"@en .

cryo:CRYO_0000000 a owl:Class ;
    rdfs:label "unit cell"@en ;
    rdfs:subClassOf ns1:BFO_0000029 ;
    skos:definition "Unit cell is a site which is a part of a crystal lattice and represents the smallest volume, from which the lattice can be constructed by translational displacements. Unit cell is characterized by the length of its sides and their angular relations."@en .

cryo:CRYO_0000043 a owl:NamedIndividual ;
    rdfs:label "primitive"@en ;
    skos:altLabel "P" ;
    skos:definition "Primitive centering type is a centering type, where lattice points are located only on the corners of a unit cell, i.e., at coordinates (0,0,0)."@en .

cryo:CRYO_0000044 a owl:NamedIndividual ;
    rdfs:label "body centered"@en ;
    skos:altLabel "I" ;
    skos:definition "Body centered centering type is a centering type, where lattice points are located  on the corners of a unit cell, i.e., at coordinates (0,0,0), and at the center of a unit cell, i.e., at coordinates (1/2,1/2,1/2)."@en .

cryo:CRYO_0000045 a owl:NamedIndividual ;
    rdfs:label "face centered"@en ;
    skos:altLabel "F" ;
    skos:definition "Face centered centering type is a centering type, where lattice points are located  on the corners of a unit cell, i.e., at coordinates (0,0,0), and at the center of each faces of a unit cell, i.e., at coordinates (1/2,1/2,0), (1/2,0,1/2), and (0,1/2,1/2)."@en .

cryo:CRYO_0000046 a owl:NamedIndividual ;
    rdfs:label "base centered"@en ;
    rdfs:comment "Add symbol annotation property" ;
    skos:altLabel "C" ;
    skos:definition "Base centered centering type is a centering type, where lattice points are located on the corners of a unit cell, i.e., at coordinates (0,0,0), and one additional lattice point is located at the center of a base of the cell, i.e., at coordinates (1/2,1/2,0)."@en .

cryo:CRYO_0000050 a owl:ObjectProperty ;
    rdfs:label "is tetragonal"@en ;
    rdfs:subPropertyOf cryo:CRYO_0000053 ;
    skos:definition "is tetragonal is a object property  for the inference of family of directions/planes Miller indices notation under tetragonal symmetry. The class crystallographic entity in tetragonal system carries a Self restriction \"is tetragonal\""@en .

cryo:CRYO_0000054 a owl:ObjectProperty ;
    rdfs:label "is triclinic"@de ;
    rdfs:subPropertyOf cryo:CRYO_0000053 ;
    skos:definition "is triclinic is a object property  for the inference of family of directions/planes Miller indices notation under triclinic symmetry. The class crystallographic entity in triclinic system carries a Self restriction \"is triclinic\""@en .

cryo:CRYO_0000055 a owl:ObjectProperty ;
    rdfs:label "is monoclinic"@de ;
    rdfs:subPropertyOf cryo:CRYO_0000053 ;
    skos:definition "is monoclinic is a object property  for the inference of family of directions/planes Miller indices notation under monoclinic symmetry. The class crystallographic entity in monoclinic system carries a Self restriction \"is monoclinic\""@en .

cryo:CRYO_0000056 a owl:ObjectProperty ;
    rdfs:label "is orthorhombic"@de ;
    rdfs:subPropertyOf cryo:CRYO_0000053 ;
    skos:definition "is orthorhombic is a object property  for the inference of family of directions/planes Miller indices notation under orthorhombic symmetry. The class crystallographic entity in orthorhombic system carries a Self restriction \"is orthorhombic\""@en .

cryo:CRYO_0000057 a owl:ObjectProperty ;
    rdfs:label "is rhombohedral"@de ;
    rdfs:subPropertyOf cryo:CRYO_0000053 ;
    skos:definition "is rhombohedral is a object property  for the inference of family of directions/planes Miller indices notation under rhombohedral symmetry. The class crystallographic entity in rhombohedral system carries a Self restriction \"is rhombohedral\""@en .

cryo:CRYO_0000058 a owl:ObjectProperty ;
    rdfs:label "is hexagonal"@de ;
    rdfs:subPropertyOf cryo:CRYO_0000053 ;
    skos:definition "is hexagonal is a object property  for the inference of family of directions/planes Miller indices notation under hexagonal symmetry. The class crystallographic entity in hexagonal system carries a Self restriction \"is hexagonal\""@en .

