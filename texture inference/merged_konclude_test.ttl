cryo:CRYO_0000075 a owl:Class ;
    rdfs:label "Euler angles"@en ;
    rdfs:comment "By aligning coordinate system of every crystal in the sample to the sample's coordinate system, anisotropy of material's properties can be investigated." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:OBI_0001927 ;
            owl:someValuesFrom cryo:CRYO_0000042 ],
        obo:IAO_0000027,
        obo:OBI_0001933 ;
    skos:definition "Euler angles are three angles which describe orientation of a sinlge crystal in respect to the sample's coordinate system"@en .

cryo:CRYO_0000076 a owl:NamedIndividual,
        cryo:CRYO_0000022 ;
    rdfs:label "(10-1)"@en ;
    cryo:CRYO_0000016 "(10-1)" .

