SubClassOf(<https://w3id.org/pmd/co/PMD_0020133> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000080> ObjectUnionOf(<http://purl.obolibrary.org/obo/BFO_0000024> <http://purl.obolibrary.org/obo/BFO_0000027> <http://purl.obolibrary.org/obo/BFO_0000030>)))

# Class: <https://w3id.org/pmd/co/PMD_0020136> (phase transformation)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0020136> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0020136> "PERSON: Philipp von Hartrott")
AnnotationAssertion(rdfs:comment <https://w3id.org/pmd/co/PMD_0020136> "The number of phases involved can vary as well as the mechanisms involved can be different."@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020136> "phase transformation"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020136> "A thermodynamic phase transformation is a process in/of a thermodynamic system, that involves the transformation of phases of the system to other phases."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020136> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020136> <http://purl.obolibrary.org/obo/BFO_0000015>)

# Class: <https://w3id.org/pmd/co/PMD_0020137> (stable phase)

AnnotationAssertion(rdfs:comment <https://w3id.org/pmd/co/PMD_0020137> "See metastable phase"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020137> "stable phase"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020137> "A stable phase is a phase that does not have a \"pmd:disposition of a phase to transform\" in the \"pmd:phase transformation\" it participates."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0020137> "A phase that participates in a phase transformation pt and pt that is not a metastable phase."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020137> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020137> <https://w3id.org/pmd/co/PMD_0020000>)
DisjointClasses(<https://w3id.org/pmd/co/PMD_0020137> <https://w3id.org/pmd/co/PMD_0020149>)

# Class: <https://w3id.org/pmd/co/PMD_0020138> (lot)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020138> "lot"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020138> "A lot is an object aggregate whose parts are output of the same production process."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020138> <http://purl.obolibrary.org/obo/BFO_0000027>)

# Class: <https://w3id.org/pmd/co/PMD_0020139> (melt)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020139> "Schmelze"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020139> "melt"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020139> "is a fluid (object) with a disposition to realize a blank role in a manufacturing process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0020139> "molten PLA in a 3D printing process"@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020139> ObjectIntersectionOf(<https://w3id.org/pmd/co/PMD_0020113> <https://w3id.org/pmd/co/PMD_0020290>))

# Class: <https://w3id.org/pmd/co/PMD_0020140> (portion of pure chemical element)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020140> "portion of pure chemical element"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020140> "A portion of pure chemical element is a pure substance composed of multiple atoms, which are all of the same kind."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020140> <http://purl.obolibrary.org/obo/CHEBI_60003>)

# Class: <https://w3id.org/pmd/co/PMD_0020142> (energy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0020142> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0020142> "PERSON: Philipp von Hartrott")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <https://w3id.org/pmd/co/PMD_0020142> <http://openenergy-platform.org/ontology/oeo/OEO_00000150>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020142> "Energie"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020142> "energy"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020142> "an extensive quality of material entities which manifests as a capacity to perform work (such as causing motion or the interaction of molecules)"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020142> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020142> <http://purl.obolibrary.org/obo/BFO_0000019>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020142> <https://w3id.org/pmd/co/PMD_0020353>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020142> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000080> ObjectUnionOf(<http://purl.obolibrary.org/obo/BFO_0000024> <http://purl.obolibrary.org/obo/BFO_0000027> <http://purl.obolibrary.org/obo/BFO_0000030>)))

# Class: <https://w3id.org/pmd/co/PMD_0020143> (process chain)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020143> "process chain"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020143> "A process chain is a process that 'has continuant part' subprocesses S1...Sn where S1...Sn precede each other and where some object or object aggregate that are output of Sn are then input to Sn+1."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020143> <http://purl.obolibrary.org/obo/BFO_0000015>)

# Class: <https://w3id.org/pmd/co/PMD_0020149> (metastable phase)

AnnotationAssertion(rdfs:comment <https://w3id.org/pmd/co/PMD_0020149> "The stability of a phase can only be evaluated in the context of a (possibly unknown) phase transformation process."@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020149> "metastable phase"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020149> "A metastable phase phase_trans is a phase that has a \"pmd:disposition of a phase to transform\" disp_trans and disp_trans is realized in a \"pmd:phase transformation\" proc_trans and proc_trans has participant sys_trans and sys_trans has part phase_trans."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020149> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020149> <https://w3id.org/pmd/co/PMD_0020000>)

# Class: <https://w3id.org/pmd/co/PMD_0020150> (Volumen)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0020150> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <https://w3id.org/pmd/co/PMD_0020150> "Necessary and sufficient conditions for 'volume' have not yet been formalized. The term is defined as a specific subtype of 'DimensionQuality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000918."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0020150> "PERSON: Philipp von Hartrott")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020150> "Volumen"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020150> "volume"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020150> "Volume is a three dimensional size."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020150> "Volumen ist eine dreidimensionale Größe."@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0020150> "A cylindrical billet has a volume of 0.002 m3, determined from its radius and height"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020150> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020150> <https://w3id.org/pmd/co/PMD_0020132>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020150> <https://w3id.org/pmd/co/PMD_0023000>)

# Class: <https://w3id.org/pmd/co/PMD_0020151> (internal energy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0020151> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0020151> "PERSON: Philipp von Hartrott")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020151> "innere Energie"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020151> "internal energy"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020151> "Innere Energie ist eine universelle umfassende Qualität, die das Potenzial des Trägers zur Arbeit festlegt."@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020151> "Internal energy is a universal extensive quality that specifies the bearers potential to do work."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020151> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020151> <https://w3id.org/pmd/co/PMD_0020142>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020151> <https://w3id.org/pmd/co/PMD_0023000>)

# Class: <https://w3id.org/pmd/co/PMD_0020161> (activity (thermodynamic))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0020161> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0020161> "PERSON: Philipp von Hartrott")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <https://w3id.org/pmd/co/PMD_0020161> "old defintion: 
Activity (a_X) is a relational property between a chemical species X and a non-ideal solution. a_X is a measure of the effective concentration of a chemical species X in the non-ideal solution, accounting for interactions between particles. It is defined as the product of the concentration and an activity coefficient, where the activity coefficient corrects for non-ideal behavior.")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020161> "activity (thermodynamic)"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020161> "thermodynamische Aktivität"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020161> "Thermodynamic activity is a relational quality that inheres between a chemical species and a non-ideal solution and represents the effective concentration of the species accounting for particle interactions."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020161> "Thermodynamische Aktivität ist eine Beziehungsqualität, die zwischen einer chemischen Spezies und einer nicht idealen Lösung innewohnt und die effektive Konzentration der Spezies darstellt, die für Partikelwechselwirkungen verantwortlich ist."@de)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020161> <http://purl.obolibrary.org/obo/BFO_0000019>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020161> <https://w3id.org/pmd/co/PMD_0020313>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020161> <https://w3id.org/pmd/co/PMD_0023004>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020161> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000080> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CHEBI_60003> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <https://w3id.org/pmd/co/PMD_0020227>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002350> <https://w3id.org/pmd/co/PMD_0020229>))))

# Class: <https://w3id.org/pmd/co/PMD_0020166> (heat (metallurgy))

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020166> "heat (metallurgy)"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020166> "A heat is a fixed amount of metallic alloy that may be input to some manufacturing process."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020166> ObjectIntersectionOf(<https://w3id.org/pmd/co/PMD_0020139> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <https://w3id.org/pmd/co/PMD_0000534>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0001001> <https://w3id.org/pmd/co/PMD_0000852>)))

# Class: <https://w3id.org/pmd/co/PMD_0020170> (Bramme)

AnnotationAssertion(rdfs:comment <https://w3id.org/pmd/co/PMD_0020170> "The ingot may be hot rolled after casting..."@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020170> "Bramme"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020170> "ingot"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020170> "An ingot is an object that has a thick section and may bear a semi finished product role and that is the specified output of a casting process. At the same time it is a material."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020170> <http://purl.obolibrary.org/obo/BFO_0000030>)

