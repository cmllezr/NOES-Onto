    skos:definition "Transverse direction is a direction in the rolling plane normal to the direction in which the sheet is pushed through the rolling mill."@en .

:NOES_0000135 a owl:Class ;
    rdfs:label "crystallite with rotated cube texture orientation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:PMD_0025998 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :NOES_0000141 [ a owl:Restriction ;
                                owl:onProperty ns2:RO_0002503 ;
                                owl:someValuesFrom :NOES_0000060 ] [ a owl:Restriction ;
                                owl:onProperty ns1:PMD_0000077 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( [ a owl:Restriction ;
                                                    owl:hasValue ns2:UO_0000185 ;
                                                    owl:onProperty ns2:IAO_0000039 ] [ a owl:Restriction ;
                                                    owl:onProperty ns2:OBI_0001937 ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:float ;
                                                            owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] ) ] ],
        ns1:PMD_0000663 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:PMD_0000663 [ a owl:Restriction ;
                        owl:onProperty ns1:PMD_0025998 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( :NOES_0000141 [ a owl:Restriction ;
                                            owl:onProperty ns2:RO_0002503 ;
                                            owl:someValuesFrom :NOES_0000060 ] [ a owl:Restriction ;
                                            owl:onProperty ns1:PMD_0000077 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( [ a owl:Restriction ;
                                                                owl:hasValue ns2:UO_0000185 ;
                                                                owl:onProperty ns2:IAO_0000039 ] [ a owl:Restriction ;
                                                                owl:onProperty ns2:OBI_0001937 ;
                                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                                        owl:onDatatype xsd:float ;
                                                                        owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] ) ] ] ) ] ;
    skos:comment "Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference."@en ;
    skos:definition "crystallite with rotated cube texture orientation is a crystallite whose family of <110> equivalent directions in a cubic lattice system are oriented approximately parallel to the rolling direction and family of {001} equivalent directions are oriented approximately parallel to the rolling plane."@en .

:NOES_0000144 a owl:Class ;
    rdfs:label "crystallite with Goss texture orientation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
