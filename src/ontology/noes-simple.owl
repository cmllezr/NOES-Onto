        <skos:definition xml:lang="en">Percentage elongation after fracture in the transversal direction is percentage elongation after fracture which is measured on a sample cut parallel to the transversal direction.</skos:definition>
        <noes:NOES_0000122 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</noes:NOES_0000122>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000101 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000101">
        <rdfs:comment>An instance belonging to the class should be rather inferred as asserted.</rdfs:comment>
        <rdfs:label xml:lang="en">percentage plastic extension at maximum force at 45° to the rolling direction</rdfs:label>
        <skos:definition xml:lang="en">Percentage plastic extension at maximum force at 45° to the rolling direction is percentage elongation at maximum force which is measured on a sample cut to the 45° to the rolling direction.</skos:definition>
        <noes:NOES_0000122 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</noes:NOES_0000122>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000102 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000102">
        <rdfs:comment xml:lang="en">An instance belonging to the class should be rather inferred as asserted.</rdfs:comment>
        <rdfs:label xml:lang="en">percentage plastic extension at maximum force in the rolling direction</rdfs:label>
        <skos:definition xml:lang="en">Percentage plastic extension at maximum force in the rolling direction is percentage elongation at maximum force which is measured on a sample cut parallel to the rolling direction.</skos:definition>
        <noes:NOES_0000122 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</noes:NOES_0000122>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000103 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000103">
        <rdfs:comment xml:lang="en">An instance belonging to the class should be rather inferred as asserted.</rdfs:comment>
        <rdfs:label xml:lang="en">percentage plastic extension at maximum force in the transversal direction</rdfs:label>
        <skos:definition xml:lang="en">Percentage plastic extension at maximum force in the transversal direction is percentage elongation at maximum force which is measured on a sample cut parallel the transversal direction.</skos:definition>
        <noes:NOES_0000122 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</noes:NOES_0000122>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000104 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000104">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000051"/>
        <rdfs:comment xml:lang="en">An instance belonging to the class should be rather inferred as asserted.</rdfs:comment>
        <rdfs:label xml:lang="en">saturation induction in the rolling direction</rdfs:label>
        <skos:definition xml:lang="en">Saturation induction in the rolling direction is a saturation induction measured exclusively in the rolling direction of an electrical sheet.</skos:definition>
        <noes:NOES_0000122 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</noes:NOES_0000122>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000105 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000105">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000051"/>
        <rdfs:comment xml:lang="en">An instance belonging to the class should be rather inferred as asserted.</rdfs:comment>
        <rdfs:label xml:lang="en">saturation induction in the transversal direction</rdfs:label>
        <skos:definition xml:lang="en">Saturation induction in the transversal direction is a saturation induction measured exclusively in the transversal direction of an electrical sheet.</skos:definition>
        <noes:NOES_0000122 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</noes:NOES_0000122>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000106 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000106">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000059"/>
        <rdfs:label xml:lang="en">differential permeability in the rolling direction</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000107 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000107">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000059"/>
        <rdfs:label xml:lang="en">differential permeability in the transversal direction</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000108 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000108">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000062"/>
        <rdfs:label xml:lang="en">maximum permeability in the rolling direction</rdfs:label>
        <noes:NOES_0000122 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</noes:NOES_0000122>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000109 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000109">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000062"/>
        <rdfs:label xml:lang="en">maximum permeability in the transversal direction</rdfs:label>
        <noes:NOES_0000122 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</noes:NOES_0000122>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000110 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000110">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000000"/>
        <rdfs:label xml:lang="en">relative permeability in the rolling direction</rdfs:label>
        <noes:NOES_0000122 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</noes:NOES_0000122>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000111 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000111">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000000"/>
        <rdfs:label xml:lang="en">relative permeability in the transversal direction</rdfs:label>
        <noes:NOES_0000122 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</noes:NOES_0000122>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000112 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000112">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000064"/>
        <rdfs:label xml:lang="en">reversible permeability in the rolling direction</rdfs:label>
        <noes:NOES_0000122 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</noes:NOES_0000122>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000113 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000113">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000064"/>
        <rdfs:label xml:lang="en">reversible permeability in the transversal direction</rdfs:label>
        <noes:NOES_0000122 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</noes:NOES_0000122>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000114 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000114">
        <rdfs:label xml:lang="de">Stanzen</rdfs:label>
        <rdfs:label xml:lang="en">stamping</rdfs:label>
        <skos:definition xml:lang="en">Stamping is a separating process, a stamping press is a participant and it realizes some cutting function.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000117 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000117">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/noes/NOES_0000118"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000023"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">rolling mill</rdfs:label>
        <skos:definition xml:lang="en">Rolling mill is device which is a participant in a rolling process, has a function of reducing thickness of an object that is specified input to the rolling process, and this function is realized in the rolling process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000118 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000118">
        <rdfs:label xml:lang="en">thickness reduction function</rdfs:label>
        <skos:definition xml:lang="en">Thickness reduction function is a function to reduce thickness of a material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000119 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000119">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025006"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000023"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025006"/>
                        <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000023"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025006"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000023"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Number of rolling passes is a process attribute of a rolling process which specifies how many times a piece of material have been passed between rolling mills to achieve desired thickness.</rdfs:comment>
        <rdfs:label xml:lang="en">number of rolling passes</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000120 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000120">
        <rdfs:comment>An instance belonging to the class should be rather inferred as asserted.</rdfs:comment>
        <rdfs:label xml:lang="en">percentage plastic extension at fracture at 45° to the rolling direction</rdfs:label>
        <skos:definition xml:lang="en">Percentage plastic extension at fracture at 45° to the rolling direction is percentage elongation atfracture which is measured on a sample cut to the 45° to the rolling direction.</skos:definition>
        <noes:NOES_0000122 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</noes:NOES_0000122>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000121 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000121">
        <rdfs:comment>An instance belonging to the class should be rather inferred as asserted.</rdfs:comment>
        <rdfs:label xml:lang="en">percentage plastic extension at fracture in the rolling direction</rdfs:label>
        <skos:definition xml:lang="en">Percentage plastic extension at fracture in the rolling direction is percentage elongation atfracture which is measured on a sample cut parallel the rolling direction.</skos:definition>
        <noes:NOES_0000122 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</noes:NOES_0000122>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000123 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000123">
        <rdfs:comment>TODO axiom</rdfs:comment>
        <rdfs:label xml:lang="en">deviation angle</rdfs:label>
        <skos:definition xml:lang="en">Deviation angle is a geometric relational quality relevant for the crystallographic texture analysis. Deviation angle  represents an angle between two crystallographic planes which are denoted by the same Miller indices, namely a crystallographic plane which is perfectly parallel to the rolling plane of a sheet material and a crystallographic plane in a crystal grain which is a part of the material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000124 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000124">
        <rdfs:comment>An instance belonging to the class should be rather inferred as asserted.</rdfs:comment>
        <rdfs:label xml:lang="en">percentage plastic extension at fracture in the transversal direction</rdfs:label>
        <skos:definition xml:lang="en">Percentage plastic extension at fracture in the transversal direction is percentage elongation at fracture which is measured on a sample cut parallel the transversal direction.</skos:definition>
        <noes:NOES_0000122 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</noes:NOES_0000122>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000125 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000125">
        <rdfs:label xml:lang="en">inclusion role</rdfs:label>
        <skos:definition xml:lang="en">Inclusion role is a role of object aggregate which is a part of microstructure of an alloy: These object aggregates are second-phase particles embedded in the alloy matrix, and are thermodynamically distinct from the matrix.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000126 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000126">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000125"/>
        <rdfs:comment xml:lang="en">Curation status: need more sophisticated axioms to detect metallic / non-metallic type. 
Will be inferable in the future</rdfs:comment>
        <rdfs:label xml:lang="en">metallic inclusion role</rdfs:label>
        <skos:definition xml:lang="en">Matallic inclusion role is a inclusion role of some object aggregate, which members have metallic bond.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000127 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000127">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000125"/>
        <rdfs:comment xml:lang="en">Curation status: need more sophisticated axioms to detect metallic / non-metallic type. 
Will be inferable in the future</rdfs:comment>
        <rdfs:label xml:lang="en">non-metallic inclusion role</rdfs:label>
        <skos:definition xml:lang="en">Non-metallic inclusion role is a inclusion role of some object aggregate, which members have non-metallic bond.</skos:definition>
        <skos:example xml:lang="en">Non-metallic inclusion role of SiO₂, MnS, AlN, Si₃N₄, etc.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000128 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000128">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000043"/>
        <qudt:symbol>A0</qudt:symbol>
        <rdfs:label xml:lang="en">texture parameter A0</rdfs:label>
        <rdfs:seeAlso>http://refhub.elsevier.com/S0304-8853(18)30867-9/h0160</rdfs:seeAlso>
        <skos:definition xml:lang="en">Texture parameter A0 is a texture parameter for a magnetic field direction parallel to RD.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000129 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000129">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000043"/>
        <qudt:symbol>A90</qudt:symbol>
        <rdfs:label xml:lang="en">texture parameter A90</rdfs:label>
        <rdfs:seeAlso>http://refhub.elsevier.com/S0304-8853(18)30867-9/h0160</rdfs:seeAlso>
        <skos:definition>Texture parameter A90 is a texture parameter for a magnetic field direction parallel to TD.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000130 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000130">
        <rdfs:label xml:lang="en">homogenization</rdfs:label>
        <skos:altLabel xml:lang="en">homogenizing</skos:altLabel>
        <skos:definition xml:lang="en">Homogenization is a type of heat treatment which involves heating the metal to a very high temperature (just below its melting point) and holding it there for a long period of time.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000132 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000132">
        <rdfs:label xml:lang="en">operating current</rdfs:label>
        <skos:definition xml:lang="en">operating current in is the electrical current (measured in milliamperes, mA) applied to the filament which controls the intensity of the beam (X-Ray, electron, etc)</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000133 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000133">
        <rdfs:label xml:lang="en">number density</rdfs:label>
        <skos:definition xml:lang="en">number density is a proportion which presents the count of individual, countable items (such as atoms, molecules, charge carriers, etc.) contained within a specific unit of volume</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000134 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000134">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025006"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000023"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">rolling speed</rdfs:label>
        <skos:definition xml:lang="en">rotational velocity and surface speed of the work rolls during rolling process</skos:definition>
        <skos:example>0.5 m/s</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000135 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000135">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000162"/>
        <rdfs:label xml:lang="en">crystallite with rotated cube texture orientation</rdfs:label>
        <skos:comment xml:lang="en">Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference.</skos:comment>
        <skos:definition xml:lang="en">crystallite with rotated cube texture orientation is a crystallite whose family of &lt;110&gt; equivalent directions in a cubic lattice system are oriented approximately parallel to the rolling direction and family of {001} equivalent directions are oriented approximately parallel to the rolling plane.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000144 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000144">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000157"/>
        <rdfs:label xml:lang="en">crystallite with Goss texture orientation</rdfs:label>
        <skos:comment xml:lang="en">Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference.</skos:comment>
        <skos:definition xml:lang="en">crystallite with Goss texture orientation is a crystallite whose family of &lt;001&gt; equivalent directions in a cubic lattice system are oriented approximately parallel to the rolling direction and family of {110} equivalent directions are oriented approximately parallel to the rolling plane.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000151 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000151">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000162"/>
        <rdfs:label xml:lang="en">crystallite with rotated Goss texture orientation</rdfs:label>
        <skos:comment xml:lang="en">Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference.</skos:comment>
        <skos:definition xml:lang="en">crystallite with rotated Goss texture orientation is a crystallite whose family of &lt;110&gt; equivalent directions in a cubic lattice system are oriented approximately parallel to the rolling direction and family of {110} equivalent directions are oriented approximately parallel to the rolling plane.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000152 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000152">
        <rdfs:label xml:lang="en">crystallite with λ-fiber texture orientation</rdfs:label>
        <skos:comment xml:lang="en">Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference.</skos:comment>
        <skos:definition xml:lang="en">crystallite with  λ-fiber texture orientation is a crystallite whose family of &lt;100&gt; equivalent directions in a cubic lattice system are oriented approximately parallel to the normal direction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000153 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000153">
        <rdfs:label xml:lang="en">diffraction process</rdfs:label>
        <skos:definition xml:lang="en">Diffraction process is a structural property analyzing process which utilizes diffraction of either electron, x-ray, or neutron waves to determine material&apos;s crystal structure, crystallographic texture, (phase) composition, and presence of defects.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000154 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000154">
        <rdfs:label xml:lang="en">diffractometer</rdfs:label>
        <skos:definition xml:lang="en">Diffractometer is a device which detects the intensity of a beam of either electrons, x-rays, or neutrons scattered from a material during a diffraction process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000155 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000155">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000154"/>
        <rdfs:label xml:lang="en">EBSD system</rdfs:label>
        <skos:definition xml:lang="en">Electron backscatter diffraction (EBSD) system is a diffractomter which detects diffracted electrons in the chamber of a scanning electron microscope.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000156 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000156">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000070"/>
        <rdfs:label xml:lang="en">maximal magnetic field strength</rdfs:label>
        <skos:definition xml:lang="en">Maximal magnetic field is a maximal value of a magnetic field has has to be achieved during characterization of magnetic properties</skos:definition>
        <co:symbol xml:lang="en">Hmax</co:symbol>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000157 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000157">
        <rdfs:label xml:lang="en">crystallite with η-fiber texture orientation</rdfs:label>
        <skos:comment xml:lang="en">Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference.</skos:comment>
        <skos:definition xml:lang="en">crystallite with η-fiber texture orientation is a crystallite whose family of &lt;001&gt; equivalent directions in a cubic lattice system are oriented approximately parallel to the rolling direction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000158 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000158">
        <rdfs:label xml:lang="en">crystallite with γ-fiber texture orientation</rdfs:label>
        <skos:comment xml:lang="en">Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference.</skos:comment>
        <skos:definition xml:lang="en">crystallite withγ-fiber texture orientation is a crystallite whose family of &lt;111&gt; equivalent directions in a cubic lattice system are oriented approximately parallel to the normal direction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000159 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000159">
        <rdfs:label xml:lang="en">operating voltage</rdfs:label>
        <skos:definition xml:lang="en">operating g voltage is a process attribute of an assay which describes the value of a voltage applied to the electron source to extract electrons from the source and accelerate them in the direction of a sample</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000160 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000160">
        <rdfs:comment>TODO refine the axiom: 
1. Add reference frames for sample and material?
2. longitudinal direction as sublcass of fiat line?</rdfs:comment>
        <rdfs:label xml:lang="en">angle to rolling direction</rdfs:label>
        <skos:definition xml:lang="en">Angle to rolling direction is a relational quality which characterizes the orientation of a sample cut from a rolled material in respect to the rolling direction (RD) of this material.</skos:definition>
        <skos:example xml:lang="en">Sample cut at 30° to rolling direction of a annealed nonoriented electrical steel.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000161 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000161">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000177"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                        <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000177"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000177"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The axiom is not expressible in OWL. SHACL restriction?</rdfs:comment>
        <rdfs:label xml:lang="en">α*-fiber texture</rdfs:label>
        <skos:altLabel>{h11}&lt;1/h12&gt;</skos:altLabel>
        <skos:definition xml:lang="en">α*-fiber texture is a type of crystallographic texture which is quality of grain population, i.e., several grains, having a similar orientation (within a misorientation threshold) in relation to the material&apos;s reference frame: {11h} family of crystallographic planes are oriented parallel to the rolling plane of a sheet material and &lt;1/h12&gt; family of crystallographic directions are oriented parallel to the rolling direction (RD) of a sheet material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000162 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000162">
        <rdfs:label xml:lang="en">crystallite with α-fiber texture orientation</rdfs:label>
        <skos:comment xml:lang="en">Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference.</skos:comment>
        <skos:definition xml:lang="en">crystallite with α-fiber texture orientation is a crystallite whose family of &lt;110&gt; equivalent directions in a cubic lattice system are oriented approximately parallel to the rolling direction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000163 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000163">
        <rdfs:label xml:lang="en">magnetic properties measuring device</rdfs:label>
        <skos:definition xml:lang="en">Magnetic properties measuring device is a device that measures a hysteresis curve, i,e., its corresponding characteristic points, hysteresis loss, and total magnetic loss, of soft magnetic materials by applying alternating (AC) or quasi-static (DC) electric current on copper coils to produde external magnetic field.</skos:definition>
        <skos:example xml:lang="en">Single sheet tester (SST), Epstein frame, Ring core tester</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000164 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000164">
        <rdfs:label xml:lang="en">crystallite with α*-fiber texture orientation</rdfs:label>
        <skos:comment xml:lang="en">Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference.</skos:comment>
        <skos:comment xml:lang="en">The axiom is not expressible in OWL. SHACL restriction?</skos:comment>
        <skos:definition xml:lang="en">crystallite with α*-fiber texture orientation is a crystallite whose family of &lt;1/h12&gt; equivalent directions in a cubic lattice system are oriented approximately parallel to the rolling direction and family of {h11} equivalent directions are oriented approximately parallel to the rolling plane.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000165 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000165">
        <rdfs:label xml:lang="en">fillet radius</rdfs:label>
        <skos:example xml:lang="en">Fillet radus is a charactereristic paramater of a geometry of a tensile test specimen which characterizes the radius of the curved sections (fillets) connecting the gripping ends to the reduced gauge length in a standard &quot;dog-bone&quot; specimen is specifically dimensioned to prevent stress concentrations from causing premature failure outside the gauge length.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000166 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000166">
        <rdfs:label xml:lang="en">average grain size</rdfs:label>
        <skos:example xml:lang="en">Average grain size is an intensive quality of a material which describes the average diameter of grains in the material&apos;s microstructure.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000167 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000167">
        <rdfs:label xml:lang="en">crystallite with cube texture orientation</rdfs:label>
        <skos:comment xml:lang="en">Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference.</skos:comment>
        <skos:definition xml:lang="en">crystallite with cube texture orientation is a crystallite whose family of &lt;100&gt; equivalent directions in a cubic lattice system are oriented approximately parallel to the rolling direction and family of {001} equivalent directions are oriented approximately parallel to the rolling plane.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000177 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000177">
        <rdfs:comment xml:lang="en">Grain population is a disconnected material aggregate which has crystallites ias parts.  Grain population represents grains which not necesserly spatially connected (unlike polycrystal) but share some collective quality, such as preffered crystallographic orientation.</rdfs:comment>
        <rdfs:label xml:lang="en">grain population</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000178 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000178">
        <rdfs:comment xml:lang="en">TODO add axioms
1. When the magnetic qualities are realized
2. Especially for peak values that would be interesting</rdfs:comment>
        <rdfs:label xml:lang="en">magnetic polarization</rdfs:label>
        <skos:definition xml:lang="en">Magnetic polarization is a magnetic property which is a measure of intrinsic magnetization of a material (alignment of magnetic dipoles) as a response to the externaly applied magnetic field H. It is determined as a difference between magnetic induction B and the external field µ0*H.</skos:definition>
        <co:symbol>J</co:symbol>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000179 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000179">
        <rdfs:comment xml:lang="en">Electrical steel is a steel material which has only ferritic metallic grain structure and uses silicon as the main alloying element. It manufactured in a form of a sheet and designed to exibit superior magenetic properties either in all directions (non-orieneted) or in a sinlge direction (oriented).</rdfs:comment>
        <rdfs:label xml:lang="en">electrical steel</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000180 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000180">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000179"/>
        <rdfs:label xml:lang="en">non-oriented electrical steel</rdfs:label>
        <skos:altLabel>NOES</skos:altLabel>
        <skos:altLabel xml:lang="en">Non-oriented electrical steel is an electrical steel material which exhibits isotropic magnetic properties in all direction in the sheet plane.</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000181 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000181">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000180"/>
        <rdfs:comment xml:lang="en">TODO: 
1. Import W/kg units
2. Add units to the equivalent class
3. Think of adding nomical thickness class
4. Check the some in the decimal</rdfs:comment>
        <rdfs:label xml:lang="en">NO27-14</rdfs:label>
        <skos:altLabel xml:lang="en">NO27-14 is a non-oriented electrical steel which has characteristic total magnetic losses P1.0/400 of max 14 W/kg and a quality thickness of 0.27 mm.</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000182 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000182">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000178"/>
        <rdfs:label xml:lang="en">peak magnetic polarization</rdfs:label>
        <skos:altLabel xml:lang="en">saturation polatization</skos:altLabel>
        <skos:definition xml:lang="en">Peak magnetic polarization is a maximum magnetic polarization that a material exhibits under the applied external magnetic field Hmax.</skos:definition>
        <co:symbol>Jmax</co:symbol>
        <co:symbol xml:lang="en">Jsat</co:symbol>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000183 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000183">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000163"/>
        <obo:IAO_0000119>https://de.wikipedia.org/wiki/Epsteinrahmen</obo:IAO_0000119>
        <rdfs:comment xml:lang="en">Epstein frame is a measuring device of magnetic properties of soft magnetic materials, especially electrical steels. It consists of outer primary (magnetizing) winding, which surrounds the inner secondary (measuring) winding, and both windings are distributed across the four coils of the  frame. The steel strips are inserted pairwise into the opposite coils.</rdfs:comment>
        <rdfs:label xml:lang="en">Epstein frame</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000184 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000184">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000163"/>
        <obo:IAO_0000119>https://www.magnet-physik.de/wp-content/uploads/2023/08/MJC-210-e-3236.pdf</obo:IAO_0000119>
        <rdfs:comment xml:lang="en">Single sheet tester is a measuring device of soft magnetic properties of sheet materials, especially electrical steels. It consists of a single coil system to magnetize the sample with and and a pick-up coil to detect  polarization in the material.</rdfs:comment>
        <rdfs:label xml:lang="en">sinlge sheet tester</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000185 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000185">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000163"/>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Rowland_ring</obo:IAO_0000119>
        <rdfs:label xml:lang="en">thoroidal core setup</rdfs:label>
        <skos:altLabel xml:lang="en">Thoroidal core setup is a measuring device of a hysteresis curve of magnetic materials. The specimen shape is a thoroid, around which a magnitization coil is closely wound.</skos:altLabel>
        <skos:altLabel xml:lang="en">ring core setup</skos:altLabel>
    </owl:Class>
    


