noes:NOES_0000114 a owl:Class ;
    rdfs:label "Stanzen"@de,
        "stamping"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0025021 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000085 ;
                                owl:someValuesFrom pmd:PMD_0000592 ] ) ] ],
        pmd:PMD_0000927 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000927 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000055 ;
                        owl:someValuesFrom pmd:PMD_0000592 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000057 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0025021 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000085 ;
                                            owl:someValuesFrom pmd:PMD_0000592 ] ) ] ] ) ] ;
    skos:definition "Stamping is a separating process, a stamping press is a participant and it realizes some cutting function."@en .

noes:NOES_0000115 a owl:AnnotationProperty ;
    rdfs:label "explicit"@en .

noes:NOES_0000116 a owl:AnnotationProperty ;
    rdfs:label "implicit"@en .

noes:NOES_0000117 a owl:Class ;
    rdfs:label "rolling mill"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000085 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( noes:NOES_0000118 [ a owl:Restriction ;
                                owl:onProperty obo:BFO_0000054 ;
                                owl:someValuesFrom noes:NOES_0000023 ] ) ] ],
        pmd:PMD_0000602 ;
    skos:definition "Rolling mill is device which is a participant in a rolling process, has a function of reducing thickness of an object that is specified input to the rolling process, and this function is realized in the rolling process."@en .

noes:NOES_0000119 a owl:Class ;
    rdfs:label "number of rolling passes"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025006 ;
                        owl:someValuesFrom noes:NOES_0000023 ] [ a owl:Restriction ;
                        owl:allValuesFrom noes:NOES_0000023 ;
                        owl:onProperty pmd:PMD_0025006 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0025006 ;
            owl:someValuesFrom noes:NOES_0000023 ],
        pmd:PMD_0000008 ;
    skos:definition "Number of rolling passes is a process attribute of a rolling process which specifies how many times a piece of material have been passed between rolling mills to achieve desired thickness."@en .

noes:NOES_0000120 a owl:Class ;
    rdfs:label "percentage plastic extension at fracture at 45° to the rolling direction"@en ;
    rdfs:comment "An instance belonging to the class should be rather inferred as asserted." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009007 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0000974 [ a owl:Restriction ;
                                owl:onProperty obo:OBI_0000293 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0001015 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( noes:NOES_0000031 [ a owl:Restriction ;
                                                                        owl:onProperty pmd:PMD_0025998 ;
                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                owl:intersectionOf ( noes:NOES_0000160 [ a owl:Restriction ;
                                                                                            owl:onProperty pmd:PMD_0000077 ;
                                                                                            owl:someValuesFrom [ a owl:Class ;
                                                                                                    owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                                                owl:hasValue 45 ;
                                                                                                                owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ],
        obo:BFO_0000020,
        <https://w3id.org/pmd/tto/TTO_0000039> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <https://w3id.org/pmd/tto/TTO_0000039> [ a owl:Restriction ;
                        owl:onProperty obo:RO_0009007 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0000974 [ a owl:Restriction ;
                                            owl:onProperty obo:OBI_0000293 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                                owl:onProperty obo:RO_0001015 ;
                                                                owl:someValuesFrom [ a owl:Class ;
                                                                        owl:intersectionOf ( noes:NOES_0000031 [ a owl:Restriction ;
                                                                                    owl:onProperty pmd:PMD_0025998 ;
                                                                                    owl:someValuesFrom [ a owl:Class ;
                                                                                            owl:intersectionOf ( noes:NOES_0000160 [ a owl:Restriction ;
                                                                                                        owl:onProperty pmd:PMD_0000077 ;
                                                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                                                owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                                                            owl:hasValue 45 ;
                                                                                                                            owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ;
    skos:definition "Percentage plastic extension at fracture at 45° to the rolling direction is percentage elongation atfracture which is measured on a sample cut to the 45° to the rolling direction."@en ;
    noes:NOES_0000122 false .

noes:NOES_0000121 a owl:Class ;
    rdfs:label "percentage plastic extension at fracture in the rolling direction"@en ;
    rdfs:comment "An instance belonging to the class should be rather inferred as asserted." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009007 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0000974 [ a owl:Restriction ;
                                owl:onProperty obo:OBI_0000293 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0001015 ;
