    <!-- https://w3id.org/pmd/cryo/CRYO_0000059 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/cryo/CRYO_0000059">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000164"/>
