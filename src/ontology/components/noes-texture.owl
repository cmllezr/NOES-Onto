                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000853"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/noes/NOES_0000177"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000162"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                                <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000162"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">α-fiber texture</rdfs:label>
        <skos:altLabel>&lt;110&gt; || RD</skos:altLabel>
        <skos:definition xml:lang="en">α-fiber texture component is a type of crystallographic texture which is quality of grain population, i.e., several grains, having a similar orientation (within a misorientation threshold) in relation to the material&apos;s reference frame: &lt;110&gt; family of crystallographic directions are oriented parallel to the rolling direction (RD) of a sheet material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000087 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000087">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000853"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/noes/NOES_0000177"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000152"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                                <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000152"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Note on a crystal structure: 
theoretically possible in both bcc and fcc because &lt;100&gt; are the same types of directions
practically lambda fiber is not stable in fcc because of the slip systems</rdfs:comment>
        <rdfs:label xml:lang="en">λ-fiber texture</rdfs:label>
        <skos:altLabel>&lt;100&gt; || ND</skos:altLabel>
        <skos:altLabel xml:lang="en">θ-fiber texture</skos:altLabel>
        <skos:definition xml:lang="en">λ-fiber texture component is a type of crystallographic texture which is quality of grain population, i.e., several grains, having a similar orientation (within a misorientation threshold) in relation to the material&apos;s reference frame:  &lt;100&gt; family of crystallographic directions are oriented parallel to the normal direction (ND) of a sheet material, i,e., normal to the rolling plane.</skos:definition>
    </owl:Class>
    


