: a owl:Ontology .

:NOES_0000002 a owl:Class ;
    rdfs:label "rolled sheet direction value"@en ;
    rdfs:subClassOf ns1:OBI_0001930 ;
    owl:deprecated true ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :NOES_0000028 :NOES_0000029 :NOES_0000030 ) ] ;
    skos:definition "Rolled sheet directions is a categorical value specification which specifies the rolled sheet direction. It  includes rolling direction (RD), transverse direction (TD), and normal direction (ND)"@en .

:NOES_0000152 a owl:Class ;
    rdfs:label "crystallite with λ-fiber texture orientation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:PMD_0025998 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :NOES_0000141 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0002503 ;
                                owl:someValuesFrom :NOES_0000112 ] [ a owl:Restriction ;
                                owl:onProperty ns2:PMD_0000077 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( [ a owl:Restriction ;
                                                    owl:hasValue ns1:UO_0000185 ;
                                                    owl:onProperty ns1:IAO_0000039 ] [ a owl:Restriction ;
                                                    owl:onProperty ns1:OBI_0001937 ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:float ;
                                                            owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] ) ] ],
        ns2:PMD_0000663 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns2:PMD_0000663 [ a owl:Restriction ;
                        owl:onProperty ns2:PMD_0025998 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( :NOES_0000141 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0002503 ;
                                            owl:someValuesFrom :NOES_0000112 ] [ a owl:Restriction ;
                                            owl:onProperty ns2:PMD_0000077 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( [ a owl:Restriction ;
                                                                owl:hasValue ns1:UO_0000185 ;
                                                                owl:onProperty ns1:IAO_0000039 ] [ a owl:Restriction ;
                                                                owl:onProperty ns1:OBI_0001937 ;
                                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                                        owl:onDatatype xsd:float ;
                                                                        owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] ) ] ] ) ] ;
    skos:comment "Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference."@en ;
    skos:definition "crystallite with  λ-fiber texture orientation is a crystallite whose family of <100> equivalent directions in a cubic lattice system are oriented approximately parallel to the normal direction."@en .

:NOES_0000157 a owl:Class ;
    rdfs:label "crystallite with η-fiber texture orientation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:PMD_0025998 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :NOES_0000141 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0002503 ;
                                owl:someValuesFrom :NOES_0000113 ] [ a owl:Restriction ;
                                owl:onProperty ns2:PMD_0000077 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( [ a owl:Restriction ;
                                                    owl:hasValue ns1:UO_0000185 ;
                                                    owl:onProperty ns1:IAO_0000039 ] [ a owl:Restriction ;
                                                    owl:onProperty ns1:OBI_0001937 ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:float ;
                                                            owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] ) ] ],
        ns2:PMD_0000663 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns2:PMD_0000663 [ a owl:Restriction ;
                        owl:onProperty ns2:PMD_0025998 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( :NOES_0000141 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0002503 ;
                                            owl:someValuesFrom :NOES_0000113 ] [ a owl:Restriction ;
                                            owl:onProperty ns2:PMD_0000077 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( [ a owl:Restriction ;
                                                                owl:hasValue ns1:UO_0000185 ;
                                                                owl:onProperty ns1:IAO_0000039 ] [ a owl:Restriction ;
                                                                owl:onProperty ns1:OBI_0001937 ;
                                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                                        owl:onDatatype xsd:float ;
                                                                        owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] ) ] ] ) ] ;
    skos:comment "Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference."@en ;
    skos:definition "crystallite with η-fiber texture orientation is a crystallite whose family of <001> equivalent directions in a cubic lattice system are oriented approximately parallel to the rolling direction."@en .

:NOES_0000158 a owl:Class ;
    rdfs:label "crystallite with γ-fiber texture orientation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:PMD_0025998 ;
            owl:someValuesFrom [ a owl:Class ;
