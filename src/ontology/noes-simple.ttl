                                                                              ]
                                                                            ) ;
                                                         rdf:type owl:Class
                                                       ]
                                  ] ;
                  rdfs:label "α-fiber texture"@en ;
                  skos:altLabel "<110> || RD" ;
                  skos:definition "α-fiber texture component is a type of crystallographic texture which is quality of grain population, i.e., several grains, having a similar orientation (within a misorientation threshold) in relation to the material's reference frame: <110> family of crystallographic directions are oriented parallel to the rolling direction (RD) of a sheet material."@en .


