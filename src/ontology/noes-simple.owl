    <!-- https://w3id.org/pmd/noes/NOES_0000090 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000090">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000177"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                        <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000177"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000177"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/noes/NOES_0000177"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000167"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                                <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000167"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&apos;crystallographic texture&apos;
 and (&apos;quality of&apos; some 
    (&apos;grain population&apos;
     and (&apos;has member&apos; only 
        (crystallite
         and (&apos;location of&apos; some 
            (&apos;crystallographic plane&apos;
             and (&apos;approximately parallel to&apos; some 
                (&apos;rolling plane&apos;
                 and (&apos;located in&apos; some material)))
             and (&apos;denoted by family under cubic symmetry&apos; only 
                (&apos;Miller indices&apos;
                 and (&apos;has Miller indices&apos; value &quot;{001}&quot;)))))
         and (&apos;location of&apos; some 
            (&apos;crystallographic direction&apos;
             and (&apos;approximately parallel to&apos; some 
                (&apos;rolling direction&apos;
                 and (&apos;located in&apos; some material)))
             and (&apos;denoted by family under cubic symmetry&apos; only 
                (&apos;Miller indices&apos;
                 and (&apos;has Miller indices&apos; value &quot;&lt;100&gt;&quot;)))))))))</rdfs:comment>
        <rdfs:comment>&apos;crystallographic texture&apos;
 and (&apos;quality of&apos; some 
    (&apos;grain population&apos;
     and (&apos;part of&apos; some 
        (material
         and (&apos;location of&apos; some 
            (&apos;rolling direction&apos;
             and (&apos;approximately parallel to&apos; some 
                (&apos;crystallographic direction&apos;
                 and (&apos;denoted by family under cubic symmetry&apos; some 
                    (&apos;Miller indices&apos;
                     and (&apos;has Miller indices&apos; value &quot;&lt;100&gt;&quot;)))))))
         and (&apos;location of&apos; some 
            (&apos;rolling plane&apos;
             and (&apos;approximately parallel to&apos; some 
                (&apos;crystallographic plane&apos;
                 and (&apos;denoted by family under cubic symmetry&apos; some 
                    (&apos;Miller indices&apos;
                     and (&apos;has Miller indices&apos; value &quot;{001}&quot;)))))))))))</rdfs:comment>
        <rdfs:label xml:lang="en">cube texture component</rdfs:label>
        <skos:altLabel>{001}&lt;100&gt;</skos:altLabel>
        <skos:definition xml:lang="en">Cube texture component is a type of crystallographic texture which is quality of grain population, i.e., several grains, having a similar orientation (within a misorientation threshold) in relation to the material&apos;s reference frame: &lt;100&gt; family of crystallographic directions are oriented parallel to the rolling direction (RD) of a sheet material and {001} family of crystallographic planes are oriented parallel to the rolling plane of a sheet material.</skos:definition>
    </owl:Class>
    


