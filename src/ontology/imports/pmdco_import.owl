SubClassOf(<https://w3id.org/pmd/co/PMD_0025997> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/RO_0002350> <https://w3id.org/pmd/co/PMD_0020004>))

# Class: <https://w3id.org/pmd/co/PMD_0040001> (Länge)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0040001> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <https://w3id.org/pmd/co/PMD_0040001> "Necessary and sufficient conditions for 'length' have not yet been formalized. The term is defined as a specific subtype of 'DimensionQuality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000122."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0040001> "PERSON: Lars Vogt")
AnnotationAssertion(rdfs:comment <https://w3id.org/pmd/co/PMD_0040001> "Length is a size that describes the spatial extent of its bearer in one dimension."@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0040001> "Länge"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0040001> "length"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0040001> "dimension"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0040001> "Die Länge ist eine eindimensionale Größe."@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0040001> "Length is a one dimensional size."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0040001> "A steel rod measures 250 mm in length between its two end faces"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0040001> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0040001> <https://w3id.org/pmd/co/PMD_0020132>)

# Class: <https://w3id.org/pmd/co/PMD_0050000> (atomic bond)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0050000> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0050000> "PERSON: Markus Schilling")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0050000> "Bindung"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0050000> "atomic bond"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0050000> "A bond is a relational quality describing the force interaction between atoms."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0050000> "Eine Bindung ist eine relationale Qualität, die die Kraftwechselwirkung zwischen Atomen beschreibt."@de)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0050000> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0050000> <https://w3id.org/pmd/co/PMD_0020353>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0050000> ObjectSomeValuesFrom(<https://w3id.org/pmd/co/PMD_0025999> <http://purl.obolibrary.org/obo/CHEBI_33250>))

# Class: <https://w3id.org/pmd/co/PMD_0050002> (metallic bond)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0050002> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0050002> "PERSON: Markus Schilling")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <https://w3id.org/pmd/co/PMD_0050002> <https://www.thoughtco.com/metallic-bond-definition-properties-and-examples-4117948>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0050002> "metallic bond"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0050002> "metallische Bindung"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0050002> "A metallic bond is a bond that forms between metal atoms, where electrons are shared in a \"sea\" of electrons that move freely around the metal ions. This type of bonding gives metals their characteristic properties such as conductivity and malleability."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0050002> "Eine Metallbindung ist eine Bindung, die zwischen Metallatomen entsteht, wobei Elektronen in einem „Meer“ von Elektronen geteilt werden, die sich frei um die Metallionen bewegen. Diese Art der Bindung verleiht Metallen ihre charakteristischen Eigenschaften wie Leitfähigkeit und Formbarkeit."@de)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0050002> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0050002> <https://w3id.org/pmd/co/PMD_0050000>)

# Class: <https://w3id.org/pmd/co/PMD_0050051> (Durchmesser)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0050051> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0050051> "PERSON: Markus Schilling")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <https://w3id.org/pmd/co/PMD_0050051> "“Diameter.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/diameter. Accessed 5 Dec. 2022.")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0050051> "Durchmesser"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0050051> "diameter"@en)
AnnotationAssertion(rdfs:seeAlso <https://w3id.org/pmd/co/PMD_0050051> <https://w3id.org/pmd/co/2.0.8/Diameter>)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0050051> "Die Länge einer geraden Linie durch den Mittelpunkt eines Objekts oder Raums."@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0050051> "The length of a straight line through the center of an object or space."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0050051> <https://w3id.org/pmd/co/PMD_0040001>)

# Class: <https://w3id.org/pmd/co/PMD_0050153> (thickness)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0050153> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0050153> "PERSON: Markus Schilling")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0050153> "Dicke"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0050153> "thickness"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0050153> "A length that describes the measured dimension in one direction of a test piece."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0050153> "Diese Klasse beschreibt das gemessene Maß in einer Richtung eines Prüfkörpers."@de)
SubClassOf(<https://w3id.org/pmd/co/PMD_0050153> <https://w3id.org/pmd/co/PMD_0040001>)

# Class: <https://w3id.org/pmd/co/PMD_0050154> (Breite)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0050154> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0050154> "PERSON: Markus Schilling")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0050154> "Breite"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0050154> "width"@en)
AnnotationAssertion(rdfs:seeAlso <https://w3id.org/pmd/co/PMD_0050154> <https://w3id.org/pmd/co/2.0.8/Width>)
AnnotationAssertion(rdfs:seeAlso <https://w3id.org/pmd/co/PMD_0050154> <https://www.merriam-webster.com/dictionary/width>)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0050154> "Diese Klasse beschreibt eine horizontale Messung eines Objekts, die im rechten Winkel zur Länge des Objekts vorgenommen wird."@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0050154> "This class describes a horizontal measurement of an object taken at right angles to the length of the object."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0050154> <https://w3id.org/pmd/co/PMD_0040001>)

# Class: <https://w3id.org/pmd/co/PMD_0050155> (shape)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0050155> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0050155> "PERSON: Markus Schilling")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <https://w3id.org/pmd/co/PMD_0050155> "“Shape.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/shape. Accessed 13 Jan. 2023.")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0050155> "Form"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0050155> "shape"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0050155> "Das sichtbare Ausstattungsmerkmal (räumliche Form oder Kontur) eines bestimmten Objektes oder einer Art von Objekt."@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0050155> "Extemsive quality, the visible makeup characteristic (spatial form or contour) of a particular item or kind of item."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0050155> <https://w3id.org/pmd/co/PMD_0020353>)

# Class: <https://w3id.org/pmd/co/PMD_0050156> (Geometrische Form)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0050156> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0050156> "PERSON: Markus Schilling")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <https://w3id.org/pmd/co/PMD_0050156> "DIN EN ISO 6892-1:2019")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0050156> "Geometrische Form"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0050156> "geometry shape"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0050156> "Dieses Konzept beschreibt die geometrischen Abmessungen und das Erscheinungsbild (Form und Abmaße) einer Probe, eines Prüfkörpers oder eines Prüfstücks, wie sie üblicherweise durch eine entsprechende Norm definiert sind. Dementsprechend ist der angegebene Formwert in Übereinstimmung mit der definierenden Norm anzugeben, z. B. \"Zugprüfstück Form 1 gemäß Anhang B der Zugversuchsnorm\"."@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0050156> "This concept describes the geometric dimensions and appearance (shape and dimensions) of a sample, specimen, or test piece as usually defined by a corresponding standard. Accordingly, the shape value given is in accordance with the defining standard, e.g., ‘tensile test piece shape 1 in accordance with annex B of the tensile test standard’."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0050156> <https://w3id.org/pmd/co/PMD_0050155>)

# Class: <https://w3id.org/pmd/co/PMD_0050157> (3D Geometrie)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0050157> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0050157> "PERSON: Markus Schilling")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0050157> "3D Geometrie"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0050157> "shape 3d"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0050157> "A shape 3D is a geometry shape that exists in three dimensions, having length, width, and height, and can be defined by its spatial properties such as volume and surface area."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0050157> "Eine 3D Geometrie ist eine geometrische Form, die in drei Dimensionen existiert, mit Länge, Breite und Höhe, und die durch ihre räumlichen Eigenschaften wie Volumen und Oberfläche definiert werden kann."@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0050157> "Beispiele sind Formen wie Würfel, Kugeln und Pyramiden."@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0050157> "Examples include shapes like cubes, spheres, and pyramids."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0050157> <https://w3id.org/pmd/co/PMD_0050156>)

# Class: <https://w3id.org/pmd/co/PMD_0060007> (material specification)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0060007> "material specification"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0060007> "A directive information entity that defines the composition, properties, performance criteria, and acceptable standards for a material, guiding its selection, processing, and application in a specific context."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0060007> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0060007> <http://purl.obolibrary.org/obo/IAO_0000033>)

# Class: <https://w3id.org/pmd/co/PMD_0060009> (specification datum)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0060009> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0060009> "PERSON: Hossein Beygi Nasrabadi")
AnnotationAssertion(rdfs:comment <https://w3id.org/pmd/co/PMD_0060009> "The intent of the specification datum is to express the \"Sollwert\" of some qualitiy or behavioral material property. Then, the specification datum can be further specified by  some value specification."@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0060009> "specification datum"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0060009> "A directive information entity that provides information of a setpoint of some value, i.e., it is an intended value."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0060009> "The setpoint value of a ultimate tensile strength of some steel material"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0060009> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0060009> <http://purl.obolibrary.org/obo/IAO_0000033>)

# Class: <https://w3id.org/pmd/co/PMD_0080019> (Fläche)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0080019> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <https://w3id.org/pmd/co/PMD_0080019> "Necessary and sufficient conditions for 'area' have not yet been formalized. The term is defined as a specific subtype of 'DimensionQuality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0001323."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0080019> "PERSON: Thomas Hanke")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <https://w3id.org/pmd/co/PMD_0080019> <http://purl.obolibrary.org/obo/PATO_0001323>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080019> "Fläche"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080019> "area"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080019> "Area signifies a 2-D extent quality inhering by virtue of the bearer's two-dimensional extent"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080019> "Fläche bedeutet eine zweidimensionale Ausdehnungsqualität, die aufgrund der zweidimensionalen Ausdehnung des Trägers inhärent ist"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0080019> "The cross-sectional area of a tensile specimen at the gauge section is 50 mm2"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0080019> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080019> <https://w3id.org/pmd/co/PMD_0020132>)

# Class: <https://w3id.org/pmd/co/PMD_0080022> (elektrische Ladung)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0080022> "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080022> "electric charge"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080022> "elektrische Ladung"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080022> "Electric charge refers to the physical property of matter causing it to experience a force when placed in an electromagnetic field"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0080022> "A capacitor stores 10 µC of electric charge at a voltage of 5 V"@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080022> <http://purl.obolibrary.org/obo/BFO_0000019>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080022> ObjectIntersectionOf(<https://w3id.org/pmd/co/PMD_0020312> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000080> ObjectUnionOf(<http://purl.obolibrary.org/obo/BFO_0000027> <http://purl.obolibrary.org/obo/BFO_0000030>))))

# Class: <https://w3id.org/pmd/co/PMD_0080026> (magnetische Permeabilität)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0080026> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <https://w3id.org/pmd/co/PMD_0080026> "Necessary and sufficient conditions for 'magnetic permeability' have not yet been formalized. The term is defined as a specific subtype of 'magnetic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0080026> "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080026> "magnetic permeability"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080026> "magnetische Permeabilität"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0080026> "Permeabilität"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0080026> "permeability"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0080026> "μ"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080026> "Magnetic permeability is a magnetic quality of a material that quantifies its ability to support the formation of a magnetic field within itself, expressed as the ratio of magnetic flux density to the applied magnetic field intensity"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080026> "Magnetische Permeabilität ist eine magnetische Qualität eines Materials, die seine Fähigkeit quantifiziert, ein Magnetfeld in seinem Inneren zu unterstützen, ausgedrückt als Verhältnis der magnetischen Flussdichte zur aufgebrachten magnetischen Feldstärke"@de)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0080026> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080026> <https://w3id.org/pmd/co/PMD_0020353>)

# Class: <https://w3id.org/pmd/co/PMD_0080029> (strain)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0080029> "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080029> "Dehnung"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080029> "strain"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080029> "Strain is defined as relative deformation, compared to a reference position configuration"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0080029> "Under a tensile load, a polymer film exhibits a strain of 2 % before yielding"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0080029> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080029> <https://w3id.org/pmd/co/PMD_0020311>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080029> <https://w3id.org/pmd/co/PMD_0023004>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080029> ObjectIntersectionOf(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <https://w3id.org/pmd/co/PMD_0000001>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002328> <https://w3id.org/pmd/co/PMD_0020132>)))

# Class: <https://w3id.org/pmd/co/PMD_0080034> (elastische Deformation)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0080034> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <https://w3id.org/pmd/co/PMD_0080034> "Necessary and sufficient conditions for 'elastic strain' have not yet been formalized. The term is defined as a specific subtype of 'strain'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Plasticity_(physics)."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0080034> "PERSON: Thomas Hanke")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <https://w3id.org/pmd/co/PMD_0080034> <https://en.wikipedia.org/wiki/Plasticity_(physics)>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080034> "elastic strain"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080034> "elastische Deformation"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0080034> "elastic deformation"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0080034> "elastische Verformung"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080034> "Bei der elastischen Dehnung handelt es sich um eine Dehnungsqualität eines Materialgebildes, die durch eine reversible Verformung gekennzeichnet ist, die bei Wegnahme der aufgebrachten Last verschwindet"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080034> "Elastic strain is a strain quality of a material entity characterized by reversible deformation that disappears upon removal of the applied load"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0080034> "Steel loaded to 200 MPa exhibits an elastic strain of about 0.001, fully recovered upon unloading"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0080034> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080034> <https://w3id.org/pmd/co/PMD_0080029>)

# Class: <https://w3id.org/pmd/co/PMD_0080035> (plastic strain)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0080035> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <https://w3id.org/pmd/co/PMD_0080035> "Necessary and sufficient conditions for 'plastic strain' have not yet been formalized. The term is defined as a specific subtype of 'strain'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Plasticity_(physics)."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0080035> "PERSON: Thomas Hanke")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <https://w3id.org/pmd/co/PMD_0080035> <https://en.wikipedia.org/wiki/Plasticity_(physics)>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080035> "plastic strain"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080035> "plastische Deformation"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0080035> "plastic deformation"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0080035> "plastische Verformung"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080035> "Plastic strain describes permanent deformation occurring when a material is subjected to stress beyond its elastic limit"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080035> "Plastische Deformation beschreibt die dauerhafte Verformung, die auftritt, wenn ein Material einer Belastung ausgesetzt wird, die über seine elastische Grenze hinausgeht"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0080035> "After exceeding yield strength, a steel rod undergoes 5 % plastic strain that remains after unloading"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0080035> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080035> <https://w3id.org/pmd/co/PMD_0080029>)

# Class: <https://w3id.org/pmd/co/PMD_0080069> (physisch relative Qualität)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0080069> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <https://w3id.org/pmd/co/PMD_0080069> "Necessary and sufficient conditions for 'physical relational quality' have not yet been formalized. The term is defined as a specific subtype of 'BFO_0000145'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0080069> "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080069> "physical relational quality"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080069> "physisch relative Qualität"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080069> "Die physische Beziehungsqualität bezieht sich auf Eigenschaften oder Merkmale einer Entität, die von ihrer Beziehung zu anderen Entitäten abhängig sind"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080069> "Physical relational quality pertains to properties or characteristics of an entity dependent on its relation to other entities"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0080069> "The coefficient of friction between two surfaces is a physical relational quality inhering in both contacting materials"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0080069> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080069> <https://w3id.org/pmd/co/PMD_0020353>)

# Class: <https://w3id.org/pmd/co/PMD_0080100> (Massenanteil)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0080100> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <https://w3id.org/pmd/co/PMD_0080100> "Necessary and sufficient conditions for 'mass fraction' have not yet been formalized. The term is defined as a specific subtype of 'mass ratio'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Massenanteil."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0080100> "PERSON: Thomas Hanke")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <https://w3id.org/pmd/co/PMD_0080100> <https://de.wikipedia.org/wiki/Massenanteil>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080100> "Massenanteil"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080100> "mass fraction"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080100> "Der Massenanteil beschreibt den relativen Anteil einer Masse an der Gesamtmasse einer Mischung, ein gängiges quantitatives Maß"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080100> "mass ratio that describes the relative proportion of a mass to the total mass of a mixture, a common quantitative measure"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0080100> "A binary Al-4 wt% Cu alloy has a copper mass fraction of 0.04"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0080100> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080100> <https://w3id.org/pmd/co/PMD_0020102>)

# Class: <https://w3id.org/pmd/co/PMD_0080104> (volume fraction)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0080104> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <https://w3id.org/pmd/co/PMD_0080104> "Necessary and sufficient conditions for 'volume fraction' have not yet been formalized. The term is defined as a specific subtype of 'volume ratio'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Volumenkonzentration."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0080104> "PERSON: Thomas Hanke")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <https://w3id.org/pmd/co/PMD_0080104> <https://de.wikipedia.org/wiki/Volumenkonzentration>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080104> "Volumenanteil"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080104> "volume fraction"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080104> "Volume fraction describes the volume of a mixture component relative to the sum of all components' volumes"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080104> "Volumenanteil beschreibt das Volumen eines Mischbestandteils im Verhältnis zur Summe der Volumina aller Bestandteile"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0080104> "A dual-phase steel contains a martensite volume fraction of 20 %, controlling its strength-ductility balance"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0080104> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080104> <https://w3id.org/pmd/co/PMD_0020104>)

# Class: <https://w3id.org/pmd/co/PMD_0080108> (Spannung)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0080108> "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080108> "Spannung"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080108> "stress"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080108> "Stress is the internal force per unit area a material experiences under external load, commonly described in tensile, compressive, or shear forms"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0080108> "A cross-section of a loaded steel column bears a compressive stress of 150 MPa"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0080108> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080108> <https://w3id.org/pmd/co/PMD_0020311>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080108> <https://w3id.org/pmd/co/PMD_0023004>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080108> ObjectIntersectionOf(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002328> <https://w3id.org/pmd/co/PMD_0020200>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002328> <https://w3id.org/pmd/co/PMD_0080019>)))
SubClassOf(Annotation(rdfs:comment "Mechanical view on stress"@en) <https://w3id.org/pmd/co/PMD_0080108> ObjectIntersectionOf(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002328> <https://w3id.org/pmd/co/PMD_0020200>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002328> <https://w3id.org/pmd/co/PMD_0080019>)))
SubClassOf(<https://w3id.org/pmd/co/PMD_0080108> ObjectIntersectionOf(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002328> <https://w3id.org/pmd/co/PMD_0020352>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002328> <https://w3id.org/pmd/co/PMD_0020380>)))
SubClassOf(Annotation(rdfs:comment "Thermodynamic view on stress"@en) <https://w3id.org/pmd/co/PMD_0080108> ObjectIntersectionOf(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002328> <https://w3id.org/pmd/co/PMD_0020352>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002328> <https://w3id.org/pmd/co/PMD_0020380>)))
SubClassOf(<https://w3id.org/pmd/co/PMD_0080108> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <https://w3id.org/pmd/co/PMD_0000001>))

# Class: <https://w3id.org/pmd/co/PMD_0080116> (potential)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0080116> "Philipp von Hartrott")
AnnotationAssertion(rdfs:comment <https://w3id.org/pmd/co/PMD_0080116> "Every potential in physics is the same mathematical object — a partial derivative of energy with respect to its conjugate extensive quantity. The differences are only in which extensive quality you're considering."@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080116> "potential"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080116> "a partial derivative of energy with respect to its conjugate extensive quantity"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0080116> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080116> <http://purl.obolibrary.org/obo/BFO_0000019>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080116> ObjectIntersectionOf(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002328> <https://w3id.org/pmd/co/PMD_0020142>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002328> <https://w3id.org/pmd/co/PMD_0020319>)))
SubClassOf(Annotation(rdfs:comment "In field theories (e.g., gravity, electrostatics), the potential becomes a field ϕ(r⃗), and the force is recovered via:
F=−∇ϕ(r⃗)F
This is the spatial analogue: instead of asking \"how does energy change per unit carrier added?\", you ask \"how does energy change per unit carrier moved in space?\""@en) <https://w3id.org/pmd/co/PMD_0080116> ObjectIntersectionOf(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002328> <https://w3id.org/pmd/co/PMD_0020142>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002328> <https://w3id.org/pmd/co/PMD_0020319>)))

# Class: <https://w3id.org/pmd/co/PMD_0080120> (magnetic susceptibility)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0080120> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <https://w3id.org/pmd/co/PMD_0080120> "Necessary and sufficient conditions for 'magnetic susceptibility' have not yet been formalized. Although χ = M/H is a well-defined ratio, a formal equivalence axiom would incorrectly classify any dimensionless relational quality of a magnetic bearer as magnetic susceptibility. Defined as a primitive subtype of 'physical relational quality'."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0080120> "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080120> "magnetic susceptibility"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080120> "magnetische Suszeptibilität"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0080120> "χ"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080120> "Magnetic susceptibility is a physical relational quality of a material that quantifies the degree to which it becomes magnetized in response to an applied magnetic field, expressed as the dimensionless ratio of magnetization to applied field intensity"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080120> "Magnetische Suszeptibilität ist eine physikalische relationale Qualität eines Materials, die den Grad angibt, in dem es sich als Reaktion auf ein angelegtes Magnetfeld magnetisiert, ausgedrückt als dimensionsloses Verhältnis der Magnetisierung zur angelegten Feldstärke"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0080120> "Paramagnetic oxygen gas has a positive magnetic susceptibility of 3.73e-6 m3/mol at 20 C"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0080120> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080120> <https://w3id.org/pmd/co/PMD_0020353>)

# Class: <https://w3id.org/pmd/co/PMD_0080128> (electrical resistance)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0080128> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <https://w3id.org/pmd/co/PMD_0080128> "Necessary and sufficient conditions for 'electrical resistance' have not yet been formalized. The term is defined as a specific subtype of 'electrical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://www.britannica.com/technology/resistance-electronics."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0080128> "PERSON: Thomas Hanke")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <https://w3id.org/pmd/co/PMD_0080128> <https://www.britannica.com/technology/resistance-electronics>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080128> "electrical resistance"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080128> "elektrischer Widerstand"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080128> "Der elektrische Widerstand bezieht sich auf die Fähigkeit eines Stromkreises, elektrische Energie in Wärmeenergie umzuwandeln, indem er elektrischem Strom durch Teilchenkollisionen entgegenwirkt, die für Widerstände, Lampen und Drähte charakteristisch sind"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080128> "Electrical resistance pertains to a circuit's capability to transform electric energy into heat energy, opposing electric current through particle collisions, characteristic of resistors, lamps, and wires"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0080128> "A nichrome heating element has an electrical resistance of 10 Ω at room temperature"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0080128> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080128> <http://purl.obolibrary.org/obo/BFO_0000019>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080128> <https://w3id.org/pmd/co/PMD_0020312>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080128> <https://w3id.org/pmd/co/PMD_0020317>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080128> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000080> <http://purl.obolibrary.org/obo/BFO_0000030>))

# Class: <https://w3id.org/pmd/co/PMD_0080171> (yield stress)

AnnotationAssertion(rdfs:comment <https://w3id.org/pmd/co/PMD_0080171> "The amount of plastic strain typically gives more information about the yield stress. E.g. Rp02 has 0.2% plastic strain."@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080171> "Fließgrenze"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080171> "yield stress"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0080171> "yield strength"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080171> "is the stress at which the material has a non-zero plastic strain."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0080171> "The yield strength of mild steel is approximately 250 MPa, beyond which permanent deformation begins"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0080171> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080171> ObjectIntersectionOf(<https://w3id.org/pmd/co/PMD_0000952> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> ObjectIntersectionOf(<https://w3id.org/pmd/co/PMD_0000068> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <https://w3id.org/pmd/co/PMD_0080035>)))))

# Class: <https://w3id.org/pmd/co/PMD_0080172> (untere Streckgrenze)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0080172> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <https://w3id.org/pmd/co/PMD_0080172> "Necessary and sufficient conditions for 'lower yield strength' have not yet been formalized. The term is defined as a specific subtype of 'yield strength'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Yield_(engineering)."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0080172> "PERSON: Thomas Hanke")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <https://w3id.org/pmd/co/PMD_0080172> <https://en.wikipedia.org/wiki/Yield_(engineering)>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080172> "lower yield strength"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080172> "untere Streckgrenze"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0080172> "lower yield stress"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0080172> "untere Fließspannung"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080172> "Lower yield strength defines the stress at which a material exhibits plastic behavior after initial yielding"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080172> "Untere Streckgrenze beschreibt die Spannung, bei der ein Material nach dem anfänglichen Fließen plastisches Verhalten zeigt"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0080172> "The lower yield strength of mild steel is approximately 235 MPa, defining the onset of stable plastic flow"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0080172> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080172> <https://w3id.org/pmd/co/PMD_0080171>)

# Class: <https://w3id.org/pmd/co/PMD_0080173> (obere Streckgrenze)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0080173> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <https://w3id.org/pmd/co/PMD_0080173> "Necessary and sufficient conditions for 'upper yield strength' have not yet been formalized. The term is defined as a specific subtype of 'yield strength'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Yield_(engineering)."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0080173> "PERSON: Thomas Hanke")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <https://w3id.org/pmd/co/PMD_0080173> <https://en.wikipedia.org/wiki/Yield_(engineering)>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080173> "obere Streckgrenze"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0080173> "upper yield strength"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0080173> "obere Fließspannung"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0080173> "upper yield stress"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080173> "Obere Streckgrenze charakterisiert die maximale Spannung, die vor dem plastischen Fließen eines Materials angewendet werden kann"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0080173> "Upper yield strength characterizes the maximum stress that can be applied before a material begins to yield plastically"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0080173> "Mild steel exhibits an upper yield strength of about 300 MPa, followed by a yield drop to the lower yield point"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0080173> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0080173> <https://w3id.org/pmd/co/PMD_0080171>)


