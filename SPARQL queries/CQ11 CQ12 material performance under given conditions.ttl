PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX pmd: <https://w3id.org/pmd/co/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX tto: <https://w3id.org/pmd/tto/> 


SELECT ?material ?property ?numeralProperty ?unitProperty
WHERE {
	# 1. user inputs
	VALUES ?targetAttrClass { noes:NOES_0000003 } # filter for some condition, e.g., field frequency
	VALUES ?minThreshold {0.001}
	VALUES ?maxThreshold {1000}
	VALUES ?propertyClass { noes:NOES_0000057 }  # The property class to find out, e.g., total magnetic power loss

	# 1. filer material property
	?material obo:RO_0000053 ?property .
	?property rdf:type ?propertyClass .
  
  	# 2. assay measures that property + its process attribute
	?assay obo:RO_0009006 ?property ;
		   pmd:PMD_0000009 ?procAttr .

	OPTIONAL { ?procAttr pmd:PMD_0020127 ?quality . }
  	# choose quality if it exists, otherwise process attribute
  	BIND(IF(BOUND(?quality), ?quality, ?procAttr) AS ?targetAttr)
  
  # Get Value and Unit from the Scalar Value Specification (linked to targetNode)
   ?valSpecAttr obo:OBI_0001927 ?targetAttr ;
           obo:OBI_0001937 ?numeralAttr ;
           obo:IAO_0000039 ?unitAttr .

  	FILTER(?numeralAttr > ?minThreshold AND ?numeralAttr < ?maxThreshold)
	
	?valueProperty obo:OBI_0001927  ?property ;
			obo:OBI_0001937 ?numeralProperty ; 
			obo:IAO_0000039 ?unitProperty .
}
ORDER BY ?numeralProperty