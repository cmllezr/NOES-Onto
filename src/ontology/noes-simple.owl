     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:doap="http://usefulinc.com/ns/doap#"
     xmlns:noes="https://w3id.org/pmd/noes/"
     xmlns:qudt="http://qudt.org/schema/qudt/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="https://w3id.org/pmd/noes/noes-simple.owl">
        <owl:versionIRI rdf:resource="https://w3id.org/pmd/noes/releases/2026-07-14/noes-simple.owl"/>
        <terms:creator rdf:resource="https://orcid.org/0009-0003-1503-4422"/>
        <terms:description>NOES-Onto is an application-level ontology based on PMDco  3.0 that focuses on the semantic modelling of Process-Structure-Property dependencies in non-oriented electrical sheets.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title>NOES-Onto: Nonoriented Electrical Steel Ontology</terms:title>
        <owl:versionInfo>2026-07-14</owl:versionInfo>
    </owl:Ontology>
    


