ns2:PMD_0023036 a owl:Class ;
    rdfs:label "averaged property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0002328 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:RO_0000052 ;
                    owl:someValuesFrom [ a owl:Class ;
                            owl:intersectionOf ( ns1:BFO_0000027 [ a owl:Restriction ;
                                        owl:onProperty ns1:BFO_0000051 ;
                                        owl:someValuesFrom [ a owl:Class ;
                                                owl:intersectionOf ( ns1:BFO_0000030 [ a owl:Restriction ;
                                                            owl:onProperty ns1:RO_0000053 ;
                                                            owl:someValuesFrom [ a owl:Class ;
                                                                    owl:intersectionOf ( [ a owl:Class ;
                                                                                owl:unionOf ( ns1:BFO_0000017 ns1:BFO_0000019 ) ] [ a owl:Restriction ;
                                                                                owl:onProperty ns2:PMD_0000077 ;
                                                                                owl:someValuesFrom ns1:OBI_0001931 ] ) ] ] ) ] ] [ a owl:Restriction ;
                                        owl:onProperty ns1:RO_0000086 ;
                                        owl:someValuesFrom ns2:PMD_0020367 ] ) ] ] ],
        ns2:PMD_0023035 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:RO_0002328 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:RO_0000052 ;
                    owl:someValuesFrom [ a owl:Class ;
                            owl:intersectionOf ( ns1:BFO_0000027 [ a owl:Restriction ;
                                        owl:onProperty ns1:BFO_0000051 ;
                                        owl:someValuesFrom [ a owl:Class ;
                                                owl:intersectionOf ( ns1:BFO_0000030 [ a owl:Restriction ;
                                                            owl:onProperty ns1:RO_0000053 ;
                                                            owl:someValuesFrom [ a owl:Class ;
                                                                    owl:intersectionOf ( [ a owl:Class ;
                                                                                owl:unionOf ( ns1:BFO_0000017 ns1:BFO_0000019 ) ] [ a owl:Restriction ;
                                                                                owl:onProperty ns2:PMD_0000077 ;
                                                                                owl:someValuesFrom ns1:OBI_0001931 ] ) ] ] ) ] ] [ a owl:Restriction ;
                                        owl:onProperty ns1:RO_0000086 ;
                                        owl:someValuesFrom ns2:PMD_0020367 ] ) ] ] ] ;
    skos:definition "an aggregated property that expresses an average of a property value of the members of an object aggregate"@en ;
    skos:example "mean diameter of grains of a polychrystaline material"@en .

cryo:CRYO_0000028 a owl:Class ;
    rdfs:label "crystal system value"@en ;
    rdfs:subClassOf ns1:OBI_0001930 ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cryo:CRYO_0000029 cryo:CRYO_0000030 cryo:CRYO_0000031 cryo:CRYO_0000032 cryo:CRYO_0000034 cryo:CRYO_0000035 cryo:CRYO_0000391 ) ] ;
    skos:definition """crystal system value is a categorical value specification which describes the grouping of
crystal system  based on the rotational and mirror symmetries of their actual atomic arrangements in the  crystal. The specific values are triclinic, monoclinic, orthorhombic, tetragonal, trigonal, hexagonal, and cubic."""@en .

cryo:CRYO_0000036 a owl:Class ;
    rdfs:label "lattice centering value"@en ;
    rdfs:subClassOf ns1:OBI_0001930 ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cryo:CRYO_0000043 cryo:CRYO_0000044 cryo:CRYO_0000045 cryo:CRYO_0000046 ) ] ;
    skos:definition "Lattice centering value is a categorical value specification which describes th geometric arrangement of lattice points in a unit cell with one of the values: primitive, body centered, face centered, base centered."@en .

