ns2:PMD_0020309 a owl:Class ;
    rdfs:label "interface property"@en ;
    rdfs:subClassOf ns2:PMD_0023003 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000052 ;
                        owl:someValuesFrom ns1:BFO_0000146 ] [ a owl:Restriction ;
                        owl:onProperty ns2:PMD_0025999 ;
                        owl:someValuesFrom ns1:BFO_0000146 ] ) ] ;
    skos:definition "a a 'property by bearer' that indicates its bearer is an interface"@en .

ns2:PMD_0020317 a owl:Class ;
    rdfs:label "an objects property"@en ;
    rdfs:subClassOf ns2:PMD_0023003 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000052 ;
                        owl:someValuesFrom ns1:BFO_0000030 ] [ a owl:Restriction ;
                        owl:onProperty ns2:PMD_0025999 ;
                        owl:someValuesFrom ns1:BFO_0000030 ] ) ] ;
    skos:definition "a 'property by bearer' that indicates that its bearer is an object" .

ns2:PMD_0020318 a owl:Class ;
    rdfs:label "intensive property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:CHEBI_59999 ns2:PMD_0000001 ) ] ],
        ns2:PMD_0023002 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0002328 ;
                                owl:someValuesFrom ns2:PMD_0023000 ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000052 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( ns1:CHEBI_59999 ns2:PMD_0000001 ) ] ] ) ] ;
    skos:definition "a facetted property that is characteristic of some portion of matter or chemical substance"@en .

ns2:PMD_0020369 a owl:Class ;
    rdfs:label "per mol property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0002328 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000001 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000086 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( ns2:PMD_0020367 [ a owl:Restriction ;
                                                    owl:hasValue ns2:PMD_0020368 ;
                                                    owl:onProperty ns2:PMD_0000077 ] ) ] ] ) ] ],
        ns2:PMD_0020364 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns2:PMD_0023001 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0002328 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000001 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000086 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( ns2:PMD_0020367 [ a owl:Restriction ;
                                                                owl:hasValue ns2:PMD_0020368 ;
                                                                owl:onProperty ns2:PMD_0000077 ] ) ] ] ) ] ] ) ] ;
    skos:definition "a per count with the count of Avogadro-number"@en .

ns2:PMD_0020370 a owl:Class ;
    rdfs:label "a mol of entites"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
