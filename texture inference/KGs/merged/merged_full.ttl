ns2:PMD_0000060 a owl:AnnotationProperty .

ns2:PMD_0000654 a owl:Class ;
    rdfs:label "functional material"@en ;
    ns1:IAO_0000116 "Classified by the role in a system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000050 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000030 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000085 ;
                                owl:someValuesFrom ns1:BFO_0000034 ] ) ] ],
        ns2:PMD_0000000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns2:PMD_0000000 [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000050 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000030 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000085 ;
                                            owl:someValuesFrom ns1:BFO_0000034 ] ) ] ] ) ] ;
    skos:definition "A functional material F is a material which has the function to be used for an object O (O consists of F) and O's function is other/more than mechanical load carrying."@en ;
    ns2:PMD_0000060 true .

ns2:PMD_0001032 a owl:AnnotationProperty .

ns2:PMD_0020128 a owl:Class ;
    rdfs:label "thermodynamic system"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000053 ;
            owl:someValuesFrom ns2:PMD_0020313 ],
        ns1:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000053 ;
                        owl:someValuesFrom ns2:PMD_0020313 ] ) ] ;
    skos:definition "A thermodynamic system is a material entity whose parts are bearer of thermodynamic properties. A thermodynamic system environs a thermodynamic process by which the thermodynamic properties of the objects of the thermodynamic system change over time."@en ;
    ns2:PMD_0000060 true .

ns2:PMD_0020217 a owl:NamedIndividual,
        ns2:PMD_0020216 ;
    rdfs:label "DEPRECATED short range order"@en ;
    rdfs:comment "Use appropriate class from crystall ontology instead" ;
    owl:deprecated true ;
    skos:definition "DEPRECATED periodische Anordnung von Strukturmerkmalen bis hin zu wenigen Einheiten"@de,
        "DEPRECATED periodic arrangement of structural features up to a few entities"@en .

ns2:PMD_0020218 a owl:NamedIndividual,
        ns2:PMD_0020216 ;
    rdfs:label "DEPRECATED medium range order"@en ;
    rdfs:comment "Use appropriate class from crystall ontology instead" ;
    owl:deprecated true ;
    skos:definition "DEPRECATED periodische Anordnung struktureller Merkmale vieler Entitäten"@de,
        "DEPRECATED periodic arrangement of structural features of many entities"@en .

ns2:PMD_0020219 a owl:NamedIndividual,
        ns2:PMD_0020216 ;
    rdfs:label "DEPRECATED long range order"@en ;
