cryo:CRYO_0000119 a owl:Class ;
    rdfs:label "crystallographic entity in triclinic system"@de ;
    rdfs:comment "Note that this class is not meant for instantiation but is needed for formulation of other logical axioms and inferences." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasSelf true ;
            owl:onProperty cryo:CRYO_0000054 ],
        ns1:BFO_0000141 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( ns1:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty ns1:BFO_0000050 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000001 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000086 ;
                                                        owl:someValuesFrom [ a owl:Class ;
                                                                owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                                            owl:hasValue cryo:CRYO_0000029 ;
                                                                            owl:onProperty ns2:PMD_0000077 ] ) ] ] ) ] ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( ns1:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty ns1:RO_0000086 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                        owl:hasValue cryo:CRYO_0000029 ;
                                                        owl:onProperty ns2:PMD_0000077 ] ) ] ] ) ] ) ] ;
    skos:definition "Crystallographic entity in triclinic system is an immaterial entity that either itself has triclinic lattice system or is a part of crystal lattice with triclinic lattice system."@en .

cryo:CRYO_0000120 a owl:Class ;
    rdfs:label "crystallographic entity in monoclinic system"@de ;
    rdfs:comment "Note that this class is not meant for instantiation but is needed for formulation of other logical axioms and inferences." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasSelf true ;
            owl:onProperty cryo:CRYO_0000055 ],
        ns1:BFO_0000141 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( ns1:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty ns1:BFO_0000050 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000001 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000086 ;
                                                        owl:someValuesFrom [ a owl:Class ;
                                                                owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                                            owl:hasValue cryo:CRYO_0000030 ;
                                                                            owl:onProperty ns2:PMD_0000077 ] ) ] ] ) ] ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( ns1:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty ns1:RO_0000086 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                        owl:hasValue cryo:CRYO_0000030 ;
                                                        owl:onProperty ns2:PMD_0000077 ] ) ] ] ) ] ) ] ;
    skos:definition "Crystallographic entity in monoclinic system is an immaterial entity that either itself has monoclinic lattice system or is a part of crystal lattice with monoclinic lattice system."@en .

