noes:NOES_0000104 rdf:type owl:Class ;
                  rdfs:subClassOf noes:NOES_0000051 ;
                  rdfs:comment "An instance belonging to the class should be rather inferred as asserted."@en ;
                  rdfs:label "saturation induction in the rolling direction"@en ;
                  skos:definition "Saturation induction in the rolling direction is a saturation induction measured exclusively in the rolling direction of an electrical sheet."@en ;
                  noes:NOES_0000122 "false"^^xsd:boolean .


###  https://w3id.org/pmd/noes/NOES_0000105
noes:NOES_0000105 rdf:type owl:Class ;
