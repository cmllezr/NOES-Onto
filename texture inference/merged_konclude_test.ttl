noes:NOES_0000163 a owl:Class ;
    rdfs:label "magnetic properties measuring device"@en ;
    rdfs:subClassOf pmd:PMD_0000827 ;
    skos:definition "Magnetic properties measuring device is a device that measures a hysteresis curve, i,e., its corresponding characteristic points, hysteresis loss, and total magnetic loss, of soft magnetic materials by applying alternating (AC) or quasi-static (DC) electric current on copper coils to produde external magnetic field."@en ;
    skos:example "Single sheet tester (SST), Epstein frame, Ring core tester"@en .

