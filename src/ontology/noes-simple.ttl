                  rdfs:comment "An instance belonging to the class should be rather inferred as asserted."@en ;
                  rdfs:label "saturation induction in the transversal direction"@en ;
                  skos:definition "Saturation induction in the transversal direction is a saturation induction measured exclusively in the transversal direction of an electrical sheet."@en ;
                  noes:NOES_0000122 "false"^^xsd:boolean .


###  https://w3id.org/pmd/noes/NOES_0000106
noes:NOES_0000106 rdf:type owl:Class ;
                  rdfs:subClassOf noes:NOES_0000059 ;
                  rdfs:label "differential permeability in the rolling direction"@en ;
                  skos:definition "Differential permeability in the rolling direction is the instantaneous slope of the magnetization curve or hysteresis loop at any given point, while magnetic field is applied parallel to the rolling direction of the rolled sheet."@en .


###  https://w3id.org/pmd/noes/NOES_0000107
noes:NOES_0000107 rdf:type owl:Class ;
                  rdfs:subClassOf noes:NOES_0000059 ;
                  rdfs:label "differential permeability in the transversal direction"@en ;
                  skos:definition "Differential permeability in the tranversal direction is the instantaneous slope of the magnetization curve or hysteresis loop at any given point, while magnetic field is applied parallel to the transverse direction of the rolled sheet."@en .


###  https://w3id.org/pmd/noes/NOES_0000108
noes:NOES_0000108 rdf:type owl:Class ;
                  rdfs:subClassOf noes:NOES_0000062 ;
                  rdfs:label "maximum permeability in the rolling direction"@en ;
                  skos:definition "Maximum permeability in the rolling direction is the steepest part of the B-H curve, where the material most readily accepts field. it indicates the easiest magnetization point of the material, while magnetic field is applied parallel to the rolling direction of the rolled sheet."@en ;
                  noes:NOES_0000122 "false"^^xsd:boolean .


###  https://w3id.org/pmd/noes/NOES_0000109
noes:NOES_0000109 rdf:type owl:Class ;
                  rdfs:subClassOf noes:NOES_0000062 ;
                  rdfs:label "maximum permeability in the transversal direction"@en ;
                  skos:definition "Maximum permeability in the transverse direction is the steepest part of the B-H curve, where the material most readily accepts field. it indicates the easiest magnetization point of the material, while magnetic field is applied parallel to the tranverse direction of the rolled sheet."@en ;
                  noes:NOES_0000122 "false"^^xsd:boolean .


###  https://w3id.org/pmd/noes/NOES_0000110
noes:NOES_0000110 rdf:type owl:Class ;
                  rdfs:subClassOf noes:NOES_0000000 ;
                  rdfs:label "relative permeability in the rolling direction"@en ;
                  skos:definition "Relative permeability in the rolling direction  is type of magnetic permeability which is defined as a ratio of the material's permeability µ to that of free space µ0, while magnetic field is applied parallel to the rolling direction of the rolled sheet."@en ;
                  noes:NOES_0000122 "false"^^xsd:boolean .


###  https://w3id.org/pmd/noes/NOES_0000111
noes:NOES_0000111 rdf:type owl:Class ;
                  rdfs:subClassOf noes:NOES_0000000 ;
                  rdfs:label "relative permeability in the transversal direction"@en ;
                  skos:definition "Relative permeability in the transversal direction  is type of magnetic permeability which is defined as a ratio of the material's permeability µ to that of free space µ0, while magnetic field is applied parallel to the transverse direction of the rolled sheet."@en ;
                  noes:NOES_0000122 "false"^^xsd:boolean .


