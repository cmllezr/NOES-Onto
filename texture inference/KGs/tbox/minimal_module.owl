        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">lattice system</rdfs:label>
        <skos:altLabel xml:lang="en">lattice type</skos:altLabel>
        <skos:definition xml:lang="en">lattice system is a quality of crystal lattice that defines its symmetry based on the 7 categories originating from its point group symmetries of their empty translational frameworks</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000392 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000392">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000029"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000030"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000031"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000032"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000033"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000034"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000035"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <rdfs:label xml:lang="en">lattice system value</rdfs:label>
        <skos:definition xml:lang="en">lattice system value is a categorical value specification which describes the grouping of
lattice system based on the point group symmetries of their empty translational frameworks. The specific values are triclinic, monoclinic, orthorhombic, tetragonal, rhombohedral, hexagonal, and cubic.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000142"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000000"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">TODO: 
which determines the directions in a sheet material in respect to the rolling direction. Rolled sheet direction is a part of material or object.</rdfs:comment>
        <rdfs:label xml:lang="en">rolled sheet direction</rdfs:label>
        <skos:definition xml:lang="en">Rolled sheet direction is a fiat line which is part of rolled material&apos;s intrinsic reference frame.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000002">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/noes/NOES_0000028"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/noes/NOES_0000029"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/noes/NOES_0000030"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <rdfs:label xml:lang="en">rolled sheet direction value</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">Rolled sheet directions is a categorical value specification which specifies the rolled sheet direction. It  includes rolling direction (RD), transverse direction (TD), and normal direction (ND)</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000031 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000031">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000094"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/noes/NOES_0000067"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000094"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">longitudinal direction</rdfs:label>
        <skos:definition xml:lang="en">Longitudinal direction is a rolled sheet direction along the dimension in which an anisotropic material property is measured. Longitudinal direction might be parallel to the rolling or transversal direction of a rolled material, and it is always normal to the rolling direction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000033 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000033">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/noes/NOES_0000068"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000035"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>TODO: 
1. Refine definition
2. Maybe remove the categorical values</rdfs:comment>
        <rdfs:label xml:lang="en">rolling direction</rdfs:label>
        <skos:definition xml:lang="en">Rolling direction is a direction in which the sheet is pushed through the rolling mill.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000035 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000035">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000031"/>
        <rdfs:label xml:lang="en">transverse direction</rdfs:label>
        <skos:definition xml:lang="en">Transverse direction is a direction in the rolling plane normal to the direction in which the sheet is pushed through the rolling mill.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000036 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000036">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000001"/>
        <rdfs:label xml:lang="en">normal direction</rdfs:label>
        <skos:definition xml:lang="en">Normal direction is a rolled sheet direction which is normal to the rolling plane of the sheet.</skos:definition>
    </owl:Class>
    


