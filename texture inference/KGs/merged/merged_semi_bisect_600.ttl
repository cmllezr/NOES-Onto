cryo:CRYO_0000119 a owl:Class ;
    rdfs:label "crystallographic entity in triclinic system"@de ;
    rdfs:comment "Note that this class is not meant for instantiation but is needed for formulation of other logical axioms and inferences." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasSelf true ;
            owl:onProperty cryo:CRYO_0000054 ],
        ns2:BFO_0000141 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( ns2:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty ns2:BFO_0000050 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000001 [ a owl:Restriction ;
                                                        owl:onProperty ns2:RO_0000086 ;
                                                        owl:someValuesFrom [ a owl:Class ;
                                                                owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                                            owl:hasValue cryo:CRYO_0000029 ;
                                                                            owl:onProperty ns1:PMD_0000077 ] ) ] ] ) ] ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( ns2:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty ns2:RO_0000086 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                        owl:hasValue cryo:CRYO_0000029 ;
                                                        owl:onProperty ns1:PMD_0000077 ] ) ] ] ) ] ) ] ;
    skos:definition "Crystallographic entity in triclinic system is an immaterial entity that either itself has triclinic lattice system or is a part of crystal lattice with triclinic lattice system."@en .

cryo:CRYO_0000120 a owl:Class ;
    rdfs:label "crystallographic entity in monoclinic system"@de ;
    rdfs:comment "Note that this class is not meant for instantiation but is needed for formulation of other logical axioms and inferences." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasSelf true ;
            owl:onProperty cryo:CRYO_0000055 ],
        ns2:BFO_0000141 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( ns2:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty ns2:BFO_0000050 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000001 [ a owl:Restriction ;
                                                        owl:onProperty ns2:RO_0000086 ;
                                                        owl:someValuesFrom [ a owl:Class ;
                                                                owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                                            owl:hasValue cryo:CRYO_0000030 ;
                                                                            owl:onProperty ns1:PMD_0000077 ] ) ] ] ) ] ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( ns2:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty ns2:RO_0000086 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                        owl:hasValue cryo:CRYO_0000030 ;
                                                        owl:onProperty ns1:PMD_0000077 ] ) ] ] ) ] ) ] ;
    skos:definition "Crystallographic entity in monoclinic system is an immaterial entity that either itself has monoclinic lattice system or is a part of crystal lattice with monoclinic lattice system."@en .

cryo:CRYO_0000121 a owl:Class ;
    rdfs:label "crystallographic entity in orthorhombic system"@de ;
    rdfs:comment "Note that this class is not meant for instantiation but is needed for formulation of other logical axioms and inferences." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasSelf true ;
            owl:onProperty cryo:CRYO_0000056 ],
        ns2:BFO_0000141 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( ns2:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty ns2:BFO_0000050 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000001 [ a owl:Restriction ;
                                                        owl:onProperty ns2:RO_0000086 ;
                                                        owl:someValuesFrom [ a owl:Class ;
                                                                owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                                            owl:hasValue cryo:CRYO_0000031 ;
                                                                            owl:onProperty ns1:PMD_0000077 ] ) ] ] ) ] ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( ns2:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty ns2:RO_0000086 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                        owl:hasValue cryo:CRYO_0000031 ;
                                                        owl:onProperty ns1:PMD_0000077 ] ) ] ] ) ] ) ] ;
    skos:definition "Crystallographic entity in orthorhombic system is an immaterial entity that either itself has orthorhombic lattice system or is a part of crystal lattice with orthorhombic lattice system."@en .

cryo:CRYO_0000122 a owl:Class ;
    rdfs:label "crystallographic entity in tetragonal system"@de ;
    rdfs:comment "Note that this class is not meant for instantiation but is needed for formulation of other logical axioms and inferences." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasSelf true ;
            owl:onProperty cryo:CRYO_0000050 ],
        ns2:BFO_0000141 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( ns2:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty ns2:BFO_0000050 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000001 [ a owl:Restriction ;
                                                        owl:onProperty ns2:RO_0000086 ;
                                                        owl:someValuesFrom [ a owl:Class ;
                                                                owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                                            owl:hasValue cryo:CRYO_0000032 ;
                                                                            owl:onProperty ns1:PMD_0000077 ] ) ] ] ) ] ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( ns2:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty ns2:RO_0000086 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                        owl:hasValue cryo:CRYO_0000032 ;
                                                        owl:onProperty ns1:PMD_0000077 ] ) ] ] ) ] ) ] ;
    skos:definition "Crystallographic entity in tetragonal system is an immaterial entity that either itself has tetragonal lattice system or is a part of crystal lattice with tetragonal lattice system."@en .

cryo:CRYO_0000123 a owl:Class ;
    rdfs:label "crystallographic entity in rhombohedral system"@de ;
    rdfs:comment "Note that this class is not meant for instantiation but is needed for formulation of other logical axioms and inferences." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasSelf true ;
            owl:onProperty cryo:CRYO_0000057 ],
        ns2:BFO_0000141 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( ns2:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty ns2:BFO_0000050 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000001 [ a owl:Restriction ;
                                                        owl:onProperty ns2:RO_0000086 ;
                                                        owl:someValuesFrom [ a owl:Class ;
                                                                owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                                            owl:hasValue cryo:CRYO_0000033 ;
                                                                            owl:onProperty ns1:PMD_0000077 ] ) ] ] ) ] ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( ns2:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty ns2:RO_0000086 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                        owl:hasValue cryo:CRYO_0000033 ;
                                                        owl:onProperty ns1:PMD_0000077 ] ) ] ] ) ] ) ] ;
    skos:definition "Crystallographic entity in rhombohedral system is an immaterial entity that either itself has rhombohedral lattice system or is a part of crystal lattice with rhombohedral lattice system."@en .

