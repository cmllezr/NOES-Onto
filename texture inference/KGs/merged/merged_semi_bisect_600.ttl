ns1:PMD_0000654 a owl:Class ;
    rdfs:label "functional material"@en ;
    ns2:IAO_0000116 "Classified by the role in a system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:BFO_0000050 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns2:BFO_0000030 [ a owl:Restriction ;
                                owl:onProperty ns2:RO_0000085 ;
                                owl:someValuesFrom ns2:BFO_0000034 ] ) ] ],
        ns1:PMD_0000000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:PMD_0000000 [ a owl:Restriction ;
                        owl:onProperty ns2:BFO_0000050 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns2:BFO_0000030 [ a owl:Restriction ;
                                            owl:onProperty ns2:RO_0000085 ;
                                            owl:someValuesFrom ns2:BFO_0000034 ] ) ] ] ) ] ;
    skos:definition "A functional material F is a material which has the function to be used for an object O (O consists of F) and O's function is other/more than mechanical load carrying."@en ;
    ns1:PMD_0000060 true .

ns1:PMD_0001032 a owl:AnnotationProperty .

ns1:PMD_0020128 a owl:Class ;
    rdfs:label "thermodynamic system"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:RO_0000053 ;
            owl:someValuesFrom ns1:PMD_0020313 ],
        ns2:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns2:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty ns2:RO_0000053 ;
                        owl:someValuesFrom ns1:PMD_0020313 ] ) ] ;
    skos:definition "A thermodynamic system is a material entity whose parts are bearer of thermodynamic properties. A thermodynamic system environs a thermodynamic process by which the thermodynamic properties of the objects of the thermodynamic system change over time."@en ;
    ns1:PMD_0000060 true .

ns1:PMD_0020217 a owl:NamedIndividual,
        ns1:PMD_0020216 ;
    rdfs:label "DEPRECATED short range order"@en ;
    rdfs:comment "Use appropriate class from crystall ontology instead" ;
    owl:deprecated true ;
    skos:definition "DEPRECATED periodische Anordnung von Strukturmerkmalen bis hin zu wenigen Einheiten"@de,
        "DEPRECATED periodic arrangement of structural features up to a few entities"@en .

ns1:PMD_0020218 a owl:NamedIndividual,
        ns1:PMD_0020216 ;
    rdfs:label "DEPRECATED medium range order"@en ;
    rdfs:comment "Use appropriate class from crystall ontology instead" ;
    owl:deprecated true ;
    skos:definition "DEPRECATED periodische Anordnung struktureller Merkmale vieler Entitäten"@de,
        "DEPRECATED periodic arrangement of structural features of many entities"@en .

ns1:PMD_0020219 a owl:NamedIndividual,
        ns1:PMD_0020216 ;
    rdfs:label "DEPRECATED long range order"@en ;
    rdfs:comment "Use appropriate class from crystall ontology instead" ;
    owl:deprecated true ;
    skos:definition "DEPRECATED periodische Anordnung struktureller Merkmale praktisch aller Entitäten"@de,
        "DEPRECATED periodic arrangement of structural features of virtually all entities"@en .

ns1:PMD_0020242 a owl:NamedIndividual,
        ns1:PMD_0020216 ;
    rdfs:label "DEPRECATED no range order"@en ;
    rdfs:comment "Use appropriate class from crystall ontology instead" ;
    owl:deprecated true ;
    skos:definition "DEPRECATED keine periodische Anordnung struktureller Merkmale von Entitäten"@de,
        "DEPRECATED no periodic arrangement of structural features of entites"@en .

ns1:PMD_0020309 a owl:Class ;
    rdfs:label "interface property"@en ;
    rdfs:subClassOf ns1:PMD_0023003 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns2:RO_0000052 ;
                        owl:someValuesFrom ns2:BFO_0000146 ] [ a owl:Restriction ;
                        owl:onProperty ns1:PMD_0025999 ;
                        owl:someValuesFrom ns2:BFO_0000146 ] ) ] ;
    skos:definition "a a 'property by bearer' that indicates its bearer is an interface"@en .

ns1:PMD_0020317 a owl:Class ;
    rdfs:label "an objects property"@en ;
    rdfs:subClassOf ns1:PMD_0023003 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns2:RO_0000052 ;
                        owl:someValuesFrom ns2:BFO_0000030 ] [ a owl:Restriction ;
                        owl:onProperty ns1:PMD_0025999 ;
                        owl:someValuesFrom ns2:BFO_0000030 ] ) ] ;
    skos:definition "a 'property by bearer' that indicates that its bearer is an object" .

ns1:PMD_0020318 a owl:Class ;
    rdfs:label "intensive property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:RO_0000052 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns2:CHEBI_59999 ns1:PMD_0000001 ) ] ],
        ns1:PMD_0023002 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty ns2:RO_0002328 ;
                                owl:someValuesFrom ns1:PMD_0023000 ] ] [ a owl:Restriction ;
                        owl:onProperty ns2:RO_0000052 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( ns2:CHEBI_59999 ns1:PMD_0000001 ) ] ] ) ] ;
    skos:definition "a facetted property that is characteristic of some portion of matter or chemical substance"@en .

ns1:PMD_0020369 a owl:Class ;
    rdfs:label "per mol property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:RO_0002328 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns2:BFO_0000001 [ a owl:Restriction ;
                                owl:onProperty ns2:RO_0000086 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( ns1:PMD_0020367 [ a owl:Restriction ;
                                                    owl:hasValue ns1:PMD_0020368 ;
                                                    owl:onProperty ns1:PMD_0000077 ] ) ] ] ) ] ],
        ns1:PMD_0020364 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:PMD_0023001 [ a owl:Restriction ;
                        owl:onProperty ns2:RO_0002328 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns2:BFO_0000001 [ a owl:Restriction ;
                                            owl:onProperty ns2:RO_0000086 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( ns1:PMD_0020367 [ a owl:Restriction ;
                                                                owl:hasValue ns1:PMD_0020368 ;
                                                                owl:onProperty ns1:PMD_0000077 ] ) ] ] ) ] ] ) ] ;
    skos:definition "a per count with the count of Avogadro-number"@en .

ns1:PMD_0020370 a owl:Class ;
    rdfs:label "a mol of entites"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:RO_0000086 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:PMD_0020367 [ a owl:Restriction ;
                                owl:hasValue ns1:PMD_0020368 ;
                                owl:onProperty ns1:PMD_0000077 ] ) ] ],
        ns2:BFO_0000027 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns2:RO_0000086 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:PMD_0020367 [ a owl:Restriction ;
                                owl:hasValue ns1:PMD_0020368 ;
                                owl:onProperty ns1:PMD_0000077 ] ) ] ] ;
    skos:definition "an object aggregate which Avogadro-number coount members of same type"@en .

ns1:PMD_0023007 a owl:Class ;
    rdfs:label "an object aggregates property"@en ;
    rdfs:subClassOf ns1:PMD_0023003 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns2:RO_0000052 ;
                        owl:someValuesFrom ns2:BFO_0000027 ] [ a owl:Restriction ;
                        owl:onProperty ns1:PMD_0025999 ;
                        owl:someValuesFrom ns2:BFO_0000027 ] ) ] ;
    skos:definition "a 'property by bearer' that indicates that its bearer is an object aggregate"@en .

ns1:PMD_0023036 a owl:Class ;
    rdfs:label "averaged property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:RO_0002328 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns2:RO_0000052 ;
                    owl:someValuesFrom [ a owl:Class ;
                            owl:intersectionOf ( ns2:BFO_0000027 [ a owl:Restriction ;
                                        owl:onProperty ns2:BFO_0000051 ;
                                        owl:someValuesFrom [ a owl:Class ;
                                                owl:intersectionOf ( ns2:BFO_0000030 [ a owl:Restriction ;
                                                            owl:onProperty ns2:RO_0000053 ;
                                                            owl:someValuesFrom [ a owl:Class ;
                                                                    owl:intersectionOf ( [ a owl:Class ;
                                                                                owl:unionOf ( ns2:BFO_0000017 ns2:BFO_0000019 ) ] [ a owl:Restriction ;
                                                                                owl:onProperty ns1:PMD_0000077 ;
                                                                                owl:someValuesFrom ns2:OBI_0001931 ] ) ] ] ) ] ] [ a owl:Restriction ;
                                        owl:onProperty ns2:RO_0000086 ;
                                        owl:someValuesFrom ns1:PMD_0020367 ] ) ] ] ],
        ns1:PMD_0023035 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns2:RO_0002328 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns2:RO_0000052 ;
                    owl:someValuesFrom [ a owl:Class ;
                            owl:intersectionOf ( ns2:BFO_0000027 [ a owl:Restriction ;
                                        owl:onProperty ns2:BFO_0000051 ;
                                        owl:someValuesFrom [ a owl:Class ;
                                                owl:intersectionOf ( ns2:BFO_0000030 [ a owl:Restriction ;
                                                            owl:onProperty ns2:RO_0000053 ;
                                                            owl:someValuesFrom [ a owl:Class ;
                                                                    owl:intersectionOf ( [ a owl:Class ;
                                                                                owl:unionOf ( ns2:BFO_0000017 ns2:BFO_0000019 ) ] [ a owl:Restriction ;
                                                                                owl:onProperty ns1:PMD_0000077 ;
                                                                                owl:someValuesFrom ns2:OBI_0001931 ] ) ] ] ) ] ] [ a owl:Restriction ;
                                        owl:onProperty ns2:RO_0000086 ;
                                        owl:someValuesFrom ns1:PMD_0020367 ] ) ] ] ] ;
    skos:definition "an aggregated property that expresses an average of a property value of the members of an object aggregate"@en ;
    skos:example "mean diameter of grains of a polychrystaline material"@en .

cryo:CRYO_0000028 a owl:Class ;
    rdfs:label "crystal system value"@en ;
    rdfs:subClassOf ns2:OBI_0001930 ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cryo:CRYO_0000029 cryo:CRYO_0000030 cryo:CRYO_0000031 cryo:CRYO_0000032 cryo:CRYO_0000034 cryo:CRYO_0000035 cryo:CRYO_0000391 ) ] ;
    skos:definition """crystal system value is a categorical value specification which describes the grouping of
crystal system  based on the rotational and mirror symmetries of their actual atomic arrangements in the  crystal. The specific values are triclinic, monoclinic, orthorhombic, tetragonal, trigonal, hexagonal, and cubic."""@en .

cryo:CRYO_0000036 a owl:Class ;
    rdfs:label "lattice centering value"@en ;
    rdfs:subClassOf ns2:OBI_0001930 ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cryo:CRYO_0000043 cryo:CRYO_0000044 cryo:CRYO_0000045 cryo:CRYO_0000046 ) ] ;
    skos:definition "Lattice centering value is a categorical value specification which describes th geometric arrangement of lattice points in a unit cell with one of the values: primitive, body centered, face centered, base centered."@en .

