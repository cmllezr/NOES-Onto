<https://w3id.org/pmd/noes/> rdf:type owl:Ontology ;
                              owl:versionIRI <https://w3id.org/pmd/noes/releases/2026-08-25/noes-simple.ttl> ;
                              terms:created "2025-06-01                                  "^^xsd:date ;
                              terms:creator <https://orcid.org/0009-0003-1503-4422> ;
                              terms:description "NOES-Onto is an application-level ontology based on PMDco  3.0 that focuses on the semantic modelling of Process-Structure-Property dependencies in non-oriented electrical sheets." ;
                              terms:identifier "https://doi.org/10.5281/zenodo.XXXXXXX      " ;
                              terms:issued "2026-08-25"^^xsd:date ;
                              terms:license <https://creativecommons.org/licenses/by/4.0/> ;
                              terms:modified "2026-08-25"^^xsd:date ;
                              terms:publisher <https://ror.org/04hm8eb66> ;
                              terms:source co: ;
                              terms:title "NOES-Onto: Nonoriented Electrical Steel Ontology" ;
                              <http://purl.org/ontology/bibo/status> "stable" ;
                              <http://purl.org/vocab/vann/preferredNamespacePrefix> "noes" ;
                              <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/pmd/noes/" ;
                              owl:versionInfo "2026-08-25" .

