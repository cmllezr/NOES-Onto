:NOES_0000064 a owl:Class ;
    rdfs:label "crystallite with ideal Goss texture orientation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:RO_0001015 ;
            owl:someValuesFrom [ a owl:Class ;
