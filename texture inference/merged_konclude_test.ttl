                                            owl:onProperty pmd:PMD_0000077 ] ) ] ] ) ] .

cryo:CRYO_0000391 a owl:NamedIndividual ;
    rdfs:label "trigonal"@en ;
    skos:definition "Triclinic crystal system is a crystal system with one 3-fold rotation axis"@en .

<https://w3id.org/pmd/cryo/components/cryo-individuals.owl/CRYO_0000000> a owl:NamedIndividual,
        cryo:CRYO_0000022 ;
    rdfs:label "(0-10)"@en ;
    cryo:CRYO_0000016 "(0-10)" .

noes:NOES_0000028 a owl:NamedIndividual ;
    rdfs:label "rolling direction (RD)"@en ;
    owl:deprecated true .

noes:NOES_0000029 a owl:NamedIndividual ;
    rdfs:label "transverse direction (TD)"@en ;
    owl:deprecated true .

noes:NOES_0000030 a owl:NamedIndividual ;
    rdfs:label "normal direction (ND)"@en ;
    owl:deprecated true .

noes:NOES_0000035 a owl:Class ;
    rdfs:label "transverse direction"@en ;
    rdfs:subClassOf noes:NOES_0000031 ;
    skos:definition "Transverse direction is a direction in the rolling plane normal to the direction in which the sheet is pushed through the rolling mill."@en .

noes:NOES_0000056 a owl:Class ;
    rdfs:label "hysteresis loss"@en ;
    rdfs:comment "Hysteresis loss can be reduced by controlling chemical composition, i.e., reducing nonmetallic impurities and increasing Si content, and by controlling microstructure, i.e., achieving large uniform grains with minimizing inclusions and precipitates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf obo:BFO_0000055 ] ;
            owl:someValuesFrom noes:NOES_0000021 ],
        noes:NOES_0000053 ;
    skos:definition "Hysteresis loss is a type of magnetic power lossses attributed dissipation of energy due to the irreversible motion of a magnetic domain wall. The value of hystereis loss is equivalent to the area of a static B-H curve."@en ;
    pmd:symbol "Phys"@en .

noes:NOES_0000118 a owl:Class ;
    rdfs:label "thickness reduction function"@en ;
    rdfs:subClassOf obo:BFO_0000034 ;
    skos:definition "Thickness reduction function is a function to reduce thickness of a material."@en .

noes:NOES_0000153 a owl:Class ;
    rdfs:label "diffraction process"@en ;
    rdfs:subClassOf pmd:PMD_0000957 ;
    skos:definition "Diffraction process is a structural property analyzing process which utilizes diffraction of either electron, x-ray, or neutron waves to determine material's crystal structure, crystallographic texture, (phase) composition, and presence of defects."@en .

noes:NOES_0000154 a owl:Class ;
    rdfs:label "diffractometer"@en ;
    rdfs:subClassOf pmd:PMD_0000602 ;
    skos:definition "Diffractometer is a device which detects the intensity of a beam of either electrons, x-rays, or neutrons scattered from a material during a diffraction process."@en .

noes:NOES_0000156 a owl:Class ;
    rdfs:label "maximal magnetic field strength"@en ;
    rdfs:subClassOf noes:NOES_0000070 ;
    skos:definition "Maximal magnetic field is a maximal value of a magnetic field has has to be achieved during characterization of magnetic properties"@en ;
    pmd:symbol "Hmax"@en .

noes:NOES_0000179 a owl:Class ;
    rdfs:label "electrical steel"@en ;
    rdfs:comment """deprecated axiom: 'has part' some 
(microstructure and ('has quality' some 
(PMD_0025003 and ('specified by value' value ferrite))))""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom pmd:PMD_0020050 ],
        pmd:PMD_0020096 ;
    skos:definition "Electrical steel is a steel material which has only ferritic metallic grain structure and uses silicon as the main alloying element. It manufactured in a form of a sheet and designed to exibit superior magenetic properties either in all directions (non-orieneted) or in a sinlge direction (oriented)."@en .

<https://w3id.org/pmd/tto/TTO_0000006> a owl:Class ;
    rdfs:label "broken tested test piece role"@en ;
    rdfs:subClassOf pmd:PMD_0000975 ;
    skos:definition "The role of a test piece that, as part of a destructive testing process, has been brought to failure and is therefore in a broken physical state after the test."@en .

<https://w3id.org/pmd/tto/TTO_0000007> a owl:Class ;
    rdfs:label "unbroken tested test piece role"@en ;
    rdfs:comment "An unbroken tested test piece role may explicitly also be realized by a destructive testing process that unintendedly actually did not lead to breakage."@en ;
    rdfs:subClassOf pmd:PMD_0000975 ;
    skos:definition "The role of a test piece that has undergone a test but remains physically intact after the testing process, typically as a result of a non-destructive or non-failure-inducing test."@en .

<https://w3id.org/pmd/tto/TTO_0000008> a owl:Class ;
    rdfs:label "Ergebnis eines Zugversuches"@de,
        "tensile test result"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000051 ;
                        owl:someValuesFrom obo:IAO_0000109 ] [ a owl:Restriction ;
                        owl:onProperty obo:OBI_0000312 ;
                        owl:someValuesFrom pmd:PMD_0000974 ] ) ],
        obo:IAO_0000027 ;
    skos:definition "Datenobjekt, das ein beliebiges Ergebnis beschreibt, das während oder nach einem Zugversuch erzeugt wird, unabhängig von Struktur, Detaillierungsgrad oder Format der Darstellung."@de,
        "Data item that represents any result generated during or after a tensile test, independent of its structure, granularity, or encoding format."@en .

<https://w3id.org/pmd/tto/TTO_0000028> a owl:Class ;
    rdfs:label "Anfangsmesslänge"@de,
        "original gauge length"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/OriginalGaugeLength> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000019> ;
    skos:definition "Länge zwischen den Marken zur Kennzeichnung der Messlänge auf der Probe, die vor dem Versuch bei Raumtemperatur gemessen wird"@de,
        "length between gauge length marks on the test piece measured at room temperature before the test"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en ;
    pmd:symbol "L_o"@en .

<https://w3id.org/pmd/tto/TTO_0000043> a owl:Class ;
    rdfs:label "Dehngrenze"@de,
        "proof strength"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/ProofStrength> ;
    rdfs:subClassOf pmd:PMD_0000952 ;
    skos:definition "Spannung, bei der ein bestimmter Dehnungswert gleich einem bestimmten Prozentsatz der Messlänge des Dehnungsmessers ist"@de,
        "stress at which the a specific extension value is equal to a specified percentage of the extensometer gauge length"@en .

<https://w3id.org/pmd/tto/TTO_0050000> a owl:Class ;
    rdfs:label "area"@en ;
    rdfs:subClassOf pmd:PMD_0020132 .

obo:BFO_0000011 a owl:Class ;
    rdfs:label "spatiotemporal region"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000011 ;
            owl:onProperty obo:BFO_0000132 ],
        obo:BFO_0000003 ;
    skos:definition "(Elucidation) A spatiotemporal region is an occurrent that is an occurrent part of spacetime"@en ;
    skos:example "The spatiotemporal region occupied by the development of a cancer tumour; the spatiotemporal region occupied by an orbiting satellite"@en .

obo:BFO_0000063 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "precedes"@en ;
    obo:IAO_0000115 "x precedes y if and only if the time point at which x ends is before or equivalent to the time point at which y starts. Formally: x precedes y iff ω(x) <= α(y), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point."@en ;
    rdfs:domain obo:BFO_0000003 ;
    rdfs:range obo:BFO_0000003 ;
    skos:definition "(Elucidation) precedes is a relation between occurrents o, o' such that if t is the temporal extent of o & t' is the temporal extent of o' then either the last instant of o is before the first instant of o' or the last instant of o is the first instant of o' & neither o nor o' are temporal instants"@en ;
    skos:example "The temporal region occupied by Mary's birth precedes the temporal region occupied by Mary's death."@en .

obo:BFO_0000066 a owl:ObjectProperty ;
    rdfs:label "occurs in"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( obo:BFO_0000015 obo:BFO_0000035 ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( obo:BFO_0000029 obo:BFO_0000040 ) ] ;
    owl:inverseOf obo:BFO_0000183 ;
    skos:definition "b occurs in c =Def b is a process or a process boundary & c is a material entity or site & there exists a spatiotemporal region r & b occupies spatiotemporal region r & for all time t, if b exists at t then c exists at t & there exist spatial regions s and s' where b spatially projects onto s at t & c occupies spatial region s' at t & s is a continuant part of s' at t"@en ;
    skos:example "A process of digestion occurs in the interior of an organism; a process of loading artillery rounds into a tank cannon occurs in the interior of the tank"@en .

obo:BFO_0000147 a owl:Class ;
    rdfs:label "fiat point"@en ;
    rdfs:subClassOf obo:BFO_0000140 ;
    skos:definition "(Elucidation) A fiat point is a zero-dimensional continuant fiat boundary that consists of a single point"@en ;
    skos:example "The geographic North Pole; the quadripoint where the boundaries of Colorado, Utah, New Mexico and Arizona meet; the point of origin of some spatial coordinate system"@en .

obo:BFO_0000148 a owl:Class ;
    rdfs:label "zero-dimensional temporal region"@en ;
    rdfs:subClassOf obo:BFO_0000008 ;
    skos:definition "(Elucidation) A zero-dimensional temporal region is a temporal region that is a whole consisting of one or more separated temporal instants as parts"@en ;
    skos:example "A temporal region that is occupied by a process boundary; the moment at which a finger is detached in an industrial accident"@en .

obo:BFO_0000202 a owl:Class ;
    rdfs:label "temporal interval"@en ;
    rdfs:subClassOf obo:BFO_0000038 ;
    skos:definition "(Elucidation) A temporal interval is a one-dimensional temporal region that is continuous, thus without gaps or breaks"@en ;
    skos:example "The year 2018."@en .

obo:IAO_0000104 a owl:Class ;
    rdfs:label "plan specification"@en ;
    obo:IAO_0000112 "PMID: 18323827.Nat Med. 2008 Mar;14(3):226.New plan proposed to help resolve conflicting medical advice."@en ;
    obo:IAO_0000115 "A directive information entity with action specifications and objective specifications as parts, and that may be concretized as a realizable entity that, if realized, is realized in a process in which the bearer tries to achieve the objectives by taking the actions specified."@en ;
    obo:IAO_0000116 "2009-03-16: provenance: a term a plan was proposed for OBI (OBI_0000344) , edited by the PlanAndPlannedProcess branch. Original definition was \" a plan is a specification of a process that is realized by an actor to achieve the objective specified as part of the plan\". It has been subsequently moved to IAO where the objective for which the original term was defined was satisfied with the definitionof this, different, term."@en,
        "2014-03-31: A plan specification can have other parts, such as conditional specifications."@en,
        "2022-01-16 Updated definition to that proposed by Clint Dowloand, IAO Issue 231."@en,
        "Alternative previous definition: a plan is a set of instructions that specify how an objective should be achieved"@en ;
    obo:IAO_0000119 "OBI Plan and Planned Process branch"@en,
        "OBI_0000344"@en ;
    rdfs:comment """2/3/2009 Comment from OBI review.

Action specification not well enough specified.
Conditional specification not well enough specified.
Question whether all plan specifications have objective specifications.

Request that IAO either clarify these or change definitions not to use them"""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom obo:IAO_0000005 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom obo:IAO_0000007 ],
        obo:IAO_0000033 .

obo:IAO_0000109 a owl:Class ;
    rdfs:label "measurement datum"@en ;
    obo:IAO_0000112 "Examples of measurement data are the recoding of the weight of a mouse as {40,mass,\"grams\"}, the recording of an observation of the behavior of the mouse {,process,\"agitated\"}, the recording of the expression level of a gene as measured through the process of microarray experiment {3.4,luminosity,}."@en ;
    obo:IAO_0000115 "A measurement datum is an information content entity that is a recording of the output of a measurement such as produced by a device."@en ;
    obo:IAO_0000116 "2/2/2009 is_specified_output of some assay?"@en ;
    obo:IAO_0000119 "OBI_0000305"@en,
        "group:OBI"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:OBI_0001938 ;
            owl:someValuesFrom obo:OBI_0001933 ],
        obo:IAO_0000027 .

obo:IAO_0000125 a owl:NamedIndividual ;
    rdfs:label "pending final vetting"@en ;
    obo:IAO_0000115 "All definitions, placement in the asserted IS_A hierarchy and required minimal metadata are complete. The class is awaiting a final review by someone other than the term editor."@en .

obo:IAO_0020000 a owl:Class ;
    rdfs:label "identifier"@en ;
    obo:IAO_0000115 "An information content entity that is the outcome of a dubbing process and is used to refer to one instance of entity shared by a group of people to refer to that individual entity."@en ;
    obo:IAO_0000233 "https://github.com/information-artifact-ontology/IAO/issues/237"@en ;
    rdfs:comment "Sep 29, 2016: The current definition has been amended from the previous version: \"A proper name is an information content entity that is the outcome of a dubbing process and is used to refer to one instance of entity shared by a group of people to refer to that individual entity.\" to more accuratly reflect the necessary and sufficient condition on the class. (MB)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:OBI_0000312 ;
            owl:someValuesFrom obo:IAO_0020010 ],
        [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000219 ;
            owl:someValuesFrom obo:BFO_0000001 ],
        obo:IAO_0000030 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:IAO_0000030 [ a owl:Restriction ;
                        owl:onProperty obo:IAO_0000219 ;
                        owl:someValuesFrom obo:BFO_0000001 ] [ a owl:Restriction ;
                        owl:onProperty obo:OBI_0000312 ;
                        owl:someValuesFrom obo:IAO_0020010 ] ) ] ;
    pmd:PMD_0000060 true .

obo:IAO_0020010 a owl:Class ;
    rdfs:label "identifier creating process"@en ;
    obo:IAO_0000115 "A planned process that provides a reference to an individual entity shared by a group of subscribers to refer to that individual entity."@en ;
    obo:IAO_0000233 "https://github.com/information-artifact-ontology/IAO/issues/237"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:OBI_0000299 ;
            owl:someValuesFrom obo:IAO_0020000 ],
        obo:COB_0000035 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:COB_0000035 [ a owl:Restriction ;
                        owl:onProperty obo:OBI_0000299 ;
                        owl:someValuesFrom obo:IAO_0020000 ] ) ] .

obo:NCBITaxon_9606 a owl:Class ;
    rdfs:label "Homo sapiens",
        "homo sapiens" ;
    rdfs:subClassOf obo:BFO_0000040 .

obo:OBI_0000245 a owl:Class ;
    rdfs:label "organization"@en ;
    obo:IAO_0000112 "PMID: 16353909.AAPS J. 2005 Sep 22;7(2):E274-80. Review. The joint food and agriculture organization of the United Nations/World Health Organization Expert Committee on Food Additives and its role in the evaluation of the safety of veterinary drug residues in foods."@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000115 "An entity that can bear roles, has members, and has a set of organization rules. Members of organizations are either organizations themselves or individual people. Members can bear specific organization member roles that are determined in the organization rules. The organization rules also determine how decisions are made on behalf of the organization by the organization members."@en ;
    obo:IAO_0000116 """BP: The definition summarizes long email discussions on the OBI developer, roles, biomaterial and denrie branches. It leaves open if an organization is a material entity or a dependent continuant, as no consensus was reached on that.  The current placement as material is therefore temporary, in order to move forward with development. Here is the entire email summary, on which the definition is based:

1) there are organization_member_roles (president, treasurer, branch
editor), with individual persons as bearers

2) there are organization_roles (employer, owner, vendor, patent holder)

3) an organization has a charter / rules / bylaws, which specify what roles
there are, how they should be realized, and how to modify the
charter/rules/bylaws themselves.

It is debatable what the organization itself is (some kind of dependent
continuant or an aggregate of people). This also determines who/what the
bearer of organization_roles' are. My personal favorite is still to define
organization as a kind of 'legal entity', but thinking it through leads to
all kinds of questions that are clearly outside the scope of OBI.

Interestingly enough, it does not seem to matter much where we place
organization itself, as long as we can subclass it (University, Corporation,
Government Agency, Hospital), instantiate it (Affymetrix, NCBI, NIH, ISO,
W3C, University of Oklahoma), and have it play roles.

This leads to my proposal: We define organization through the statements 1 -
3 above, but without an 'is a' statement for now. We can leave it in its
current place in the is_a hierarchy (material entity) or move it up to
'continuant'. We leave further clarifications to BFO, and close this issue
for now."""@en ;
    obo:IAO_0000117 "PERSON: Alan Ruttenberg",
        "PERSON: Bjoern Peters",
        "PERSON: Philippe Rocca-Serra",
        "PERSON: Susanna Sansone" ;
    obo:IAO_0000119 "GROUP: OBI" ;
    rdfs:subClassOf obo:BFO_0000040 .

obo:OBI_0000295 a owl:ObjectProperty ;
    rdfs:label "is specified input of"@en ;
    obo:IAO_0000112 "some Autologous EBV(Epstein-Barr virus)-transformed B-LCL (B lymphocyte cell line) is_input_for instance of Chromum Release Assay described at https://wiki.cbil.upenn.edu/obiwiki/index.php/Chromium_Release_assay"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000115 "A relation between a completely executed planned process and a continuant participating in that process that is not created during the process. The presence of the continuant during the process is explicitly specified in the plan specification which the process realizes the concretization of." ;
    obo:IAO_0000117 "PERSON:Bjoern Peters",
        "Alan Ruttenberg"@en ;
    rdfs:range obo:COB_0000035 ;
    rdfs:subPropertyOf obo:RO_0000056 .

obo:OBI_0000571 a owl:Class ;
    rdfs:label "manufacturer role" ;
    obo:IAO_0000112 "With respect to The Accuri C6 Flow Cytometer System, the organization Accuri bears the role manufacturer role.  With respect to a transformed line of tissue culture cells derived by a specific lab, the lab whose personnel isolated the cll line bears the role manufacturer role.  With respect to a specific antibody produced by an individual scientist, the scientist who purifies, characterizes and distributes the anitbody bears the role manufacturer role." ;
    obo:IAO_0000114 obo:IAO_0000123 ;
    obo:IAO_0000115 "Manufacturer role is a role which inheres in a person or organization and which is realized by a manufacturing process."@en ;
    obo:IAO_0000117 "GROUP:  Role Branch" ;
    obo:IAO_0000119 "OBI" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom obo:BFO_0000040 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:NCBITaxon_9606 obo:OBI_0000245 ) ] ],
        obo:BFO_0000023 .

obo:RO_0000092 a owl:ObjectProperty ;
    rdfs:label "disposition of"@en ;
    obo:IAO_0000115 "inverse of has disposition" ;
    rdfs:comment "This relation is modeled after the BFO relation of the same name which was in BFO2, but is used in a more restricted sense - specifically, we model this relation as functional (inherited from characteristic-of). Note that this relation is now removed from BFO2020." ;
    rdfs:subPropertyOf obo:RO_0000052 .

obo:RO_0001001 a owl:ObjectProperty ;
    rdfs:label "derives into"@en ;
    obo:IAO_0000112 "this parent cell derives into this cell (cell division)"@en,
        "this parent nucleus derives into this nucleus (nuclear division)"@en ;
    obo:IAO_0000115 "a relation between two distinct material entities, the old entity and the new entity, in which the new entity begins to exist when the old entity ceases to exist, and the new entity inherits the significant portion of the matter of the old entity"@en ;
    obo:IAO_0000116 "This is a very general relation. More specific relations are preferred when applicable, such as 'directly develops into'. To avoid making statements about a future that may not come to pass, it is often better to use the backward-looking 'derives from' rather than the forward-looking 'derives into'."@en .

obo:RO_0002224 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "starts with"@en ;
    obo:IAO_0000112 "Every insulin receptor signaling pathway starts with the binding of a ligand to the insulin receptor" ;
    obo:IAO_0000115 "x starts with y if and only if x has part y and the time point at which x starts is equivalent to the time point at which y starts. Formally: α(y) = α(x) ∧ ω(y) < ω(x), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point." ;
    rdfs:subPropertyOf obo:BFO_0000051 .

obo:RO_0002230 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "ends with"@en ;
    obo:IAO_0000115 "x ends with y if and only if x has part y and the time point at which x ends is equivalent to the time point at which y ends. Formally: α(y) > α(x) ∧ ω(y) = ω(x), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point." ;
    rdfs:subPropertyOf obo:BFO_0000051 .

obo:RO_0002353 a owl:ObjectProperty ;
    rdfs:label "output of"@en ;
    obo:IAO_0000115 "inverse of has output" ;
    rdfs:subPropertyOf obo:RO_0000056,
        obo:RO_0002328 .

pmd:PMD_0000055 a owl:Class ;
    rdfs:label "Kühlfunktion"@de,
        "cooling function"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000969 ;
    skos:definition "Eine Kühlfunktion ist eine (realisierbare) Funktion, die es einem System oder Gerät ermöglicht, die Temperatur eines Materials zu senken, häufig um die Erstarrung zu steuern oder einen stabilen Zustand unterhalb eines gewünschten thermischen Schwellenwerts aufrechtzuerhalten."@de,
        "A temperature change function that enables a system or device to lower the temperature of a material, often to control solidification or maintain a stable state below a desired thermal threshold."@en ;
    skos:example "The function of a water-cooled mold to solidify molten metal in casting."@en .

pmd:PMD_0000501 a owl:Class ;
    rdfs:label "1D"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf obo:IAO_0000027 ;
    skos:definition "1D is a data item representing a one-dimensional structure or model representing a single linear dimension, often used in material science simulations or analysis."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000502 a owl:Class ;
    rdfs:label "2D"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf obo:IAO_0000027 ;
    skos:definition "A two-dimensional data item is a representation or analysis, commonly applied in studying planar material properties or surface phenomena."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000521 a owl:Class ;
    rdfs:label "Erzeugung eines Magnetfeldes"@de,
        "generation of magnetic field"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0000009 ;
            owl:someValuesFrom noes:NOES_0000070 ],
        [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0000009 ;
            owl:someValuesFrom noes:NOES_0000003 ],
        obo:BFO_0000015 ;
    skos:definition "ist ein Prozess, der als Reaktion auf eine Änderung des elektrischen Feldes oder die Bewegung von Ladungen abläuft und ein magnetisches Feld erzeugt"@de,
        "is a process that occurs as a reaction to change of elctric field or movement of charges and produces a magnetic field"@en .

pmd:PMD_0000538 a owl:Class ;
    rdfs:label "bulk"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000027 obo:BFO_0000030 ) ] ;
            owl:onProperty obo:BFO_0000050 ],
        obo:BFO_0000024 ;
    owl:disjointWith pmd:PMD_0000965 ;
    skos:definition "a fiat object part that describes the inner part of a somewhat homogenous object, often in contrast to its surface layer"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000549 a owl:Class ;
    rdfs:label "Temperaturänderung"@de,
        "change of temperature"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf obo:BFO_0000015 ;
    skos:definition "Temperaturänderung ist ein Prozess, bei dem ein Teilnehmer seine Temperatur ändert"@de,
        "change of temperature is a process in which a particpant changes its temperature"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000553 a owl:Class ;
    rdfs:label "chemisches Potential"@de,
        "chemical potential"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0080116 ;
    skos:definition "eine intensive Qualität eines thermodynamischen Systems, die die Energieänderung beschreibt, die mit der Zugabe einer kleinen Menge einer Substanz zu einem System bei konstanter Temperatur und konstantem Druck verbunden ist."@de,
        "a quality of a thermodynamic system describing the energy change associated with the addition of a small quantity of a substance to a system at constant temperature and pressure."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000583 a owl:Class ;
    rdfs:label "Rechenprozess"@de,
        "computing process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "The subclass trees of \"Computing Process\" are currently still proposals and serve as a working basis for the discussion round with the simulation/workflow domain experts."@en ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:OBI_0000293 ;
                        owl:someValuesFrom obo:IAO_0000030 ] [ a owl:Restriction ;
                        owl:onProperty obo:OBI_0000299 ;
                        owl:someValuesFrom obo:IAO_0000030 ] ) ],
        obo:COB_0000035 ;
    skos:definition "Ein Prozess, der die systematische Verwendung von rechnerischen Methoden und Werkzeugen umfasst, um Simulationen, Analysen oder Datenumwandlungen durchzuführen, um spezifische wissenschaftliche oder technische Ziele zu erreichen."@de,
        "A process that involves the systematic use of computational methods and tools to perform simulations, analyses, or data transformations to achieve specific scientific or engineering goals."@en .

pmd:PMD_0000591 a owl:Class ;
    rdfs:label "Kristallstruktur"@de,
        "OBSOLETE crystal structure"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "will move to CryO" ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    obo:IAO_0100001 "Obsolete by Kamilla: replaced with defines crystal lattices with fancy axioms an SWRL rules in CryO https://github.com/materialdigital/crystallography-subdomain-ontology"@en ;
    rdfs:comment "The finite set of periodic geometric arrangements is described e.g. by the 14 possible Bravais Lattices in three-dimensional space."@en ;
    owl:deprecated true ;
    skos:definition "eine intensive Kristallqualität, die die periodische geometrische Anordnung von Einheiten in einem Kristallgitter verkörpert."@de,
        "an intensive quality of a crystal that embodies the periodic geometric arrangement of entities in a crystal lattice."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000624 a owl:Class ;
    rdfs:label "Elektronenmikroskop"@de,
        "electron microscope"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    obo:IAO_0000119 "“Electron microscope.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/electron%20microscope. Accessed 24 Nov. 2022."@en ;
    rdfs:subClassOf pmd:PMD_0000855 ;
    skos:definition "Ein Gerät, das einen Elektronenstrahl verwendet, um hochauflösende Bilder der Oberfläche oder Struktur einer Probe zu erstellen."@de,
        "A microscope that uses a beam of electrons to create high-resolution images of a sample's surface or structure."@en .

pmd:PMD_0000625 a owl:Class ;
    rdfs:label "Elektronenmikroskopie"@de,
        "electron microscopy"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000856 ;
    skos:definition "Ein Mikroskopieverfahren, das einen Elektronenstrahl verwendet, um ein Bild eines Objekts zu erzeugen, wodurch eine hochauflösende Visualisierung der Oberfläche und der inneren Strukturen des Materials ermöglicht wird."@de,
        "A microscopy process that uses a beam of electrons to create an image of an object, allowing for high-resolution visualization of the material's surface and internal structures."@en ;
    skos:example "An example of an electron microscopy process is Scanning Electron Microscopy (SEM), which provides detailed images of the surface topography and composition of a material. Another example is Transmission Electron Microscopy (TEM), which can visualize the internal structure of a sample at atomic resolution."@en .

pmd:PMD_0000646 a owl:Class ;
    rdfs:label "Umformen"@de,
        "forming"@en ;
    obo:IAO_0000119 "Offizielle Definition findet man in: DIN 8580:2003-9 Fertigungsverfahren, Seite 4, 3.1.2 Umformen - Definition"@de,
        "Official definition can be found in: DIN 8580:2003-9 Fertigungsverfahren, Page 4, 3.1.2 Umformen - Definition"@en ;
    rdfs:subClassOf pmd:PMD_0000833 ;
    skos:altLabel "Shaping"@en ;
    skos:definition "Ein Herstellungsprozess, der durch plastische Umformung die Gestalt eines festen Körpers verändert, wobei sowohl die Masse als auch die strukturelle Integrität erhalten bleiben."@de,
        "A manufacturing process that changes the shape of a solid body through plastic deformation while retaining both mass and structural integrity."@en ;
    skos:example "Tension Forming, Compression Forming"@en .

pmd:PMD_0000648 a owl:Class ;
    rdfs:label "Formmaschine"@de,
        "forming machine"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000602 ;
    skos:definition "Ein Gerät zur Formgebung von Materialien unter verschiedenen Bedingungen, einschließlich Zug-, Druck- und Scherbedingungen."@de,
        "A device used for shaping materials under various conditions, including tensile, compressive, and shearing."@en .

pmd:PMD_0000655 a owl:Class ;
    rdfs:label "Ofen"@de,
        "furnace"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    obo:IAO_0000119 "“Furnace.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/furnace. Accessed 13 Jan. 2023."@en ;
    rdfs:subClassOf pmd:PMD_0000602 ;
    skos:definition "Ein Gerät, das hochintensive thermische Energie innerhalb eines isolierten Gehäuses erzeugt und speichert."@de,
        "A device that generates and contains high-intensity thermal energy within an insulated enclosure."@en .

pmd:PMD_0000817 a owl:Class ;
    rdfs:label "Laserschneider"@de,
        "lasercutter"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000602 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000085 ;
                        owl:someValuesFrom pmd:PMD_0000592 ] ) ] ;
    skos:definition "Ein Gerät, das Laserstrahlen verwendet, um präzise Schnitte in verschiedenen Materialien wie Holz, Kunststoff, Metall usw. zu erzeugen."@de,
        "A device that utilizes laser beams to create precise cuts in various materials such as wood, plastic, metal, etc."@en .

pmd:PMD_0000827 a owl:Class ;
    rdfs:label "Magnetisierungsgerät"@de,
        "magnetizing device"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000602 ;
    skos:definition "Ein Gerät zur Induktion eines Magnetfelds in Materialien, um deren magnetische Eigenschaften zu verändern."@de,
        "A device used for inducing a magnetic field in materials to alter their magnetic properties."@en .

pmd:PMD_0000852 a owl:Class ;
    rdfs:label "metal"@en ;
    obo:IAO_0000116 "Classified by morphology."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000000 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000051 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0000663 [ a owl:Restriction ;
                                            owl:onProperty obo:BFO_0000051 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( obo:CHEBI_33521 [ a owl:Restriction ;
                                                                owl:onProperty pmd:PMD_0025998 ;
                                                                owl:someValuesFrom pmd:PMD_0050002 ] ) ] ] ) ] ] ) ] ;
    skos:definition "material characterized by high electrical and thermal conductivity, ductility, and metallic bonding"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000855 a owl:Class ;
    rdfs:label "Mikroskop"@de,
        "microscope"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000602 ;
    skos:definition "Ein Gerät zur Vergrößerung und Betrachtung kleiner Objekte oder Details, die mit bloßem Auge nicht sichtbar sind."@de,
        "A device used to magnify and view small objects or details that are not visible to the naked eye."@en .

pmd:PMD_0000856 a owl:Class ;
    rdfs:label "Mikroskopie Verfahren"@de,
        "microscopy process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf obo:OBI_0000070 ;
    skos:definition "Ein Struktur Eigenschaften Analyseverfahren, das verschiedene Arten von Mikroskopietechniken verwendet, um die Mikrostruktur und Morphologie von Materialien auf verschiedenen Ebenen zu visualisieren und zu analysieren."@de,
        "Microscopy process that uses various types of microscopy techniques to visualize and analyze the microstructure and morphology of materials at different scales."@en ;
    skos:example "Electron microscopy, which provides detailed images at high resolution; ion microscopy, which offers high-precision imaging and material milling capabilities; and optical microscopy, which uses visible light to study e.g. the microstructure of materials."@en ;
    pmd:PMD_0050117 "Mikroskopie"@de .

pmd:PMD_0000969 a owl:Class ;
    rdfs:label "Temperaturänderungsfunktion"@de,
        "temperature change function"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000079 ;
            owl:someValuesFrom pmd:PMD_0000968 ],
        obo:BFO_0000034,
        pmd:PMD_0020254,
        pmd:PMD_0020317 ;
    skos:definition "Eine Unterfunktion der Wärmebehandlung, die durchgeführt wird, um Temperaturänderungen hervorzurufen, um die Materialeigenschaften zu verändern."@de,
        "A function in heat treatment performed to induce changes in temperature to alter material properties."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0001007 a owl:Class ;
    rdfs:label "Wasserstrahlschneider"@de,
        "waterjet cutter"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000602 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000085 ;
                        owl:someValuesFrom pmd:PMD_0000592 ] ) ] ;
    skos:definition "Ein Gerät, das einen Hochdruckwasserstrahl oder einen Wasserstrahl mit abrasiven Partikeln verwendet, um Materialien wie Metall, Stein, Kunststoff usw. zu schneiden."@de,
        "A device that utilizes a high-pressure stream of water or a water stream with abrasive particles to cut materials such as metal, stone, plastic, etc."@en .

pmd:PMD_0001028 a owl:ObjectProperty ;
    rdfs:label "als Antwort auf"@de,
        "in response to"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    owl:inverseOf pmd:PMD_0001029 ;
    skos:definition "Umkehrung von antwortet mit"@de,
        "inverse of responds with"@en .

pmd:PMD_0020000 a owl:Class ;
    rdfs:label "phase (thermodynamic)"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000053 ;
            owl:someValuesFrom pmd:PMD_0000553 ],
        obo:BFO_0000040 ;
    skos:definition "A thermodynamic phase is a material entity that forms a homogeneous portion of matter within a thermodynamic system and is characterized by uniform thermodynamic properties."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020004 a owl:Class ;
    rdfs:label "composition data item"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 """See editior note of composition to underatand the difference between composition and chemical composition data items.

To understand the difference between the composition and the composition data item, one has to understand the difference between SDCs and GDCs in BFO. A triple "material entity has quality compsition", conveys the fact such quality exists without telling us what are fractions of compounds in this material entity. A triple "compostion is subject of composition data item" conveys that there's an information about values of these fractions. Think of comosition data item as a pdf where the composition is documented."""@en ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:comment "These portions of other matters do not have to be portions of specific chemical elements, i.e., atomic composition, but rather portions of other substances, such as nitric acid and water."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( obo:IAO_0000027 [ a owl:Restriction ;
                        owl:onProperty obo:IAO_0000136 ;
                        owl:someValuesFrom pmd:PMD_0025001 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0002351 ;
            owl:someValuesFrom pmd:PMD_0025997 ] ;
    skos:altLabel "composition specification"@en ;
    skos:definition "Bei einem Zusammensetzungsdatenelement handelt es sich um eine Informationsinhaltseinheit, die sich mit der Zusammensetzung einer materiellen Einheit befasst. Es verfügt über Bruchwertspezifikationen für Mitglieder, die Werte von Anteilen von Verbindungen angeben, die Teile der materiellen Einheit sind."@de,
        "Composition data entity is an information content entity that is about composition of a material enity. It has members fraction value specifications which specifiy values of propotions of compounds, which are parts of the material enity."@en ;
    skos:example "Nitric acid solution has quality  composition, and  the composition data item is about this composition.The composition data item has members fraction specifications of nitric acid, e.g., 4 vol.%, and distilled water. These fraction specifications specify value of pure substances of nitric acid and distilled water, respectively. Furthermore, these fraction specifications specify values of relational qualities (volume) proportion of nitric acid and (volume) proportion of distilled water."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020102 a owl:Class ;
    rdfs:label "Massenverhältnis"@de,
        "mass ratio"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Necessary and sufficient conditions for 'mass ratio' have not yet been formalized. The term is defined as a specific subtype of 'material composition'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf pmd:PMD_0080069 ;
    skos:definition "Das Massenverhältnis bezeichnet eine relationale Qualität, die einen Massenwert im Verhältnis zu einem anderen ausdrückt und typischerweise eine dimensionslose Zahl ergibt"@de,
        "Mass ratio denotes a relational quality expressing one mass value relative to another, typically producing a dimensionless number"@en ;
    skos:example "A fiber-reinforced composite has a fiber-to-matrix mass ratio of 60:40"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020103 a owl:Class ;
    rdfs:label "Molverhältnis"@de,
        "molar ratio"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf pmd:PMD_0080069 ;
    skos:altLabel "molar proportion"@en ;
    skos:definition "Der Molanteil ist der Anteil, der die Anzahl der Einheiten des Teils im Verhältnis zur Anzahl der Einheiten des Ganzen quantifiziert."@de,
        "Molar proportion is the proportion which quantifies the entities count of the part in relation to the entities count of the whole."@en ;
    skos:example """The molar ratio of hydrogen gas H2 molecules to water H2O molecules is 1/1 in the oxyhydrogen reaction. The molar ratio of oxygen molecules O2 to water molecules is 2/1.
The molar ratio of carbon dioxide to average atmosphere air is 420 ppm as of 2022 AD."""@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020104 a owl:Class ;
    rdfs:label "Volumenverhältnis"@de,
        "volume ratio"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Necessary and sufficient conditions for 'volume ratio' have not yet been formalized. The term is defined as a specific subtype of 'material composition'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf pmd:PMD_0080069 ;
    skos:definition "Volumenverhältnis stellt eine relationale Qualität dar, die einen Volumenwert im Verhältnis zu einem anderen ausdrückt, typischerweise resultierend in einer dimensionslosen Zahl"@de,
        "Volume ratio represents a relational quality expressing one volume value relative to another, typically resulting in a dimensionless number"@en ;
    skos:example "A foam material has a pore-to-solid volume ratio of 4:1, indicating 80 % porosity"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020139 a owl:Class ;
    rdfs:label "Schmelze"@de,
        "melt"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0020113 pmd:PMD_0020290 ) ] ;
    skos:definition "is a fluid (object) with a disposition to realize a blank role in a manufacturing process"@en ;
    skos:example "molten PLA in a 3D printing process"@en .

pmd:PMD_0020197 a owl:Class ;
    rdfs:label "lattice point"@en ;
    rdfs:subClassOf obo:BFO_0000147 ;
    skos:definition "A lattice point is a fiat point that represents a position in a crystal lattice at which structural entities are regularly arranged."@en .

pmd:PMD_0020198 a owl:Class ;
    rdfs:label "interstitial site"@en ;
    rdfs:subClassOf obo:BFO_0000029 ;
    skos:definition "An interstitial site is a site that is located between regular lattice points in a crystal structure."@en .

pmd:PMD_0020241 a owl:Class ;
    rdfs:label "Winkel der Fehlausrichtung (Kristallographie)"@de,
        "angle of misalignment (crystallography)"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf pmd:PMD_0001035 ;
    skos:definition "kleinster Drehwinkel, der erforderlich ist, um eine Kristallorientierung so zu drehen, dass sie mit der benachbarten Orientierung übereinstimmt"@de,
        "smallest rotation angle needed to rotate one crystal orientation to coincide with the neighboring orientation"@en .

pmd:PMD_0020259 a owl:Class ;
    rdfs:label "chemical property"@en ;
    rdfs:subClassOf pmd:PMD_0020265 ;
    skos:definition "a property that is commonly associated with the domain of chemistry"@en .

pmd:PMD_0020288 a owl:Class ;
    rdfs:label "atom gas"@en ;
    rdfs:comment "Make entity member of subclass of 'portion of matter in aggregate state'" ;
    rdfs:subClassOf pmd:PMD_0020287 ;
    skos:definition "a portion of matter in an gaseous aggregate state where the gas entities are atoms"@en .

pmd:PMD_0020291 a owl:Class ;
    rdfs:label "mesomorphic"@en ;
    rdfs:subClassOf pmd:PMD_0020287 ;
    skos:definition "a portion of matter in an mesomorphic aggregate state where some entities transmit no shear stress while others do"@en .

pmd:PMD_0020292 a owl:Class ;
    rdfs:label "plasma"@en ;
    rdfs:subClassOf pmd:PMD_0020287 ;
    skos:definition "a portion of matter in an plasma aggregate state where entities are atom nuclei and have no bonds"@en .

pmd:PMD_0020294 a owl:Class ;
    rdfs:label "supercritical fluid"@en ;
    rdfs:subClassOf pmd:PMD_0020287 ;
    skos:definition "a portion of matter in an supercritical fluid aggregate state"@en .

pmd:PMD_0020295 a owl:Class ;
    rdfs:label "suprafluid"@en ;
    rdfs:subClassOf pmd:PMD_0020287 ;
    skos:definition "a portion of matter in an suprafluid aggregate state"@en .

pmd:PMD_0020296 a owl:Class ;
    rdfs:label "suprasolid"@en ;
    rdfs:subClassOf pmd:PMD_0020287 ;
    skos:definition "a portion of matter in a suprasolid aggregate state"@en .

pmd:PMD_0020309 a owl:Class ;
    rdfs:label "interface property"@en ;
    rdfs:subClassOf pmd:PMD_0023003 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000052 ;
                        owl:someValuesFrom obo:BFO_0000146 ] [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025999 ;
                        owl:someValuesFrom obo:BFO_0000146 ] ) ] ;
    skos:definition "a a 'property by bearer' that indicates its bearer is an interface"@en .

pmd:PMD_0020332 a owl:Class ;
    rdfs:label "normal force"@en ;
    rdfs:subClassOf pmd:PMD_0020200 ;
    skos:definition "a force that is acting perpendicular to some characteristic extend of one of the two involved objects"@en .

pmd:PMD_0020365 a owl:Class ;
    rdfs:label "per volume property"@en ;
    obo:IAO_0000116 "TODO axiom wrong"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002328 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000001 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000086 ;
                                owl:someValuesFrom pmd:PMD_0020150 ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0002328 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0020150 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000077 ;
                                owl:someValuesFrom obo:OBI_0001931 ] ) ] ],
        pmd:PMD_0023001 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:RO_0002328 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000001 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000086 ;
                                owl:someValuesFrom pmd:PMD_0020150 ] ) ] ] ;
    skos:definition "a quotient where the denominator is a volume"@en .

pmd:PMD_0023041 a owl:Class ;
    rdfs:label "a sites property"@en ;
    rdfs:subClassOf pmd:PMD_0023003 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000052 ;
                        owl:someValuesFrom obo:BFO_0000029 ] [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025999 ;
                        owl:someValuesFrom obo:BFO_0000029 ] ) ] ;
    skos:definition "a 'property by bearer' that indicates that its bearer is a site"@en .

pmd:PMD_0025019 a owl:Class ;
    rdfs:label "rate"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Ideally, a temporally qualified continuant must be used as a participant in a process where the qualities of the participant changes.This temporally qualitified continuant has an instance of quality with one on value before the process and another instance of the same quality with another on value after the process."@en,
        "In the axiom, the instance of quality in \"refers to\" triple must be the same instance as in \"has quality\" triple."@en ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom obo:BFO_0000019 ;
                        owl:onProperty pmd:PMD_0020127 ] [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:BFO_0000015 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000057 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( [ a owl:Class ;
                                                                owl:unionOf ( obo:BFO_0000004 pmd:PMD_0000068 ) ] [ a owl:Restriction ;
                                                                owl:onProperty obo:RO_0000086 ;
                                                                owl:someValuesFrom obo:BFO_0000019 ] ) ] ] ) ] ;
                        owl:onProperty pmd:PMD_0025006 ] ) ],
        pmd:PMD_0000008 ;
    skos:definition "process attribute which describes the change of some quality of some of the participants in a process over time"@en .

pmd:PMD_0025021 a owl:Class ;
    rdfs:label "Stanzmachine"@de,
        "stamping press"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    obo:IAO_0000119 "https://en.wikipedia.org/wiki/Stamping_press" ;
    rdfs:subClassOf pmd:PMD_0000602 ;
    skos:definition "Eine Stanzmachine ist ein Werkzeug/Gerät zur Metallbearbeitung, das dazu dient, geschnittenes Metall durch Verformung mit einer Matrize zu formen."@de,
        "Stamping press is a metalworking device which is used to shape a cut metal by deforming it with a die."@en .

pmd:PMD_0025997 a owl:Class ;
    rdfs:label "Angabe des Bruchwerts"@de,
        "fraction value specification"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pmd:PMD_0020004 ;
            owl:onProperty obo:RO_0002350 ],
        [ a owl:Restriction ;
            owl:onProperty obo:OBI_0001927 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0020101 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0025999 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                                                    owl:onProperty obo:BFO_0000050 ;
                                                    owl:someValuesFrom obo:BFO_0000040 ] ) ] ] ) ] ],
        obo:OBI_0001931 ;
    skos:definition "Bei der Bruchwertspezifikation handelt es sich um eine Wertspezifikation, die Informationen über den quantitativen Anteil eines Teils im Verhältnis zu einem angegebenen Ganzen enthält."@de,
        "Fraction value specification is a value specification that contains information about quantitative share of a part relative to a specified whole."@en ;
    skos:example "2.05 wt.% of carbon in steel, 4 vol.% of nitric acid in a solution"@en .

pmd:PMD_0050154 a owl:Class ;
    rdfs:label "Breite"@de,
        "width"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Markus Schilling" ;
    rdfs:seeAlso <https://w3id.org/pmd/co/2.0.8/Width>,
        <https://www.merriam-webster.com/dictionary/width> ;
    rdfs:subClassOf pmd:PMD_0040001 ;
    skos:definition "Diese Klasse beschreibt eine horizontale Messung eines Objekts, die im rechten Winkel zur Länge des Objekts vorgenommen wird."@de,
        "This class describes a horizontal measurement of an object taken at right angles to the length of the object."@en .

pmd:PMD_0080019 a owl:Class ;
    rdfs:label "Fläche"@de,
        "area"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Necessary and sufficient conditions for 'area' have not yet been formalized. The term is defined as a specific subtype of 'DimensionQuality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0001323."@en ;
    obo:IAO_0000117 "PERSON: Thomas Hanke" ;
    obo:IAO_0000119 obo:PATO_0001323 ;
    rdfs:subClassOf pmd:PMD_0020132 ;
    skos:definition "Fläche bedeutet eine zweidimensionale Ausdehnungsqualität, die aufgrund der zweidimensionalen Ausdehnung des Trägers inhärent ist"@de,
        "Area signifies a 2-D extent quality inhering by virtue of the bearer's two-dimensional extent"@en ;
    skos:example "The cross-sectional area of a tensile specimen at the gauge section is 50 mm2"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0080171 a owl:Class ;
    rdfs:label "Fließgrenze"@de,
        "yield stress"@en ;
    rdfs:comment "The amount of plastic strain typically gives more information about the yield stress. E.g. Rp02 has 0.2% plastic strain."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000952 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000052 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0000068 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000053 ;
                                            owl:someValuesFrom pmd:PMD_0080035 ] ) ] ] ) ] ;
    skos:altLabel "yield strength"@en ;
    skos:definition "is the stress at which the material has a non-zero plastic strain."@en ;
    skos:example "The yield strength of mild steel is approximately 250 MPa, beyond which permanent deformation begins"@en ;
    pmd:PMD_0000060 true .

cryo:CRYO_0000028 a owl:Class ;
    rdfs:label "crystal system value"@en ;
    rdfs:subClassOf obo:OBI_0001930 ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cryo:CRYO_0000029 cryo:CRYO_0000030 cryo:CRYO_0000031 cryo:CRYO_0000032 cryo:CRYO_0000034 cryo:CRYO_0000035 cryo:CRYO_0000391 ) ] ;
    skos:definition """crystal system value is a categorical value specification which describes the grouping of
crystal system  based on the rotational and mirror symmetries of their actual atomic arrangements in the  crystal. The specific values are triclinic, monoclinic, orthorhombic, tetragonal, trigonal, hexagonal, and cubic."""@en .

cryo:CRYO_0000036 a owl:Class ;
    rdfs:label "lattice centering value"@en ;
    rdfs:subClassOf obo:OBI_0001930 ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cryo:CRYO_0000043 cryo:CRYO_0000044 cryo:CRYO_0000045 cryo:CRYO_0000046 ) ] ;
    skos:definition "Lattice centering value is a categorical value specification which describes th geometric arrangement of lattice points in a unit cell with one of the values: primitive, body centered, face centered, base centered."@en .

cryo:CRYO_0000041 a owl:Class ;
    rdfs:label "crystallographic entity in cubic system"@en ;
    rdfs:comment "Note that this class is not meant for instantiation but is needed for formulation of other logical axioms and inferences." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasSelf true ;
            owl:onProperty cryo:CRYO_0000170 ],
        obo:BFO_0000141 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( obo:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty obo:BFO_0000050 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000001 [ a owl:Restriction ;
                                                        owl:onProperty obo:RO_0000086 ;
                                                        owl:someValuesFrom [ a owl:Class ;
                                                                owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                                            owl:hasValue cryo:CRYO_0000035 ;
                                                                            owl:onProperty pmd:PMD_0000077 ] ) ] ] ) ] ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( obo:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty obo:RO_0000086 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                        owl:hasValue cryo:CRYO_0000035 ;
                                                        owl:onProperty pmd:PMD_0000077 ] ) ] ] ) ] ) ] ;
    skos:definition "Crystallographic entity in cubic system is an immaterial entity that either itself has cubic lattice system or is a part of crystal lattice with cubic lattice system."@en .

cryo:CRYO_0000042 a owl:Class ;
    rdfs:label "grain orientation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom pmd:PMD_0000663 ],
        obo:BFO_0000019,
        pmd:PMD_0020317 ;
    skos:definition """Grain orientation is an intensive quality of grains in material's microstructure, which describes the crystallographic orientation in respect to the external (sample's) reference frame. Grain orientation can be a quality of an individual grain / crystallite or of a polycrystal, i.e., several grains with similar crystallographic orientations.
Grain orientation can be specified by either texture fibers or texture components. When several grains exhibit similar orientations, then the material exhibits a specific crystallographic texture."""@en .

cryo:CRYO_0000381 a owl:Class ;
    rdfs:label "monoclinic crystal lattice"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000086 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                owl:hasValue cryo:CRYO_0000030 ;
                                owl:onProperty pmd:PMD_0000077 ] ) ] ],
        cryo:CRYO_0000001,
        cryo:CRYO_0000120 ;
    owl:deprecated true ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cryo:CRYO_0000001 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000086 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                            owl:hasValue cryo:CRYO_0000030 ;
                                            owl:onProperty pmd:PMD_0000077 ] ) ] ] ) ] .

cryo:CRYO_0000383 a owl:Class ;
    rdfs:label "tetragonal crystal lattice"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000086 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                owl:hasValue cryo:CRYO_0000032 ;
                                owl:onProperty pmd:PMD_0000077 ] ) ] ],
        cryo:CRYO_0000001,
        cryo:CRYO_0000122 ;
    owl:deprecated true ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cryo:CRYO_0000001 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000086 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                            owl:hasValue cryo:CRYO_0000032 ;
                                            owl:onProperty pmd:PMD_0000077 ] ) ] ] ) ] .

cryo:CRYO_0000392 a owl:Class ;
    rdfs:label "lattice system value"@en ;
    rdfs:subClassOf obo:OBI_0001930 ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cryo:CRYO_0000029 cryo:CRYO_0000030 cryo:CRYO_0000031 cryo:CRYO_0000032 cryo:CRYO_0000033 cryo:CRYO_0000034 cryo:CRYO_0000035 ) ] ;
    skos:definition """lattice system value is a categorical value specification which describes the grouping of
lattice system based on the point group symmetries of their empty translational frameworks. The specific values are triclinic, monoclinic, orthorhombic, tetragonal, rhombohedral, hexagonal, and cubic."""@en .

noes:NOES_0000001 a owl:Class ;
    rdfs:label "rolled sheet direction"@en ;
    rdfs:comment """TODO: 
which determines the directions in a sheet material in respect to the rolling direction. Rolled sheet direction is a part of material or object."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0001025 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000030 pmd:PMD_0000000 ) ] ],
        obo:BFO_0000142 ;
    skos:definition "Rolled sheet direction is a fiat line which is part of rolled material's intrinsic reference frame."@en .

noes:NOES_0000004 a owl:Class ;
    rdfs:label "plot"@en ;
    rdfs:subClassOf pmd:PMD_0000502 ;
    skos:definition "A plot is a 2-D information content entity describing a dependency of one variable on another."@en ;
    skos:example "B-H curve, stress-strain curve"@en .

noes:NOES_0000008 a owl:Class ;
    rdfs:label "orientation distribution function"@en ;
    rdfs:subClassOf pmd:PMD_0025005 ;
    skos:altLabel "ODF"@en ;
    skos:definition "Orientation distrubution function (ODF) is a 3D information content entity which quantitively describes texture (preferred crystallographic orientation of grains) in polycrystalline materials. ODF can be caclulated from pole figures obtained from the diffraction patterns."@en .

noes:NOES_0000021 a owl:Class ;
    rdfs:label "domain wall motion"@en ;
    rdfs:subClassOf pmd:PMD_0025009 ;
    skos:definition "Domain wall motion is a naturally occuring process which occurs in ferromagnetic materials due to the external stimulus such as applied magnetic field."@en .

noes:NOES_0000043 a owl:Class ;
    rdfs:label "texture parameter Aθ"@en ;
    rdfs:seeAlso "doi:10.1155/2008/173083" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom pmd:PMD_0000857 ],
        obo:BFO_0000019,
        pmd:PMD_0020335,
        pmd:PMD_0023004 ;
    skos:definition "Texture parameter is a intensive quality which quantifies crystallographic texture in materials. Texture parameter is defined as a minimun angle between the magnitization vector and the closest <100> direction in a crystal. Texture parameter can be derived from orientation distribution function (ODF) by integrating ODF f(g) multiplied by Aθ(g) over orientations dg."@en .

noes:NOES_0000049 a owl:Class ;
    rdfs:label "magnetic induction"@en ;
    rdfs:subClassOf pmd:PMD_0020312 ;
    skos:altLabel "magnetic flux density"@en ;
    skos:definition "Magnetic induction is a magnetic property stimulated by an applied extermal magnetic field H. It characterizes the response of magnetic domains within a material to the applied magnetic field, i.e., the alignment of the magnetic domains and the stregnth of the total induced magnetic field in the material."@en ;
    pmd:symbol "B" .

noes:NOES_0000069 a owl:Class ;
    rdfs:label "magnetic power loss at 1.0 T / 400 Hz"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009007 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:OBI_0000070 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000009 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( pmd:PMD_0000008 [ a owl:Restriction ;
                                                    owl:onProperty pmd:PMD_0000077 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                        owl:hasValue obo:UO_0000106 ;
                                                                        owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                                        owl:hasValue 400.0 ;
                                                                        owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000009 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( pmd:PMD_0000008 [ a owl:Restriction ;
                                                    owl:onProperty pmd:PMD_0020127 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( noes:NOES_0000178 [ a owl:Restriction ;
                                                                        owl:onProperty pmd:PMD_0000077 ;
                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                            owl:hasValue obo:UO_0000228 ;
                                                                                            owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                                                            owl:hasValue 1.0 ;
                                                                                            owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ],
        noes:NOES_0000057 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:RO_0009007 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:OBI_0000070 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000009 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( pmd:PMD_0000008 [ a owl:Restriction ;
                                                    owl:onProperty pmd:PMD_0000077 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                        owl:hasValue obo:UO_0000106 ;
                                                                        owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                                        owl:hasValue 400.0 ;
                                                                        owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000009 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( pmd:PMD_0000008 [ a owl:Restriction ;
                                                    owl:onProperty pmd:PMD_0020127 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( noes:NOES_0000178 [ a owl:Restriction ;
                                                                        owl:onProperty pmd:PMD_0000077 ;
                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                            owl:hasValue obo:UO_0000228 ;
                                                                                            owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                                                            owl:hasValue 1.0 ;
                                                                                            owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ;
    skos:definition "Magnetic power loss at 1.0 T / 400 Hz is a total magnetic power loss that has been determined at 1.0 T of maximum magnetic induction B and 400 Hz of frequency of alternating magnetic field"@en ;
    pmd:symbol "P1.0/400"@en ;
    noes:NOES_0000122 false .

noes:NOES_0000070 a owl:Class ;
    rdfs:label "magnetic field strength"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0025006 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( pmd:PMD_0000521 pmd:PMD_0000829 ) ] ],
        pmd:PMD_0000008 ;
    skos:definition "Magnetic field strength is a process attribute of an aplication of magnetic field process which characterizes the magnitude the external / applied magnetic field."@en ;
    pmd:symbol "H" .

noes:NOES_0000125 a owl:Class ;
    rdfs:label "inclusion role"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000081 ;
            owl:someValuesFrom obo:BFO_0000027 ],
        obo:BFO_0000023,
        pmd:PMD_0023007 ;
    skos:definition "Inclusion role is a role of object aggregate which is a part of microstructure of an alloy: These object aggregates are second-phase particles embedded in the alloy matrix, and are thermodynamically distinct from the matrix."@en .

noes:NOES_0000152 a owl:Class ;
    rdfs:label "crystallite with λ-fiber texture orientation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0025998 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( noes:NOES_0000141 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000077 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( [ a owl:Restriction ;
                                                    owl:hasValue obo:UO_0000185 ;
                                                    owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                    owl:onProperty obo:OBI_0001937 ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:float ;
                                                            owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0025999 ;
                                owl:someValuesFrom noes:NOES_0000112 ] ) ] ],
        pmd:PMD_0000663 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000663 [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025998 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( noes:NOES_0000141 [ a owl:Restriction ;
                                            owl:onProperty pmd:PMD_0000077 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( [ a owl:Restriction ;
                                                                owl:hasValue obo:UO_0000185 ;
                                                                owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                                owl:onProperty obo:OBI_0001937 ;
                                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                                        owl:onDatatype xsd:float ;
                                                                        owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty pmd:PMD_0025999 ;
                                            owl:someValuesFrom noes:NOES_0000112 ] ) ] ] ) ] ;
    skos:comment "Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference."@en ;
    skos:definition "crystallite with  λ-fiber texture orientation is a crystallite whose family of <100> equivalent directions in a cubic lattice system are oriented approximately parallel to the normal direction."@en .

noes:NOES_0000157 a owl:Class ;
    rdfs:label "crystallite with η-fiber texture orientation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0025998 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( noes:NOES_0000141 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000077 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( [ a owl:Restriction ;
                                                    owl:hasValue obo:UO_0000185 ;
                                                    owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                    owl:onProperty obo:OBI_0001937 ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:float ;
                                                            owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0025999 ;
                                owl:someValuesFrom noes:NOES_0000113 ] ) ] ],
        pmd:PMD_0000663 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000663 [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025998 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( noes:NOES_0000141 [ a owl:Restriction ;
                                            owl:onProperty pmd:PMD_0000077 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( [ a owl:Restriction ;
                                                                owl:hasValue obo:UO_0000185 ;
                                                                owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                                owl:onProperty obo:OBI_0001937 ;
                                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                                        owl:onDatatype xsd:float ;
                                                                        owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty pmd:PMD_0025999 ;
                                            owl:someValuesFrom noes:NOES_0000113 ] ) ] ] ) ] ;
    skos:comment "Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference."@en ;
    skos:definition "crystallite with η-fiber texture orientation is a crystallite whose family of <001> equivalent directions in a cubic lattice system are oriented approximately parallel to the rolling direction."@en .

noes:NOES_0000158 a owl:Class ;
    rdfs:label "crystallite with γ-fiber texture orientation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0025998 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( noes:NOES_0000141 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000077 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( [ a owl:Restriction ;
                                                    owl:hasValue obo:UO_0000185 ;
                                                    owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                    owl:onProperty obo:OBI_0001937 ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:float ;
                                                            owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0025999 ;
                                owl:someValuesFrom noes:NOES_0000138 ] ) ] ],
        pmd:PMD_0000663 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000663 [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025998 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( noes:NOES_0000141 [ a owl:Restriction ;
                                            owl:onProperty pmd:PMD_0000077 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( [ a owl:Restriction ;
                                                                owl:hasValue obo:UO_0000185 ;
                                                                owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                                owl:onProperty obo:OBI_0001937 ;
                                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                                        owl:onDatatype xsd:float ;
                                                                        owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty pmd:PMD_0025999 ;
                                            owl:someValuesFrom noes:NOES_0000138 ] ) ] ] ) ] ;
    skos:comment "Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference."@en ;
    skos:definition "crystallite withγ-fiber texture orientation is a crystallite whose family of <111> equivalent directions in a cubic lattice system are oriented approximately parallel to the normal direction."@en .

noes:NOES_0000180 a owl:Class ;
    rdfs:label "non-oriented electrical steel"@en ;
    rdfs:subClassOf noes:NOES_0000179 ;
    skos:altLabel "NOES" ;
    skos:definition "Non-oriented electrical steel is an electrical steel material which exhibits isotropic magnetic properties in all direction in the sheet plane."@en .

noes:NOES_0000183 a owl:Class ;
    rdfs:label "Epstein frame"@en ;
    obo:IAO_0000119 "https://de.wikipedia.org/wiki/Epsteinrahmen" ;
    rdfs:subClassOf noes:NOES_0000163 ;
    skos:definition "Epstein frame is a measuring device of magnetic properties of soft magnetic materials, especially electrical steels. It consists of outer primary (magnetizing) winding, which surrounds the inner secondary (measuring) winding, and both windings are distributed across the four coils of the  frame. The steel strips are inserted pairwise into the opposite coils."@en .

noes:NOES_0000184 a owl:Class ;
    rdfs:label "sinlge sheet tester"@en ;
    obo:IAO_0000119 "https://www.magnet-physik.de/wp-content/uploads/2023/08/MJC-210-e-3236.pdf" ;
    rdfs:subClassOf noes:NOES_0000163 ;
    skos:definition "Single sheet tester is a measuring device of soft magnetic properties of sheet materials, especially electrical steels. It consists of a single coil system to magnetize the sample with and and a pick-up coil to detect  polarization in the material."@en .

noes:NOES_0000185 a owl:Class ;
    rdfs:label "thoroidal core setup"@en ;
    obo:IAO_0000119 "https://en.wikipedia.org/wiki/Rowland_ring" ;
    rdfs:subClassOf noes:NOES_0000163 ;
    skos:altLabel "ring core setup"@en ;
    skos:definition "Thoroidal core setup is a measuring device of a hysteresis curve of magnetic materials. The specimen shape is a thoroid, around which a magnitization coil is closely wound."@en .

<https://w3id.org/pmd/tto/TTO_0000012> a owl:Class ;
    rdfs:label "Querschnittsfläche"@de,
        "cross section area"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/co/2.0.8/CrossSectionArea> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0050000> ;
    skos:definition "Die Querschnittsfläche ist die Fläche eines Schnittes oder eines rechtwinklig geschnittenen oder gebrochenen Stücks eines Objektes in Bezug auf eine Achse."@de,
        "The cross section area is an area of a cutting or piece of an object cut off or broken at right angles or related to an axis."@en ;
    pmd:definitionSource <https://www.merriam-webster.com/dictionary/cross%20section> .

<https://w3id.org/pmd/tto/TTO_0000044> a owl:Class ;
    rdfs:label "Dehngrenze bei plastischer Extensometer-Dehnung"@de,
        "proof strength plastic extension"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/ProofStrengthPlasticExtension> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000043> ;
    skos:definition """Spannung, bei der die plastische Extensometer-Dehnung einem vorgegebenen Prozentanteil der Extensometer-Messlänge entspricht

Anmerkung: Der Index wird durch den Zahlenwert ergänzt, der den vorgegebenen Zahlenwert der plastischen Extensometer-Dehnung in Prozent angibt, z. B. R_p_0,2."""@de,
        """stress at which the plastic extension is equal to a specified percentage of the extensometer gauge length

Note: A suffix is added to the subscript to indicate the prescribed percentage, e.g. R_p_0.2.

Source: ISO 6892-1:2019"""@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en ;
    pmd:symbol "R_p"@en .

obo:BFO_0000142 a owl:Class ;
    rdfs:label "fiat line"@en ;
    rdfs:subClassOf obo:BFO_0000140 ;
    skos:definition "(Elucidation) A fiat line is a one-dimensional continuant fiat boundary that is continuous"@en ;
    skos:example "The Equator; all geopolitical boundaries; all lines of latitude and longitude; the median sulcus of your tongue; the line separating the outer surface of the mucosa of the lower lip from the outer surface of the skin of the chin"@en .

obo:CHEBI_24431 a owl:Class ;
    rdfs:label "chemical entity" ;
    obo:IAO_0000115 "A chemical entity is a physical entity of interest in chemistry including molecular entities, parts thereof, and chemical substances." ;
    rdfs:subClassOf obo:BFO_0000040 .

obo:CHEBI_59999 a owl:Class ;
    rdfs:label "chemical substance" ;
    obo:IAO_0000115 "A chemical substance is a portion of matter of constant composition, composed of molecular entities of the same type or of different types." ;
    rdfs:comment "Frequently used for fluidic portions of matter and/or in the context of chemical reactions. Boundary to material not always sharp."@en ;
    rdfs:subClassOf obo:CHEBI_24431,
        pmd:PMD_0000001 .

obo:IAO_0000005 a owl:Class ;
    rdfs:label "objective specification"@en ;
    obo:IAO_0000112 "In the protocol of a ChIP assay the objective specification says to identify protein and DNA interaction."@en ;
    obo:IAO_0000115 "A directive information entity that describes an intended process endpoint. When part of a plan specification the concretization is realized in a planned process in which the bearer tries to effect the world so that the process endpoint is achieved."@en ;
    obo:IAO_0000116 "2009-03-16: original definition when imported from OBI read: \"objective is an non realizable information entity which can serve as that  proper part of a plan towards which the realization of the plan is directed.\""@en,
        "2014-03-31: In the example of usage (\"In the protocol of a ChIP assay the objective specification says to identify protein and DNA interaction\") there is a protocol which is the ChIP assay protocol. In addition to being concretized on paper, the protocol can be concretized as a realizable entity, such as a plan that inheres in a person. The objective specification is the part that says that some protein and DNA interactions are identified. This is a specification of a process endpoint: the boundary in the process before which they are not identified and after which they are. During the realization of the plan, the goal is to get to the point of having the interactions, and participants in the realization of the plan try to do that."@en,
        "Answers the question, why did you do this experiment?"@en ;
    obo:IAO_0000119 "OBI Plan and Planned Process/Roles Branch"@en,
        "OBI_0000217"@en ;
    rdfs:subClassOf obo:IAO_0000033 .

obo:IAO_0000102 a owl:Class ;
    rdfs:label "data about an ontology part"@en ;
    obo:IAO_0000115 "Data about an ontology part is a data item about a part of an ontology, for example a term"@en ;
    rdfs:subClassOf obo:IAO_0000027 .

obo:IAO_0000428 a owl:NamedIndividual ;
    rdfs:label "requires discussion"@en ;
    obo:IAO_0000115 "A term that is metadata complete, has been reviewed, and problems have been identified that require discussion before release. Such a term requires editor note(s) to identify the outstanding issues."@en ;
    obo:IAO_0000119 "group:OBI"@en .

obo:OBI_0000067 a owl:Class ;
    rdfs:label "evaluant role"@en ;
    obo:IAO_0000112 "When a specimen of blood is assayed for glucose concentration, the blood has the evaluant role. When measuring the mass of a mouse, the evaluant is the mouse. When measuring the time of DNA replication, the evaluant is the DNA. When measuring the intensity of light on a surface, the evaluant is the light source."@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000115 "a role that inheres in a material entity that is realized in an assay in which data is generated about the bearer of the evaluant role"@en ;
    obo:IAO_0000116 "Role call - 17nov-08: JF and MC think an evaluant role is always specified input of a process. Even in the case where we have an assay taking blood as evaluant and outputting blood, the blood is not the specified output at the end of the assay (the concentration of glucose in the blood is)"@en,
        "examples of features that could be described in an evaluant: quality.... e.g. \"contains 10 pg/ml IL2\", or \"no glucose detected\")"@en ;
    obo:IAO_0000117 "GROUP:  Role Branch" ;
    obo:IAO_0000119 "OBI" ;
    obo:IAO_0000232 "Feb 10, 2009.  changes after discussion at OBI Consortium Workshop Feb 2-6, 2009.  accepted as core term." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom obo:OBI_0000070 ;
            owl:onProperty obo:BFO_0000054 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom obo:BFO_0000040 ],
        obo:BFO_0000023 .

obo:RO_0000059 a owl:ObjectProperty ;
    rdfs:label "concretizes"@en ;
    obo:IAO_0000112 "A journal article is an information artifact that inheres in some number of printed journals. For each copy of the printed journal there is some quality that carries the journal article, such as a pattern of ink. The quality (a specifically dependent continuant) concretizes the journal article (a generically dependent continuant), and both depend on that copy of the printed journal (an independent continuant)."@en,
        "An investigator reads a protocol and forms a plan to carry out an assay. The plan is a realizable entity (a specifically dependent continuant) that concretizes the protocol (a generically dependent continuant), and both depend on the investigator (an independent continuant). The plan is then realized by the assay (a process)."@en ;
    obo:IAO_0000115 "A relationship between a specifically dependent continuant and a generically dependent continuant, in which the generically dependent continuant depends on some independent continuant in virtue of the fact that the specifically dependent continuant also depends on that same independent continuant. Multiple specifically dependent continuants can concretize the same generically dependent continuant."@en,
        "A relationship between a specifically dependent continuant or process and a generically dependent continuant, in which the generically dependent continuant depends on some independent continuant in virtue of the fact that the specifically dependent continuant or process also depends on that same independent continuant. Multiple specifically dependent continuants or processes can concretize the same generically dependent continuant."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( obo:BFO_0000015 obo:BFO_0000020 ) ] ;
    rdfs:range obo:BFO_0000031 .

obo:RO_0000079 a owl:ObjectProperty ;
    rdfs:label "function of"@en ;
    obo:IAO_0000112 "this catalysis function is a function of this enzyme"@en ;
    obo:IAO_0000115 "a relation between a function and an independent continuant (the bearer), in which the function specifically depends on the bearer for its existence"@en ;
    obo:IAO_0000116 "A function inheres in its bearer at all times for which the function exists, however the function need not be realized at all the times that the function exists."@en ;
    rdfs:comment "This relation is modeled after the BFO relation of the same name which was in BFO2, but is used in a more restricted sense - specifically, we model this relation as functional (inherited from characteristic-of). Note that this relation is now removed from BFO2020." ;
    rdfs:domain obo:BFO_0000034 ;
    rdfs:subPropertyOf obo:RO_0000052 ;
    owl:inverseOf obo:RO_0000085 .

obo:UO_0000045 a owl:Class ;
    rdfs:label "base unit" ;
    obo:IAO_0000115 "A unit which is one of a particular measure to which all measures of that type can be related." ;
    rdfs:subClassOf obo:IAO_0000003 ;
    noes:NOES_0000122 false .

obo:UO_0000190 a owl:Class ;
    rdfs:label "ratio unit" ;
    obo:IAO_0000115 "A dimensionless unit which denotes an amount or magnitude of one quantity relative to another." ;
    rdfs:subClassOf obo:IAO_0000003 ;
    noes:NOES_0000122 false .

obo:UO_1000008 a owl:Class ;
    rdfs:label "meter based unit" ;
    rdfs:subClassOf obo:IAO_0000003 ;
    noes:NOES_0000122 false .

pmd:PMD_0000054 a owl:Class ;
    rdfs:label "Heizfunktion"@de,
        "heating function"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000969 ;
    skos:definition "Eine Heizfunktion ist eine (realisierbare) Funktion, die ein System oder Gerät in die Lage versetzt, die Wärmeenergie eines Materials zu erhöhen, um die für die Verarbeitung, Umwandlung oder Reaktion erforderlichen Temperaturen zu erreichen."@de,
        "A temperature change function that, when realized, enables a system or device to increase the thermal energy of a material, typically to reach temperatures required for processing, transformation, or reaction."@en ;
    skos:example "The function of a resistance heater in a vacuum furnace."@en .

pmd:PMD_0000070 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "is state of"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    skos:definition "relates a temporally qualified continuant to the unique anchor continuant that it is a temporal phase of"@en .

pmd:PMD_0000550 a owl:Class ;
    rdfs:label "Stoffeigenschaft Ändern"@de,
        "changing properties of material"@en ;
    obo:IAO_0000119 "Offizielle Definition findet man in: DIN 8580:2003-9 Fertigungsverfahren, Seite 5, 3.1.6 Stoffeigenschaften ändern - Definition"@de,
        "Official definition can be found in: DIN 8580:2003-9 Fertigungsverfahren, Page 5, 3.1.6 Stoffeigenschaften ändern - Definition"@en ;
    rdfs:subClassOf pmd:PMD_0000833 ;
    skos:altLabel "Changing Of Material  Properties"@en,
        "Property Alteration"@en ;
    skos:definition "Ein Herstellungsprozess, der die Merkmale des Materials, aus dem ein Werkstück gefertigt ist, modifiziert, was unter anderem durch Vorgänge im submikroskopischen oder atomaren Bereich erfolgt, wie etwa durch Atomdiffusion, die Versetzungsentstehung und -bewegung im Atomgitter oder durch chemische Reaktionen, wobei die dabei auftretenden Formveränderungen nicht charakteristisch für diese Verfahren sind."@de,
        "A manufacturing process that modifies the characteristics of the material from which a workpiece is made, including by processes at the submicroscopic or atomic scale, such as atomic diffusion, dislocation formation and movement in the atomic lattice or chemical reactions, whereby the resulting shape changes are not characteristic of these processes."@en ;
    skos:example "Heat Treatment"@en .

pmd:PMD_0000779 a owl:Class ;
    rdfs:label "Wärmebehandlung"@de,
        "heat treatment"@en ;
    obo:IAO_0000119 "Offizielle Definition findet man in: DIN EN ISO 4885:2018 Wärmebehandlung Seite 21, 3.108 Wärmebehandlung - Definition"@de,
        "Official definition can be found in: DIN EN ISO 4885:2018 Wärmebehandlung Page 21, 3.108 Wärmebehandlung - Definition"@en ;
    rdfs:subClassOf pmd:PMD_0000550 ;
    skos:altLabel "Wärmebehandeln"@de ;
    skos:definition "Ein Stoffeigenschaft Ändern Prozess, bei dem durch eine Reihe von Verfahrensschritten ein festes (Eisen-)Produkt ganz oder teilweise bestimmten Zeit-Temperatur-Abfolgen ausgesetzt wird, mit dem Ziel, seine Eigenschaften und/oder seine innere Struktur zu modifizieren."@de,
        "A changing properties of material process in which a solid (ferrous) product is fully or partially exposed to specific time-temperature sequences through a series of process steps with the aim of modifying its properties and/or its internal structure."@en ;
    skos:example "Annealing, Ageing, Hardening"@en .

pmd:PMD_0000834 a owl:Class ;
    rdfs:label "map"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000502 ;
    skos:definition "A map is a 2D information content entity describing a representation of spatial data or relationships, often used in material science for visualizing properties or distributions."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000857 a owl:Class ;
    rdfs:label "microstructure"@en ;
    rdfs:comment "The focus of interest when looking at an object through the microstructure perspective is often its morphology."@en ;
    rdfs:subClassOf pmd:PMD_0000001 ;
    skos:definition "A microstructure is a portion of matter that represents the small-scale structure of a material, including grains, phases, and defects, visible under a microscope."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000885 a owl:Class ;
    rdfs:label "pole figure"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000834 [ a owl:Restriction ;
                        owl:onProperty obo:IAO_0000136 ;
                        owl:someValuesFrom pmd:PMD_0000853 ] ) ] ;
    skos:definition "A pole figure is a map depicting a 2D stereographic projection which represents crystallographic orientations of grains in a polycrystalline material in respect to the sample's reference frame."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000965 a owl:Class ;
    rdfs:label "Oberflächenschicht (Fiat-Objektteil)"@de,
        "surface layer (fiat object part)"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000027 obo:BFO_0000030 ) ] ;
            owl:onProperty obo:BFO_0000050 ],
        obo:BFO_0000024 ;
    skos:definition "Eine Oberflächenschicht (Fiat-Objektteil) ist ein Fiat-Objektteil, der nur Teil eines Objekts ist. Die Oberflächenschicht ist der dreidimensionale Bereich, der die äußerste Schicht eines Objekts definiert, wo Oberflächeninteraktionen mit anderen materiellen Einheiten stattfinden. Was als Oberfläche betrachtet wird, wird somit durch den Interaktionsprozess definiert."@de,
        "A surface layer (fiat object part) is a fiat object part that is part of only object. The surface layer is the three dimensional region defining the outermost layer of an object, where surface-interactions with other material entities occur. What is considered as the surface is thus defined by the interaction process."@en ;
    skos:example "When considering optical properties of a surface layer (fiat object part) of a polished piece of metal we likely consider a different three dimensional spatial region than when considering the scratch hardness properties of the same polished piece of metal."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0001014 a owl:Class ;
    rdfs:label "Röntgen Analyseverfahren"@de,
        "x-ray analyzing process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000957 ;
    skos:definition "Ein Struktur Eigenschaften Analyseverfahren, das Röntgenstrahlen verwendet, um die innere Struktur, Zusammensetzung und Eigenschaften von Materialien zu untersuchen, indem die Wechselwirkung der Röntgenstrahlen mit der Probe gemessen wird."@de,
        "A structural property analyzing process that uses X-rays to investigate the internal structure, composition, and properties of materials by measuring the interaction of X-rays with the sample."@en .

pmd:PMD_0020101 a owl:Class ;
    rdfs:label "Anteil"@de,
        "proportion"@en ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002328 ;
            owl:someValuesFrom obo:BFO_0000001 ],
        obo:BFO_0000145,
        pmd:PMD_0020353 ;
    skos:definition "A proportion is a relational quality between two entities (the whole and the part) which quantifies the relation between the whole and its part."@en .

pmd:PMD_0020142 a owl:Class ;
    rdfs:label "Energie"@de,
        "energy"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    obo:IAO_0000119 <http://openenergy-platform.org/ontology/oeo/OEO_00000150> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000024 obo:BFO_0000027 obo:BFO_0000030 ) ] ],
        obo:BFO_0000019,
        pmd:PMD_0020353 ;
    skos:definition "an extensive quality of material entities which manifests as a capacity to perform work (such as causing motion or the interaction of molecules)"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020228 a owl:Class ;
    rdfs:label "Lösungsmittelrolle"@de,
        "solvent role"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000081 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty obo:BFO_0000050 ;
                                owl:someValuesFrom pmd:PMD_0020229 ] ) ] ],
        pmd:PMD_0020259 ;
    skos:definition "Rolle einer Entität, die in einer Lösung in großer Konzentration vorhanden ist"@de,
        "role of an entity that is present in major concentration in a solution"@en .

pmd:PMD_0020254 a owl:Class ;
    rdfs:label "manufacturing property"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf pmd:PMD_0020265 ;
    skos:definition "a property that is commonly associated with the domain of manufacturing" .

pmd:PMD_0020289 a owl:Class ;
    rdfs:label "gas"@en ;
    rdfs:subClassOf pmd:PMD_0020287 ;
    skos:definition "a portion of matter in an gaseous aggregate state where the gas entities have no bonds"@en .

pmd:PMD_0020313 a owl:Class ;
    rdfs:label "thermodynamic property"@en ;
    rdfs:subClassOf pmd:PMD_0020265 ;
    skos:definition "a property that is commonly associated with the domain of thermodynamics"@en .

pmd:PMD_0020366 a owl:Class ;
    rdfs:label "per mass property"@en ;
    obo:IAO_0000116 "TODO axiom wrong"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002328 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000001 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000086 ;
                                owl:someValuesFrom pmd:PMD_0020133 ] ) ] ],
        pmd:PMD_0023001 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:RO_0002328 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000001 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000086 ;
                                owl:someValuesFrom pmd:PMD_0020133 ] ) ] ] ;
    skos:definition "a quotient where the denominator is the mass of the bearer"@en .

pmd:PMD_0023007 a owl:Class ;
    rdfs:label "an object aggregates property"@en ;
    rdfs:subClassOf pmd:PMD_0023003 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000052 ;
                        owl:someValuesFrom obo:BFO_0000027 ] [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025999 ;
                        owl:someValuesFrom obo:BFO_0000027 ] ) ] ;
    skos:definition "a 'property by bearer' that indicates that its bearer is an object aggregate"@en .

pmd:PMD_0023043 a owl:Class ;
    rdfs:label "fundamental quality of matter"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom pmd:PMD_0000001 ],
        obo:BFO_0000019,
        pmd:PMD_0023004 ;
    owl:disjointUnionOf ( pmd:PMD_0000597 pmd:PMD_0000896 pmd:PMD_0000967 ) ;
    skos:definition "a quality that is quality of every portion of matter"@en .

pmd:PMD_0025001 a owl:Class ;
    rdfs:label "Zusammensetzung"@de,
        "composition"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "There's a dfference between composition and chemical compositon for the following reason: chemical compositon is relevant when the mass/volume/mole proportions of chemical elements(!) are identified, whlist composition includes proportions of molecules, other pure chemical substances, or even proptions of objects (in an object aggregate)."@en ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0000001 [ a owl:Restriction ;
                                owl:onProperty obo:BFO_0000051 ;
                                owl:someValuesFrom pmd:PMD_0000001 ] ) ] ],
        obo:BFO_0000019,
        pmd:PMD_0020335,
        pmd:PMD_0023004 ;
    skos:definition "Zusammensetzung ist eine intensive Qualität, die Arten und Anteile von Verbindungen definiert, die in einer materiellen Einheit vorhanden sind, und Gegenstand einiger Zusammensetzungsdatenelemente ist."@de,
        "Composition is an intensive quality which defines types and proportions of compounds present in a material entity and is subject of some composition data item."@en ;
    skos:example "4 vol.% nitric acid solution, Styrene-Butadiene-Styrene (SBS) Block Copolymer with 50 vol.% of both styrene and butadiene"@en ;
    pmd:PMD_0000060 true ;
    pmd:PMD_0000064 "Composition is a collective property of a portion of matter, i.e., the triple portion of matter has quality composition holds. As \"has quality\" is an inverse  functional property, only one instance of portion of matter can have this specific composition. However, proportions describe the relation between the prortion of matter (the whole) and some compound (the part). Thus, the following triples hold: portion of matter has relational quality proportion; portion of matter has part some substance (or whatever is your part); substance has relational quality proportion. \"Has relational quality\" is not inverse functional, i.e., it can point to a single object from 2 distinct subjects."@en .

pmd:PMD_0025009 a owl:Class ;
    rdfs:label "materieller Reaktionsprozess"@de,
        "material reacting process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:comment "material reacting process has always energy minimization as a driving force."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000066 ;
            owl:someValuesFrom pmd:PMD_0000001 ],
        [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0001028 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000016 pmd:PMD_0000005 ) ] ],
        obo:BFO_0000015 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000015 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000066 ;
                        owl:someValuesFrom pmd:PMD_0000001 ] [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0001028 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( obo:BFO_0000016 pmd:PMD_0000005 ) ] ] ) ] ;
    skos:definition "Ein materieller Reaktionsprozess ist ein Prozess, der in einem Teil der Materie aufgrund einiger seiner Dispositionen oder Verhaltenseigenschaften stattfindet, die in einem stimulierenden Prozess umgesetzt werden. Sowohl der materielle Reaktionsprozess als auch der stimulierende Prozess müssen stattfindende Teile eines geplanten Prozesses sein, wenn der geplante Prozess stattfindet."@de,
        "Material reacting process is a process which occurs in a portion of matter due to some of its disposition or behavioral material property which has realization in some  stimulating process. Both the material reacting process and stimulating process must be occurent parts of a planned process, if the planned process takes place."@en .

pmd:PMD_0080029 a owl:Class ;
    rdfs:label "Dehnung"@de,
        "strain"@en ;
    obo:IAO_0000117 "PERSON: Thomas Hanke" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000052 ;
                        owl:someValuesFrom pmd:PMD_0000001 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002328 ;
                        owl:someValuesFrom pmd:PMD_0020132 ] ) ],
        pmd:PMD_0020311,
        pmd:PMD_0023004 ;
    skos:definition "Strain is defined as relative deformation, compared to a reference position configuration"@en ;
    skos:example "Under a tensile load, a polymer film exhibits a strain of 2 % before yielding"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0080069 a owl:Class ;
    rdfs:label "physisch relative Qualität"@de,
        "physical relational quality"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Necessary and sufficient conditions for 'physical relational quality' have not yet been formalized. The term is defined as a specific subtype of 'BFO_0000145'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
    obo:IAO_0000117 "PERSON: Thomas Hanke" ;
    rdfs:subClassOf obo:BFO_0000145,
        pmd:PMD_0020353 ;
    skos:definition "Die physische Beziehungsqualität bezieht sich auf Eigenschaften oder Merkmale einer Entität, die von ihrer Beziehung zu anderen Entitäten abhängig sind"@de,
        "Physical relational quality pertains to properties or characteristics of an entity dependent on its relation to other entities"@en ;
    skos:example "The coefficient of friction between two surfaces is a physical relational quality inhering in both contacting materials"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0080108 a owl:Class ;
    rdfs:label "Spannung"@de,
        "stress"@en ;
    obo:IAO_0000117 "PERSON: Thomas Hanke" ;
    rdfs:subClassOf _:N39dbc4f3b646420ab2e5c6512e0f1f9f,
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom pmd:PMD_0000001 ],
        _:Nd1fe915fd4fc45acac54dff15757523d,
        pmd:PMD_0020311,
        pmd:PMD_0023004 ;
    skos:definition "Stress is the internal force per unit area a material experiences under external load, commonly described in tensile, compressive, or shear forms"@en ;
    skos:example "A cross-section of a loaded steel column bears a compressive stress of 150 MPa"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0080116 a owl:Class ;
    rdfs:label "potential"@en ;
    obo:IAO_0000117 "Philipp von Hartrott" ;
    rdfs:comment "Every potential in physics is the same mathematical object — a partial derivative of energy with respect to its conjugate extensive quantity. The differences are only in which extensive quality you're considering."@en ;
    rdfs:subClassOf _:Nd0cc7ab70ae44c0c9b8588b17e6884f4,
        obo:BFO_0000019 ;
    skos:definition "a partial derivative of energy with respect to its conjugate extensive quantity"@en ;
    pmd:PMD_0000060 true .

cryo:CRYO_0000379 a owl:Class ;
    rdfs:label "cubic crystal lattice"@en ;
    rdfs:comment "TODO think if these classes are really needed???" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000086 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                owl:hasValue cryo:CRYO_0000035 ;
                                owl:onProperty pmd:PMD_0000077 ] ) ] ],
