AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000596> "deformation"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000596> "a process that changes the 'dimension quality' of a participant. It excludes translations and rotations."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0000596> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000596> <http://purl.obolibrary.org/obo/BFO_0000015>)
SubClassOf(Annotation(rdfs:comment "simple form: 
process and ('has participant' some 
