###  https://w3id.org/pmd/noes/NOES_0000130
noes:NOES_0000130 rdf:type owl:Class ;
                  rdfs:label "homogenization"@en ;
                  skos:altLabel "homogenizing"@en ;
                  skos:definition "Homogenization is a type of heat treatment which involves heating the metal to a very high temperature (just below its melting point) and holding it there for a long period of time."@en .


###  https://w3id.org/pmd/noes/NOES_0000132
noes:NOES_0000132 rdf:type owl:Class ;
                  rdfs:label "operating current"@en ;
                  skos:definition "operating current in is the electrical current (measured in milliamperes, mA) applied to the filament which controls the intensity of the beam (X-Ray, electron, etc)"@en .


###  https://w3id.org/pmd/noes/NOES_0000133
noes:NOES_0000133 rdf:type owl:Class ;
                  rdfs:label "number density"@en ;
                  skos:definition "number density is a proportion which presents the count of individual, countable items (such as atoms, molecules, charge carriers, etc.) contained within a specific unit of volume"@en .


###  https://w3id.org/pmd/noes/NOES_0000134
noes:NOES_0000134 rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty co:PMD_0025006 ;
                                    owl:someValuesFrom noes:NOES_0000023
                                  ] ;
                  rdfs:label "rolling speed"@en ;
                  skos:definition "rotational velocity and surface speed of the work rolls during rolling process"@en ;
                  skos:example "0.5 m/s" .


###  https://w3id.org/pmd/noes/NOES_0000135
noes:NOES_0000135 rdf:type owl:Class ;
                  rdfs:label "crystallite with rotated cube texture orientation"@en ;
                  skos:comment "Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference."@en ;
                  skos:definition "crystallite with rotated cube texture orientation is a crystallite whose family of <110> equivalent directions in a cubic lattice system are oriented approximately parallel to the rolling direction and family of {001} equivalent directions are oriented approximately parallel to the rolling plane."@en .


###  https://w3id.org/pmd/noes/NOES_0000136
noes:NOES_0000136 rdf:type owl:Class ;
                  rdfs:label "area proportion"@en ;
                  skos:definition "Area proportion is a proportion which quantifies the area of the part relative to the area of the whole."@en .


###  https://w3id.org/pmd/noes/NOES_0000137
noes:NOES_0000137 rdf:type owl:Class ;
                  rdfs:label "strip"@en ;
                  skos:definition "Strip is a semi-finished product of a rolled metal" .


###  https://w3id.org/pmd/noes/NOES_0000138
noes:NOES_0000138 rdf:type owl:Class ;
                  rdfs:label "crystallite with ideal γ-fiber texture orientation"@en .


