                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                        owl:hasValue cryo:CRYO_0000031 ;
                                                        owl:onProperty pmd:PMD_0000077 ] ) ] ] ) ] ) ] ;
    skos:definition "Crystallographic entity in orthorhombic system is an immaterial entity that either itself has orthorhombic lattice system or is a part of crystal lattice with orthorhombic lattice system."@en .

