    <!-- https://w3id.org/pmd/cryo/CRYO_0000122 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000122">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
