    <!-- https://w3id.org/pmd/co/PMD_0000077 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0000077">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/pmd/co/PMD_0000004"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">specified by value</rdfs:label>
        <skos:definition xml:lang="en">A relation between an entity and a value specification which is about this entity.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0025998 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0025998">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000145"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Kamilla Zaripova</obo:IAO_0000117>
        <rdfs:label xml:lang="en">has relational quality</rdfs:label>
        <rdfs:label xml:lang="de">hat relationale Qualität</rdfs:label>
        <skos:definition xml:lang="en">a relation between an independent continuant (the bearer) and a relational quality, in which the quality specifically depends on the bearer for its existence</skos:definition>
        <skos:definition xml:lang="de">eine Beziehung zwischen einem unabhängigen Kontinuum (dem Träger) und einer relationalen Qualität, bei der die Qualität in ihrer Existenz speziell vom Träger abhängt</skos:definition>
        <skos:example xml:lang="en">material has relational quality mass proportion m, and portion of iron has the same relational quality mass proportion m</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0025999 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0025999">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">The &apos;relational quality of&apos; is more strict that &apos;quality of&apos; from RO, since domain is &apos;relational quality&apos;. The motivtion to introduce an object property for relational qualities is the following:
RO&apos;s &apos;quality of&apos; is functional i.e., a-&gt;b, a-&gt;c =&gt; b=c. The functionality is relevant for most of the SDC -&gt; IC triples, expect for relational qualities, which per definiton can be simultaneously inherited in &gt;=2 ICs. Thus,  &apos;relational quality of&apos;  has the same intention to connect SDC to IC, however, without cardinality constraints.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Kamilla Zaripova</obo:IAO_0000117>
        <rdfs:label xml:lang="en">relational quality of</rdfs:label>
        <rdfs:label xml:lang="de">relationale Qualität von</rdfs:label>
        <skos:definition xml:lang="en">a relation between a relational quality and an independent continuant (the bearer), in which the quality specifically depends on the bearer for its existence</skos:definition>
        <skos:definition xml:lang="de">eine Beziehung zwischen einer relationalen Qualität und einem unabhängigen Kontinuum (dem Träger), bei der die Existenz der Qualität speziell vom Träger abhängt</skos:definition>
        <skos:example xml:lang="en">mass proportion m is relational qualitiy of material, and the same mass proportion m is relational qualitiy of portion of iron</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000050 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/cryo/CRYO_0000050">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000053"/>
        <rdfs:label xml:lang="en">is tetragonal</rdfs:label>
        <skos:definition xml:lang="en">is tetragonal is a object property  for the inference of family of directions/planes Miller indices notation under tetragonal symmetry. The class crystallographic entity in tetragonal system carries a Self restriction &quot;is tetragonal&quot;</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000053 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/cryo/CRYO_0000053">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment>DO NOT USE DIRECTLY
For taxonomy purpose only</rdfs:comment>
        <rdfs:label xml:lang="de">has symmetry</rdfs:label>
        <skos:definition xml:lang="en">has symmetry is a top-level object property which gathers other symmetry/lattice system-specific object properties for the inference of family of directions/planes Miller indices notation</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000054 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/cryo/CRYO_0000054">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000053"/>
        <rdfs:label xml:lang="de">is triclinic</rdfs:label>
        <skos:definition xml:lang="en">is triclinic is a object property  for the inference of family of directions/planes Miller indices notation under triclinic symmetry. The class crystallographic entity in triclinic system carries a Self restriction &quot;is triclinic&quot;</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000055 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/cryo/CRYO_0000055">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000053"/>
        <rdfs:label xml:lang="de">is monoclinic</rdfs:label>
        <skos:definition xml:lang="en">is monoclinic is a object property  for the inference of family of directions/planes Miller indices notation under monoclinic symmetry. The class crystallographic entity in monoclinic system carries a Self restriction &quot;is monoclinic&quot;</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000056 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/cryo/CRYO_0000056">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000053"/>
        <rdfs:label xml:lang="de">is orthorhombic</rdfs:label>
        <skos:definition xml:lang="en">is orthorhombic is a object property  for the inference of family of directions/planes Miller indices notation under orthorhombic symmetry. The class crystallographic entity in orthorhombic system carries a Self restriction &quot;is orthorhombic&quot;</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000057 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/cryo/CRYO_0000057">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000053"/>
        <rdfs:label xml:lang="de">is rhombohedral</rdfs:label>
        <skos:definition xml:lang="en">is rhombohedral is a object property  for the inference of family of directions/planes Miller indices notation under rhombohedral symmetry. The class crystallographic entity in rhombohedral system carries a Self restriction &quot;is rhombohedral&quot;</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000058 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/cryo/CRYO_0000058">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000053"/>
        <rdfs:label xml:lang="de">is hexagonal</rdfs:label>
        <skos:definition xml:lang="en">is hexagonal is a object property  for the inference of family of directions/planes Miller indices notation under hexagonal symmetry. The class crystallographic entity in hexagonal system carries a Self restriction &quot;is hexagonal&quot;</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000164 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/cryo/CRYO_0000164">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000021"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000023"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Intentially not a sub-property of &quot;denoted by&quot; as this rescticts using &quot;denoted by&quot; in property chains of its sub-properties</rdfs:comment>
        <rdfs:comment>The sub-properties are inferrable through corresponding property chains</rdfs:comment>
        <rdfs:label xml:lang="en">denoted by family</rdfs:label>
        <skos:definition xml:lang="en">denoted by family is a top-level object property between a crystallographic entity, i.e., plane or direction, and the family of Miller indices</skos:definition>
        <skos:example xml:lang="en">Consider a (011) crystallographic plane in cubic lattice, i.e., the instance of the plane is denoted by (011) instance. The instance of the plane is be inferred to be of type &quot;crystallographic entity in cubic system&quot; and carries &quot;is cubic&quot; reftexive triple. The (011) is a member of {110} family of Miller indices. The property chain &quot;is cubic + denoted by + member of&quot; will infer that the plane is denoted by {110} in a cubic lattice.</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000168 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/cryo/CRYO_0000168">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000164"/>
        <rdfs:domain rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000041"/>
        <rdfs:label>denoted by family under cubic symmetry</rdfs:label>
        <skos:definition xml:lang="en">denoted by family under cubic symmetry is an object property between a crystallographic entity in cubic system, i.e., plane or direction, and the family of Miller indices.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000170 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/cryo/CRYO_0000170">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000053"/>
        <rdfs:label>is cubic</rdfs:label>
        <skos:definition xml:lang="en">is cubic is a object property  for the inference of family of directions/planes Miller indices notation. The class crystallographic entity in cubic  system carries a Self restriction &quot;is cubic&quot;</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000052 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/noes/NOES_0000052">
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000145"/>
        <rdfs:label xml:lang="en">has simple relational quality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000066 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/noes/NOES_0000066">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:comment xml:lang="en">This object property is not intended to be used between intances.</rdfs:comment>
        <rdfs:label xml:lang="en">geometrically related</rdfs:label>
        <skos:definition xml:lang="en">Geometrically related is a top-level object property to describe geometrical relations between different spatial regions</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000067 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/noes/NOES_0000067">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000066"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label xml:lang="en">parallel to</rdfs:label>
        <skos:definition xml:lang="en">Parallel to is an object property which connect two or  more spatial regions that are parallel to each other</skos:definition>
        <skos:example xml:lang="en">normal direction (ND) of a rolled sheet is parallel to rolling plane RP.</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/noes/NOES_0000068 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/noes/NOES_0000068">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/pmd/noes/NOES_0000066"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:label xml:lang="en">normal to</rdfs:label>
        <skos:definition xml:lang="en">Normal to is a object property which describes geometric relation between two spatial regions which are normal to each other</skos:definition>
    </owl:ObjectProperty>
    


