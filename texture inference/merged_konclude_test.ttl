[] a owl:Axiom ;
    rdfs:comment """In field theories (e.g., gravity, electrostatics), the potential becomes a field ϕ(r⃗), and the force is recovered via:
F=−∇ϕ(r⃗)F
This is the spatial analogue: instead of asking "how does energy change per unit carrier added?", you ask "how does energy change per unit carrier moved in space?\""""@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource pmd:PMD_0080116 ;
    owl:annotatedTarget _:Nd0cc7ab70ae44c0c9b8588b17e6884f4 .

