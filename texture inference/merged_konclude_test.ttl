pmd:PMD_0020097 a owl:NamedIndividual ;
    rdfs:label "Austenit"@de,
        "OBSOLETE austenite"@en ;
    owl:deprecated true ;
    skos:definition "flächenzentrierte kubische Phase aus Eisen oder einer Legierung auf Eisenbasis, die oberhalb der Eutektoidtemperatur stabil ist und in der Lage ist, erhebliche Mengen Kohlenstoff in fester Lösung aufzulösen"@de,
        "face-centered cubic phase of iron or an iron-based alloy, stable above the eutectoid temperature and capable of dissolving significant amounts of carbon in solid solution"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020098 noes:NOES_0000122 false .

pmd:PMD_0020128 a owl:Class ;
    rdfs:label "thermodynamic system"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000053 ;
            owl:someValuesFrom pmd:PMD_0020313 ],
        obo:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000053 ;
                        owl:someValuesFrom pmd:PMD_0020313 ] ) ] ;
    skos:definition "A thermodynamic system is a material entity whose parts are bearer of thermodynamic properties. A thermodynamic system environs a thermodynamic process by which the thermodynamic properties of the objects of the thermodynamic system change over time."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020131 a owl:Class .

pmd:PMD_0020137 a owl:Class ;
    rdfs:label "stable phase"@en ;
    rdfs:comment "See metastable phase"@en ;
    rdfs:subClassOf pmd:PMD_0020000 ;
    owl:disjointWith pmd:PMD_0020149 ;
    skos:definition "A stable phase is a phase that does not have a \"pmd:disposition of a phase to transform\" in the \"pmd:phase transformation\" it participates."@en ;
    skos:example "A phase that participates in a phase transformation pt and pt that is not a metastable phase."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020143 a owl:Class ;
    rdfs:label "process chain"@en ;
    rdfs:subClassOf obo:BFO_0000015 ;
    skos:definition "A process chain is a process that 'has continuant part' subprocesses S1...Sn where S1...Sn precede each other and where some object or object aggregate that are output of Sn are then input to Sn+1."@en .

pmd:PMD_0020148 a owl:Class .

pmd:PMD_0020205 a owl:Class ;
    rdfs:label "Defektrolle"@de,
        "defect role"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000081 ;
            owl:someValuesFrom obo:BFO_0000001 ],
        obo:BFO_0000017,
        pmd:PMD_0020335 ;
    skos:definition "Eine Defektrolle ist eine Rolle eines unabhängigen Kontinuums C, die darauf hinweist, dass C die Fähigkeit einer materiellen Entität E, eine Funktion zu realisieren, beeinträchtigen kann. C ist fortlaufender Teil von E."@de,
        "A defect role is a role of an independent continuant C indicating that C may affect a material entity E's ability to realize a function. C is continuant part of E."@en ;
    skos:example "A crack in an structural member may affect its ability to carry a load."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020207 a owl:Class ;
    rdfs:label "Stoffmenge"@de,
        "amount of substance"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf pmd:PMD_0020103 ;
    skos:definition "Die Menge der Substanz n ist ein molarer Anteil, wenn das Ganze ein Objektaggregat N ist, das Avogadro-Anzahlobjekte (gleicher Art) als Teile hat (n = N/N_A)."@de,
        "Amount of substance n is a molar proportion when the whole is an object aggregate N, which has avogadro number objects (of same type) as parts (n = N/N_A)."@en .

pmd:PMD_0020210 a owl:Class ;
    rdfs:label "elemental crystal"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002351 ;
            owl:someValuesFrom pmd:PMD_0020140 ],
        pmd:PMD_0020003 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onClass pmd:PMD_0020140 ;
            owl:onProperty obo:RO_0002351 ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "a crystal that consists of exactly one atomic species"@en .

pmd:PMD_0020213 a owl:Class ;
    rdfs:label "grain boundary"@en ;
    obo:IAO_0000116 "the part of a grain that is close to the grain boundary and possibly characterized by disorder is a fiat object part (grain surface layer)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0020003 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0025998 ;
                                owl:someValuesFrom pmd:PMD_0020241 ] ) ] ;
            owl:onProperty obo:RO_0002350 ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0002350 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0020003 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0025998 ;
                                owl:someValuesFrom pmd:PMD_0020241 ] ) ] ],
        obo:BFO_0000146 ;
    skos:definition "A grain boundary is a fiat surface that separates adjacent grains in a polycrystalline material and is characterized by structural discontinuity."@en .

pmd:PMD_0020217 a owl:NamedIndividual,
        pmd:PMD_0020216 ;
    rdfs:label "DEPRECATED short range order"@en ;
    rdfs:comment "Use appropriate class from crystall ontology instead" ;
    owl:deprecated true ;
    skos:definition "DEPRECATED periodische Anordnung von Strukturmerkmalen bis hin zu wenigen Einheiten"@de,
        "DEPRECATED periodic arrangement of structural features up to a few entities"@en .

pmd:PMD_0020218 a owl:NamedIndividual,
        pmd:PMD_0020216 ;
    rdfs:label "DEPRECATED medium range order"@en ;
    rdfs:comment "Use appropriate class from crystall ontology instead" ;
    owl:deprecated true ;
    skos:definition "DEPRECATED periodische Anordnung struktureller Merkmale vieler Entitäten"@de,
        "DEPRECATED periodic arrangement of structural features of many entities"@en .

pmd:PMD_0020219 a owl:NamedIndividual,
        pmd:PMD_0020216 ;
    rdfs:label "DEPRECATED long range order"@en ;
    rdfs:comment "Use appropriate class from crystall ontology instead" ;
    owl:deprecated true ;
    skos:definition "DEPRECATED periodische Anordnung struktureller Merkmale praktisch aller Entitäten"@de,
        "DEPRECATED periodic arrangement of structural features of virtually all entities"@en .

pmd:PMD_0020231 a owl:Class ;
    rdfs:label "interstitital solid solution"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002351 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:CHEBI_60003 [ a owl:Restriction ;
                                owl:onProperty obo:BFO_0000051 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000001 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0001025 ;
                                                    owl:someValuesFrom pmd:PMD_0020198 ] ) ] ] [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000087 ;
                                owl:someValuesFrom pmd:PMD_0020227 ] ) ] ],
        pmd:PMD_0020230 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0020230 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002351 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:CHEBI_60003 [ a owl:Restriction ;
                                            owl:onProperty obo:BFO_0000051 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( obo:BFO_0000001 [ a owl:Restriction ;
                                                                owl:onProperty obo:RO_0001025 ;
                                                                owl:someValuesFrom pmd:PMD_0020198 ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000087 ;
                                            owl:someValuesFrom pmd:PMD_0020227 ] ) ] ] ) ] ;
    skos:definition "a solid solution whose solute entities are located in the interstitial sites"@en .

pmd:PMD_0020232 a owl:Class ;
    rdfs:label "substitutional solid solution"@en ;
    obo:IAO_0000116 "TODO: replace topObjectProperty with bfo:occupies spatial region"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002351 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:CHEBI_60003 [ a owl:Restriction ;
                                owl:onProperty obo:BFO_0000051 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000001 [ a owl:Restriction ;
                                                    owl:onProperty owl:topObjectProperty ;
                                                    owl:someValuesFrom pmd:PMD_0020197 ] ) ] ] [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000087 ;
                                owl:someValuesFrom pmd:PMD_0020227 ] ) ] ],
        pmd:PMD_0020230 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0020230 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002351 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:CHEBI_60003 [ a owl:Restriction ;
                                            owl:onProperty obo:BFO_0000051 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( obo:BFO_0000001 [ a owl:Restriction ;
                                                                owl:onProperty owl:topObjectProperty ;
                                                                owl:someValuesFrom pmd:PMD_0020197 ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000087 ;
                                            owl:someValuesFrom pmd:PMD_0020227 ] ) ] ] ) ] ;
    skos:definition "a solid solution whose solute entities occupy lattice points"@en .

pmd:PMD_0020242 a owl:NamedIndividual,
        pmd:PMD_0020216 ;
    rdfs:label "DEPRECATED no range order"@en ;
    rdfs:comment "Use appropriate class from crystall ontology instead" ;
    owl:deprecated true ;
    skos:definition "DEPRECATED keine periodische Anordnung struktureller Merkmale von Entitäten"@de,
        "DEPRECATED no periodic arrangement of structural features of entites"@en .

pmd:PMD_0020318 a owl:Class ;
    rdfs:label "intensive property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:CHEBI_59999 pmd:PMD_0000001 ) ] ],
        pmd:PMD_0023002 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002328 ;
                                owl:someValuesFrom pmd:PMD_0023000 ] ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000052 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( obo:CHEBI_59999 pmd:PMD_0000001 ) ] ] ) ] ;
    skos:definition "a facetted property that is characteristic of some portion of matter or chemical substance"@en .

pmd:PMD_0020370 a owl:Class ;
    rdfs:label "a mol of entites"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000086 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0020367 [ a owl:Restriction ;
                                owl:hasValue pmd:PMD_0020368 ;
                                owl:onProperty pmd:PMD_0000077 ] ) ] ],
        obo:BFO_0000027 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:RO_0000086 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0020367 [ a owl:Restriction ;
                                owl:hasValue pmd:PMD_0020368 ;
                                owl:onProperty pmd:PMD_0000077 ] ) ] ] ;
    skos:definition "an object aggregate which Avogadro-number coount members of same type"@en .

pmd:PMD_0023023 a owl:Class ;
    rdfs:label "fluid property"@en ;
    rdfs:subClassOf pmd:PMD_0023003 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000052 ;
                        owl:someValuesFrom pmd:PMD_0020113 ] [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025999 ;
                        owl:someValuesFrom pmd:PMD_0020113 ] ) ] ;
    skos:definition "a 'property by bearer' that indicates that its bearer is a fluid"@en .

pmd:PMD_0023036 a owl:Class ;
    rdfs:label "averaged property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002328 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty obo:RO_0000052 ;
                    owl:someValuesFrom [ a owl:Class ;
                            owl:intersectionOf ( obo:BFO_0000027 [ a owl:Restriction ;
                                        owl:onProperty obo:BFO_0000051 ;
                                        owl:someValuesFrom [ a owl:Class ;
                                                owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                            owl:onProperty obo:RO_0000053 ;
                                                            owl:someValuesFrom [ a owl:Class ;
                                                                    owl:intersectionOf ( [ a owl:Class ;
                                                                                owl:unionOf ( obo:BFO_0000017 obo:BFO_0000019 ) ] [ a owl:Restriction ;
                                                                                owl:onProperty pmd:PMD_0000077 ;
                                                                                owl:someValuesFrom obo:OBI_0001931 ] ) ] ] ) ] ] [ a owl:Restriction ;
                                        owl:onProperty obo:RO_0000086 ;
                                        owl:someValuesFrom pmd:PMD_0020367 ] ) ] ] ],
        pmd:PMD_0023035 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:RO_0002328 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty obo:RO_0000052 ;
                    owl:someValuesFrom [ a owl:Class ;
                            owl:intersectionOf ( obo:BFO_0000027 [ a owl:Restriction ;
                                        owl:onProperty obo:BFO_0000051 ;
                                        owl:someValuesFrom [ a owl:Class ;
                                                owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                            owl:onProperty obo:RO_0000053 ;
                                                            owl:someValuesFrom [ a owl:Class ;
                                                                    owl:intersectionOf ( [ a owl:Class ;
                                                                                owl:unionOf ( obo:BFO_0000017 obo:BFO_0000019 ) ] [ a owl:Restriction ;
                                                                                owl:onProperty pmd:PMD_0000077 ;
                                                                                owl:someValuesFrom obo:OBI_0001931 ] ) ] ] ) ] ] [ a owl:Restriction ;
                                        owl:onProperty obo:RO_0000086 ;
                                        owl:someValuesFrom pmd:PMD_0020367 ] ) ] ] ] ;
    skos:definition "an aggregated property that expresses an average of a property value of the members of an object aggregate"@en ;
    skos:example "mean diameter of grains of a polychrystaline material"@en .

pmd:PMD_0025002 a owl:Class ;
    rdfs:label "Datenelement zur chemischen Zusammensetzung"@de,
        "chemical composition data item"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0020004 [ a owl:Restriction ;
                        owl:onProperty obo:IAO_0000136 ;
                        owl:someValuesFrom pmd:PMD_0000551 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002351 ;
                        owl:someValuesFrom pmd:PMD_0025997 ] ) ] ;
    skos:altLabel "chemical composition specification"@en ;
    skos:definition "Bei einem Datenelement zur chemischen Zusammensetzung handelt es sich um eine Informationsinhaltseinheit, die sich auf die Zusammensetzung eines Stoffteils bezieht. Es verfügt über Bruchwertspezifikationen für Mitglieder, die Werte für Anteile von Anteilen (reiner) chemischer Elemente angeben, die Teile des Anteils der Materie sind."@de,
        "Chemical composition data item is an information content entity that is about composition of a portion of matter. It has members fraction value specifications which specifiy values of propotions of portions of (pure) chemical elements, which are parts of the portion of matter."@en ;
    skos:example "Steel has quality chemical composition , and the chemical composition data item is about the chemical composition .The chemical composition data item has members fraction specifications of iron and carbon. These fraction specifications specify value of portion of iron and portion of carbon respectively. Furthermore, these fraction specifications specify  values of relational qualities (mass) proportion of iron and (mass) proportion of carbon."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0025008 a owl:Class ;
    rdfs:label "Transmissionselektronenmikroskop"@de,
        "transmission electron microscope"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf pmd:PMD_0000624 ;
    skos:definition "Ein Elektronenmikroskop, das hochauflösende Bilder der inneren Struktur einer Probe erzeugt, indem es Elektronen durch die Probe strahlt."@de,
        "An electron microscope that produces high-resolution images of a sample's internal structure by transmitting electrons through the sample."@en ;
    pmd:PMD_0050117 "TEM" .

pmd:PMD_0025015 a owl:Class ;
    rdfs:label "portion of lanthanum"@en ;
    rdfs:comment "'portion of pure chemical element' and 'has part' only CHEBI:33336"@en ;
    rdfs:subClassOf pmd:PMD_0020140 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0020140 [ a owl:Restriction ;
                        owl:allValuesFrom obo:CHEBI_33336 ;
                        owl:onProperty obo:BFO_0000051 ] ) ] ;
    skos:definition "A portion of lanthanum is a portion of pure element that has parts only chebi:lanthanum atom."@en .

pmd:PMD_0025016 a owl:Class ;
    rdfs:label "Innendurchmesser"@de,
        "inner diameter"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf pmd:PMD_0050051 ;
    skos:definition "Der Innendurchmesser ist die Länge einer geraden Linie von einer Innenfläche eines Objekts oder Raums zur anderen Seite seiner Innenfläche durch den Mittelpunkt eines Objekts oder Raums, wenn es eine Innen- und Außenfläche hat."@de,
        "Inner diameter is a length of a straight line from one inner surface of an object or space to the other side of its inner surface through the center of an object or space when it has the inside and outside surface."@en .

pmd:PMD_0025017 a owl:Class ;
    rdfs:label "Außendurchmesser"@de,
        "outer diameter"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf pmd:PMD_0050051 ;
    skos:definition "Der Außendurchmesser ist die Länge einer geraden Linie von einer Außenfläche eines Objekts oder Raums zur anderen Seite seiner Außenfläche durch den Mittelpunkt eines Objekts oder Raums, wenn es eine Innen- und Außenfläche hat."@de,
        "Outer diameter is a length of a straight line from one outer surface of an object or space to the other side of its outer surface through the center of an object or space when it has the inside and outside surface."@en .

pmd:PMD_0025022 a owl:Class ;
    rdfs:label "cooling rate"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom pmd:PMD_0000967 ;
                        owl:onProperty pmd:PMD_0020127 ] [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0025011 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000057 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( [ a owl:Class ;
                                                                owl:unionOf ( obo:BFO_0000040 pmd:PMD_0000068 ) ] [ a owl:Restriction ;
                                                                owl:onProperty obo:RO_0000086 ;
                                                                owl:someValuesFrom pmd:PMD_0000967 ] ) ] ] ) ] ;
                        owl:onProperty pmd:PMD_0025006 ] ) ],
        pmd:PMD_0025019 ;
    skos:definition "Cooling rate is a process attribute which describes the descreate of temperature of some of the participant in a process over time."@en ;
    skos:example "10 K/s"@en .

pmd:PMD_0025023 a owl:Class ;
    rdfs:label "heating rate"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom pmd:PMD_0000967 ;
                        owl:onProperty pmd:PMD_0020127 ] [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0025010 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000057 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( [ a owl:Class ;
                                                                owl:unionOf ( obo:BFO_0000040 pmd:PMD_0000068 ) ] [ a owl:Restriction ;
                                                                owl:onProperty obo:RO_0000086 ;
                                                                owl:someValuesFrom pmd:PMD_0000967 ] ) ] ] ) ] ;
                        owl:onProperty pmd:PMD_0025006 ] ) ],
        pmd:PMD_0025019 ;
    skos:definition "Heating rate is a process attribute which describes the increare of temperature of some of the participant in a process over time"@en ;
    skos:example "1000 K/s"@en .

pmd:PMD_0025028 a owl:Class ;
    rdfs:label "smelting"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:OBI_0000299 ;
                        owl:someValuesFrom pmd:PMD_0020166 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000057 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000087 ;
                                owl:someValuesFrom pmd:PMD_0025029 ] ] ) ],
        pmd:PMD_0000833 ;
    skos:definition "smelting is a manufacturing process which utilizes chemical reducing agent to remove non-metalic elements from the ore and has heat as a specified output"@en .

pmd:PMD_0050117 a owl:AnnotationProperty ;
    rdfs:label "abbreviation"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Markus Schilling" ;
    skos:definition "A textual annotation used to specify a commonly accepted abbreviation, acronym, or shortened form of a class label. This property is intended to support concise referencing of ontology classes, especially when standard abbreviations are widely used in practice."@en ;
    skos:example "\"DNA\" for \"Deoxyribonucleic Acid\""@en .

pmd:PMD_0050157 a owl:Class ;
    rdfs:label "3D Geometrie"@de,
        "shape 3d"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Markus Schilling" ;
    rdfs:subClassOf pmd:PMD_0050156 ;
    skos:definition "Eine 3D Geometrie ist eine geometrische Form, die in drei Dimensionen existiert, mit Länge, Breite und Höhe, und die durch ihre räumlichen Eigenschaften wie Volumen und Oberfläche definiert werden kann."@de,
        "A shape 3D is a geometry shape that exists in three dimensions, having length, width, and height, and can be defined by its spatial properties such as volume and surface area."@en ;
    skos:example "Beispiele sind Formen wie Würfel, Kugeln und Pyramiden."@de,
        "Examples include shapes like cubes, spheres, and pyramids."@en .

pmd:PMD_0060007 a owl:Class ;
    rdfs:label "material specification"@en ;
    rdfs:subClassOf obo:IAO_0000033 ;
    skos:definition "A directive information entity that defines the composition, properties, performance criteria, and acceptable standards for a material, guiding its selection, processing, and application in a specific context."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0060009 a owl:Class ;
    rdfs:label "specification datum"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Hossein Beygi Nasrabadi" ;
    rdfs:comment "The intent of the specification datum is to express the \"Sollwert\" of some qualitiy or behavioral material property. Then, the specification datum can be further specified by  some value specification."@en ;
    rdfs:subClassOf obo:IAO_0000033 ;
    skos:definition "A directive information entity that provides information of a setpoint of some value, i.e., it is an intended value."@en ;
    skos:example "The setpoint value of a ultimate tensile strength of some steel material"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0080100 a owl:Class ;
    rdfs:label "Massenanteil"@de,
        "mass fraction"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Necessary and sufficient conditions for 'mass fraction' have not yet been formalized. The term is defined as a specific subtype of 'mass ratio'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Massenanteil."@en ;
    obo:IAO_0000117 "PERSON: Thomas Hanke" ;
    obo:IAO_0000119 <https://de.wikipedia.org/wiki/Massenanteil> ;
    rdfs:subClassOf pmd:PMD_0020102 ;
    skos:definition "Der Massenanteil beschreibt den relativen Anteil einer Masse an der Gesamtmasse einer Mischung, ein gängiges quantitatives Maß"@de,
        "mass ratio that describes the relative proportion of a mass to the total mass of a mixture, a common quantitative measure"@en ;
    skos:example "A binary Al-4 wt% Cu alloy has a copper mass fraction of 0.04"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0080104 a owl:Class ;
    rdfs:label "Volumenanteil"@de,
        "volume fraction"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Necessary and sufficient conditions for 'volume fraction' have not yet been formalized. The term is defined as a specific subtype of 'volume ratio'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Volumenkonzentration."@en ;
    obo:IAO_0000117 "PERSON: Thomas Hanke" ;
    obo:IAO_0000119 <https://de.wikipedia.org/wiki/Volumenkonzentration> ;
    rdfs:subClassOf pmd:PMD_0020104 ;
    skos:definition "Volumenanteil beschreibt das Volumen eines Mischbestandteils im Verhältnis zur Summe der Volumina aller Bestandteile"@de,
        "Volume fraction describes the volume of a mixture component relative to the sum of all components' volumes"@en ;
    skos:example "A dual-phase steel contains a martensite volume fraction of 20 %, controlling its strength-ductility balance"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0080120 a owl:Class ;
    rdfs:label "magnetische Suszeptibilität"@de,
        "magnetic susceptibility"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Necessary and sufficient conditions for 'magnetic susceptibility' have not yet been formalized. Although χ = M/H is a well-defined ratio, a formal equivalence axiom would incorrectly classify any dimensionless relational quality of a magnetic bearer as magnetic susceptibility. Defined as a primitive subtype of 'physical relational quality'."@en ;
    obo:IAO_0000117 "PERSON: Thomas Hanke" ;
    rdfs:subClassOf pmd:PMD_0020353 ;
    skos:altLabel "χ"@en ;
    skos:definition "Magnetische Suszeptibilität ist eine physikalische relationale Qualität eines Materials, die den Grad angibt, in dem es sich als Reaktion auf ein angelegtes Magnetfeld magnetisiert, ausgedrückt als dimensionsloses Verhältnis der Magnetisierung zur angelegten Feldstärke"@de,
        "Magnetic susceptibility is a physical relational quality of a material that quantifies the degree to which it becomes magnetized in response to an applied magnetic field, expressed as the dimensionless ratio of magnetization to applied field intensity"@en ;
    skos:example "Paramagnetic oxygen gas has a positive magnetic susceptibility of 3.73e-6 m3/mol at 20 C"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0080128 a owl:Class ;
    rdfs:label "elektrischer Widerstand"@de,
        "electrical resistance"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Necessary and sufficient conditions for 'electrical resistance' have not yet been formalized. The term is defined as a specific subtype of 'electrical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://www.britannica.com/technology/resistance-electronics."@en ;
    obo:IAO_0000117 "PERSON: Thomas Hanke" ;
    obo:IAO_0000119 <https://www.britannica.com/technology/resistance-electronics> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom obo:BFO_0000030 ],
        obo:BFO_0000019,
        pmd:PMD_0020312,
        pmd:PMD_0020317 ;
    skos:definition "Der elektrische Widerstand bezieht sich auf die Fähigkeit eines Stromkreises, elektrische Energie in Wärmeenergie umzuwandeln, indem er elektrischem Strom durch Teilchenkollisionen entgegenwirkt, die für Widerstände, Lampen und Drähte charakteristisch sind"@de,
        "Electrical resistance pertains to a circuit's capability to transform electric energy into heat energy, opposing electric current through particle collisions, characteristic of resistors, lamps, and wires"@en ;
    skos:example "A nichrome heating element has an electrical resistance of 10 Ω at room temperature"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0080172 a owl:Class ;
    rdfs:label "untere Streckgrenze"@de,
        "lower yield strength"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Necessary and sufficient conditions for 'lower yield strength' have not yet been formalized. The term is defined as a specific subtype of 'yield strength'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Yield_(engineering)."@en ;
    obo:IAO_0000117 "PERSON: Thomas Hanke" ;
    obo:IAO_0000119 <https://en.wikipedia.org/wiki/Yield_(engineering)> ;
    rdfs:subClassOf pmd:PMD_0080171 ;
    skos:altLabel "untere Fließspannung"@de,
        "lower yield stress"@en ;
    skos:definition "Untere Streckgrenze beschreibt die Spannung, bei der ein Material nach dem anfänglichen Fließen plastisches Verhalten zeigt"@de,
        "Lower yield strength defines the stress at which a material exhibits plastic behavior after initial yielding"@en ;
    skos:example "The lower yield strength of mild steel is approximately 235 MPa, defining the onset of stable plastic flow"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0080173 a owl:Class ;
    rdfs:label "obere Streckgrenze"@de,
        "upper yield strength"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Necessary and sufficient conditions for 'upper yield strength' have not yet been formalized. The term is defined as a specific subtype of 'yield strength'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Yield_(engineering)."@en ;
    obo:IAO_0000117 "PERSON: Thomas Hanke" ;
    obo:IAO_0000119 <https://en.wikipedia.org/wiki/Yield_(engineering)> ;
    rdfs:subClassOf pmd:PMD_0080171 ;
    skos:altLabel "obere Fließspannung"@de,
        "upper yield stress"@en ;
    skos:definition "Obere Streckgrenze charakterisiert die maximale Spannung, die vor dem plastischen Fließen eines Materials angewendet werden kann"@de,
        "Upper yield strength characterizes the maximum stress that can be applied before a material begins to yield plastically"@en ;
    skos:example "Mild steel exhibits an upper yield strength of about 300 MPa, followed by a yield drop to the lower yield point"@en ;
    pmd:PMD_0000060 true .

pmd:definitionSource a owl:AnnotationProperty .

pmd:symbol a owl:AnnotationProperty .

cryo:CRYO_0000024 a owl:Class ;
    rdfs:label "point coordinate datum"@en ;
    rdfs:comment "Current decision is not to import 'cartesian spatial coordinate datum' (http://purl.obolibrary.org/obo/IAO_0000400) cause it denotes spatial regions, and we model lattice points and atoms in voids as sites."@en ;
    rdfs:subClassOf obo:IAO_0000027 ;
    skos:definition "Point coordinate datum define the coordinates of a point within a conventional unit cell of a crystal. Point Miller indices must be given in round brackets separated by commas, e.g., (x, y, z)."@en ;
    skos:example "(1,1,1)" .

cryo:CRYO_0000026 a owl:Class ;
    rdfs:label "crystal system"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass cryo:CRYO_0000028 ;
            owl:onProperty pmd:PMD_0000077 ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom pmd:PMD_0020003 ],
        [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0000077 ;
            owl:someValuesFrom cryo:CRYO_0000028 ],
        obo:BFO_0000019,
        pmd:PMD_0020317 ;
    skos:definition "Crystal system is a quality of a (real) crystal which defines its symmetry based on the rotational and mirror symmetries of the actual atomic arrangements."@en .

