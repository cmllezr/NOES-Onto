    rdfs:label "Megapascal",
        "Megapascal"@cs,
        "Megapascal"@de,
        "Megapascal"@en,
        "Megapascal"@es,
        "Megapascal"@fr,
        "Megapascal"@hu,
        "Megapascal"@it,
        "Megapascal"@ms,
        "Megapaskal"@pl,
        "Megapascal"@ro,
        "Megapascal"@sl,
        "Megapascal"@tr ;
    dcterms:description "1,000,000-fold of the derived unit pascal"^^rdf:HTML ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA215"^^xsd:anyURI ;
    qudt:plainTextDescription "1,000,000-fold of the derived unit pascal" ;
    qudt:symbol "MPa" ;
    qudt:wikidataMatch <http://www.wikidata.org/entity/Q21062777> ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/N-PER-M2> a obo:IAO_0000003,
        owl:NamedIndividual ;
    rdfs:label "Newton per Square Metre",
        "Нютон на Квадратен Метър"@bg,
        "Newton na Čtvereční Metr"@cs,
        "Newton pro Quadratmeter"@de,
        "Νιούτον ανά Τετραγωνικό Μέτρο"@el,
        "Newton per Square Metre"@en,
        "Newton per Square Meter"@en-us,
        "Newton por Metro Cuadrado"@es,
        "Newton par Mètre Carré"@fr,
        "Newton per Metro Quadrato"@it,
        "Newtonium per Metrum Quadratum"@la,
        "Newton per Meter Persegi"@ms,
        "Niuton na Metr Kwadratowy"@pl,
        "Newton por Metro Quadrado"@pt,
        "Newton pe Metru Pătrat"@ro,
        "Ньютон на Квадратный Метр"@ru,
        "Newton na Kvadratni Meter"@sl,
        "Newton per Metrekare"@tr ;
    dcterms:description """The SI unit of pressure. The pascal is the standard pressure unit in the MKS metric system, equal to one
    newton per square meter or one "kilogram per meter per second per second." The unit is named for Blaise Pascal (1623-1662),
    French philosopher and mathematician, who was the first person to use a barometer to measure differences in altitude.
  """^^rdf:HTML ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA247"^^xsd:anyURI,
        "https://en.wikipedia.org/wiki/Pascal?oldid=492989202"^^xsd:anyURI ;
    qudt:symbol "N/m²" ;
    qudt:wikidataMatch <http://www.wikidata.org/entity/Q39469927> ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/PERCENT> a obo:IAO_0000003,
        owl:NamedIndividual ;
    rdfs:label "Percent",
        "Percent"@en ;
    dcterms:description "\"Percent\" is a unit for  'Dimensionless Ratio' expressed as $\\%$."^^qudt:LatexString ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA000"^^xsd:anyURI,
        "https://en.wikipedia.org/wiki/Percentage?oldid=495284540"^^xsd:anyURI ;
    qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/percent> ;
    qudt:symbol "%" ;
    qudt:wikidataMatch <http://www.wikidata.org/entity/Q11229> ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/W-PER-KiloGM> a obo:IAO_0000003,
        owl:NamedIndividual ;
    rdfs:label "Watt per Kilogram",
        "Ват на Килограм"@bg,
        "Watt na Kilogram"@cs,
        "Watt pro Kilogramm"@de,
        "Βατ ανά Χιλιόγραμμο"@el,
        "Watt per Kilogram"@en,
        "Vatio por Kilogramo"@es,
        "Watt par Kilogramme"@fr,
        "Watt per Chilogrammo"@it,
        "Wattium per Chiliogramma"@la,
        "Watt per Kilogram"@ms,
        "Wat na Kilogram"@pl,
        "Watt por Quilograma"@pt,
        "Watt pe Kilogram"@ro,
        "Ватт на Килограмм"@ru,
        "Watt na Kilogram"@sl,
        "Watt per Kilogram"@tr ;
    dcterms:description "SI derived unit watt divided by the SI base unit kilogram"^^rdf:HTML ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA316"^^xsd:anyURI ;
    qudt:plainTextDescription "SI derived unit watt divided by the SI base unit kilogram" ;
    qudt:symbol "W/kg" ;
    qudt:wikidataMatch <http://www.wikidata.org/entity/Q67060736> ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit> .

doap:repository a owl:AnnotationProperty .

oboInOwl:hasDbXref a owl:AnnotationProperty .

oboInOwl:hasExactSynonym a owl:AnnotationProperty .

rdf:HTML a rdfs:Datatype .

rdfs:Literal a rdfs:Datatype .

xsd:date a rdfs:Datatype .

skos:altLabel a owl:AnnotationProperty .

skos:comment a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:example a owl:AnnotationProperty .

pmd:PMD_0000002 a owl:Class ;
    rdfs:label "engineered material"@en ;
    rdfs:comment "We recognize that some of the materials in the subclasses also occur naturally. However, these are not within the scope of our consideration for technical use."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:OBI_0000312 ;
            owl:someValuesFrom pmd:PMD_0000833 ],
        pmd:PMD_0000000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000000 [ a owl:Restriction ;
                        owl:onProperty obo:OBI_0000312 ;
                        owl:someValuesFrom pmd:PMD_0000833 ] ) ] ;
    skos:definition "material that is output of a manufacturing process"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000006 a owl:DatatypeProperty ;
    rdfs:label "has value"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:domain obo:IAO_0000030 ;
    skos:definition "data property that relates an information content entity to a literal"@en .

pmd:PMD_0000053 a owl:Class ;
    rdfs:label "Schmelzprozess"@de,
        "melting process"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000547 [ a owl:Restriction ;
                        owl:onProperty obo:OBI_0000293 ;
                        owl:someValuesFrom obo:BFO_0000040 ] [ a owl:Restriction ;
                        owl:onProperty obo:OBI_0000299 ;
                        owl:someValuesFrom pmd:PMD_0020139 ] ) ],
        obo:COB_0000035 ;
    skos:definition "Ein Schmelzvorgang ist ein thermisch induzierter Prozess, bei dem ein festes Material einen Phasenübergang in einen flüssigen Zustand erfährt. Er beinhaltet die Absorption von Wärme und findet bei oder oberhalb des Schmelzpunkts des Materials statt."@de,
        "a thermally induced change of aggregate state during which a solid material undergoes a phase transition into a liquid state. It involves the absorption of heat and occurs at or above the material's melting point."@en ;
    skos:example "The process of melting aluminum ingots in preparation for extrusion."@en .

pmd:PMD_0000056 a owl:Class ;
    rdfs:label "Schmelzofen"@de,
        "melting furnace"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:comment "An electric arc furnace used in steelmaking."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000655 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000085 ;
                        owl:someValuesFrom pmd:PMD_0000057 ] ) ],
        pmd:PMD_0000780 ;
    skos:definition "Ein Schmelzofen ist ein Gerät, das eine Schmelzfunktion hat und in der Regel dazu dient, die Temperatur eines festen Materials zu erhöhen, um seine Umwandlung in eine Schmelze einzuleiten und aufrechtzuerhalten."@de,
        "A melting furnace is a device that bears a melting function, typically designed to raise the temperature of a solid material to initiate and sustain its transformation into a melt."@en .

pmd:PMD_0000060 a owl:AnnotationProperty ;
    rdfs:label "isInMinimalProfile"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:comment "Indicates whether the ontology element is part of the minimal profile of the ontology. Useful for modularization, simplified views, or lightweight implementations."@en ;
    pmd:PMD_0001032 "https://github.com/materialdigital/core-ontology/issues/121" .

pmd:PMD_0000064 a owl:AnnotationProperty ;
    rdfs:label "pattern example"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:comment "An editor note referring to a pattern which shows the usage of this class or property."@en .

pmd:PMD_0000069 a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has state"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:domain [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000002 [ a owl:Class ;
                        owl:complementOf pmd:PMD_0000068 ] ) ] ;
    rdfs:range pmd:PMD_0000068 ;
    owl:inverseOf pmd:PMD_0000070 ;
    skos:definition "relates an anchor continuant to a temporally qualified continuant that represents a specific temporal phase of its existence."@en ;
    pmd:PMD_0001032 "https://github.com/materialdigital/core-ontology/issues/185" .

pmd:PMD_0000075 a owl:Class ;
    rdfs:label "mould"@en,
        "mold"@en-us ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000602 ;
    skos:definition "A device consisting of a hollowed-out cavity that shapes fluid or plastic material into a specific form through the process of solidification or cooling."@en .

pmd:PMD_0000503 a owl:Class ;
    rdfs:label "ASTM-Korngröße"@de,
        "OBSOLETE ASTM grainsize"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "TODO: axiom needs refinement"@en ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    owl:deprecated true ;
    skos:definition "Die ASTM-Korngröße ist eine Qualität, die durch ein Verfahren gemessen wird, das dem ASTM-Standard folgt."@de,
        "The ASTM grain size is a quality that is measured through a process that follows the ASTM standard."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000522 a owl:Class ;
    rdfs:label "mechanischer Prozess"@de,
        "mechanical process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf obo:BFO_0000015 ;
    skos:definition "ist ein Prozess, bei dem Kräfte, Momente oder auferlegte Verschiebungen auf Objekte oder Objektaggregate und/oder das Äquivalent (Spannungen, Dehnungen) auf Materialien oder Teile der Materie auftreten"@de,
        "is a process in which forces, moments, or imposed displacements to objects or object aggregates occur and/or the equivalent (stresses, strains) to materials or portions of matter"@en .

pmd:PMD_0000544 a owl:Class ;
    rdfs:label "Messschieber"@de,
        "caliper"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    obo:IAO_0000119 "https://www.merriam-webster.com/dictionary/caliper"@en ;
    rdfs:subClassOf pmd:PMD_0000602 ;
    skos:definition "Messgerät mit zwei in der Regel verstellbaren Armen, Schenkeln oder Klemmbacken, das vor allem zur Messung der Abmessungen von Gegenständen, wie z. B. des Durchmessers oder der Dicke, verwendet wird"@de,
        "A measuring device having two usually adjustable arms, legs, or jaws used especially to measure the dimensions of objects, such as diameters or thicknesses"@en .

pmd:PMD_0000560 a owl:Class ;
    rdfs:label "Reinigen"@de,
        "cleaning"@en ;
    obo:IAO_0000119 "Offizielle Definition findet man in: DIN 8592"@de,
        "Official definition can be found in: DIN 8592"@en ;
    rdfs:subClassOf pmd:PMD_0000927 ;
    skos:definition "Ein Trennprozess, bei dem unerwünschtes Material von einer Oberfläche durch Reinigungsmethoden entfernt wird, die Verfahren wie Strahlen, Waschen oder chemische Reinigung umfassen können."@de,
        "A separating process that involves removing unwanted material from a surface through cleaning methods, which may include processes like blasting, washing, or chemical cleaning."@en ;
    skos:example "Chemical Cleaning, Mechanical Cleaning"@en .

pmd:PMD_0000595 a owl:Class ;
    rdfs:label "Defektdichte"@de,
        "defect density"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0020353 ;
    skos:definition "eine intensive Qualität, die die Anzahl der Defekte pro Volumen- oder Flächeneinheit in einem Material beschreibt, die sich auf seine mechanischen und elektronischen Eigenschaften auswirken können"@de,
        "an intensive quality describing the number of defects per unit volume or area in a material, which can affect its mechanical and electronic properties"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000604 a owl:Class ;
    rdfs:label "Dielektrizitätskonstante"@de,
        "dielectric constant"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom pmd:PMD_0000000 ],
        obo:BFO_0000019,
        pmd:PMD_0020312,
        pmd:PMD_0023004 ;
    skos:definition "Die Dielektrizitätskonstante ist eine elektrische Eigenschaft, die ein Maß für die Fähigkeit eines Materials darstellt, elektrische Energie in einem elektrischen Feld zu speichern."@de,
        "The dielectric constant is an electrical property representing a measure of a material's ability to store electrical energy in an electric field."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000611 a owl:Class ;
    rdfs:label "Dimensions Messprozess"@de,
        "dimension measuring process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009006 ;
            owl:someValuesFrom pmd:PMD_0020132 ],
        pmd:PMD_0000957 ;
    skos:definition "Ein Struktur Eigenschaften Analyseverfahren, das die physikalischen Dimensionen eines Materials oder Objekts, wie Länge, Breite, Höhe, Durchmesser und Dicke, mit hoher Genauigkeit und Präzision bestimmt."@de,
        "A structural property analyzing process that determines the physical dimensions of a material or object, such as length, width, height, diameter, and thickness, with high accuracy and precision."@en .

pmd:PMD_0000614 a owl:Class ;
    rdfs:label "Zerteilen"@de,
        "dividing"@en ;
    obo:IAO_0000119 "Offizielle Definition findet man in: DIN 8588"@de,
        "Official definition can be found in: DIN 8588"@en ;
    rdfs:subClassOf pmd:PMD_0000927 ;
    skos:definition "Ein Trennprozess, bei dem das Material durch Techniken wie Scherschneiden, Spalten, Reißen oder Brechen in verschiedene Teile zerlegt wird. Es wird in der Regel bei Prozessen eingesetzt, bei denen eine genaue Kontrolle über den Schnitt weniger wichtig ist."@de,
        "A separating process that involves separating material into distinct parts using techniques like shear cutting, splitting, tearing, or breaking, typically employed in processes where precise control over the cut is less critical."@en ;
    skos:example "Shearing, Cracking"@en .

pmd:PMD_0000618 a owl:Class ;
    rdfs:label "Elastizitätsmodul"@de,
        "elastic modulus"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom pmd:PMD_0000000 ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002328 ;
                        owl:someValuesFrom pmd:PMD_0020331 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002328 ;
                        owl:someValuesFrom pmd:PMD_0080034 ] ) ],
        pmd:PMD_0020311,
        pmd:PMD_0023004 ;
    skos:definition "represents a material's stiffness to loading in the normal direction, defined as the ratio of stress to strain in the elastic deformation region."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000620 a owl:Class ;
    rdfs:label "elektrische Leitfähigkeit"@de,
        "electrical conductivity"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000092 ;
            owl:someValuesFrom pmd:PMD_0000000 ],
        pmd:PMD_0020312,
        pmd:PMD_0023004 ;
    skos:definition "Die elektrische Leitfähigkeit ist eine elektrische Eigenschaft, die die Fähigkeit eines Materials beschreibt, elektrischen Strom zu leiten, beeinflusst von seiner Struktur und Zusammensetzung."@de,
        "The electrical conductivity is an electrical property describing the ability of a material to conduct electric current, influenced by its structure and composition."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000638 a owl:Class ;
    rdfs:label "Ermüdungsprüfverfahren"@de,
        "fatigue testing process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000117 ;
            owl:someValuesFrom pmd:PMD_0025020 ],
        pmd:PMD_0000849 ;
    skos:altLabel "S-N testing process"@en,
        "fatigue testing series"@en ;
    skos:definition "Ein Mechanische Eigenschaften Analyseverfahren, das die Fähigkeit eines Materials bewertet, zyklischen Belastungen standzuhalten, und seine Ermüdungslebensdauer und -grenze bestimmt."@de,
        "Fatigue testing process is a  mechanical property analyzing process that assesses a material's ability to withstand cyclic loading, determining its fatigue life and endurance limit. It must have occurent parts single fatigue tests."@en ;
    skos:example "Fatigue testing of metal components in bridges to predict their lifespan under repetitive loading conditions."@en .

pmd:PMD_0000654 a owl:Class ;
    rdfs:label "functional material"@en ;
    obo:IAO_0000116 "Classified by the role in a system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000085 ;
                                owl:someValuesFrom obo:BFO_0000034 ] ) ] ],
        pmd:PMD_0000000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000000 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000050 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000085 ;
                                            owl:someValuesFrom obo:BFO_0000034 ] ) ] ] ) ] ;
    skos:definition "A functional material F is a material which has the function to be used for an object O (O consists of F) and O's function is other/more than mechanical load carrying."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000667 a owl:Class ;
    rdfs:label "Schleifmaschine"@de,
        "grinding machine"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000648 ;
    skos:definition "Eine Schleifmaschine ist eine Formmaschine, die ein Schleifrad verwendet, um Material von der Oberfläche eines Werkstücks zu entfernen, typischerweise für Feinarbeiten oder Präzisionsarbeiten."@de,
        "A grinding machine is a forming machine that uses an abrasive wheel to remove material from the surface of a workpiece, typically for finishing or precision work."@en .

pmd:PMD_0000772 a owl:Class ;
    rdfs:label "Verfestigen Durch Umformen"@de,
        "hardening by forming"@en ;
    rdfs:subClassOf pmd:PMD_0000550 ;
    skos:definition "Ein Stoffeigenschaft Ändern Prozess, der die Eigenschaften des Materials durch mechanische Verformung verändert."@de,
        "A changing properties of material process, that involves altering material properties by mechanical deformation."@en ;
    skos:example "Sheet Metal Rolling to Achieve Higher Strength."@en .

pmd:PMD_0000776 a owl:Class ;
    rdfs:label "Härteprüfverfahren"@de,
        "hardness testing process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000849 ;
    skos:definition "Ein Mechanische Eigenschaften Analyseverfahren, das den Widerstand eines Materials gegen Verformung misst und typischerweise Eindringverfahren verwendet, um die Härte zu bestimmen."@de,
        "A mechanical property analyzing process that measures a material's resistance to deformation, typically using indentation methods to determine hardness."@en ;
    skos:example "Hardness testing of steel using the Rockwell method to classify its grade for industrial applications."@en .

pmd:PMD_0000791 a owl:Class ;
    rdfs:label "Induktionsofen"@de,
        "induction furnace"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000655 ;
    skos:definition "Ein Induktionsofen ist ein Ofen, der Materialien durch elektromagnetische Induktion erhitzt, wobei die Wärme direkt im Material erzeugt wird."@de,
        "An induction furnace is a furnace that heats materials using electromagnetic induction, generating heat directly within the material."@en .

pmd:PMD_0000819 a owl:Class ;
    rdfs:label "Lichtmikroskopie"@de,
        "light microscopy"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000875 ;
    skos:definition "Ein optisches Mikroskopieverfahren, das sichtbares Licht und Linsen verwendet, um Proben zu vergrößern und zu visualisieren, wodurch die Untersuchung der Mikrostruktur und Morphologie von Materialien ermöglicht wird."@de,
        "An optical microscopy process that uses visible light and lenses to magnify and visualize specimens, enabling the study of the microstructure and morphology of materials."@en ;
    skos:example "An example of a light microscopy process is Confocal Laser Scanning Microscopy, which uses laser light to scan specimens and create high-resolution, three-dimensional images. Another example is Fluorescence Microscopy, which uses fluorescent dyes to label specific components of the specimen, allowing for the visualization of structures that are otherwise difficult to see. A third example is Polarized Light Microscopy, which utilizes polarized light to enhance contrast in samples with birefringent properties, such as crystalline materials."@en .

pmd:PMD_0000822 a owl:Class ;
    rdfs:label "Spanen Mit Geometrisch Bestimmten Schneiden"@de,
        "machining geometrically defined"@en ;
    obo:IAO_0000119 "Offizielle Definition findet man in: DIN 8589-0"@de,
        "Official definition can be found in: DIN 8589-0"@en ;
    rdfs:subClassOf pmd:PMD_0000927 ;
    skos:definition "Ein Trennprozess, bei dem Material mit einem Werkzeug mit definierter Form und scharfen Kanten entfernt wird, wie z. B. beim Sägen und Bohren."@de,
        "A separating process that involves removing material with a tool that has a defined shape and sharp edges, such as in sawing and drilling operations."@en ;
    skos:example "Drilling, Turning"@en .

pmd:PMD_0000823 a owl:Class ;
    rdfs:label "Spanen Mit Geometrisch Unbestimmten Schneiden"@de,
        "machining geometrically undefined"@en ;
    obo:IAO_0000119 "Offizielle Definition findet man in: DIN 8589-0"@de,
        "Official definition can be found in: DIN 8589-0"@en ;
    rdfs:subClassOf pmd:PMD_0000927 ;
    skos:definition "Ein Trennprozess, bei dem Material mit Werkzeugen mit undefinierten Schneiden abgetragen wird, wie z. B. beim Schleifen oder bei der abrasiven Bearbeitung, bei der die genaue Form des zu schneidenden Teils nicht klar definiert ist."@de,
        "A separating process that involves removing material using tools with undefined cutting edges, such as grinding or abrasive machining, where the exact shape of the cutting part isn't clearly defined."@en ;
    skos:example "Grinding, Blasting"@en .

pmd:PMD_0000825 a owl:Class ;
    rdfs:label "DEPRECATED magnetische Eigenschaft"@de,
        "DEPRECATED magnetic property"@en ;
    rdfs:seeAlso pmd:PMD_0020312 ;
    owl:deprecated true ;
    skos:definition "DEPRECATED Eine magnetische Eigenschaft ist eine Materialeigenschaft, die Eigenschaften darstellt, die beschreiben, wie ein Material auf Magnetfelder reagiert, wie z. B. Permeabilität und Koerzitivfeldstärke."@de,
        "DEPRECATED A magnetic property is a material property representing characteristics that describe how a material responds to magnetic fields, such as permeability and coercivity."@en .

pmd:PMD_0000828 a owl:Class ;
    rdfs:label "Magnetisierungsfunktion"@de,
        "magnetizing function"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom pmd:PMD_0000826 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000079 ;
            owl:someValuesFrom pmd:PMD_0000827 ],
        obo:BFO_0000034,
        pmd:PMD_0020317,
        pmd:PMD_0020353 ;
    skos:definition "Eine Funktion, die durchgeführt wird, um ein Magnetfeld in Materialien zu induzieren, um deren magnetische Eigenschaften zu verändern."@de,
        "A function performed to induce a magnetic field in materials to modify their magnetic properties."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000874 a owl:Class ;
    rdfs:label "Optisches Mikroskop"@de,
        "optical microscope"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000855 ;
    skos:definition "Ein Mikroskop, das sichtbares Licht und Linsen verwendet, um kleine Objekte oder Details zu vergrößern und zu betrachten."@de,
        "A microscope that uses visible light and lenses to magnify and view small objects or details."@en .

pmd:PMD_0000886 a owl:Class ;
    rdfs:label "Poliermaschine"@de,
        "polishing machine"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000648 ;
    skos:definition "Eine Poliermaschine ist eine Formmaschine, die die Oberfläche eines Materials durch Reiben mit einem Werkzeug, Schleifmittel oder Chemikalien glättet."@de,
        "A polishing machine is a forming machine that smooths the surface of a material by rubbing it with a tool, abrasive, or chemical."@en .

pmd:PMD_0000914 a owl:Class ;
    rdfs:label "Abtragen"@de,
        "removing"@en ;
    obo:IAO_0000119 "Offizielle Definition findet man in: DIN 8590"@de,
        "Official definition can be found in: DIN 8590"@en ;
    rdfs:subClassOf pmd:PMD_0000927 ;
    skos:definition "Ein Trennprozess, bei dem Material durch thermische, chemische und elektrochemische Methoden abgetragen wird."@de,
        "A separating process that involves removing material through thermal, chemical and electrochemical methods."@en ;
    skos:example "Electrical Discharge Machining, Thermal Ablation"@en .

pmd:PMD_0000922 a owl:Class ;
    rdfs:label "Rasterelektronenmikroskop"@de,
        "scanning electron microscope"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000624 ;
    skos:definition "Ein Rasterelektronenmikroskop (REM) ist ein Messgerät, das hochauflösende Bilder einer Probenoberfläche erzeugt, indem es sie mit einem fokussierten Elektronenstrahl abtastet."@de,
        "A scanning electron microscope (SEM) is a measuring device that produces high-resolution images of a sample surface by scanning it with a focused beam of electrons."@en .

pmd:PMD_0000933 a owl:Class ;
    rdfs:label "Simulationsprozess"@de,
        "simulation process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000583 ;
    skos:definition "Ein Datenverarbeitungsprozess, der das Verhalten eines Systems im Laufe der Zeit mit mathematischen oder rechnerischen Techniken modelliert"@de,
        "A computing process that models the behavior of a system over time using mathematical or computational techniques."@en .

pmd:PMD_0000946 a owl:Class ;
    rdfs:label "spectrum"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000501 ;
    owl:disjointWith pmd:PMD_0000992 ;
    skos:definition "A spectrum is a 1-D information content entity that describes the range of wavelengths or frequencies of a physical property, often used in reference to light, sound, or electromagnetic radiation."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000950 a owl:Class ;
    rdfs:label "DEPRECATED anregender Prozess"@de,
        "DEPRECATED stimulating process"@en ;
    rdfs:comment "Might come back later with appropriate axioms" ;
    owl:deprecated true ;
    skos:definition "DEPRECATED Der Stimulationsprozess ist ein Prozess, der die Anwendung eines äußeren Einflusses wie Kraft, Wärme oder Strahlung beschreibt, um die materielle Reaktion zu untersuchen."@de,
        "DEPRECATED The stimulating process is a process describing the application of an external influence, such as force, heat, or radiation, to study material response."@en .

pmd:PMD_0000978 a owl:Class ;
    rdfs:label "Wärmeleitfähigkeit"@de,
        "thermal conductivity"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0020353 ;
    skos:definition "Die Wärmeleitfähigkeit ist eine thermische Eigenschaft, die die Fähigkeit eines Materials beschreibt, Wärme zu leiten."@de,
        "The thermal conductivity is a thermal property describing the ability of a material to conduct heat."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000997 a owl:Class ;
    rdfs:label "Ultraschallreiniger"@de,
        "ultrasonic cleaner"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000561 ;
    skos:definition "Ein Gerät, das Ultraschall und ein Reinigungsmittel verwendet, um empfindliche oder komplexe Gegenstände zu reinigen."@de,
        "A device that uses ultrasound and a cleaning solvent to clean delicate or complex items."@en .

pmd:PMD_0001016 a owl:Class ;
    rdfs:label "Beugungsprozess"@de,
        "x-ray diffraction process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009006 ;
            owl:someValuesFrom pmd:PMD_0000591 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0009006 ;
            owl:someValuesFrom pmd:PMD_0000853 ],
        pmd:PMD_0001014 ;
    skos:definition "Ein Röntgenanalyseverfahren, das die Wechselwirkung von Röntgenstrahlen mit der kristallinen Struktur eines Materials umfasst."@de,
        "An X-ray analyzing process, that involves the interaction of X-rays with the crystalline structure of a material."@en ;
    skos:example "XRD is used to e.g. determine the crystal structure of newly synthesized compounds to determine the crystal lattice arrangement."@en ;
    pmd:PMD_0050117 "XRD"@en .

pmd:PMD_0001017 a owl:Class ;
    rdfs:label "Röntgen-Mapping"@de,
        "x-ray mapping"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009006 ;
            owl:someValuesFrom pmd:PMD_0000551 ],
        pmd:PMD_0001014 ;
    skos:definition "Ein Röntgenanalyseverfahren, das eine räumliche Verteilungskarte der Elemente innerhalb einer Probe erstellt, indem die Probe mit einem Elektronen- oder Röntgenstrahl abgetastet und die emittierten Röntgenstrahlen detektiert werden, wodurch detaillierte Zusammensetzungsinformationen über die Oberfläche der Probe geliefert werden."@de,
        "An X-ray analyzing process, that generates a spatial distribution map of the elements within a specimen by scanning the sample with an electron or X-ray beam and detecting the emitted X-rays, providing detailed compositional information across the sample's surface."@en ;
    skos:example "An example of an X-ray Mapping process is X-ray Absorption Spectroscopy, X-ray Fluorescence, or X-ray Photoelectron Spectroscopy."@en .

pmd:PMD_0001018 a owl:Class ;
    rdfs:label "Röntgen-Mikroanalyse"@de,
        "x-ray microanalysis"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009006 ;
            owl:someValuesFrom pmd:PMD_0000551 ],
        pmd:PMD_0001014 ;
    skos:definition "Ein Röntgenanalyseverfahren, das die elementare Zusammensetzung und chemischen Eigenschaften einer Probe bestimmt, indem die charakteristischen Röntgenstrahlen detektiert und analysiert werden, die von der Probe emittiert werden, wenn sie mit einem fokussierten Elektronenstrahl bestrahlt wird."@de,
        "An X-ray analyzing process that determines the elemental composition and chemical properties of a specimen by detecting and analyzing the characteristic X-rays emitted from the sample when it is irradiated with a focused electron beam."@en ;
    skos:example "An example for X-ray Microanalysis process is Energy Dispersive X-ray Spectroscopy."@en .

pmd:PMD_0001019 a owl:Class ;
    rdfs:label "Röntgenspektroskopie"@de,
        "x-ray spectroscopy"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000945 ;
    skos:definition "Ein Spektroskopie Verfahren, das die Wechselwirkung von Röntgenstrahlen mit Materie analysiert, um die Zusammensetzung und Struktur des Materials zu bestimmen."@de,
        "A spectroscopy process, that analyzes the interaction of X-rays with matter to determine the material's composition and structure."@en ;
    skos:example "Examples are e.g. X-ray absorption spectroscopy, X-ray emission spectroscopy, and X-ray reflection spectroscopy."@en .

pmd:PMD_0001020 a owl:Class ;
    rdfs:label "Röntgenbeugungsgerät"@de,
        "x-ray diffractometer"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000602 ;
    skos:definition "Ein Röntgenbeugungsgerät ist ein Messgerät, das die Kristallstruktur von Materialien durch Analyse der Beugungsmuster von durch eine Probe geleiteten Röntgenstrahlen bestimmt."@de,
        "An X-Ray diffractometer is a measuring device that determines the crystal structure of materials by analyzing the diffraction patterns of X-rays passed through a sample."@en .

pmd:PMD_0001026 a owl:ObjectProperty ;
    rdfs:label "entspricht"@de,
        "complies with"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:domain obo:BFO_0000004 ;
    rdfs:range obo:IAO_0000030 ;
    rdfs:subPropertyOf pmd:PMD_0000004 ;
    skos:definition "complies with is a relation between an independent continuant and an information content entity (e.g., specification or objective) that it conforms to."@en .

pmd:PMD_0001032 a owl:AnnotationProperty ;
    rdfs:label "term tracker annotation"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000115 "A term tracker annotation is an editor note used to track the history of an entity. For each change, it records the related GitHub issue and pull request."@en ;
    obo:IAO_0000116 "hijacked from http://openenergy-platform.org/ontology/oeo/OEO_00020426"@en ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" .

