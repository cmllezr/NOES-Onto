PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX ex: <http://example.org/noes/> 
PREFIX noes: <https://w3id.org/pmd/noes/> 
PREFIX obo: <http://purl.obolibrary.org/obo/> 
PREFIX pmd: <https://w3id.org/pmd/co/> 
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> 
PREFIX tto: <https://w3id.org/pmd/tto/> 
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?material  ?portion ?numeral ?unitLabel
WHERE {
    # 1. Find all instances of specific material class
    ?material rdf:type noes:NOES_0000180 . #NOES
    
    # 2. Material --> has part --> portion of chemical element
    ?material obo:BFO_0000051 ?portion .
	?portion rdf:type pmd:PMD_0020140 . # portion of pure chemical element
    
	# 3. portion of chemical element --> has relational quality --> fraction
	?portion pmd:PMD_0025998 ?fraction .
	?fraction rdf:type pmd:PMD_0020101 . #proportion

    # 4. fraction --> specified by value --> value
    ?fraction pmd:PMD_0000077 ?value .
    
    # 4. value --> numeric valu and unit
    ?value obo:OBI_0001937 ?numeral ; 
    	obo:IAO_0000039 ?unit .
    ?unit rdfs:label ?unitLabel .
}
ORDER BY ?numeral