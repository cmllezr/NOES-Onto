        <skos:definition xml:lang="en">a a &apos;property by bearer&apos; that indicates its bearer is an interface</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020317 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020317">
