                  rdfs:label "Stanzen"@de ,
                             "stamping"@en ;
                  skos:definition "Stamping is a separating process, a stamping press is a participant and it realizes some cutting function."@en .


###  https://w3id.org/pmd/noes/NOES_0000117
noes:NOES_0000117 rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:RO_0000085 ;
                                    owl:someValuesFrom [ owl:intersectionOf ( noes:NOES_0000118
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty obo:BFO_0000054 ;
                                                                                owl:someValuesFrom noes:NOES_0000023
                                                                              ]
                                                                            ) ;
                                                         rdf:type owl:Class
                                                       ]
                                  ] ;
                  rdfs:label "rolling mill"@en ;
                  skos:definition "Rolling mill is device which is a participant in a rolling process, has a function of reducing thickness of an object that is specified input to the rolling process, and this function is realized in the rolling process."@en .


###  https://w3id.org/pmd/noes/NOES_0000118
noes:NOES_0000118 rdf:type owl:Class ;
                  rdfs:label "thickness reduction function"@en ;
                  skos:definition "Thickness reduction function is a function to reduce thickness of a material."@en .


###  https://w3id.org/pmd/noes/NOES_0000119
noes:NOES_0000119 rdf:type owl:Class ;
                  rdfs:subClassOf [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
