                                                    owl:intersectionOf ( :NOES_0000094 [ a owl:Restriction ;
                                                                owl:onProperty ns1:RO_0001025 ;
                                                                owl:someValuesFrom ns2:PMD_0000000 ] ) ] ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0001015 ;
                        owl:someValuesFrom [ a owl:Class ;
