PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ex: <http://example.org/>
prefix pmd: <https://w3id.org/pmd/co/>
prefix noes: <https://w3id.org/pmd/noes/>
prefix obo: <http://purl.obolibrary.org/obo/>
prefix cryo: <https://w3id.org/pmd/cryo/>

# Extracts, from the full crystallite ABox, only the subgraph that is
# actually relevant to texture classification: crystallites that have at
# least one misorientation-angle relational quality (obo:RO_0000086 /area
# triples are deliberately left out -- HermiT never needs them, and they're
# the majority of the ABox by individual count), plus the misorientation
# angle's scalar value specification and the ideal-texture individual it
# points at (needed so HermiT can see the PMD_0025999 someValuesFrom
# <IDEAL_X> restriction is satisfied).
#
# One (grain, ideal texture) pair per solution row -- CONSTRUCT unions the
# triples from every row, so a grain with angles to several ideal textures
# keeps all of them, not just one.

CONSTRUCT {
	?grain a pmd:PMD_0000663 ;
		pmd:PMD_0025998 ?miso .

	?miso a noes:NOES_0000141 ;
		pmd:PMD_0000077 ?svs ;
		pmd:PMD_0025999 ?ideal .

	?svs a obo:OBI_0001931 ;
		obo:IAO_0000039 obo:UO_0000185 ;
		obo:OBI_0001937 ?angle .

	?ideal a ?idealClass .
}
WHERE {
	?grain a pmd:PMD_0000663 ;
		pmd:PMD_0025998 ?miso .

	?miso a noes:NOES_0000141 ;
		pmd:PMD_0000077 ?svs ;
		pmd:PMD_0025999 ?ideal .

	?svs a obo:OBI_0001931 ;
		obo:IAO_0000039 obo:UO_0000185 ;
		obo:OBI_0001937 ?angle .

	?ideal a ?idealClass .
}
