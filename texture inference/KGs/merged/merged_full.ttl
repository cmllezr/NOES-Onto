<http://qudt.org/vocab/unit/MegaPA> a ns1:IAO_0000003,
        owl:NamedIndividual ;
    rdfs:label "Megapascal",
        "Megapascal"@cs,
        "Megapascal"@de,
        "Megapascal"@en,
        "Megapascal"@es,
        "Megapascal"@fr,
        "Megapascal"@hu,
        "Megapascal"@it,
        "Megapascal"@ms,
        "Megapaskal"@pl,
        "Megapascal"@ro,
        "Megapascal"@sl,
        "Megapascal"@tr ;
    dcterms:description "1,000,000-fold of the derived unit pascal"^^rdf:HTML ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA215"^^xsd:anyURI ;
    qudt:plainTextDescription "1,000,000-fold of the derived unit pascal" ;
    qudt:symbol "MPa" ;
    qudt:wikidataMatch <http://www.wikidata.org/entity/Q21062777> ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/N-PER-M2> a ns1:IAO_0000003,
        owl:NamedIndividual ;
    rdfs:label "Newton per Square Metre",
        "Нютон на Квадратен Метър"@bg,
        "Newton na Čtvereční Metr"@cs,
        "Newton pro Quadratmeter"@de,
        "Νιούτον ανά Τετραγωνικό Μέτρο"@el,
        "Newton per Square Metre"@en,
        "Newton per Square Meter"@en-us,
        "Newton por Metro Cuadrado"@es,
        "Newton par Mètre Carré"@fr,
        "Newton per Metro Quadrato"@it,
        "Newtonium per Metrum Quadratum"@la,
        "Newton per Meter Persegi"@ms,
        "Niuton na Metr Kwadratowy"@pl,
        "Newton por Metro Quadrado"@pt,
        "Newton pe Metru Pătrat"@ro,
        "Ньютон на Квадратный Метр"@ru,
        "Newton na Kvadratni Meter"@sl,
        "Newton per Metrekare"@tr ;
    dcterms:description """The SI unit of pressure. The pascal is the standard pressure unit in the MKS metric system, equal to one
    newton per square meter or one "kilogram per meter per second per second." The unit is named for Blaise Pascal (1623-1662),
    French philosopher and mathematician, who was the first person to use a barometer to measure differences in altitude.
  """^^rdf:HTML ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA247"^^xsd:anyURI,
        "https://en.wikipedia.org/wiki/Pascal?oldid=492989202"^^xsd:anyURI ;
    qudt:symbol "N/m²" ;
    qudt:wikidataMatch <http://www.wikidata.org/entity/Q39469927> ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/PERCENT> a ns1:IAO_0000003,
        owl:NamedIndividual ;
    rdfs:label "Percent",
        "Percent"@en ;
    dcterms:description "\"Percent\" is a unit for  'Dimensionless Ratio' expressed as $\\%$."^^qudt:LatexString ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA000"^^xsd:anyURI,
        "https://en.wikipedia.org/wiki/Percentage?oldid=495284540"^^xsd:anyURI ;
    qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/percent> ;
    qudt:symbol "%" ;
    qudt:wikidataMatch <http://www.wikidata.org/entity/Q11229> ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/W-PER-KiloGM> a ns1:IAO_0000003,
        owl:NamedIndividual ;
    rdfs:label "Watt per Kilogram",
        "Ват на Килограм"@bg,
        "Watt na Kilogram"@cs,
        "Watt pro Kilogramm"@de,
        "Βατ ανά Χιλιόγραμμο"@el,
        "Watt per Kilogram"@en,
        "Vatio por Kilogramo"@es,
        "Watt par Kilogramme"@fr,
        "Watt per Chilogrammo"@it,
        "Wattium per Chiliogramma"@la,
        "Watt per Kilogram"@ms,
        "Wat na Kilogram"@pl,
        "Watt por Quilograma"@pt,
        "Watt pe Kilogram"@ro,
        "Ватт на Килограмм"@ru,
        "Watt na Kilogram"@sl,
