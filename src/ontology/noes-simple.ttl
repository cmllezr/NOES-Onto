                  skos:definition "Percentage plastic extension at fracture in the transversal direction is percentage elongation at fracture which is measured on a sample cut parallel the transversal direction."@en ;
                  noes:NOES_0000122 "false"^^xsd:boolean .


###  https://w3id.org/pmd/noes/NOES_0000125
noes:NOES_0000125 rdf:type owl:Class ;
                  rdfs:label "inclusion role"@en ;
                  skos:definition "Inclusion role is a role of object aggregate which is a part of microstructure of an alloy: These object aggregates are second-phase particles embedded in the alloy matrix, and are thermodynamically distinct from the matrix."@en .


###  https://w3id.org/pmd/noes/NOES_0000126
noes:NOES_0000126 rdf:type owl:Class ;
                  rdfs:subClassOf noes:NOES_0000125 ;
                  rdfs:comment """Curation status: need more sophisticated axioms to detect metallic / non-metallic type. 
Will be inferable in the future"""@en ;
                  rdfs:label "metallic inclusion role"@en ;
                  skos:definition "Matallic inclusion role is a inclusion role of some object aggregate, which members have metallic bond."@en .


###  https://w3id.org/pmd/noes/NOES_0000127
noes:NOES_0000127 rdf:type owl:Class ;
                  rdfs:subClassOf noes:NOES_0000125 ;
                  rdfs:comment """Curation status: need more sophisticated axioms to detect metallic / non-metallic type. 
Will be inferable in the future"""@en ;
                  rdfs:label "non-metallic inclusion role"@en ;
                  skos:definition "Non-metallic inclusion role is a inclusion role of some object aggregate, which members have non-metallic bond."@en ;
                  skos:example "Non-metallic inclusion role of SiO₂, MnS, AlN, Si₃N₄, etc."@en .


