                                            owl:hasValue cryo:CRYO_0000032 ;
                                            owl:onProperty pmd:PMD_0000077 ] ) ] ] ) ] ;
    skos:definition "Bravais lattice tetragonal primitive is a crystal lattice with tetragonal lattice system and primitive lattice centering."@en .

cryo:CRYO_0000140 a owl:Class ;
    rdfs:label "bravais lattice tetragonal body-centered"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000086 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( cryo:CRYO_0000027 [ a owl:Restriction ;
                                owl:hasValue cryo:CRYO_0000044 ;
                                owl:onProperty pmd:PMD_0000077 ] ) ] ],
        cryo:CRYO_0000383 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cryo:CRYO_0000001 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000086 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( cryo:CRYO_0000027 [ a owl:Restriction ;
                                            owl:hasValue cryo:CRYO_0000044 ;
