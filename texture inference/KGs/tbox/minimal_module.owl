    <!-- https://w3id.org/pmd/noes/NOES_0000141 -->

    <owl:Class rdf:about="https://w3id.org/pmd/noes/NOES_0000141">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0001035"/>
        <rdfs:label xml:lang="en">misorentation angle</rdfs:label>
        <skos:definition xml:lang="en">misorientation angle is a relational quality that characterizes an angle between a crystallite in a microstructure and a reference crystallite with the ideal orientation of the specified crystallographic texture fiber or component. It is often used to determine if a crystallite contributes to this specific texture.</skos:definition>
        <skos:example xml:lang="en">9° misorientation between a crystallite with &lt;hkl&gt;{uvw} orientation and &lt;100&gt;{001} cube texture component.</skos:example>
    </owl:Class>
    


