                                                                                                                owl:hasValue 90 ;
                                                                                                                owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ],
        noes:NOES_0000062 ;
    owl:equivalentClass [ a owl:Class ;
