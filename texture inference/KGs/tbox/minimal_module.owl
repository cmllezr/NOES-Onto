            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">extensive property</rdfs:label>
        <skos:definition xml:lang="en">a facetted property that is characteristic of some object or object aggregate or fiat object part and that changes with bearers makeup.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023000 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <obo:IAO_0000116 xml:lang="en">TODO: system requires further precision</obo:IAO_0000116>
        <rdfs:label xml:lang="en">fundamental quality of system</rdfs:label>
        <skos:definition xml:lang="en">a quality that is quality of every system made of demarcated materail entites</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020265"/>
        <rdfs:label xml:lang="en">facetted property</rdfs:label>
        <skos:definition xml:lang="en">an specifically dependent continuant that is giving more detail to an other property or about its bearer</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023003 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023003">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023002"/>
        <rdfs:label xml:lang="en">property by bearer</rdfs:label>
        <skos:definition>is a facetted property that indicates the type of its bearer</skos:definition>
        <skos:example>a fluid property is only applicable to fluids.</skos:example>
    </owl:Class>
    


