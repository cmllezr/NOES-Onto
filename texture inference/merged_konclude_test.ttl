                                                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                                                owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                                                            owl:hasValue 0 ;
                                                                                                                            owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ;
    skos:definition "Percentage plastic extension at fracture in the rolling direction is percentage elongation atfracture which is measured on a sample cut parallel the rolling direction."@en ;
    noes:NOES_0000122 false .

noes:NOES_0000122 a owl:AnnotationProperty ;
    rdfs:label "for embedding"@en ;
    rdfs:range xsd:boolean .

noes:NOES_0000123 a owl:Class ;
    rdfs:label "deviation angle"@en ;
    rdfs:comment "TODO axiom" ;
    rdfs:subClassOf pmd:PMD_0001035 ;
    skos:definition "Deviation angle is a geometric relational quality relevant for the crystallographic texture analysis. Deviation angle  represents an angle between two crystallographic planes which are denoted by the same Miller indices, namely a crystallographic plane which is perfectly parallel to the rolling plane of a sheet material and a crystallographic plane in a crystal grain which is a part of the material."@en .

noes:NOES_0000124 a owl:Class ;
    rdfs:label "percentage plastic extension at fracture in the transversal direction"@en ;
    rdfs:comment "An instance belonging to the class should be rather inferred as asserted." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009007 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0000974 [ a owl:Restriction ;
                                owl:onProperty obo:OBI_0000293 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0001015 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( noes:NOES_0000031 [ a owl:Restriction ;
                                                                        owl:onProperty pmd:PMD_0025998 ;
                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                owl:intersectionOf ( noes:NOES_0000160 [ a owl:Restriction ;
                                                                                            owl:onProperty pmd:PMD_0000077 ;
                                                                                            owl:someValuesFrom [ a owl:Class ;
                                                                                                    owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                                                owl:hasValue 90 ;
                                                                                                                owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ],
        obo:BFO_0000020,
        <https://w3id.org/pmd/tto/TTO_0000039> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <https://w3id.org/pmd/tto/TTO_0000039> [ a owl:Restriction ;
                        owl:onProperty obo:RO_0009007 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0000974 [ a owl:Restriction ;
                                            owl:onProperty obo:OBI_0000293 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                                owl:onProperty obo:RO_0001015 ;
                                                                owl:someValuesFrom [ a owl:Class ;
                                                                        owl:intersectionOf ( noes:NOES_0000031 [ a owl:Restriction ;
                                                                                    owl:onProperty pmd:PMD_0025998 ;
                                                                                    owl:someValuesFrom [ a owl:Class ;
                                                                                            owl:intersectionOf ( noes:NOES_0000160 [ a owl:Restriction ;
                                                                                                        owl:onProperty pmd:PMD_0000077 ;
                                                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                                                owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                                                            owl:hasValue 90 ;
                                                                                                                            owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ;
    skos:definition "Percentage plastic extension at fracture in the transversal direction is percentage elongation at fracture which is measured on a sample cut parallel the transversal direction."@en ;
    noes:NOES_0000122 false .

noes:NOES_0000126 a owl:Class ;
    rdfs:label "metallic inclusion role"@en ;
    rdfs:comment """Curation status: need more sophisticated axioms to detect metallic / non-metallic type. 
Will be inferable in the future"""@en ;
    rdfs:subClassOf noes:NOES_0000125 ;
    skos:definition "Matallic inclusion role is a inclusion role of some object aggregate, which members have metallic bond."@en .

noes:NOES_0000127 a owl:Class ;
    rdfs:label "non-metallic inclusion role"@en ;
    rdfs:comment """Curation status: need more sophisticated axioms to detect metallic / non-metallic type. 
Will be inferable in the future"""@en ;
    rdfs:subClassOf noes:NOES_0000125 ;
    skos:definition "Non-metallic inclusion role is a inclusion role of some object aggregate, which members have non-metallic bond."@en ;
    skos:example "Non-metallic inclusion role of SiO₂, MnS, AlN, Si₃N₄, etc."@en .

noes:NOES_0000128 a owl:Class ;
    rdfs:label "texture parameter A0"@en ;
    qudt:symbol "A0" ;
    rdfs:seeAlso "http://refhub.elsevier.com/S0304-8853(18)30867-9/h0160" ;
    rdfs:subClassOf noes:NOES_0000043 ;
    skos:definition "Texture parameter A0 is a texture parameter for a magnetic field direction parallel to RD."@en .

noes:NOES_0000129 a owl:Class ;
    rdfs:label "texture parameter A90"@en ;
    qudt:symbol "A90" ;
    rdfs:seeAlso "http://refhub.elsevier.com/S0304-8853(18)30867-9/h0160" ;
    rdfs:subClassOf noes:NOES_0000043 ;
    skos:definition "Texture parameter A90 is a texture parameter for a magnetic field direction parallel to TD." .

noes:NOES_0000130 a owl:Class ;
    rdfs:label "homogenization"@en ;
    rdfs:subClassOf pmd:PMD_0000779 ;
    skos:altLabel "homogenizing"@en ;
    skos:definition "Homogenization is a type of heat treatment which involves heating the metal to a very high temperature (just below its melting point) and holding it there for a long period of time."@en .

noes:NOES_0000131 a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "approximately parallel to"@en ;
    rdfs:subPropertyOf noes:NOES_0000066 ;
    skos:definition "Approximately parallel to is an object property which connect two or  more spatial regions that are parallel to each other considering the misalignment angle of usually 15°"@en ;
    skos:example "<111> family of directions in crystals are approximately parellel to normal direction (ND) of a sample in γ-fiber texture component"@en .

noes:NOES_0000132 a owl:Class ;
    rdfs:label "operating current"@en ;
    rdfs:subClassOf pmd:PMD_0000008 ;
    skos:definition "operating current in is the electrical current (measured in milliamperes, mA) applied to the filament which controls the intensity of the beam (X-Ray, electron, etc)"@en .

noes:NOES_0000133 a owl:Class ;
    rdfs:label "number density"@en ;
    rdfs:subClassOf pmd:PMD_0020101 ;
    skos:definition "number density is a proportion which presents the count of individual, countable items (such as atoms, molecules, charge carriers, etc.) contained within a specific unit of volume"@en .

noes:NOES_0000134 a owl:Class ;
    rdfs:label "rolling speed"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0025006 ;
            owl:someValuesFrom noes:NOES_0000023 ],
        pmd:PMD_0000008 ;
    skos:definition "rotational velocity and surface speed of the work rolls during rolling process"@en ;
    skos:example "0.5 m/s" .

noes:NOES_0000136 a owl:Class ;
    rdfs:label "area proportion"@en ;
    rdfs:subClassOf pmd:PMD_0020101 ;
    skos:definition "Area proportion is a proportion which quantifies the area of the part relative to the area of the whole."@en .

noes:NOES_0000137 a owl:Class ;
    rdfs:label "strip"@en ;
    rdfs:subClassOf obo:BFO_0000030 ;
    skos:definition "Strip is a semi-finished product of a rolled metal" .

noes:NOES_0000140 a owl:Class ;
    rdfs:label "crystallite with ideal α*-fiber texture orientation"@en ;
    rdfs:subClassOf pmd:PMD_0000663 .

noes:NOES_0000155 a owl:Class ;
    rdfs:label "EBSD system"@en ;
    rdfs:subClassOf noes:NOES_0000154 ;
    skos:definition "Electron backscatter diffraction (EBSD) system is a diffractomter which detects diffracted electrons in the chamber of a scanning electron microscope."@en .

noes:NOES_0000159 a owl:Class ;
    rdfs:label "operating voltage"@en ;
    rdfs:subClassOf pmd:PMD_0000008 ;
    skos:definition "operating g voltage is a process attribute of an assay which describes the value of a voltage applied to the electron source to extract electrons from the source and accelerate them in the direction of a sample"@en .

noes:NOES_0000161 a owl:Class ;
    rdfs:label "α*-fiber texture"@en ;
    rdfs:comment "The axiom is not expressible in OWL. SHACL restriction?"@en ;
    rdfs:subClassOf pmd:PMD_0000853 ;
    skos:altLabel "{h11}<1/h12>" ;
    skos:definition "α*-fiber texture is a type of crystallographic texture which is quality of grain population, i.e., several grains, having a similar orientation (within a misorientation threshold) in relation to the material's reference frame: {11h} family of crystallographic planes are oriented parallel to the rolling plane of a sheet material and <1/h12> family of crystallographic directions are oriented parallel to the rolling direction (RD) of a sheet material."@en .

noes:NOES_0000164 a owl:Class ;
    rdfs:label "crystallite with α*-fiber texture orientation"@en ;
    rdfs:subClassOf pmd:PMD_0000663 ;
    skos:comment "Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference."@en,
        "The axiom is not expressible in OWL. SHACL restriction?"@en ;
    skos:definition "crystallite with α*-fiber texture orientation is a crystallite whose family of <1/h12> equivalent directions in a cubic lattice system are oriented approximately parallel to the rolling direction and family of {h11} equivalent directions are oriented approximately parallel to the rolling plane."@en .

noes:NOES_0000165 a owl:Class ;
    rdfs:label "fillet radius"@en ;
    rdfs:subClassOf pmd:PMD_0040001 ;
    skos:definition "Fillet radus is a charactereristic paramater of a geometry of a tensile test specimen which characterizes the radius of the curved sections (fillets) connecting the gripping ends to the reduced gauge length in a standard \"dog-bone\" specimen is specifically dimensioned to prevent stress concentrations from causing premature failure outside the gauge length."@en .

noes:NOES_0000166 a owl:Class ;
    rdfs:label "average grain size"@en ;
    rdfs:subClassOf pmd:PMD_0020335 ;
    skos:definition "Average grain size is an intensive quality of a material which describes the average diameter of grains in the material's microstructure."@en .

noes:NOES_0000168 a owl:Class ;
    rdfs:label "inverse pole figure" ;
    rdfs:subClassOf pmd:PMD_0000834 ;
    skos:definition "An inverse pole figure is a stereographic projection that plots a specific, macroscopic physical direction of a sample, e.g., rolling or normal direction relative to the internal coordinate system of the crystal lattice, revealing the statistical frequency of grain orientations that align with that chosen physical axis."@en .

noes:NOES_0000181 a owl:Class ;
    rdfs:label "NO27-14"@en ;
    rdfs:comment """TODO: 
1. Import W/kg units
2. Add units to the equivalent class
3. Think of adding nomical thickness class
4. Check the some in the decimal"""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000086 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0050153 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000077 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                    owl:onProperty obo:OBI_0001937 ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:decimal ;
                                                            owl:withRestrictions ( [ xsd:minInclusive 0.27 ] ) ] ] ) ] ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000053 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( noes:NOES_0000069 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000077 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                    owl:onProperty obo:OBI_0001937 ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:decimal ;
                                                            owl:withRestrictions ( [ xsd:maxInclusive 14.0 ] ) ] ] ) ] ] ) ] ],
        noes:NOES_0000180 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( noes:NOES_0000180 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000053 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( noes:NOES_0000069 [ a owl:Restriction ;
                                            owl:onProperty pmd:PMD_0000077 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                owl:onProperty obo:OBI_0001937 ;
                                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                                        owl:onDatatype xsd:decimal ;
                                                                        owl:withRestrictions ( [ xsd:maxInclusive 14.0 ] ) ] ] ) ] ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000086 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0050153 [ a owl:Restriction ;
                                            owl:onProperty pmd:PMD_0000077 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                owl:onProperty obo:OBI_0001937 ;
                                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                                        owl:onDatatype xsd:decimal ;
                                                                        owl:withRestrictions ( [ xsd:minInclusive 0.27 ] ) ] ] ) ] ] ) ] ] ) ] ;
    skos:definition "NO27-14 is a non-oriented electrical steel which has characteristic total magnetic losses P1.0/400 of max 14 W/kg and a quality thickness of 0.27 mm."@en .

<https://w3id.org/pmd/tto/TTO_0000015> a owl:Class ;
    rdfs:label "End-Probendurchmesser"@de,
        "diameter after fracture"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/DiameterAfterFracture> ;
    rdfs:subClassOf pmd:PMD_0050051 ;
    skos:definition "Die Länge einer geraden Linie durch den Mittelpunkt eines Objekts (Zugprüfstücks), gemessen nach einem Bruch, der während einer Prüfung aufgetreten ist."@de,
        "The length of a straight line through the center of an object (tensile test piece) as measured after a fracture occured during a test."@en .

<https://w3id.org/pmd/tto/TTO_0000017> a owl:Class ;
    rdfs:label "Extensometer-Messlänge"@de,
        "extensometer gauge length"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/ExtensometerGaugeLength> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000019> ;
    skos:definition """Anfangsmesslänge des Dehnungsaufnehmers (Extensometer), die zum Messen der Verlängerung benutzt wird

Anmerkung: Für die Bestimmung mehrerer Eigenschaften, die (teilweise oder vollständig) von der Verlängerung abhängig sind, z. B. R_p, A_e oder A_g, ist die Verwendung eines Extensometers zwingend erforderlich."""@de,
        """initial gauge length of the extensometer used for measurement of extension

Note: For the determination of several properties which are based (partly or complete) on extension, e. g. R_p, A_e or A_g, the use of an extensometer is mandatory."""@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en ;
    pmd:symbol "L_e"@en .

<https://w3id.org/pmd/tto/TTO_0000018> a owl:Class ;
    rdfs:label "Messlänge nach dem Bruch"@de,
        "final gauge length after fracture"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/FinalGaugeLengthAfterFracture> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000019> ;
    skos:definition "Länge zwischen den Marken zur Kennzeichnung der Messlänge auf der Probe, die nach dem Bruch bei Raumtemperatur gemessen wird, nachdem die beiden Probenbruchstücke sorgfältig so zusammengefügt wurden, dass ihre Achsen in einer Geraden liegen"@de,
        "length between gauge length marks on the test piece measured after rupture, at room temperature, the two pieces having been carefully fitted back together so that their axes lie in a straight line"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en ;
    pmd:symbol "L_u"@en .

<https://w3id.org/pmd/tto/TTO_0000023> a owl:Class ;
    rdfs:label "Höchstkraft"@de,
        "maximum force"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/MaximumForce> ;
    rdfs:subClassOf pmd:PMD_0020200 ;
    skos:definition """Bei Werkstoffen, die kein diskontinuierliches Fließen zeigen: größte Kraft, der die Probe während des Versuchs standhält

Bei Werkstoffen, die ein diskontinuierliches Fließen zeigen: größte Kraft, der die Probe während des Versuchs nach dem Beginn der Verfestigung standhält

Anmerkung: Für Werkstoffe, die ein diskontinuierliches Fließen zeigen, aber keine Verfestigung erzielt werden kann, ist die Höchstkraft nicht definiert
."""@de,
        """For materials displaying no discontinuous yielding: highest force that the test piece withstands during the test

For materials displaying discontinuous yielding: highest force that the test piece withstands during the test after the beginning of work-hardening

Note: For materials which display discontinuous yielding, but where no work-hardening can be established, the maximum force is not defined."""@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en .

<https://w3id.org/pmd/tto/TTO_0000024> a owl:Class ;
    rdfs:label "Kleinster Querschnitt nach dem Bruch"@de,
        "minimum cross-sectional area after fracture"@en ;
    rdfs:comment "Symbol: S_u" ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/MinimumCrossSectionalAreaAfterFracture> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000012> ;
    skos:definition """Dieses Konzept beschreibt die kleinste Querschnittsfläche des Zugprüfkörers, die nach dem Bruch infolge der aufgebrachten Zugkraft erhalten wird.

Anmerkung: Sie wird in der Regel senkrecht zur Richtung der aufgebrachten Kraft gemessen und dient zur Berechnung der technischen Spannung während der Prüfung.

Anmerkung: Es wird empfohlen, den Anfangsquerschnitt innerhalb der parallelen Länge mit einer Genauigkeit von ±2 % zu messen. Bei runden Prüfkörpern mit kleinem Durchmesser oder Prüfkörpern mit anderen Querschnittsgeometrien ist es jedoch möglicherweise nicht möglich, den Anfangsquerschnitt innerhalb der parallelen Länge mit einer Genauigkeit von ±2 % zu messen."""@de,
        """This concept describes the smallest cross-sectional area of the tensile test piece observed after it has fractured under the applied tensile force.

Note: It is typically measured perpendicular to the direction of the applied force and is used to calculate engineering stress during the test.

Note: It is recommended to measure the original cross-sectional area of the parallel length to an accuracy of ±2 %. However, measuring the original cross-sectional area of the parallel length with an accuracy of ±2 % on small diameter round test pieces, or test pieces with other cross-sectional geometries, may not be possible."""@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019" .

<https://w3id.org/pmd/tto/TTO_0000026> a owl:Class ;
    rdfs:label "Anfangsquerschnitt innerhalb der parallelen Länge"@de,
        "original cross-sectional area of the parallel length"@en ;
    rdfs:comment "Symbol: S_o" ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/OriginalCrossSectionalArea> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000012> ;
    skos:definition "Dieses Konzept beschreibt die initiale Querschnittsfläche des Zugprüfkörpers entlang seiner parallelen Länge, bevor eine Verformung auftritt."@de,
        "This concept describes the initial area of the tensile test piece before any deformation occurs."@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019" .

<https://w3id.org/pmd/tto/TTO_0000027> a owl:Class ;
    rdfs:label "Anfangs-Probendurchmesser"@de,
        "original diameter"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/OriginalDiameter> ;
    rdfs:subClassOf pmd:PMD_0050051 ;
    skos:definition "Die Länge einer geraden Linie durch den Mittelpunkt eines Objekts (Zugprüfkörpers), die vor einer Prüfung gemessen wird."@de,
        "The length of a straight line through the center of an object (tensile test piece) as measured prior to a tensile test."@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en .

<https://w3id.org/pmd/tto/TTO_0000029> a owl:Class ;
    rdfs:label "Anfangs-Dicke"@de,
        "original thickness"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/OriginalThickness> ;
    rdfs:subClassOf pmd:PMD_0050153 ;
    skos:definition "Diese Entität beschreibt die gemessene Dimension in einer Richtung eines Prüfstücks, wie sie vor der Prüfung gemessen wurde."@de,
        "This entity describes the measured dimension in one direction of a test piece, as measured before the test."@en .

<https://w3id.org/pmd/tto/TTO_0000030> a owl:Class ;
    rdfs:label "Anfangs-Breite"@de,
        "original width"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/OriginalWidth> ;
    rdfs:subClassOf pmd:PMD_0050154 ;
    skos:definition "Diese Entität beschreibt eine horizontale Messung eines Objekts (Prüfkörpers) im rechten Winkel zur Länge des Objekts (Prüfkörpers), wie sie vor einer Prüfung gemessen wird."@de,
        "This entity describes a horizontal measurement of an object (test piece) taken at right angles to the length of the object (test piece), as measured before a test."@en .

<https://w3id.org/pmd/tto/TTO_0000032> a owl:Class ;
    rdfs:label "Dehnung"@de,
        "percentage elongation"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/PercentageElongation> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000004> ;
    skos:definition "Verlängerung, angegeben in Prozent, bezogen auf die Anfangsmesslänge"@de,
        "elongation expressed as a percentage of the original gauge length"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en .

<https://w3id.org/pmd/tto/TTO_0000034> a owl:Class ;
    rdfs:label "Extensometer-Dehnung"@de,
        "percentage extension"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/co/2.0.8/PercentageExtension> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000005> ;
    skos:altLabel "technische Dehnung"@de,
        "(engineering) strain"@en ;
    skos:definition """in Prozent angegebene Verlängerung der Extensometer-Messlänge

Anmerkung: Die Extensometer-Dehnung wird oftmals auch als technische Dehnung bezeichnet.""",
        """extension expressed as a percentage of the extensometer gauge length

Note: The percentage extension is commonly called engineering strain."""@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019" .

<https://w3id.org/pmd/tto/TTO_0000035> a owl:Class ;
    rdfs:label "Bleibende Dehnung"@de,
        "percentage permanent elongation"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/PercentagePermanentElongation> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000004> ;
    skos:definition "Zunahme der Anfangsmesslänge einer Probe nach Entfernen einer festgelegten Zugspannung, angegeben in Prozent, bezogen auf die Anfangsmesslänge"@de,
        "increase in the original gauge length of a test piece after removal of a specified stress, expressed as a percentage of the original gauge length"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en .

<https://w3id.org/pmd/tto/TTO_0000036> a owl:Class ;
    rdfs:label "Bleibende Extensometer-Dehnung"@de,
        "percentage permanent extension"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/PercentagePermanentExtension> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000005> ;
    skos:definition "Vergrößerung der Extensometer-Messlänge nach Entfernen einer festgelegten, auf die Probe aufgebrachten Zugspannung, angegeben in Prozent, bezogen auf die Extensometer-Messlänge"@de,
        "increase in the extensometer gauge length, after removal of a specified stress from the test piece, expressed as a percentage of the extensometer gauge length"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en .

<https://w3id.org/pmd/tto/TTO_0000038> a owl:Class ;
    rdfs:label "Brucheinschnürung"@de,
        "percentage reduction of area"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/PercentageReductionOfArea> ;
    rdfs:subClassOf pmd:PMD_0000848 ;
    skos:definition "größte während des Versuchs aufgetretene Änderung des Querschnitts (S_o − S_u), angegeben in Prozent, bezogen auf den Anfangsquerschnitt S_o"@de,
        "maximum change in cross-sectional area which has occurred during the test (S_o − S_u), expressed as a percentage of the original cross-sectional area, S_o"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en ;
    pmd:symbol "Z" .

<https://w3id.org/pmd/tto/TTO_0000040> a owl:Class ;
    rdfs:label "Gesamte Extensometer-Dehnung bei Höchstkraft"@de,
        "percentage total extension at maximum force"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/PercentageTotalExtensionAtMaximumForce> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000005> ;
    skos:definition "gesamte Verlängerung (elastische plus plastische Verlängerung) der Extensometer-Messlänge bei Höchstkraft, angegeben in Prozent, bezogen auf die Extensometer-Messlänge"@de,
        "total extension (elastic extension plus plastic extension) at maximum force, expressed as a percentage of the extensometer gauge length"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en ;
    pmd:symbol "A_gt"@en .

<https://w3id.org/pmd/tto/TTO_0000041> a owl:Class ;
    rdfs:label "Streckgrenzen-Extensometer-Dehnung"@de,
        "percentage yield point extension"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/PercentageYieldPointExtension> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000005> ;
    skos:definition "Bei Werkstoffen, die ein diskontinuierliches Fließen zeigen: Verlängerung der Extensometer-Messlänge zwischen dem Beginn örtlichen Fließens und dem Einsetzen gleichmäßiger Verfestigung, angegeben in Prozent, bezogen auf die Extensometer-Messlänge"@de,
        "For discontinuous yielding materials: extension between the start of yielding and the start of uniform work-hardening, expressed as a percentage of the extensometer gauge length"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en ;
    pmd:symbol "A_e"@en .

<https://w3id.org/pmd/tto/TTO_0000046> a owl:Class ;
    rdfs:label "Dehngrenze bei plastischer Extensometer-Dehnung Rp01"@de,
        "proof strength plastic extension rp01"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/Rp01> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000044> ;
    skos:definition "Spannung bei einer plastischen Extensometer-Dehnung, die 0,1 Prozent der Extensometer-Messlänge entspricht"@de,
        "stress at which the plastic extension is equal to 0.1 percent of the extensometer gauge length"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en ;
    pmd:symbol "R_p_0.1"@en .

<https://w3id.org/pmd/tto/TTO_0000051> a owl:Class ;
    rdfs:label "Dehngeschwindigkeit"@de,
        "strain rate"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/StrainRate> ;
    rdfs:subClassOf pmd:PMD_0000008 ;
    skos:definition "Zunahme der mit einem Extensometer in der Extensometer-Messlänge gemessenen Dehnung je Zeiteinheit"@de,
        "increase of strain, measured with an extensometer, in extensometer gauge length, per time"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en ;
    pmd:symbol "e^._L_e"@en .

<https://w3id.org/pmd/tto/TTO_0000052> a owl:Class ;
    rdfs:label "Spannungsgeschwindigkeit"@de,
        "stress rate"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/StressRate> ;
    rdfs:subClassOf pmd:PMD_0000008 ;
    skos:definition """Zunahme der Spannung je Zeiteinheit

Anmerkung: Die Spannungsgeschwindigkeit wird nur im elastischen Bereich des Versuchs verwendet."""@de,
        """increase of stress per time

Note: Stress rate is only used in the elastic part of the test."""@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en ;
    pmd:symbol "R"@en .

<https://w3id.org/pmd/tto/TTO_0000056> a owl:Class ;
    rdfs:label "End-Dicke"@de,
        "thickness after fracture"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/ThicknessAfterFracture> ;
    rdfs:subClassOf pmd:PMD_0050153 ;
    skos:definition "Diese Entität beschreibt die gemessene Dimension in einer Richtung eines Prüfstücks, wie sie vor der Prüfung gemessen wurde."@de,
        "This entity describes the measured dimension in one direction of a test piece, as measured after the test."@en .

<https://w3id.org/pmd/tto/TTO_0000060> a owl:Class ;
    rdfs:label "End-Breite"@de,
        "width after fracture"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/WidthAfterFracture> ;
    rdfs:subClassOf pmd:PMD_0050154 ;
    skos:definition "Diese Entität beschreibt eine horizontale Messung eines Objekts (Prüfkörpers) im rechten Winkel zur Länge des Objekts (Prüfkörpers), wie sie nach einer Prüfung gemessen wird."@de,
        "This entity describes a horizontal measurement of an object (test piece) taken at right angles to the length of the object (test piece), as measured after a test."@en .

ex:SVS_10_alpha_deg a obo:OBI_0001931 ;
    obo:IAO_0000039 obo:UO_0000185 ;
    obo:OBI_0001937 "29.2611"^^xsd:float .

ex:SVS_10_cube_deg a obo:OBI_0001931 ;
    obo:IAO_0000039 obo:UO_0000185 ;
    obo:OBI_0001937 "23.2949"^^xsd:float .

ex:SVS_10_eta_deg a obo:OBI_0001931 ;
    obo:IAO_0000039 obo:UO_0000185 ;
    obo:OBI_0001937 "17.3838"^^xsd:float .

ex:SVS_10_gamma_deg a obo:OBI_0001931 ;
    obo:IAO_0000039 obo:UO_0000185 ;
    obo:OBI_0001937 "43.2812"^^xsd:float .

ex:SVS_10_goss_deg a obo:OBI_0001931 ;
    obo:IAO_0000039 obo:UO_0000185 ;
    obo:OBI_0001937 "34.0857"^^xsd:float .

ex:SVS_10_lambda_deg a obo:OBI_0001931 ;
    obo:IAO_0000039 obo:UO_0000185 ;
