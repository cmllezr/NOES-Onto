    skos:definition "Bravais lattice  tetragonal body-centered is a crystal lattice with tetragonal lattice system and  body-centered lattice centering."@en .

noes: a owl:Ontology ;
    dcterms:created "2025-06-01                                  "^^xsd:date ;
    dcterms:creator <https://orcid.org/0009-0003-1503-4422> ;
    dcterms:description "NOES-Onto is an application-level ontology based on PMDco  3.0 that focuses on the semantic modelling of Process-Structure-Property dependencies in non-oriented electrical sheets." ;
    dcterms:identifier "https://doi.org/10.5281/zenodo.XXXXXXX      " ;
    dcterms:issued "2026-08-17"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-08-17"^^xsd:date ;
    dcterms:publisher <https://ror.org/04hm8eb66> ;
    dcterms:source pmd: ;
    dcterms:title "NOES-Onto: Nonoriented Electrical Steel Ontology" ;
    bibo:status "stable" ;
    vann:preferredNamespacePrefix "noes" ;
    vann:preferredNamespaceUri "https://w3id.org/pmd/noes/" ;
    owl:versionIRI <https://w3id.org/pmd/noes/releases/2026-08-17/noes-full.owl> ;
    owl:versionInfo "2026-08-17" .

noes:NOES_0000002 a owl:Class ;
    rdfs:label "rolled sheet direction value"@en ;
    rdfs:subClassOf obo:OBI_0001930 ;
    owl:deprecated true ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( noes:NOES_0000028 noes:NOES_0000029 noes:NOES_0000030 ) ] ;
    skos:definition "Rolled sheet directions is a categorical value specification which specifies the rolled sheet direction. It  includes rolling direction (RD), transverse direction (TD), and normal direction (ND)"@en .

noes:NOES_0000005 a owl:Class ;
    rdfs:label "B-H curve"@en ;
    rdfs:subClassOf noes:NOES_0000004 ;
    skos:definition "B-H curve is a plot which describes the dependency of magnetic flux density B on magnetic field strength H in soft and hard magnetic materials."@en .

noes:NOES_0000006 a owl:Class ;
    rdfs:label "stress-strain curve"@en ;
    rdfs:subClassOf noes:NOES_0000004 ;
    skos:definition "Stress-strain curve is a plot which describes the dependency of deformation in a sample on the applied stress (force per unit area)."@en .

noes:NOES_0000007 a owl:Class ;
    rdfs:label "coercitivy in the rolling direction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009007 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0000829 [ a owl:Restriction ;
                                owl:onProperty obo:OBI_0000293 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0001015 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( noes:NOES_0000031 [ a owl:Restriction ;
                                                                        owl:onProperty pmd:PMD_0025998 ;
                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                owl:intersectionOf ( noes:NOES_0000160 [ a owl:Restriction ;
                                                                                            owl:onProperty pmd:PMD_0000077 ;
                                                                                            owl:someValuesFrom [ a owl:Class ;
                                                                                                    owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                                                owl:hasValue 0 ;
                                                                                                                owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ],
        noes:NOES_0000048 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( noes:NOES_0000048 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0009007 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0000829 [ a owl:Restriction ;
                                            owl:onProperty obo:OBI_0000293 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                                owl:onProperty obo:RO_0001015 ;
                                                                owl:someValuesFrom [ a owl:Class ;
                                                                        owl:intersectionOf ( noes:NOES_0000031 [ a owl:Restriction ;
                                                                                    owl:onProperty pmd:PMD_0025998 ;
                                                                                    owl:someValuesFrom [ a owl:Class ;
                                                                                            owl:intersectionOf ( noes:NOES_0000160 [ a owl:Restriction ;
                                                                                                        owl:onProperty pmd:PMD_0000077 ;
                                                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                                                owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                                                            owl:hasValue 0 ;
                                                                                                                            owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ;
    skos:definition "Coercivity in the rolling direction describes the value of the magnetic field strength H required to reduce the magnetic flux bensity B back to zero after the material has been driven to the saturation of magnetic flux density B sat, while the magnetic field is applied parallel to the rolling direction of the specimen."@en .

noes:NOES_0000009 a owl:Class ;
    rdfs:label "EBSD map"@en ;
    rdfs:subClassOf pmd:PMD_0000834 ;
    skos:definition "EBSD (electron backscatter diffraction) map represents a information content entity which is determined analytically from data obtrained from EBSD characterization. EBSD map provides information about grain size and grain orientation."@en .

noes:NOES_0000010 a owl:Class ;
    rdfs:label "quasi-static (DC) characterization of magnetic properties"@en ;
    rdfs:comment """TODO: The definition has to be refined. 
TODO: Write axioms based on the definition"""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0000009 ;
            owl:someValuesFrom noes:NOES_0000156 ],
        [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0000009 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( noes:NOES_0000003 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000077 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                    owl:hasValue obo:UO_0000106 ;
                                                    owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                    owl:onProperty obo:OBI_0001937 ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:decimal ;
                                                            owl:withRestrictions ( [ xsd:maxExclusive 1.0 ] ) ] ] ) ] ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0009006 ;
            owl:someValuesFrom noes:NOES_0000056 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0009006 ;
            owl:someValuesFrom noes:NOES_0000051 ],
        pmd:PMD_0000829 ;
    skos:definition "Quasi-static (DC) characterization is a magnetic properties analyzing process for soft magnetic sheet materials which aims to determine a static magnetic curve of the tested material. During the test, the current in the primary winding is changed slowly, thus the frequency of a magnetic field remains low, i.e., below 0.01 Hz. The output of the quasi-static characterization of magnetic properties  is a static B-H curve, which  provides information on hysteresis loss Ph, saturation induction Bsat, coercivity Hc, remanence Br, and maximum permeability µmax. During DC characterization primarily domain wall motion and pinning effects play role."@en ;
    skos:example "Measurement of hysteresis losses; measurement of saturation magnetic induction at specified maximal magnetic field, e.g., 5000 A/m."@en .

noes:NOES_0000011 a owl:Class ;
    rdfs:label "dynamic (AC) characterization of magnetic properties"@en ;
    rdfs:comment """TODO: refine defintion
TODO: write axioms"""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0000009 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( noes:NOES_0000003 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000077 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                    owl:hasValue obo:UO_0000106 ;
                                                    owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                    owl:onProperty obo:OBI_0001937 ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:decimal ;
                                                            owl:withRestrictions ( [ xsd:minExclusive 1.0 ] ) ] ] ) ] ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0009006 ;
            owl:someValuesFrom noes:NOES_0000057 ],
        pmd:PMD_0000829 ;
    skos:definition "Dynamic (AC) characterization of magnetic properties is a magnetic properties analyzing process for soft magnetic sheet materials which aims to determine the total energy loss of a tested material at specific frequency and magnetic flux density. During the test, the current in the primary winding is changed with frequency between 50-400 Hz to ensure sinusoidal waveform of the magnetic flux density at Bpeak. The output of the dynamic characterization of magnetic properties  is a  B-H curve, which  provides information on total core loss Ptot and dynamic permeability µdyn."@en ;
    skos:example "Measurement of total power (iron) loss at given current frequency and maximal magnetic induction, e.g. 50 Hz and 1.5 T, or 400 Hz and 1.0 T"@en .

noes:NOES_0000012 a owl:Class ;
    rdfs:label "magnetic property analyzing process using Epstein frame"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom noes:NOES_0000183 ],
        pmd:PMD_0000829 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000829 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000057 ;
                        owl:someValuesFrom noes:NOES_0000183 ] ) ] ;
    skos:definition "Magnetic property analyzing process using Epstein frame is a standardized assay which uses Epstein frame to test magnetic properties of soft magnetic materials, where several (how many) strips are stacked."@en .

noes:NOES_0000013 a owl:Class ;
    rdfs:label "magnetic property analyzing process using single sheet tester"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom noes:NOES_0000184 ],
        pmd:PMD_0000829 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000829 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000057 ;
                        owl:someValuesFrom noes:NOES_0000184 ] ) ] ;
    skos:definition "magnetic property analyzing process using single sheet tester is an assay for determining magnetic properties of soft mangetic materials, where magnetic field H is applied to a single sheet."@en .

noes:NOES_0000014 a owl:Class ;
    rdfs:label "magnetic property analyzing process using thoroidal core"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom noes:NOES_0000185 ],
        pmd:PMD_0000829 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000829 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000057 ;
                        owl:someValuesFrom noes:NOES_0000185 ] ) ] ;
    skos:definition "Magnetic property analyzing process using thoroidal core is an assay for determing magnetic properties of soft magnetic materials, where the sample has closed wound ring core shape. As the ring shape does not have any air gaps or joint losses, this testing procedure provides information on most intrinsic material properties."@en .

noes:NOES_0000015 a owl:Class ;
    rdfs:label "cold rolling"@en ;
    rdfs:comment "Cold rolling is a rolling process which aims to reduce thickness of a metallic sheet. Cold rolling takes place at room temperature."@en ;
    rdfs:subClassOf noes:NOES_0000023 .

noes:NOES_0000016 a owl:Class ;
    rdfs:label "hot rolling"@en ;
    rdfs:comment "Hot rolling is a rolling process which aims to reduce the thickness of a sheet material. Hot rolling  takes place at temperatures above alloy's recrystallization temperature."@en ;
    rdfs:subClassOf noes:NOES_0000023 .

noes:NOES_0000017 a owl:Class ;
    rdfs:label "occurence of magnetic flux"@en ;
    rdfs:comment "Occurence of magnetic flux  is a process that (realizes??) responds with magnetic flux in the material when some magnetic field is applied."@en ;
    rdfs:subClassOf obo:BFO_0000015 ;
    owl:deprecated true .

noes:NOES_0000018 a owl:Class ;
    rdfs:label "recrystallization"@en ;
    rdfs:comment """follows  Arrhenius equation.
Has part grain growth and recovery."""@en ;
    rdfs:subClassOf obo:BFO_0000015 ;
    skos:definition "Recrystallization is a naturally occuring process which occurs in metallic materials and during which deformed grains are replaced by new defect-free grains. Recrystallization is a thermally activated process, i.e., it requires sufficiently high temperatures for the process to occur. Thus, recrystallization is a process which is part of annealing heat treatment."@en .

noes:NOES_0000019 a owl:Class ;
    rdfs:label "recovery"@en ;
    rdfs:subClassOf obo:BFO_0000015 ;
    skos:definition "Recovery is a naturally occuring process which occurs in metallic materials and during which the reduction of stored deformation energy in grains occurs due to the removal and rearragement of crystal structure defects (dislocations). Recovery is a part of recrystallization process, thus it is a thermally activated process, which occurs during annealing heat treatment."@en .

noes:NOES_0000020 a owl:Class ;
    rdfs:label "grain growth"@en ;
    rdfs:subClassOf obo:BFO_0000015 ;
    skos:definition "Grain growth is a process which occurs in polycrystalline materials. The driving force of grain growth is reduction of the interal energy via reduction of the total grain boundary. Grain growth is a thermally activated process which occurs after recovery and (primary) recrystallization."@en .

noes:NOES_0000022 a owl:Class ;
    rdfs:label "domain wall pinning"@en ;
    rdfs:subClassOf pmd:PMD_0025009 ;
    skos:definition "Domain wall pinning is a naturally occuring process which occurs in ferromagnetic materials when domain wall montion is temporally inhibited due to an energy barrier."@en .

noes:NOES_0000024 a owl:Class ;
    rdfs:label "strip-casting"@en ;
    rdfs:comment "The defintion has potential"@en ;
    rdfs:subClassOf pmd:PMD_0000906 ;
    skos:definition "Strip-casting is a primary shaping from fluid state process for metals and alloys. During Strip-casting the melt flows between two rolls resulting in the strip."@en .

noes:NOES_0000025 a owl:Class ;
    rdfs:label "Schmieden"@de,
        "forging"@en ;
    rdfs:subClassOf pmd:PMD_0000650 ;
    skos:definition "Forging is a pressure forming process of metals and alloys. During forging the material is heated to forging temperature and formed to the desired form using either hammers and anvils or heat-resistant upper and lower dies."@en .

noes:NOES_0000026 a owl:Class ;
    rdfs:label "normalizing"@en ;
    rdfs:subClassOf pmd:PMD_0000779 ;
    skos:definition "Normalizing is a heat treatment process which aims to create uniform grain structure and improve toughness of an alloy. During normalizing the material is heated above its critical temperature, kept at this temperature for a period of time, and then cooled in the air."@en .

noes:NOES_0000027 a owl:Class ;
    rdfs:label "annealing"@en ;
    rdfs:subClassOf pmd:PMD_0000779 ;
    skos:definition "Annealing is a heat treatment process which aims to soften an alloy and relieve internal stresses. The material is heated above its critical termperature at which recrystallization occurs. After holding the material at the temperature, it is cooled in a slow and controlled way usually inside an oven."@en .

noes:NOES_0000032 a owl:Class ;
    rdfs:label "scanning electron microscopy"@en ;
    rdfs:seeAlso "https://www.thermofisher.com/de/de/home/materials-science/learning-center/applications/sem-tem-difference.html" ;
    rdfs:subClassOf pmd:PMD_0000625 ;
    skos:altLabel "SEM"@en ;
    skos:definition "Scanning electron microscopy (SEM) is a type of electron microscopy where a focused beam of electrons scans the surface of an object. An image is created by detecting electrons reflected from the surface. Thus, SEM provides information on the surface and composition of the sample."@en .

noes:NOES_0000034 a owl:Class ;
    rdfs:label "electron backscatter diffraction"@en ;
    rdfs:seeAlso "https://www.ebsd.com/ebsd-explained/what-is-ebsd" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009006 ;
            owl:someValuesFrom pmd:PMD_0020112 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0009006 ;
            owl:someValuesFrom cryo:CRYO_0000042 ],
        noes:NOES_0000153 ;
    skos:altLabel "EBSD"@en ;
    skos:definition "Electron Backscatter Diffraction (EBSD) is a SEM based technique for characterizing  material's local microstructure. EBSD provides an information about phases and their distribution in the material, grain structure, grain size, grain boundary, texture  (crystallographic orientation of individual grains), and local strain variation."@en .

noes:NOES_0000037 a owl:Class ;
    rdfs:label "waterjet cutting"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0001007 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000085 ;
                                owl:someValuesFrom pmd:PMD_0000592 ] ) ] ],
        pmd:PMD_0000927 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000927 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000055 ;
                        owl:someValuesFrom pmd:PMD_0000592 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000057 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0001007 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000085 ;
                                            owl:someValuesFrom pmd:PMD_0000592 ] ) ] ] ) ] ;
    skos:definition "Waterjet cutting is a cutting process, where waterjet cutter is a participant and it realizes some cutting function."@en .

noes:NOES_0000038 a owl:Class ;
    rdfs:label "number of strips"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom pmd:PMD_0000891 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom pmd:PMD_0020138 ],
        obo:BFO_0000019,
        pmd:PMD_0020254,
        pmd:PMD_0023007 ;
    skos:definition "Number of strips is a extensive quality of a disconnected material entity aggregate which has parts individual strips of an electrical sheet and characterizes how many strips or sheets are present in a packet, used for Epstein or thoroidal core measurement or construction of stators and rotors"@en .

noes:NOES_0000039 a owl:Class ;
    rdfs:label "tensile strength in the rolling direction"@en ;
    rdfs:comment "An instance belonging to the class should be rather inferred as asserted."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009007 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0000974 [ a owl:Restriction ;
                                owl:onProperty obo:OBI_0000293 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0001015 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( noes:NOES_0000031 [ a owl:Restriction ;
                                                                        owl:onProperty pmd:PMD_0025998 ;
                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                owl:intersectionOf ( noes:NOES_0000160 [ a owl:Restriction ;
                                                                                            owl:onProperty pmd:PMD_0000077 ;
                                                                                            owl:someValuesFrom [ a owl:Class ;
                                                                                                    owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                                                owl:hasValue 0 ;
                                                                                                                owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ],
        <https://w3id.org/pmd/tto/TTO_0000053> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <https://w3id.org/pmd/tto/TTO_0000053> [ a owl:Restriction ;
                        owl:onProperty obo:RO_0009007 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0000974 [ a owl:Restriction ;
                                            owl:onProperty obo:OBI_0000293 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                                owl:onProperty obo:RO_0001015 ;
                                                                owl:someValuesFrom [ a owl:Class ;
                                                                        owl:intersectionOf ( noes:NOES_0000031 [ a owl:Restriction ;
                                                                                    owl:onProperty pmd:PMD_0025998 ;
                                                                                    owl:someValuesFrom [ a owl:Class ;
                                                                                            owl:intersectionOf ( noes:NOES_0000160 [ a owl:Restriction ;
                                                                                                        owl:onProperty pmd:PMD_0000077 ;
                                                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                                                owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                                                            owl:hasValue 0 ;
                                                                                                                            owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ;
    skos:definition "Tensile strength in to the rolling direction is a tensile strength which is measured on a sample cut parallel to the rolling direction."@en ;
    noes:NOES_0000122 false .

noes:NOES_0000040 a owl:Class ;
    rdfs:label "coercitivy in the transversal direction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009007 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0000829 [ a owl:Restriction ;
                                owl:onProperty obo:OBI_0000293 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0001015 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( noes:NOES_0000031 [ a owl:Restriction ;
                                                                        owl:onProperty pmd:PMD_0025998 ;
                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                owl:intersectionOf ( noes:NOES_0000160 [ a owl:Restriction ;
                                                                                            owl:onProperty pmd:PMD_0000077 ;
                                                                                            owl:someValuesFrom [ a owl:Class ;
                                                                                                    owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                                                owl:hasValue 90 ;
                                                                                                                owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ],
        noes:NOES_0000048 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( noes:NOES_0000048 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0009007 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0000829 [ a owl:Restriction ;
                                            owl:onProperty obo:OBI_0000293 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                                owl:onProperty obo:RO_0001015 ;
                                                                owl:someValuesFrom [ a owl:Class ;
                                                                        owl:intersectionOf ( noes:NOES_0000031 [ a owl:Restriction ;
                                                                                    owl:onProperty pmd:PMD_0025998 ;
                                                                                    owl:someValuesFrom [ a owl:Class ;
                                                                                            owl:intersectionOf ( noes:NOES_0000160 [ a owl:Restriction ;
                                                                                                        owl:onProperty pmd:PMD_0000077 ;
                                                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                                                owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                                                            owl:hasValue 90 ;
                                                                                                                            owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ;
    skos:definition "Coercivity in the transversal direction describes the value of the magnetic field strength H required to reduce the magnetic flux bensity B back to zero after the material has been driven to the saturation of magnetic flux density B sat, while the magnetic field is applied paralllel to the transverse direction of the specimen."@en .

noes:NOES_0000041 a owl:Class ;
    rdfs:label "remanence in the rolling direction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009007 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0000829 [ a owl:Restriction ;
                                owl:onProperty obo:OBI_0000293 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0001015 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( noes:NOES_0000031 [ a owl:Restriction ;
                                                                        owl:onProperty pmd:PMD_0025998 ;
                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                owl:intersectionOf ( noes:NOES_0000160 [ a owl:Restriction ;
                                                                                            owl:onProperty pmd:PMD_0000077 ;
                                                                                            owl:someValuesFrom [ a owl:Class ;
                                                                                                    owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                                                owl:hasValue 0 ;
                                                                                                                owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ],
        noes:NOES_0000050 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( noes:NOES_0000050 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0009007 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0000829 [ a owl:Restriction ;
                                            owl:onProperty obo:OBI_0000293 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                                owl:onProperty obo:RO_0001015 ;
                                                                owl:someValuesFrom [ a owl:Class ;
                                                                        owl:intersectionOf ( noes:NOES_0000031 [ a owl:Restriction ;
                                                                                    owl:onProperty pmd:PMD_0025998 ;
                                                                                    owl:someValuesFrom [ a owl:Class ;
                                                                                            owl:intersectionOf ( noes:NOES_0000160 [ a owl:Restriction ;
                                                                                                        owl:onProperty pmd:PMD_0000077 ;
                                                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                                                owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                                                            owl:hasValue 0 ;
                                                                                                                            owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ;
    skos:definition "Remanence in the rolling direction is the magnetic induction B that remains in the material when the magnetic field strength H is reduced to zero,  while the magnetic field is applied parallel to the rolling direction of the specimen."@en .

noes:NOES_0000042 a owl:Class ;
    rdfs:label "laser cutting"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0000817 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000085 ;
                                owl:someValuesFrom pmd:PMD_0000592 ] ) ] ],
        pmd:PMD_0000927 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000927 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000055 ;
                        owl:someValuesFrom pmd:PMD_0000592 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000057 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0000817 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000085 ;
                                            owl:someValuesFrom pmd:PMD_0000592 ] ) ] ] ) ] ;
    skos:definition "Laser cutting is a cutting process, where lasercutter is a participant and it realizes some cutting function."@en .

noes:NOES_0000044 a owl:Class ;
    rdfs:label "direction averaged texture parameter A"@en ;
    rdfs:seeAlso "doi:10.1155/2008/173083" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom pmd:PMD_0000857 ],
        obo:BFO_0000019,
        pmd:PMD_0020335,
        pmd:PMD_0023004 ;
    skos:definition "Direction averaged texture parameter A is a intensive quality which quantifies crystallographic texture in materials, which are utilized in applications where applied magnetic field is equally distributed in the rolling plane (RP) of the material. Direction averaged texture parameter A is derived from the texture parameter Aθ by integrating Aθ over dθ. For noriented electrical steels it can be simplified as (A0 + 2*A45 + A90) / 4, where A0, A45, and A90 are values of texture parameter Aθ for an applied magnetic field which encloses an angle of 0, 45, and 90 with the rolling direction, respectively."@en .

noes:NOES_0000045 a owl:Class ;
    rdfs:label "texture factor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom pmd:PMD_0000857 ],
        obo:BFO_0000019,
        pmd:PMD_0020335,
        pmd:PMD_0023004 ;
    skos:definition "Texture factor is an intensive quality used to quantify texture in materials. It is determined as sum of volume fractions of Goss and Cube texture components divided by the volume fraction of γ-fiber orientations."@en .

noes:NOES_0000046 a owl:Class ;
    rdfs:label "transmission electron microscopy"@en ;
    rdfs:seeAlso "https://www.thermofisher.com/de/de/home/materials-science/learning-center/applications/sem-tem-difference.html" ;
    rdfs:subClassOf pmd:PMD_0000625 ;
    skos:altLabel "TEM"@en ;
    skos:definition "Transmission electron microscopy (TEM) is a type of electron microscopy where a beam of electrons goes through a sample. An image is created by detecting electrons transmitted through the sample. Thus, TEM provides information on the crystal structure, morphology and stress state of the sample"@en .

noes:NOES_0000047 a owl:Class ;
    rdfs:label "electron probe microanalysis"@en ;
    rdfs:subClassOf pmd:PMD_0000552 ;
    skos:altLabel "EPMA"@en ;
    skos:definition "Electron probe microanalysis (EPMA) is a technique to non-destructively determine the chemical element composition of small volumes of solid materials. In EPMA an electron beam is focued on a single point of a surface of a sample. The energy of an electron beam is high enough for electrons to pentrate deeper in the sample causing excitation of characteristic x-rays. An x-ray spectrometer detects those characteristic x-rays providing information about materials chemical composition."@en .

noes:NOES_0000054 a owl:Class ;
    rdfs:label "anomalous loss"@en ;
    rdfs:comment "Anamalous loss is propotional to the frequency of the alternating magnetic field f^3/2."@en,
        "Anomalous loss can be reduced by minimizing domain wall spacing to ensure more uniform magnetization. This can be achieved by controlling grain size and crystallographic texure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf obo:BFO_0000055 ] ;
            owl:someValuesFrom noes:NOES_0000021 ],
        noes:NOES_0000053 ;
    skos:definition "Anomalous loss is a type of a magnetic power loss which is determined as a difference between total magnetic power loss P_tot and the sum of both hysteresis loss P_hys and eddy current loss  P_e. Anomalous loss is attributed to the localized, microscopic eddy currents generated by the motion of individual magnetic domain walls."@en ;
    pmd:symbol "P_a" .

noes:NOES_0000055 a owl:Class ;
    rdfs:label "eddy current loss"@en ;
    rdfs:comment "Eddy current loss can be reduced by using thinner sheets and increasing Si content, which raises resistivity ρ."@en,
        """The value of eddy current loss is proportional to the alternating frequency of an applied magnetic field f, sheet thickness d, and the peak induction Bsat, and inversely proportinal to the electric resistivity ρ. 
Pe∝f2⋅d2⋅Bp2​/ρ"""@en ;
    rdfs:subClassOf noes:NOES_0000053 ;
    skos:definition "Eddy current loss is a type of magnetic power loss which is attributed to the macroscopic circulating electrical currents which are induced  by the change of the magnetic flux dB/dt in the bulk of a material."@en ;
    pmd:symbol "P_e" .

noes:NOES_0000061 a owl:Class ;
    rdfs:label "initial permeability"@en ;
    rdfs:comment "How easily the material magnetizes from rest"@en ;
    rdfs:subClassOf pmd:PMD_0080026 ;
    skos:definition "Initial permeability characterizes the slope of the tangent to the magnetization curve at the origin, i.e., H=0 and B=0. It represents the permeability in the weakest magnetic fields"@en ;
    pmd:symbol "µi"@en .

noes:NOES_0000063 a owl:Class ;
    rdfs:label "normal permeability"@en ;
    rdfs:comment "A line from the origin to the loop tip"@en ;
    rdfs:subClassOf pmd:PMD_0080026 ;
    skos:definition "Normal permeabilty is the ratio of the peak magnetic induction B_max to the peak magnetic field strength H_max for a specific magnitization cycle."@en ;
    pmd:symbol "μa"@en .

noes:NOES_0000065 a owl:Class ;
    rdfs:label "magnetic power loss at 1.5 T / 50 Hz"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009007 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:OBI_0000070 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000009 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( pmd:PMD_0000008 [ a owl:Restriction ;
                                                    owl:onProperty pmd:PMD_0000077 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                        owl:hasValue obo:UO_0000106 ;
                                                                        owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                                        owl:hasValue 50.0 ;
                                                                        owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000009 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( pmd:PMD_0000008 [ a owl:Restriction ;
                                                    owl:onProperty pmd:PMD_0020127 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( noes:NOES_0000178 [ a owl:Restriction ;
                                                                        owl:onProperty pmd:PMD_0000077 ;
                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                            owl:hasValue obo:UO_0000228 ;
                                                                                            owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                                                            owl:hasValue 1.5 ;
                                                                                            owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ],
        noes:NOES_0000057 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:RO_0009007 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:OBI_0000070 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000009 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( pmd:PMD_0000008 [ a owl:Restriction ;
                                                    owl:onProperty pmd:PMD_0000077 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                        owl:hasValue obo:UO_0000106 ;
                                                                        owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                                        owl:hasValue 50.0 ;
                                                                        owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000009 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( pmd:PMD_0000008 [ a owl:Restriction ;
                                                    owl:onProperty pmd:PMD_0020127 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( noes:NOES_0000178 [ a owl:Restriction ;
                                                                        owl:onProperty pmd:PMD_0000077 ;
                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                            owl:hasValue obo:UO_0000228 ;
                                                                                            owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                                                            owl:hasValue 1.5 ;
                                                                                            owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ;
    skos:definition "Magnetic power loss at 1.5 T / 50 Hz is a total magnetic power loss that has been determined at 1.5 T of maximum magnetic induction B and 50 Hz of frequency of alternating magnetic field"@en ;
    pmd:symbol "P1.5/50"@en ;
    noes:NOES_0000122 false .

noes:NOES_0000072 a owl:Class ;
    rdfs:label "reduction of thickness"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025999 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                            owl:onProperty obo:OBI_0000295 ;
                                            owl:someValuesFrom noes:NOES_0000023 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025999 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                            owl:onProperty obo:OBI_0000312 ;
                                            owl:someValuesFrom noes:NOES_0000023 ] ) ] ] ) ],
        obo:BFO_0000145,
        pmd:PMD_0020317 ;
    skos:definition "Reduction of thickness is a relational quality between a sheet material before and after a rolling process. Reduction of thickness characterizes relation between the final and initial sheet thickness usually given in percent."@en ;
    skos:example "90% reduction of thickess during cold rolling from 3 mm to 0.30 mm."@en .

noes:NOES_0000073 a owl:Class ;
    rdfs:label "orientation distribution function calculation"@en ;
    rdfs:comment "Fix axiom\"!!" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:OBI_0000299 ;
            owl:someValuesFrom noes:NOES_0000008 ],
        pmd:PMD_0025012 ;
    skos:definition "An orientation distribution function is an analytical calculation that quantifies the statistical distribution of crystallographic orientations within a polycrystalline material, by  inverting two-dimensional experimental diffraction data (pole figures) into a continuous three-dimensional Euler space, i.e., orientation distribution functions (ODFs)."@en .

noes:NOES_0000074 a owl:Class ;
    rdfs:label "remanence in the transversal direction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009007 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0000829 [ a owl:Restriction ;
                                owl:onProperty obo:OBI_0000293 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0001015 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( noes:NOES_0000031 [ a owl:Restriction ;
                                                                        owl:onProperty pmd:PMD_0025998 ;
                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                owl:intersectionOf ( noes:NOES_0000160 [ a owl:Restriction ;
                                                                                            owl:onProperty pmd:PMD_0000077 ;
                                                                                            owl:someValuesFrom [ a owl:Class ;
                                                                                                    owl:intersectionOf ( obo:OBI_0001931 [ a owl:Restriction ;
                                                                                                                owl:hasValue 90 ;
                                                                                                                owl:onProperty obo:OBI_0001937 ] ) ] ] ) ] ] ) ] ] ) ] ] ) ] ],
        noes:NOES_0000050 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( noes:NOES_0000050 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0009007 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( pmd:PMD_0000829 [ a owl:Restriction ;
                                            owl:onProperty obo:OBI_0000293 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                                owl:onProperty obo:RO_0001015 ;
                                                                owl:someValuesFrom [ a owl:Class ;
                                                                        owl:intersectionOf ( noes:NOES_0000031 [ a owl:Restriction ;
