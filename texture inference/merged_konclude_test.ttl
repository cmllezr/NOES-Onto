    skos:definition "Bravais lattice orthorhombic primitive is a crystal lattice with orthorhombic lattice system and primitive lattice centering."@en .

cryo:CRYO_0000132 a owl:Class ;
    rdfs:label "bravais lattice orthorhombic body-centered"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000086 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( cryo:CRYO_0000027 [ a owl:Restriction ;
