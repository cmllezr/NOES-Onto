        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000663"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/noes/NOES_0000052"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/noes/NOES_0000141"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002503"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/noes/NOES_0000058"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000077"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000039"/>
                                                <owl:hasValue rdf:resource="http://purl.obolibrary.org/obo/UO_0000185"/>
                                            </owl:Restriction>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0001937"/>
                                                <owl:someValuesFrom>
                                                    <rdfs:Datatype>
                                                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                            <rdf:Description>
                                                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">15.0</xsd:maxInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">crystallite with cube texture orientation</rdfs:label>
        <skos:comment xml:lang="en">Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference.</skos:comment>
        <skos:definition xml:lang="en">crystallite with cube texture orientation is a crystallite whose family of &lt;100&gt; equivalent directions in a cubic lattice system are oriented approximately parallel to the rolling direction and family of {001} equivalent directions are oriented approximately parallel to the rolling plane.</skos:definition>
    </owl:Class>
    


