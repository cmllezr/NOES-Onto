PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX noes: <https://w3id.org/pmd/noes/> 
PREFIX obo: <http://purl.obolibrary.org/obo/> 
PREFIX pmd: <https://w3id.org/pmd/co/> 
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> 
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?material ?stepNumber ?process
WHERE {
    {
        SELECT ?material ?process (COUNT(?midProcess) AS ?stepNumber)
        WHERE {
            ?material rdf:type noes:NOES_0000180 . 
            
            # Identify the last process for this material
            { ?material obo:OBI_0000312 ?lastProcess . } 
            UNION 
            { ?material pmd:PMD_0000069 ?state . ?state obo:OBI_0000312 ?lastProcess . }
            
            # Use 'preceded by' to find the previous processes
            ?lastProcess obo:BFO_0000062* ?process .
            ?process obo:BFO_0000062* ?midProcess .
            
            # Make sure that these processes are manufacturing processes
            ?process rdf:type pmd:PMD_0000833 . 
            ?midProcess rdf:type pmd:PMD_0000833 .

            # Check of precedes or preceded by triples exist (to filter cutting)
            FILTER (
                ?process = ?lastProcess || 
                EXISTS { ?process obo:BFO_0000062 [] } || 
                EXISTS { ?process obo:BFO_0000063 [] }
            )
        }
        GROUP BY ?material ?process
    }
}
ORDER BY ?material ?stepNumber