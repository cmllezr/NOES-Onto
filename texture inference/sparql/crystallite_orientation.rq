PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ex: <http://example.org/>
prefix pmd: <https://w3id.org/pmd/co/>
prefix noes: <https://w3id.org/pmd/noes/>
prefix obo: <http://purl.obolibrary.org/obo/>
prefix cryo: <https://w3id.org/pmd/cryo/>
prefix tto: <https://w3id.org/pmd/tto/>

# Builds every grain's crystallite + area (as before), plus its
# misorientation-angle relational quality to each of the (up to 8) ideal
# textures CrystalliteBuilder staged a ?entry for. One generic OPTIONAL
# block handles all 8 textures at once -- ?entry's temp:misoNode/svsNode/
# idealNode are already fully-formed, deterministic ex: IRIs minted in
# Python (CrystalliteBuilder._stage / IdealTextureNodes), not left as
# CONSTRUCT template variables, so there's no per-texture duplication here
# and no risk of a template-only blank node being minted for a grain/
# texture pair that has no staged entry.

CONSTRUCT {
    ?grain a pmd:PMD_0000663 ; #crystallite
           obo:RO_0000086 ?area .

	?area a tto:TTO_0050000 ; # area, but to be replaced with dedicated grain area from micro ontology
		pmd:PMD_0000077 ?area_SVS . # specified by value

	?area_SVS a obo:OBI_0001931 ; # scalar value specification
			obo:OBI_0001937 ?areaValue ; # has numetic value
			obo:IAO_0000039 obo:UO_0000017 . # has unit microns

	?grain pmd:PMD_0025998 ?miso . # has relational quality

	?miso a noes:NOES_0000141 ; # misorientation angle
		pmd:PMD_0000077 ?svs ; # specified by value
		obo:RO_0002503 ?ideal . # towards

	?svs a obo:OBI_0001931 ;
		obo:IAO_0000039 obo:UO_0000185 ; # has measurement unit label = degree
		obo:OBI_0001937 ?angle .
}
WHERE {
    ?config <temp:grainID> ?id ;
            <temp:areaValue> ?areaValue .

    BIND(URI(CONCAT(STR(ex:), "grain_", ?id)) AS ?grain)
	BIND(URI(CONCAT(STR(ex:), "area_", ?id)) AS ?area)
	BIND(REPLACE(STR(?areaValue), "[.]", "_") AS ?areaValueClean)
	BIND(URI(CONCAT(STR(ex:), "SVS_", ?areaValueClean, "_mkm")) AS ?area_SVS)

	OPTIONAL {
		?entry <temp:grain> ?grain ;
			   <temp:misoNode> ?miso ;
			   <temp:svsNode> ?svs ;
			   <temp:idealNode> ?ideal ;
			   <temp:angleValue> ?angle .
	}
}
