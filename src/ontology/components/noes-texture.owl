        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000834"/>
        <rdfs:label>inverse pole figure</rdfs:label>
        <skos:definition xml:lang="en">An inverse pole figure is a stereographic projection that plots a specific, macroscopic physical direction of a sample, e.g., rolling or normal direction relative to the internal coordinate system of the crystal lattice, revealing the statistical frequency of grain orientations that align with that chosen physical axis.</skos:definition>
    </owl:Class>
    


