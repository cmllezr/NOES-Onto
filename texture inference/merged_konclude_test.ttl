        pmd:PMD_0000663 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000663 [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025998 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( noes:NOES_0000141 [ a owl:Restriction ;
                                            owl:onProperty pmd:PMD_0000077 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( [ a owl:Restriction ;
                                                                owl:hasValue obo:UO_0000185 ;
                                                                owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                                owl:onProperty obo:OBI_0001937 ;
                                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                                        owl:onDatatype xsd:float ;
                                                                        owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty pmd:PMD_0025999 ;
                                            owl:someValuesFrom noes:NOES_0000058 ] ) ] ] ) ] ;
    skos:comment "Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference."@en ;
    skos:definition "crystallite with cube texture orientation is a crystallite whose family of <100> equivalent directions in a cubic lattice system are oriented approximately parallel to the rolling direction and family of {001} equivalent directions are oriented approximately parallel to the rolling plane."@en .

<https://w3id.org/pmd/tto/TTO_0000004> a owl:Class ;
    rdfs:label "Verlängerung"@de,
        "elongation"@en ;
    rdfs:comment """'characteristic of' some 
    (object
     and ('is specified output of' some 
        ('tensile testing process'
         and ('has specified input' some 
            (object
             and ('has quality' some 'original gauge length'))))))""" ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/Elongation> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0000974 [ a owl:Restriction ;
                                owl:onProperty obo:OBI_0000293 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0000086 ;
                                                    owl:someValuesFrom <https://w3id.org/pmd/tto/TTO_0000028> ] ) ] ] ) ] ],
        obo:BFO_0000017,
        pmd:PMD_0000848 ;
    skos:definition "Zunahme der Anfangsmesslänge zu einem beliebigen Zeitpunkt während des Versuchs"@de,
        "increase in the original gauge length at any moment during the test"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en .

<https://w3id.org/pmd/tto/TTO_0000019> a owl:Class ;
    rdfs:label "Messlänge"@de,
        "gauge length"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/GaugeLength> ;
    rdfs:subClassOf pmd:PMD_0040001 ;
    skos:definition "Länge des parallelen Teils der Probe, an dem zu einem beliebigen Zeitpunkt während des Versuchs die Verlängerung gemessen wird"@de,
        "length of the parallel portion of the test piece on which elongation is measured at any moment during the test"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en ;
    pmd:symbol "L"@en .

<https://w3id.org/pmd/tto/TTO_0000047> a owl:Class ;
    rdfs:label "Dehngrenze bei plastischer Extensometer-Dehnung Rp02"@de,
        "proof strength plastic extension rp02"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/Rp02> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000044> ;
    skos:definition "Spannung bei einer plastischen Extensometer-Dehnung, die 0,2 Prozent der Extensometer-Messlänge entspricht"@de,
        "stress at which the plastic extension is equal to 0.2 percent of the extensometer gauge length"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en ;
    pmd:symbol "R_p_0.2"@en .

obo:BFO_0000108 a owl:ObjectProperty ;
    rdfs:label "exists at"@en ;
    rdfs:domain obo:BFO_0000001 ;
    rdfs:range obo:BFO_0000008 ;
    skos:definition "(Elucidation) exists at is a relation between a particular and some temporal region at which the particular exists"@en ;
    skos:example "First World War exists at 1914-1916; Mexico exists at January 1, 2000"@en .

obo:CHEBI_33303 a owl:Class ;
    rdfs:label "chalcogen" ;
    obo:IAO_0000115 "Any p-block element belonging to the group 16 family of the periodic table." ;
    rdfs:subClassOf obo:CHEBI_33250 .

obo:IAO_0000120 a owl:NamedIndividual ;
    rdfs:label "metadata complete"@en ;
    obo:IAO_0000115 "Class has all its metadata, but is either not guaranteed to be in its final location in the asserted IS_A hierarchy or refers to another class that is not complete."@en .

obo:OBI_0001927 a owl:ObjectProperty ;
    rdfs:label "specifies value of" ;
    obo:IAO_0000114 obo:IAO_0000123 ;
    obo:IAO_0000115 "A relation between a value specification and an entity which the specification is about."@en ;
    rdfs:domain obo:OBI_0001933 ;
    rdfs:subPropertyOf obo:IAO_0000136 ;
    owl:inverseOf pmd:PMD_0000077 .

obo:OBI_0001930 a owl:Class ;
    rdfs:label "categorical value specification" ;
    obo:IAO_0000114 obo:IAO_0000123 ;
    obo:IAO_0000115 "A value specification that is specifies one category out of a fixed number of nominal categories"@en ;
    obo:IAO_0000117 "PERSON:Bjoern Peters" ;
    rdfs:subClassOf obo:OBI_0001933 .

obo:RO_0002350 a owl:ObjectProperty ;
    rdfs:label "member of"@en ;
    obo:IAO_0000112 "An organism that is a member of a population of organisms" ;
    obo:IAO_0000115 "is member of is a mereological relation between a item and a collection." ;
    obo:IAO_0000119 "SIO" ;
    rdfs:subPropertyOf obo:BFO_0000050 ;
    owl:inverseOf obo:RO_0002351 .

obo:UO_0000051 a owl:Class ;
    rdfs:label "concentration unit" ;
    obo:IAO_0000115 "A unit which represents a standard measurement of how much of a given substance there is mixed with another substance." ;
    rdfs:subClassOf obo:IAO_0000003 .

obo:UO_0000187 a owl:Class ;
    rdfs:label "percent" ;
    obo:IAO_0000115 "A dimensionless ratio unit which denotes numbers as fractions of 100." ;
    oboInOwl:hasExactSynonym "%" ;
    rdfs:subClassOf obo:UO_0000190 .

pmd:PMD_0000004 a owl:ObjectProperty ;
    rdfs:label "is subject of"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    skos:definition "Inverse of 'is about'."@en .

pmd:PMD_0000005 a owl:Class ;
    rdfs:label "Materialeigenschaft"@de,
        "material performance property"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:comment """A property is a material trait in terms of the kind and magnitude of response to a specific imposed stimulus. Generally, definitions of properties are made independent of material shape and size.
(Callister, W.D., Rethwisch, D.G., Materials Science and Engineering, Wiley, 2014)

Technical materials are complex aggregates. Many properties that are determined for those aggregates are intrinsically associated with the methodologies employed in the measurement process. This is in contrast to typical 'physical' properties, which like e.g. mass that can be determined to high accuracy independently of the measurement process. 
As a consequence, material properties in the ontology are differeciated according to their measurement method, e.g. Brinell hardness and Vickers hardness are different types of indentation hardness rather than different measures/quantification (GDC) of the materials property 'indentation hardness'.
 The 'unit idenifieres' of such properties (e.g. "HV1", "HV10", "HBW") are strictly speaking not units but rather references to the measurement methodology used to determine a numeric value that quantifies the property.

Extensive properties that depend on the object being tested rather than on the portion of matter are (extensive) object- or system-properties."""@en ;
    rdfs:subClassOf _:N381208b319f040db801e26839fd9c03f,
        pmd:PMD_0020353,
        pmd:PMD_0023004 ;
    skos:definition "a disposition of a portion of matter that is realized in a compatible process and whose realization is grounded in the portions intensive qualities"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000551 a owl:Class ;
    rdfs:label "chemische Zusammensetzung"@de,
        "chemical composition"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:comment """See the editor note of composition to understand the difference between composition and chemical composition.

See the pattern example of composition to underatand the difference between composition and proportion."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0000000 [ a owl:Restriction ;
                                owl:onProperty obo:BFO_0000051 ;
                                owl:someValuesFrom pmd:PMD_0020140 ] ) ] ],
        pmd:PMD_0025001 ;
    skos:definition "Die chemische Zusammensetzung ist eine intensive Eigenschaft eines Materieteils, die die Arten und Anteile reiner chemischer Elemente in dem Materieteil beschreibt, und ist Gegenstand einiger Datenelemente zur chemischen Zusammensetzung."@de,
        "The chemical composition is an intensive quality of a portion of matter which describes the types and proportions of pure chemical elements in the portion of matter, and it is a subject of some chemical composition data item."@en ;
    pmd:PMD_0000060 true ;
    pmd:PMD_0000064 "Material has quality chemical composition. Chemical composition is a subject of chemical composition data item. Chemical composition data item has members fraction value specifications (which have a numeral and a unit). Material has part portion of carbon. Material has relational quality mass proportion. Portion of carbon  has relational quality mass proportion. Mass propotion is specified by value fraction value specification. Same approach for all chemical elements."@en .

pmd:PMD_0000848 a owl:Class ;
    rdfs:label "DEPRECATED mechanische Eigenschaft"@de,
        "DEPRECATED mechanical property"@en ;
    rdfs:comment "DEPRECATED The axiom that mechanical property has realization some application of mechanical load treats only conventional materials and not such effects as magnetostriction etc."@en ;
    rdfs:seeAlso pmd:PMD_0020311 ;
    owl:deprecated true ;
    skos:definition "DEPRECATED Eine mechanische Eigenschaft ist eine Materialeigenschaft, die eine Eigenschaft des Materials M ist. Eine mechanische Eigenschaft wird in einem stimulierenden Prozess (in den meisten Fällen durch Anwendung einer mechanischen Belastung) verwirklicht, und der stimulierende Prozess ist ein stattfindender Teil eines anderen Prozesses, an dem ein Objekt O, das eine Instanz von M ist, teilnimmt."@de,
        "DEPRECATED A mechanical property is a material property which is a characteristic of material M. Mechanical property has realization in a stimulating process (in most cases, application of mechanical load), and the stimulating process is an occurent part of another process, in which an object O that is an instance of M participates."@en .

pmd:PMD_0000849 a owl:Class ;
    rdfs:label "Mechanische Eigenschaften Analyseverfahren"@de,
        "mechanical property analyzing process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009006 ;
            owl:someValuesFrom pmd:PMD_0020311 ],
        obo:OBI_0000070 ;
    skos:definition "Eine Analyse, die die mechanischen Eigenschaften von Materialien bewertet, wie z.B. Festigkeit, Härte, Elastizität und Zugfestigkeit, oft durch Tests, die die Reaktion auf Kräfte und Lasten messen."@de,
        "An assay that evaluates the mechanical characteristics of materials, such as strength, hardness, elasticity, and tensile properties, often through tests that measure response to forces and loads."@en .

pmd:PMD_0000952 a owl:Class ;
    rdfs:label "Festigkeit"@de,
        "strength"@en ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty obo:BFO_0000054 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( obo:BFO_0000015 [ a owl:Restriction ;
                                                        owl:onProperty obo:BFO_0000117 ;
                                                        owl:someValuesFrom pmd:PMD_0020258 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty obo:RO_0000052 ;
                                    owl:someValuesFrom pmd:PMD_0000068 ] ) ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000052 ;
                        owl:someValuesFrom pmd:PMD_0000001 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002328 ;
                        owl:someValuesFrom pmd:PMD_0020200 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002328 ;
                        owl:someValuesFrom pmd:PMD_0080019 ] ) ],
        pmd:PMD_0020335,
        pmd:PMD_0023004 ;
    skos:definition "is a material property describing the stress before a characteristic (failure-) event occurs."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000975 a owl:Class ;
    rdfs:label "DEPRECATED Proben-Rolle"@de,
        "DEPRECATED test piece role"@en ;
    rdfs:comment "Duplicate" ;
    rdfs:seeAlso pmd:PMD_0000919 ;
    owl:deprecated true ;
    skos:definition "DEPRECATED Rolle eines Objekts, welches eine Probe ist, die aus einem Prüfling (Specimen) oder Probenabschnitt (Sample) entnommen wurde; die Probe hat festgelegte Dimensionen, kann maschinell bearbeitet sein, wurde in einen für die Verwendung in einem Prüfverfahren notwendigen Zustand gebracht"@de,
        "DEPRECATED Role of object which is a part taken from a specimen or sample; the part has specified dimensions, is machined or un-machined, brought to a required condition for submission to a given test"@en .

pmd:PMD_0001035 a owl:Class ;
    rdfs:label "angle"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0025018 ;
    skos:definition "A property that represents the measure of rotation or inclination between two intersecting lines or planes, independent of the size of the object." ;
    pmd:PMD_0001032 <https://github.com/materialdigital/core-ontology/issues/278> .

pmd:PMD_0020113 a owl:Class ;
    rdfs:label "fluid (object)"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf obo:BFO_0000030 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000030 [ a owl:Class ;
                        owl:unionOf ( pmd:PMD_0020289 pmd:PMD_0020290 ) ] ) ] ;
    skos:definition "Fluid (object) is an object that consists of some portion of matter which bears an aggregate state that concretizes a liquid or gaseous aggregate state."@en .

pmd:PMD_0020133 a owl:Class ;
    rdfs:label "Masse"@de,
        "mass"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000024 obo:BFO_0000027 obo:BFO_0000030 ) ] ],
        pmd:PMD_0023000 ;
    skos:definition "Mass is fundamental extensive quality."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020150 a owl:Class ;
    rdfs:label "Volumen"@de,
        "volume"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Necessary and sufficient conditions for 'volume' have not yet been formalized. The term is defined as a specific subtype of 'DimensionQuality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000918."@en ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf pmd:PMD_0020132,
        pmd:PMD_0023000 ;
    skos:definition "Volumen ist eine dreidimensionale Größe."@de,
        "Volume is a three dimensional size."@en ;
    skos:example "A cylindrical billet has a volume of 0.002 m3, determined from its radius and height"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020216 a owl:Class ;
    rdfs:label "DEPRECATED order scale value"@en ;
    rdfs:comment "Use appropriate class from crystall ontology instead" ;
    owl:deprecated true ;
    skos:definition "DEPRECATED Mögliche Werte der charakteristischen Länge, über die strukturelle Zusammenhänge in einem Material bestehen bleiben"@de,
        "DEPRECATED possible values of characteristic length over which structural correlations persist in a material"@en .

pmd:PMD_0020230 a owl:Class ;
    rdfs:label "solid solution"@en ;
    rdfs:subClassOf pmd:PMD_0020229,
        pmd:PMD_0020293 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0020229 pmd:PMD_0020293 ) ] ;
    skos:definition "a solution with solid aggregate state"@en .

pmd:PMD_0020290 a owl:Class ;
    rdfs:label "liquid"@en ;
    rdfs:subClassOf pmd:PMD_0020287 ;
    skos:definition "a portion of matter in an liquid aggregate state where the liquid's entities transmit no shear stress"@en .

pmd:PMD_0020293 a owl:Class ;
    rdfs:label "solid"@en ;
    rdfs:subClassOf pmd:PMD_0020287 ;
    skos:definition "a portion of matter in an solid aggregate state where the solid's entities transmit shear stress"@en .

pmd:PMD_0020364 a owl:Class ;
    rdfs:label "per count property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002328 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000001 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000086 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( pmd:PMD_0020367 [ a owl:Restriction ;
                                                    owl:onProperty pmd:PMD_0000077 ;
                                                    owl:someValuesFrom obo:OBI_0001931 ] ) ] ] ) ] ],
        pmd:PMD_0023001 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0023001 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002328 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:BFO_0000001 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000086 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( pmd:PMD_0020367 [ a owl:Restriction ;
                                                                owl:onProperty pmd:PMD_0000077 ;
                                                                owl:someValuesFrom obo:OBI_0001931 ] ) ] ] ) ] ] ) ] ;
    skos:definition "a quotient with a denominator that has is a count"@en .

pmd:PMD_0020368 a obo:OBI_0001931,
        owl:NamedIndividual ;
    rdfs:label "avogadro number"@en ;
    obo:IAO_0000039 <http://qudt.org/vocab/unit/PER-MOL> ;
    obo:OBI_0001937 602214086000000000000000.0 ;
    skos:definition "The Avogadro number"@en .

pmd:PMD_0050051 a owl:Class ;
    rdfs:label "Durchmesser"@de,
        "diameter"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Markus Schilling" ;
    obo:IAO_0000119 "“Diameter.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/diameter. Accessed 5 Dec. 2022." ;
    rdfs:seeAlso <https://w3id.org/pmd/co/2.0.8/Diameter> ;
    rdfs:subClassOf pmd:PMD_0040001 ;
    skos:definition "Die Länge einer geraden Linie durch den Mittelpunkt eines Objekts oder Raums."@de,
        "The length of a straight line through the center of an object or space."@en .

pmd:PMD_0050153 a owl:Class ;
    rdfs:label "Dicke"@de,
        "thickness"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Markus Schilling" ;
    rdfs:subClassOf pmd:PMD_0040001 ;
    skos:definition "Diese Klasse beschreibt das gemessene Maß in einer Richtung eines Prüfkörpers."@de,
        "A length that describes the measured dimension in one direction of a test piece."@en .

cryo:CRYO_0000021 a owl:Class ;
    rdfs:label "family of directions Miller indices"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000219 ;
            owl:someValuesFrom cryo:CRYO_0000012 ],
        cryo:CRYO_0000014 ;
    skos:definition "<111>",
        "Set of directions Miller indices define the components of symmetrically equivalent directions in a crystal lattice. Set of directions Miller indices must be written as <hkl>."@en .

cryo:CRYO_0000023 a owl:Class ;
    rdfs:label "family of planes Miller indices"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000219 ;
            owl:someValuesFrom cryo:CRYO_0000011 ],
        cryo:CRYO_0000014 ;
    skos:definition "Set of planes Miller indices define set of symmetrically equivalent planes. Set of planes must be written in curly brackets, e.g., {hkl}."@en ;
    skos:example "{111}" .

cryo:CRYO_0000382 a owl:Class ;
    rdfs:label "orthomombic crystal lattice"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000086 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                owl:hasValue cryo:CRYO_0000031 ;
                                owl:onProperty pmd:PMD_0000077 ] ) ] ],
        cryo:CRYO_0000001,
        cryo:CRYO_0000121 ;
    owl:deprecated true ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cryo:CRYO_0000001 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000086 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                            owl:hasValue cryo:CRYO_0000031 ;
                                            owl:onProperty pmd:PMD_0000077 ] ) ] ] ) ] .

noes:NOES_0000000 a owl:Class ;
    rdfs:label "relative permeability"@en ;
    rdfs:subClassOf pmd:PMD_0080026 ;
    skos:definition "Relative permeability  is type of magnetic permeability which is defined as a ratio of the material's permeability µ to that of free space µ0."@en ;
    pmd:symbol "µr" .

noes:NOES_0000048 a owl:Class ;
    rdfs:label "coercivity"@en ;
    rdfs:comment "A low H_c​ is desirable for soft magnetic materials like electrical steel, indicating easy magnetization and demagnetization"@en ;
    rdfs:subClassOf pmd:PMD_0020312 ;
    skos:altLabel "coercive field strength"@en ;
    skos:definition "Coercivity is a magnetic property which is stimulated under an application of magnetic field. It describesthe value of the magnetic field strength H required to reduce the Magnetic Flux Density B back to zero after the material has been driven to the saturation of magnetic flux density B_sat."@en ;
    pmd:symbol "Hc"@en .

noes:NOES_0000050 a owl:Class ;
    rdfs:label "remanence"@en ;
    rdfs:subClassOf noes:NOES_0000049 ;
    skos:altLabel "remnant Induction"@en ;
    skos:definition "Remanence is the magnetic induction B that remains in the material when the magnetic field strength H is reduced to zero."@en ;
    pmd:symbol "Br"@en .

noes:NOES_0000053 a owl:Class ;
    rdfs:label "magnetic power loss"@en ;
    rdfs:subClassOf pmd:PMD_0020312 ;
    skos:definition "Magnetic power loss is a magnetic property of materials which describes dissipated energy due to application of an external magnetic field H."@en .

noes:NOES_0000059 a owl:Class ;
    rdfs:label "differential permeability"@en ;
    rdfs:comment "Derivative dB/dH"@en ;
    rdfs:subClassOf pmd:PMD_0080026 ;
    skos:definition "Differential permeability is the instantaneous slope of the magnetization curve or hysteresis loop at any given point"@en ;
    pmd:symbol "µd"@en .

noes:NOES_0000062 a owl:Class ;
    rdfs:label "maximum permeability"@en ;
    rdfs:comment "The maximum value of the normal permeability (the steepest line from the origin to the magnetization curve)."@en ;
    rdfs:subClassOf pmd:PMD_0080026 ;
    skos:definition "Maximum permeability is the steepest part of the B-H curve, where the material most readily accepts field. it indicates the easiest magnetization point of the material,"@en ;
    pmd:symbol "µmax"@en .

noes:NOES_0000113 a owl:Class ;
    rdfs:label "crystallite with ideal η-fiber texture orientation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0001015 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( cryo:CRYO_0000012 [ a owl:Restriction ;
                                owl:onProperty cryo:CRYO_0000168 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( cryo:CRYO_0000014 [ a owl:Restriction ;
                                                    owl:hasValue "<001>" ;
                                                    owl:onProperty cryo:CRYO_0000016 ] ) ] ] [ a owl:Restriction ;
                                owl:onProperty noes:NOES_0000067 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( noes:NOES_0000033 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0001025 ;
                                                    owl:someValuesFrom pmd:PMD_0000000 ] ) ] ] ) ] ],
        pmd:PMD_0000663 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000663 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0001015 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( cryo:CRYO_0000012 [ a owl:Restriction ;
                                            owl:onProperty cryo:CRYO_0000168 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( cryo:CRYO_0000014 [ a owl:Restriction ;
                                                                owl:hasValue "<001>" ;
                                                                owl:onProperty cryo:CRYO_0000016 ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty noes:NOES_0000067 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( noes:NOES_0000033 [ a owl:Restriction ;
                                                                owl:onProperty obo:RO_0001025 ;
                                                                owl:someValuesFrom pmd:PMD_0000000 ] ) ] ] ) ] ] ) ] .

noes:NOES_0000162 a owl:Class ;
    rdfs:label "crystallite with α-fiber texture orientation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0025998 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( noes:NOES_0000141 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000077 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( [ a owl:Restriction ;
                                                    owl:hasValue obo:UO_0000185 ;
                                                    owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                    owl:onProperty obo:OBI_0001937 ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:float ;
                                                            owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0025999 ;
                                owl:someValuesFrom noes:NOES_0000139 ] ) ] ],
        pmd:PMD_0000663 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000663 [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025998 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( noes:NOES_0000141 [ a owl:Restriction ;
                                            owl:onProperty pmd:PMD_0000077 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( [ a owl:Restriction ;
                                                                owl:hasValue obo:UO_0000185 ;
                                                                owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                                owl:onProperty obo:OBI_0001937 ;
                                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                                        owl:onDatatype xsd:float ;
                                                                        owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty pmd:PMD_0025999 ;
                                            owl:someValuesFrom noes:NOES_0000139 ] ) ] ] ) ] ;
    skos:comment "Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference."@en ;
    skos:definition "crystallite with α-fiber texture orientation is a crystallite whose family of <110> equivalent directions in a cubic lattice system are oriented approximately parallel to the rolling direction."@en .

noes:NOES_0000182 a owl:Class ;
    rdfs:label "peak magnetic polarization"@en ;
    rdfs:subClassOf noes:NOES_0000178 ;
    skos:altLabel "saturation polatization"@en ;
    skos:definition "Peak magnetic polarization is a maximum magnetic polarization that a material exhibits under the applied external magnetic field Hmax."@en ;
    pmd:symbol "Jmax",
        "Jsat"@en .

obo:BFO_0000016 a owl:Class ;
    rdfs:label "disposition"@en ;
    obo:IAO_0000112 "an atom of element X has the disposition to decay to an atom of element Y"@en,
        "certain people have a predisposition to colon cancer"@en,
        "children are innately disposed to categorize objects in certain ways."@en,
        "the cell wall is disposed to filter chemicals in endocytosis and exocytosis"@en ;
    obo:IAO_0000116 "BFO 2 Reference: Dispositions exist along a strength continuum. Weaker forms of disposition are realized in only a fraction of triggering cases. These forms occur in a significant number of cases of a similar type."@en ;
    rdfs:subClassOf obo:BFO_0000017 ;
    owl:disjointWith obo:BFO_0000023 ;
    skos:altLabel "internally-grounded realizable entity"@en ;
    skos:definition "(Elucidation) A disposition b is a realizable entity such that if b ceases to exist then its bearer is physically changed & b's realization occurs when and because this bearer is in some special physical circumstances & this realization occurs in virtue of the bearer's physical make-up"@en ;
    skos:example "An atom of element X has the disposition to decay to an atom of element Y; the cell wall is disposed to transport cellular material through endocytosis and exocytosis; certain people have a predisposition to colon cancer; children are innately disposed to categorize objects in certain ways"@en .

obo:BFO_0000117 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has occurrent part"@en ;
    rdfs:domain obo:BFO_0000003 ;
    rdfs:range obo:BFO_0000003 ;
    rdfs:subPropertyOf obo:BFO_0000051 ;
    owl:inverseOf obo:BFO_0000132 ;
    skos:definition "b has occurrent part c =Def c occurrent part of b"@en ;
    skos:example "Mary's life has occurrent part Mary's 5th birthday"@en .

obo:CHEBI_33250 a owl:Class ;
    rdfs:label "atom" ;
    obo:IAO_0000115 "A chemical entity constituting the smallest component of an element having the chemical properties of the element." ;
    rdfs:subClassOf obo:CHEBI_24431 .

obo:CHEBI_33319 a owl:Class ;
    rdfs:label "lanthanoid atom" ;
    rdfs:subClassOf obo:CHEBI_33521 .

obo:IAO_0000033 a owl:Class ;
    rdfs:label "directive information entity"@en ;
    obo:IAO_0000115 "An information content entity whose concretizations indicate to their bearer how to realize them in a process."@en ;
    obo:IAO_0000116 "2009-03-16: provenance: a term realizable information entity was proposed for OBI (OBI_0000337) , edited by the PlanAndPlannedProcess branch. Original definition was  \"is the specification of a process that can be concretized and realized by an actor\" with alternative term  \"instruction\".It has been subsequently moved to IAO where the objective for which the original term was defined was satisfied with the definitionof this, different, term."@en,
        "2013-05-30 Alan Ruttenberg: What differentiates a directive information entity from an information concretization is that it can have concretizations that are either qualities or realizable entities. The concretizations that are realizable entities are created when an individual chooses to take up the direction, i.e. has the intention to (try to) realize it."@en,
        "8/6/2009 Alan Ruttenberg: Changed label from \"information entity about a realizable\" after discussions at ICBO"@en,
        "Werner pushed back on calling it realizable information entity as it isn't realizable. However this name isn't right either. An example would be a recipe. The realizable entity would be a plan, but the information entity isn't about the plan, it, once concretized, *is* the plan. -Alan"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000136 ;
            owl:someValuesFrom obo:BFO_0000017 ],
        obo:IAO_0000030 .

obo:RO_0000056 a owl:ObjectProperty ;
    rdfs:label "participates in"@en ;
    obo:IAO_0000112 "this blood clot participates in this blood coagulation"@en,
        "this input material (or this output material) participates in this process"@en,
        "this investigator participates in this investigation"@en ;
    obo:IAO_0000115 "a relation between a continuant and a process, in which the continuant is somehow involved in the process"@en ;
    rdfs:domain obo:BFO_0000002 ;
    rdfs:range obo:BFO_0000003 ;
    owl:inverseOf obo:RO_0000057 .

obo:UO_0000228 a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "tesla" ;
    obo:IAO_0000115 "A magnetic flux density unit which is equal to one weber per square meter." ;
    oboInOwl:hasExactSynonym "T",
        "Wb/m2" ;
    rdfs:subClassOf obo:UO_1000228 .

pmd:PMD_0000957 a owl:Class ;
    rdfs:label "Struktur Eigenschaften Analyseverfahren"@de,
        "structural property analyzing process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf obo:OBI_0000070 ;
    skos:definition "Eine Analyse, die die äußere und innere Struktur und Morphologie von Materialien untersucht, einschließlich der Anordnung von Atomen, Kristallen, Körnern und Phasen, oft unter Verwendung von Techniken wie Mikroskopie und Beugung."@de,
        "An assay that examines the external and internal structure and morphology of materials, including the arrangement of atoms, crystals, grains, and phases, often using techniques like microscopy and diffraction."@en .

pmd:PMD_0000967 a owl:Class ;
    rdfs:label "Temperatur"@de,
        "temperature"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:comment "The concept refers to an absolute temperature, not to be mistaken with temperature difference."@en,
        "To express that an object has a temperature, the property 'intensive bearer of' can be used. It implies a chain of: object consists of some portion of matter and portion of matter bearer of some temperature."@en ;
    rdfs:subClassOf pmd:PMD_0023043 ;
    skos:definition "Die Temperatur ist eine grundlegende intensive Qualität, die die durchschnittliche atomare oder molekulare Bewegung oder Schwingung eines Teils der Materie darstellt."@de,
        "The temperature is a fundamental intensive quality representing the average atomic or molcular movement or vibration of a portion of matter."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020200 a owl:Class ;
    rdfs:label "force"@en ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    obo:IAO_0000119 "Old definition: Force is a reciprocal relation realized between two objects where the other object exerts the same force with opposite sign onto the first. Force may be responsible for changes in velocity and/or deformation of objects." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0025999 ;
            owl:someValuesFrom obo:BFO_0000030 ],
        pmd:PMD_0020311,
        pmd:PMD_0020317 ;
    skos:definition "A force is an entity that consists of a reciprocal interaction between two objects and is realized as equal and opposite influences capable of changing motion or causing deformation."@en .

pmd:PMD_0020229 a owl:Class ;
    rdfs:label "solution"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002351 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:CHEBI_60003 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000087 ;
                                owl:someValuesFrom pmd:PMD_0020227 ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0002351 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:CHEBI_60003 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000087 ;
                                owl:someValuesFrom pmd:PMD_0020228 ] ) ] ],
        pmd:PMD_0000001 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002351 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:CHEBI_60003 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000087 ;
                                            owl:someValuesFrom pmd:PMD_0020227 ] ) ] ] [ a owl:Restriction ;
                        owl:onClass [ a owl:Class ;
                                owl:intersectionOf ( obo:CHEBI_60003 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000087 ;
                                            owl:someValuesFrom pmd:PMD_0020228 ] ) ] ;
                        owl:onProperty obo:RO_0002351 ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ;
    skos:definition "A portion of matter that is homogeneous, made up of at least two entity types, one playing the role of sovlent and the others playing the role of solute"@en .

pmd:PMD_0023001 a owl:Class ;
    rdfs:label "normalized property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002328 ;
            owl:someValuesFrom obo:BFO_0000020 ],
        pmd:PMD_0023002 ;
    owl:disjointUnionOf ( pmd:PMD_0020364 pmd:PMD_0020365 pmd:PMD_0020366 ) ;
    skos:definition "a facetted property that subsumes quotient classes"@en .

pmd:PMD_0023002 a owl:Class ;
    rdfs:label "facetted property"@en ;
    rdfs:subClassOf pmd:PMD_0020265 ;
    skos:definition "an specifically dependent continuant that is giving more detail to an other property or about its bearer"@en .

pmd:PMD_0040001 a owl:Class ;
    rdfs:label "Länge"@de,
        "length"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Necessary and sufficient conditions for 'length' have not yet been formalized. The term is defined as a specific subtype of 'DimensionQuality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000122."@en ;
    obo:IAO_0000117 "PERSON: Lars Vogt" ;
    rdfs:comment "Length is a size that describes the spatial extent of its bearer in one dimension."@en ;
    rdfs:subClassOf pmd:PMD_0020132 ;
    skos:altLabel "dimension"@en ;
    skos:definition "Die Länge ist eine eindimensionale Größe."@de,
        "Length is a one dimensional size."@en ;
    skos:example "A steel rod measures 250 mm in length between its two end faces"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0080026 a owl:Class ;
    rdfs:label "magnetische Permeabilität"@de,
        "magnetic permeability"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Necessary and sufficient conditions for 'magnetic permeability' have not yet been formalized. The term is defined as a specific subtype of 'magnetic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
    obo:IAO_0000117 "PERSON: Thomas Hanke" ;
    rdfs:subClassOf pmd:PMD_0020353 ;
    skos:altLabel "Permeabilität"@de,
        "permeability"@en,
        "μ"@en ;
    skos:definition "Magnetische Permeabilität ist eine magnetische Qualität eines Materials, die seine Fähigkeit quantifiziert, ein Magnetfeld in seinem Inneren zu unterstützen, ausgedrückt als Verhältnis der magnetischen Flussdichte zur aufgebrachten magnetischen Feldstärke"@de,
        "Magnetic permeability is a magnetic quality of a material that quantifies its ability to support the formation of a magnetic field within itself, expressed as the ratio of magnetic flux density to the applied magnetic field intensity"@en ;
    pmd:PMD_0000060 true .

cryo:CRYO_0000045 a owl:NamedIndividual ;
    rdfs:label "face centered"@en ;
    skos:altLabel "F" ;
    skos:definition "Face centered centering type is a centering type, where lattice points are located  on the corners of a unit cell, i.e., at coordinates (0,0,0), and at the center of each faces of a unit cell, i.e., at coordinates (1/2,1/2,0), (1/2,0,1/2), and (0,1/2,1/2)."@en .

cryo:CRYO_0000046 a owl:NamedIndividual ;
    rdfs:label "base centered"@en ;
    rdfs:comment "Add symbol annotation property" ;
    skos:altLabel "C" ;
    skos:definition "Base centered centering type is a centering type, where lattice points are located on the corners of a unit cell, i.e., at coordinates (0,0,0), and one additional lattice point is located at the center of a base of the cell, i.e., at coordinates (1/2,1/2,0)."@en .

noes:NOES_0000036 a owl:Class ;
    rdfs:label "normal direction"@en ;
    rdfs:subClassOf noes:NOES_0000001 ;
    skos:definition "Normal direction is a rolled sheet direction which is normal to the rolling plane of the sheet."@en .

noes:NOES_0000051 a owl:Class ;
    rdfs:label "saturation induction"@en ;
    rdfs:subClassOf noes:NOES_0000049 ;
    skos:altLabel "saturation magnetic flux density"@en ;
    skos:definition "Saturation induction is a magnetic property which is stimulated under an application of magnetic field. It characterizes the maximum induction B a material can achieve, i.e., the saturation induction is reached when it remains unchanged with increasing magnetic field strength H."@en ;
    pmd:symbol "Bmax",
        "Bsat"@en .

noes:NOES_0000139 a owl:Class ;
    rdfs:label "crystallite with ideal α-fiber texture orientation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0001015 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( cryo:CRYO_0000012 [ a owl:Restriction ;
                                owl:onProperty cryo:CRYO_0000168 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( cryo:CRYO_0000014 [ a owl:Restriction ;
                                                    owl:hasValue "<110>" ;
                                                    owl:onProperty cryo:CRYO_0000016 ] ) ] ] [ a owl:Restriction ;
                                owl:onProperty noes:NOES_0000067 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( noes:NOES_0000033 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0001025 ;
                                                    owl:someValuesFrom pmd:PMD_0000000 ] ) ] ] ) ] ],
        pmd:PMD_0000663 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000663 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0001015 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( cryo:CRYO_0000012 [ a owl:Restriction ;
                                            owl:onProperty cryo:CRYO_0000168 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( cryo:CRYO_0000014 [ a owl:Restriction ;
                                                                owl:hasValue "<110>" ;
                                                                owl:onProperty cryo:CRYO_0000016 ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty noes:NOES_0000067 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( noes:NOES_0000033 [ a owl:Restriction ;
                                                                owl:onProperty obo:RO_0001025 ;
                                                                owl:someValuesFrom pmd:PMD_0000000 ] ) ] ] ) ] ] ) ] .

noes:NOES_0000151 a owl:Class ;
    rdfs:label "crystallite with rotated Goss texture orientation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0025998 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( noes:NOES_0000141 [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0000077 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( [ a owl:Restriction ;
                                                    owl:hasValue obo:UO_0000185 ;
                                                    owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                    owl:onProperty obo:OBI_0001937 ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:float ;
                                                            owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] [ a owl:Restriction ;
                                owl:onProperty pmd:PMD_0025999 ;
                                owl:someValuesFrom noes:NOES_0000071 ] ) ] ],
        pmd:PMD_0000663 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000663 [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025998 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( noes:NOES_0000141 [ a owl:Restriction ;
                                            owl:onProperty pmd:PMD_0000077 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( [ a owl:Restriction ;
                                                                owl:hasValue obo:UO_0000185 ;
                                                                owl:onProperty obo:IAO_0000039 ] [ a owl:Restriction ;
                                                                owl:onProperty obo:OBI_0001937 ;
                                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                                        owl:onDatatype xsd:float ;
                                                                        owl:withRestrictions ( [ xsd:maxInclusive "15.0"^^xsd:float ] ) ] ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty pmd:PMD_0025999 ;
                                            owl:someValuesFrom noes:NOES_0000071 ] ) ] ] ) ] ;
    skos:comment "Note: this class is  not intended to be asserted, but inferred based on the grain orientation relative to the rolling reference frame. It is a part of the macroscopic texture inference."@en ;
    skos:definition "crystallite with rotated Goss texture orientation is a crystallite whose family of <110> equivalent directions in a cubic lattice system are oriented approximately parallel to the rolling direction and family of {110} equivalent directions are oriented approximately parallel to the rolling plane."@en .

noes:NOES_0000178 a owl:Class ;
    rdfs:label "magnetic polarization"@en ;
    rdfs:comment """TODO add axioms
1. When the magnetic qualities are realized
2. Especially for peak values that would be interesting"""@en ;
    rdfs:subClassOf pmd:PMD_0020312 ;
    skos:definition "Magnetic polarization is a magnetic property which is a measure of intrinsic magnetization of a material (alignment of magnetic dipoles) as a response to the externaly applied magnetic field H. It is determined as a difference between magnetic induction B and the external field µ0*H."@en ;
    pmd:symbol "J" .

obo:BFO_0000023 a owl:Class ;
    rdfs:label "role"@en ;
    obo:IAO_0000112 "John’s role of husband to Mary is dependent on Mary’s role of wife to John, and both are dependent on the object aggregate comprising John and Mary as member parts joined together through the relational quality of being married."@en,
        "the priest role"@en,
        "the role of a boundary to demarcate two neighboring administrative territories"@en,
        "the role of a building in serving as a military target"@en,
        "the role of a stone in marking a property boundary"@en,
        "the role of subject in a clinical trial"@en,
        "the student role"@en ;
    obo:IAO_0000115 "A realizable entity  the manifestation of which brings about some result or end that is not essential to a continuant  in virtue of the kind of thing that it is but that can be served or participated in by that kind of continuant  in some kinds of natural, social or institutional contexts."@en ;
    obo:IAO_0000116 "BFO 2 Reference: One major family of examples of non-rigid universals involves roles, and ontologies developed for corresponding administrative purposes may consist entirely of representatives of entities of this sort. Thus ‘professor’, defined as follows,b instance_of professor at t =Def. there is some c, c instance_of professor role & c inheres_in b at t.denotes a non-rigid universal and so also do ‘nurse’, ‘student’, ‘colonel’, ‘taxpayer’, and so forth. (These terms are all, in the jargon of philosophy, phase sortals.) By using role terms in definitions, we can create a BFO conformant treatment of such entities drawing on the fact that, while an instance of professor may be simultaneously an instance of trade union member, no instance of the type professor role is also (at any time) an instance of the type trade union member role (any more than any instance of the type color is at any time an instance of the type length).If an ontology of employment positions should be defined in terms of roles following the above pattern, this enables the ontology to do justice to the fact that individuals instantiate the corresponding universals –  professor, sergeant, nurse – only during certain phases in their lives."@en ;
    rdfs:subClassOf obo:BFO_0000017 ;
    skos:altLabel "externally-grounded realizable entity"@en ;
    skos:definition "(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be & b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed"@en ;
    skos:example "The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a boundary to demarcate two neighbouring administrative territories; the role of a building in serving as a military target"@en .

obo:BFO_0000054 a owl:ObjectProperty ;
    rdfs:label "has realization"@en,
        "realized in"@en ;
    rdfs:domain obo:BFO_0000017 ;
    rdfs:range obo:BFO_0000015 ;
    owl:inverseOf obo:BFO_0000055 ;
    skos:altLabel "realized in"@en ;
    skos:definition "b has realization c =Def c realizes b"@en ;
    skos:example "As for realizes"@en .

obo:BFO_0000145 a owl:Class ;
    rdfs:label "relational quality"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0025999 ;
            owl:someValuesFrom obo:BFO_0000002 ],
        obo:BFO_0000019 ;
    skos:definition "b is a relational quality =Def b is a quality & there exists c and d such that c and d are not identical & b specifically depends on c & b specifically depends on d"@en ;
    skos:example "A marriage bond; an instance of love; an obligation between one person and another"@en .

obo:BFO_0000146 a owl:Class ;
    rdfs:label "fiat surface"@en ;
    rdfs:subClassOf obo:BFO_0000140 ;
    skos:definition "(Elucidation) A fiat surface is a two-dimensional continuant fiat boundary that is self-connected"@en ;
    skos:example "The surface of the Earth; the plane separating the smoking from the non-smoking zone in a restaurant"@en .

obo:CHEBI_137980 a owl:Class ;
    rdfs:label "metalloid atom" ;
    obo:IAO_0000115 "An atom of an element that exhibits properties that are between those of metals and nonmetals, or that has a mixture of them. The term generally includes boron, silicon, germanium, arsenic, antimony, and tellurium, while carbon, aluminium, selenium, polonium, and astatine are less commonly included." ;
    rdfs:subClassOf obo:CHEBI_33250 .

obo:IAO_0000219 a owl:ObjectProperty ;
    rdfs:label "denotes"@en ;
    obo:IAO_0000112 "A person's name denotes the person. A variable name in a computer program denotes some piece of memory. Lexically equivalent strings can denote different things, for instance \"Alan\" can denote different people. In each case of use, there is a case of the denotation relation obtaining, between \"Alan\" and the person that is being named."@en ;
    obo:IAO_0000115 "A primitive, instance-level, relation obtaining between an information content entity and some portion of reality. Denotation is what happens when someone creates an information content entity E in order to specifically refer to something. The only relation between E and the thing is that E can be used to 'pick out' the thing. This relation connects those two together. Freedictionary.com sense 3: To signify directly; refer to specifically"@en ;
    obo:IAO_0000116 """2009-11-10 Alan Ruttenberg. Old definition said the following to emphasize the generic nature of this relation. We no longer have 'specifically denotes', which would have been primitive, so make this relation primitive.
g denotes r =def 
r is a portion of reality
there is some c that is a concretization of g 
every c that is a concretization of g specifically denotes r"""@en ;
    obo:IAO_0000119 "Conversations with Barry Smith, Werner Ceusters, Bjoern Peters, Michel Dumontier, Melanie Courtot, James Malone, Bill Hogan"@en ;
    rdfs:comment ""@en ;
    rdfs:domain obo:IAO_0000030 ;
    rdfs:range obo:BFO_0000001 ;
    rdfs:subPropertyOf obo:IAO_0000136 ;
    owl:inverseOf obo:IAO_0000235 .

obo:RO_0000081 a owl:ObjectProperty ;
    rdfs:label "role of"@en ;
    obo:IAO_0000112 "this investigator role is a role of this person"@en ;
    obo:IAO_0000115 "a relation between a role and an independent continuant (the bearer), in which the role specifically depends on the bearer for its existence"@en ;
    obo:IAO_0000116 "A role inheres in its bearer at all times for which the role exists, however the role need not be realized at all the times that the role exists."@en ;
    rdfs:comment "This relation is modeled after the BFO relation of the same name which was in BFO2, but is used in a more restricted sense - specifically, we model this relation as functional (inherited from characteristic-of). Note that this relation is now removed from BFO2020." ;
    rdfs:subPropertyOf obo:RO_0000052 ;
    owl:inverseOf obo:RO_0000087 .

pmd:PMD_0020003 a owl:Class ;
    rdfs:label "crystal"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000086 ;
            owl:someValuesFrom pmd:PMD_0000591 ],
        obo:BFO_0000030 ;
    skos:definition "A crystal is an object that has a quality \"crystal structure\"."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020311 a owl:Class ;
    rdfs:label "classical mechanics property"@en ;
    rdfs:subClassOf pmd:PMD_0020265 ;
    skos:definition "a property that is commonly associated with the domain of classical (Newtonian) mechanics"@en .

cryo:CRYO_0000033 a owl:NamedIndividual ;
    rdfs:label "rhombohedral"@en ;
    skos:definition "Rhombohedral crystal system is a crystal system with one threefold rotation axis."@en .

<https://w3id.org/pmd/tto/TTO_0000005> a owl:Class ;
    rdfs:label "Verlängerung (der Extensometer-Messlänge)"@de,
        "extension"@en ;
    obo:IAO_0000114 obo:IAO_0000428 ;
    rdfs:comment """Hinweis: Die Dehnung kann mit verschiedenen Kanälen gemessen werden (z. B. bei Verwendung von einem oder zwei Dehnungsmesserkanälen); in der Regel wird als Dehnungswert der mittlere Durchschnittswert der beteiligten Kanäle angegeben, falls zutreffend.

Hinweis: Die optische Längenänderungsmessung kann eine besondere Methode der Datenspeicherung erfordern."""@de,
        """Dimensional analysis: L
Unit (e.g. SI): mm"""@en,
        """Note: The extension might be measured using different channels (e.g. when using one or two extensometer channels); usually, the mean average value of involved channels is given as extension value, if applicable.

Note: Optical extensometry may require a specific data storage method."""@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/co/2.0.8/Extension> ;
    rdfs:subClassOf pmd:PMD_0000848 ;
    skos:definition "Zunahme der Extensometer-Messlänge zu einem beliebigen Zeitpunkt eines Versuchs"@de,
        "Increase in the extensometer gauge length at any moment during a test"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019" .

<https://w3id.org/pmd/tto/TTO_0000009> a owl:Class ;
    rdfs:label "Streckgrenze"@de,
        "yield strength"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/YieldStrength> ;
    rdfs:subClassOf pmd:PMD_0000952 ;
    skos:definition "Wenn der metallische Werkstoff diese Eigenschaft aufweist: die Spannung zu einem bestimmten Zeitpunkt während des Versuchs bei dem eine plastische Verformung ohne Zunahme der Kraft auftritt"@de,
        "when the metallic material exhibits a yield phenomenon, stress corresponding to the point reached during the test at which plastic deformation occurs without any increase in the force"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en .

<https://w3id.org/pmd/tto/TTO_0000033> a owl:Class ;
    rdfs:label "Bruchdehnung"@de,
        "percentage elongation after fracture"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/PercentageElongationAfterFracture> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000004> ;
    skos:definition "bleibende Verlängerung der Messlänge nach dem Bruch (L_u − L_o), angegeben in Prozent, bezogen auf die Anfangsmesslänge"@de,
        "permanent elongation of the gauge length after fracture (L_u − L_o), expressed as a percentage of the original gauge length"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en ;
    pmd:symbol "A"@en .

<https://w3id.org/pmd/tto/TTO_0000037> a owl:Class ;
    rdfs:label "Plastische Extensometer-Dehnung bei Höchstkraft"@de,
        "percentage plastic extension at maximum force"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/PercentagePlasticExtensionAtMaximumForce> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000005> ;
    skos:definition "plastische Verlängerung der Extensometer-Messlänge bei Höchstkraft, angegeben in Prozent, bezogen auf die Extensometer-Messlänge"@de,
        "plastic extension at maximum force, expressed as a percentage of the extensometer gauge length"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en ;
    pmd:symbol "A_g"@en .

<https://w3id.org/pmd/tto/TTO_0000039> a owl:Class ;
    rdfs:label "Gesamte Extensometer-Dehnung beim Bruch"@de,
        "percentage total extension at fracture"@en ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/PercentageTotalExtensionAtFracture> ;
    rdfs:subClassOf <https://w3id.org/pmd/tto/TTO_0000005> ;
    skos:definition "gesamte Verlängerung (elastische plus plastische Verlängerung) der Extensometer-Messlänge beim Bruch, angegeben in Prozent, bezogen auf die Extensometer-Messlänge"@de,
        "total extension (elastic extension plus plastic extension) at the moment of fracture, expressed as a percentage of the extensometer gauge length"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en ;
    pmd:symbol "A_t"@en .

<https://w3id.org/pmd/tto/TTO_0000053> a owl:Class ;
    rdfs:label "Zugfestigkeit"@de,
        "tensile strength"@en ;
    obo:IAO_0000114 obo:IAO_0000428 ;
    rdfs:isDefinedBy <https://w3id.org/pmd/tto> ;
    rdfs:seeAlso <https://w3id.org/pmd/tto/TensileStrength> ;
    rdfs:subClassOf pmd:PMD_0000952 ;
    skos:definition "Spannung, die der Höchstkraft entspricht"@de,
        "stress corresponding to the maximum force"@en ;
    pmd:definitionSource "DIN EN ISO 6892-1:2019"@en ;
    pmd:symbol "R_m"@en .

<https://w3id.org/pmd/tto/TTO_1000000> a owl:Class ;
    rdfs:label "Streckgrenzenverhältnis"@de,
        "yield strength ratio"@en ;
    rdfs:seeAlso "https://www.zwickroell.com/industries/materials-testing/tensile-test/yield-point/",
        "Yield strength ratio is a mechanical property which is determined as a ratio between the offset yield Rp0.2 and the ultimate tensile strength Rm."@en ;
    rdfs:subClassOf pmd:PMD_0000848 ;
    skos:definition "Streckgrenzenverhältnis ist eine mechanische Eigenschaft, die als Verhältnis zwischen der Dehngrenze Rp0.2 und der Zugfestigkeit Rm bestimmt wird."@de ;
    pmd:symbol "Rp0.2 / Rm" .

obo:BFO_0000006 a owl:Class ;
    rdfs:label "spatial region"@en ;
    rdfs:subClassOf obo:BFO_0000141 ;
    skos:definition "(Elucidation) A spatial region is a continuant entity that is a continuant part of the spatial projection of a portion of spacetime at a given time"@en ;
    skos:example "As for zero-dimensional spatial region, one-dimensional spatial region, two-dimensional spatial region, three-dimensional spatial region"@en .

obo:BFO_0000008 a owl:Class ;
    rdfs:label "temporal region"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000008 ;
            owl:onProperty obo:BFO_0000132 ],
        obo:BFO_0000003 ;
    skos:definition "(Elucidation) A temporal region is an occurrent over which processes can unfold"@en ;
    skos:example "As for zero-dimensional temporal region and one-dimensional temporal region"@en .

obo:BFO_0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    obo:IAO_0000112 "The entries in your database are patterns instantiated as quality instances in your hard drive. The database itself is an aggregate of such patterns. When you create the database you create a particular instance of the generically dependent continuant type database. Each entry in the database is an instance of the generically dependent continuant type IAO: information content entity."@en,
        "the pdf file on your laptop, the pdf file that is a copy thereof on my laptop"@en,
        "the sequence of this protein molecule; the sequence that is a copy thereof in that protein molecule."@en ;
    obo:IAO_0000115 "b is a generically dependent continuant = Def. b is a continuant that g-depends_on one or more other entities. (axiom label in BFO2 Reference: [074-001])"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000031 ;
            owl:onProperty obo:BFO_0000050 ],
        obo:BFO_0000002 ;
    skos:altLabel "g-dependent continuant"@en ;
    skos:definition "(Elucidation) A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share"@en ;
    skos:example "The pdf file on your laptop; the pdf file that is a copy thereof on my laptop; the sequence of this protein molecule; the sequence that is a copy thereof in that protein molecule; the content that is shared by a string of dots and dashes written on a page and the transmitted Morse code signal; the content of a sentence; an engineering blueprint"@en .

obo:BFO_0000035 a owl:Class ;
    rdfs:label "process boundary"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000015 obo:BFO_0000035 ) ] ;
            owl:onProperty obo:BFO_0000132 ],
        [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000035 ;
            owl:onProperty obo:BFO_0000117 ],
        obo:BFO_0000003 ;
    skos:definition "p is a process boundary =Def p is a temporal part of a process & p has no proper temporal parts"@en ;
    skos:example "The boundary between the 2nd and 3rd year of your life"@en .

obo:BFO_0000132 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "occurrent part of"@en ;
    rdfs:domain obo:BFO_0000003 ;
    rdfs:range obo:BFO_0000003 ;
    rdfs:subPropertyOf obo:BFO_0000050 ;
    skos:definition "(Elucidation) occurrent part of is a relation between occurrents b and c when b is part of c"@en ;
    skos:example "Mary's 5th birthday is an occurrent part of Mary's life; the first set of the tennis match is an occurrent part of the tennis match"@en .

obo:BFO_0000140 a owl:Class ;
    rdfs:label "continuant fiat boundary"@en ;
    rdfs:subClassOf obo:BFO_0000141 ;
    skos:definition "(Elucidation) A continuant fiat boundary b is an immaterial entity that is of zero, one or two dimensions & such that there is no time t when b has a spatial region as continuant part & whose location is determined in relation to some material entity"@en ;
    skos:example "As for fiat point, fiat line, fiat surface"@en .

obo:OBI_0000312 a owl:ObjectProperty ;
    rdfs:label "is specified output of"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000115 "A relation between a completely executed planned process and a continuant participating in that process. The presence of the continuant at the end of the process is explicitly specified in the objective specification which the process realizes the concretization of."@en ;
    obo:IAO_0000117 "PERSON:Bjoern Peters",
        "Alan Ruttenberg"@en ;
    rdfs:range obo:COB_0000035 ;
    rdfs:subPropertyOf obo:RO_0000056 .

obo:UO_0000106 a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "hertz" ;
    obo:IAO_0000115 "A frequency unit which is equal to 1 complete cycle of a recurring phenomenon in 1 second." ;
    oboInOwl:hasExactSynonym "Hz",
        "s^1" ;
    rdfs:subClassOf obo:UO_1000106 .

pmd:PMD_0020127 a owl:ObjectProperty ;
    rdfs:label "refers to"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:comment """Despite has characteristic from RO does not have any domain constraints, it is still not possible to directly connect an instance of a process with an instance of a SDC. 

First, SDC is dependent on a IC. As RO does not have "bearer of" object property, the "has characteristic" implies that the domain should be an IC. 

Second, characteristic of is a functional property. Thus, two triples SDC_1 characteristc of IC_1 and SDC_2  characteristc of Process_1 (where IC_1 participates in Process_1), cannot exist simultaneously. 
An example of such case can be "Temperature of during the annealing process was 1000°C". Temperature is an SDC of some participant of the annealing, however it is not clear whether it is an SDC of an oven or of a sample in the oven. If we assert triple Annealing--> has characteristic --> Temperature 1000°C, then the correct triple connecting temperature SDC with either oven or specimen cannot exist."""@en ;
    rdfs:domain pmd:PMD_0000008 ;
    rdfs:range obo:BFO_0000020 ;
    skos:definition "a relation between a process attribute and an SDC of some participant in a process"@en ;
    skos:example "a relation to between a process attribute an a SDC of some participant in a process."@en .

pmd:PMD_0020227 a owl:Class ;
    rdfs:label "gelöste Rolle"@de,
        "solute role"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000081 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty obo:BFO_0000050 ;
                                owl:someValuesFrom pmd:PMD_0020229 ] ) ] ],
        pmd:PMD_0020259 ;
    owl:disjointWith pmd:PMD_0020228 ;
    skos:definition "Rolle einer Entität, die in einer Lösung in geringer Konzentration vorhanden ist"@de,
        "role of an entity that is present in minor concentration in a solution"@en .

pmd:PMD_0023000 a owl:Class ;
    rdfs:label "fundamental quality of system"@en ;
    obo:IAO_0000116 "TODO: system requires further precision"@en ;
    rdfs:subClassOf obo:BFO_0000019 ;
    owl:disjointUnionOf ( pmd:PMD_0020133 pmd:PMD_0020150 pmd:PMD_0020151 pmd:PMD_0020367 ) ;
    skos:definition "a quality that is quality of every system made of demarcated materail entites"@en .

cryo:CRYO_0000029 a owl:NamedIndividual ;
    rdfs:label "triclinic"@en ;
    skos:definition "Triclinic crystal system is a crystal system with only translational symmetry."@en .

cryo:CRYO_0000034 a owl:NamedIndividual ;
    rdfs:label "hexagonal"@en ;
    skos:definition "Hexagonal crystal system is a crystal system with one sixfold rotation axis."@en .

cryo:CRYO_0000044 a owl:NamedIndividual ;
    rdfs:label "body centered"@en ;
    skos:altLabel "I" ;
    skos:definition "Body centered centering type is a centering type, where lattice points are located  on the corners of a unit cell, i.e., at coordinates (0,0,0), and at the center of a unit cell, i.e., at coordinates (1/2,1/2,1/2)."@en .

cryo:CRYO_0000053 a owl:ObjectProperty ;
    rdfs:label "has symmetry"@de ;
    rdfs:comment """DO NOT USE DIRECTLY
For taxonomy purpose only""" ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    skos:definition "has symmetry is a top-level object property which gathers other symmetry/lattice system-specific object properties for the inference of family of directions/planes Miller indices notation"@en .

noes:NOES_0000057 a owl:Class ;
    rdfs:label "total magnetic power loss"@en ;
    rdfs:subClassOf noes:NOES_0000053 ;
    skos:definition "Total magnetic power loss is magnetic property of a material which describes its performance in an external magnetic field. Total magnetic power loss is a sum of hysteresis P_hys, eddy current P_e, and anomalous losses P_a."@en ;
    pmd:symbol "P_tot"@en .

obo:BFO_0000024 a owl:Class ;
    rdfs:label "fiat object part"@en ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "(Elucidation) A fiat object part b is a material entity & such that if b exists then it is continuant part of some object c & demarcated from the remainder of c by one or more fiat surfaces"@en ;
    skos:example "The upper and lower lobes of the left lung; the dorsal and ventral surfaces of the body; the Western hemisphere of the Earth; the FMA:regional parts of an intact human body"@en .

obo:IAO_0000123 a owl:NamedIndividual ;
    rdfs:label "metadata incomplete"@en ;
    obo:IAO_0000115 "Class is being worked on; however, the metadata (including definition) are not complete or sufficiently clear to the branch editors."@en .

obo:OBI_0001933 a owl:Class ;
    rdfs:label "value specification" ;
    obo:IAO_0000112 "The value of 'positive' in a classification scheme of \"positive or negative\"; the value of '20g' on the quantitative scale of mass." ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000115 "An information content entity that specifies a value within a classification scheme or on a quantitative scale."@en ;
    obo:IAO_0000116 "This term is currently a descendant of 'information content entity', which requires that it 'is about' something. A value specification of '20g' for a measurement data item of the mass of a particular mouse 'is about' the mass of that mouse. However there are cases where a value specification is not clearly about any particular. In the future we may change 'value specification' to remove the 'is about' requirement." ;
    obo:IAO_0000117 "PERSON:Bjoern Peters" ;
    rdfs:subClassOf obo:IAO_0000030 .

pmd:PMD_0020265 a owl:Class ;
    rdfs:label "property"@en ;
    obo:IAO_0000116 "Do not use this class directly. Use 'qualtiy' or 'realizable entity'"@en ;
    rdfs:subClassOf obo:BFO_0000020 ;
    skos:definition "property is a collection class for entities that are either qualites (represent a state) or realizable entities (represent a behavior)"@en .

pmd:PMD_0023003 a owl:Class ;
    rdfs:label "property by bearer"@en ;
    rdfs:subClassOf pmd:PMD_0023002 ;
    skos:definition "is a facetted property that indicates the type of its bearer" ;
    skos:example "a fluid property is only applicable to fluids." .

cryo:CRYO_0000030 a owl:NamedIndividual ;
    rdfs:label "monoclinic"@en ;
    skos:definition "Monoclinic crystal system is a crystal system with one twofold rotation axis or one mirror plane."@en .

cryo:CRYO_0000032 a owl:NamedIndividual ;
    rdfs:label "tetragonal"@en ;
    skos:definition "Tetragonal crystal system is a crystal system with one fourfold rotation axis."@en .

<urn:swrl:var#e> a swrl:Variable .

obo:BFO_0000002 a owl:Class ;
    rdfs:label "continuant"@en ;
    obo:IAO_0000115 "An entity that exists in full at any time in which it exists at all, persists through time while maintaining its identity and has no temporal parts."@en ;
    obo:IAO_0000116 "BFO 2 Reference: Continuant entities are entities which can be sliced to yield parts only along the spatial dimension, yielding for example the parts of your table which we call its legs, its top, its nails. ‘My desk stretches from the window to the door. It has spatial parts, and can be sliced (in space) in two. With respect to time, however, a thing is a continuant.’ [60, p. 240"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000002 ;
            owl:onProperty obo:BFO_0000050 ],
        obo:BFO_0000001 ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:BFO_0000003 ],
        obo:BFO_0000003 ;
    skos:definition "(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity"@en ;
    skos:example "A human being; a tennis ball; a cave; a region of space; someone's temperature"@en .

obo:BFO_0000034 a owl:Class ;
    rdfs:label "function"@en ;
    obo:IAO_0000112 "the function of a hammer to drive in nails"@en,
        "the function of a heart pacemaker to regulate the beating of a heart through electricity"@en,
        "the function of amylase in saliva to break down starch into sugar"@en ;
    obo:IAO_0000116 "BFO 2 Reference: In the past, we have distinguished two varieties of function, artifactual function and biological function. These are not asserted subtypes of BFO:function however, since the same function – for example: to pump, to transport – can exist both in artifacts and in biological entities. The asserted subtypes of function that would be needed in order to yield a separate monoheirarchy are not artifactual function, biological function, etc., but rather transporting function, pumping function, etc."@en ;
    rdfs:subClassOf obo:BFO_0000016 ;
    skos:definition "(Elucidation) A function is a disposition that exists in virtue of its bearer's physical make-up & this physical make-up is something the bearer possesses because it came into being either through evolution (in the case of natural biological entities) or through intentional design (in the case of artefacts) in order to realize processes of a certain sort"@en ;
    skos:example "The function of a hammer to drive in nails; the function of a heart pacemaker to regulate the beating of a heart through electricity"@en .

obo:OBI_0000070 a owl:Class ;
    rdfs:label "assay"@en ;
    obo:IAO_0000112 "Assay the wavelength of light emitted by excited Neon atoms. Count of geese flying over a house." ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000115 "A planned process that has the objective to produce information about a material entity (the evaluant) by examining it."@en ;
    obo:IAO_0000116 "12/3/12: BP: the reference to the 'physical examination' is included to point out that a prediction is not an assay, as that does not require physical examiniation.",
        "Discussion on OBI call 2023-05-01 resulted in an agreement to revise the textual definition of 'assay'.  https://github.com/obi-ontology/obi/issues/1683." ;
    obo:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    obo:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000087 ;
                                owl:someValuesFrom obo:OBI_0000067 ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000055 ;
            owl:someValuesFrom obo:OBI_0000067 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0009006 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000019 pmd:PMD_0000005 ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:OBI_0000417 ;
            owl:someValuesFrom obo:IAO_0000005 ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:OBI_0000293 ;
                        owl:someValuesFrom obo:BFO_0000040 ] [ a owl:Restriction ;
                        owl:onProperty obo:OBI_0000299 ;
                        owl:someValuesFrom obo:IAO_0000027 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty obo:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:IAO_0000027 [ a owl:Restriction ;
                                owl:onProperty obo:IAO_0000136 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0000087 ;
                                                    owl:someValuesFrom obo:OBI_0000067 ] ) ] ] ) ] ],
        obo:COB_0000035 .

pmd:PMD_0000833 a owl:Class ;
    rdfs:label "Herstellungsprozess"@de,
        "manufacturing process"@en ;
    rdfs:comment """Manufacturing processes alternate qualities of materials, i.e., a value specification of some quality of a material entity, which is a specified input to the process, cannot be the same as a value specification of the same quality of another material entity, which is a specified output of the process. 

Unfortunately it is not possible to write down such axiom based on OWL. Semi-working solution are the temporally qualified continuants + SPARQL constrains."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000027 obo:BFO_0000030 ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000027 obo:BFO_0000030 ) ] ],
        obo:COB_0000035 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:COB_0000035 [ a owl:Restriction ;
                        owl:onProperty obo:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( obo:BFO_0000027 obo:BFO_0000030 ) ] ] [ a owl:Restriction ;
                        owl:onProperty obo:OBI_0000299 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( obo:BFO_0000027 obo:BFO_0000030 ) ] ] ) ] ;
    skos:definition "Ein geplannter Prozess, der von der primären Absicht angetrieben wird, Objekte zu transformieren. Ein Herstellungsprozess ist immer ein Transformationsprozess."@de,
        """A planned process that is driven by the primary intent to transform objects
A manufacturing process is always a transformative process."""@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020132 a owl:Class ;
    rdfs:label "spatial extend"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000019 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000080 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( obo:BFO_0000024 obo:BFO_0000027 obo:BFO_0000029 obo:BFO_0000030 obo:BFO_0000140 ) ] ] ) ] ;
    skos:definition "Dimension quality is a quality of a material entity that pertains to its measurable spatial extent, such as length, area, or volume"@en ;
    skos:example "the wall thickness of a steel pipe is a dimension quality functionally related to its pressure resistance"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020287 a owl:Class ;
    rdfs:label "portion of matter in aggregate state"@en ;
    rdfs:subClassOf pmd:PMD_0000001 ;
    owl:disjointUnionOf ( pmd:PMD_0020288 pmd:PMD_0020289 pmd:PMD_0020290 pmd:PMD_0020291 pmd:PMD_0020292 pmd:PMD_0020293 pmd:PMD_0020294 pmd:PMD_0020295 pmd:PMD_0020296 ) ;
    skos:definition "a portion of matter that is at the same time in a specific aggregate state"@en .

pmd:PMD_0020317 a owl:Class ;
    rdfs:label "an objects property"@en ;
    rdfs:subClassOf pmd:PMD_0023003 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000052 ;
                        owl:someValuesFrom obo:BFO_0000030 ] [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025999 ;
                        owl:someValuesFrom obo:BFO_0000030 ] ) ] ;
    skos:definition "a 'property by bearer' that indicates that its bearer is an object" .

pmd:PMD_0020367 a owl:Class ;
    rdfs:label "member count"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "OWL cardinality is restricted to xsd:integer type. Avogardo number is integer but larger that the xsd:integer range. Thus 'has member' exactly 'avogadro number' can not be axiomatized."@en ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000027 ;
            owl:onProperty obo:RO_0000080 ],
        pmd:PMD_0023000 ;
    skos:definition "the number of similar objects in an object aggregate"@en .

cryo:CRYO_0000035 a owl:NamedIndividual ;
    rdfs:label "cubic"@en ;
    skos:definition "Cubic crystal system is a crystal system with fourfold rotation axes."@en .

noes:NOES_0000023 a owl:Class ;
    rdfs:label "rolling"@en ;
    rdfs:comment "Rolling is a shaping process in which material is passed through under a roll with the goal of reducing the thickness of a semi-finished object. After rolling the mateiral deformed microstructure, which is characterized by elongated defomed grains, high dislocation density, high internal strains, and preferred grain orientation."@en ;
    rdfs:subClassOf pmd:PMD_0000649 .

obo:IAO_0000136 a owl:ObjectProperty ;
    rdfs:label "is about"@en ;
    obo:IAO_0000112 "This document is about information artifacts and their representations"@en ;
    obo:IAO_0000115 "A (currently) primitive relation that relates an information artifact to an entity."@en ;
    obo:IAO_0000116 """7/6/2009 Alan Ruttenberg. Following discussion with Jonathan Rees, and introduction of "mentions" relation. Weaken the is_about relationship to be primitive. 

We will try to build it back up by elaborating the various subproperties that are more precisely defined.

Some currently missing phenomena that should be considered "about" are predications - "The only person who knows the answer is sitting beside me" , Allegory, Satire, and other literary forms that can be topical without explicitly mentioning the topic."""@en ;
    obo:IAO_0000119 "Smith, Ceusters, Ruttenberg, 2000 years of philosophy"@en ;
    rdfs:domain obo:IAO_0000030 ;
    owl:inverseOf <https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000226>,
        pmd:PMD_0000004 .

pmd:PMD_0020312 a owl:Class ;
    rdfs:label "electromagnetic property"@en ;
    rdfs:subClassOf pmd:PMD_0020265 ;
    skos:definition "a property that is commonly associated with the domain of electricity and magnetics"@en .

pmd:PMD_0020335 a owl:Class ;
    rdfs:label "characteristic material property"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( pmd:PMD_0000000 [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Class ;
                                            owl:unionOf ( obo:BFO_0000024 obo:BFO_0000027 obo:BFO_0000029 obo:BFO_0000030 ) ] [ a owl:Restriction ;
                                            owl:onProperty obo:BFO_0000050 ;
                                            owl:someValuesFrom pmd:PMD_0000000 ] ) ] ) ] ],
        pmd:PMD_0020265 ;
    skos:definition "a property that is commonly associated with the domain of materials science and engineering"@en .

cryo:CRYO_0000011 a owl:Class ;
    rdfs:label "crystallographic plane"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom cryo:CRYO_0000001 ],
        obo:BFO_0000146 ;
    skos:definition "Crystallographic plane is a fiat surface which is part of a crystal lattice and which is denoted by Miller indices of a plane."@en .

cryo:CRYO_0000031 a owl:NamedIndividual ;
    rdfs:label "orthorhombic"@en ;
    skos:definition "Orthorhombic crystal system is a crystal system with three twofold rotation axes or one twofold rotation axis and two mirror planes"@en .

noes:NOES_0000033 a owl:Class ;
    rdfs:label "rolling direction"@en ;
    rdfs:comment """TODO: 
1. Refine definition
2. Maybe remove the categorical values""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty noes:NOES_0000068 ;
            owl:someValuesFrom noes:NOES_0000035 ],
        noes:NOES_0000031 ;
    skos:definition "Rolling direction is a direction in which the sheet is pushed through the rolling mill."@en .

noes:NOES_0000094 a owl:Class ;
    rdfs:label "rolling plane"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty noes:NOES_0000068 ;
            owl:someValuesFrom noes:NOES_0000036 ],
        obo:BFO_0000146 ;
    skos:definition "Rolling plane is a fiat surface which is a geometric basis of a rolled material. Rolling plane is normal to the normal direction. Rolling plane is a parallel to and has parts rolling, transverse, and longitudinal directions."@en .

obo:CHEBI_60003 a owl:Class ;
    rdfs:label "pure substance" ;
    obo:IAO_0000115 "A pure substance is a chemical substance composed of multiple molecules, which are all of the same kind." ;
    rdfs:seeAlso obo:CHEBI_60003 ;
    rdfs:subClassOf obo:CHEBI_59999 ;
    skos:example "Pure water, a portion of iron atoms. In contrast, salt water 'has part' a portion of pure water and a portion of pure NaCl. Steel 'has part' a 'portion of pure iron', a 'portion of pure carbon' and possibly portions of other alloying- and impurity-elements."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000068 a owl:Class ;
    rdfs:label "temporally qualified continuant"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "For any temporally qualified continuant x@t, there exists a continuant y such that x@t has_state y, meaning that y is the anchor continuant of which x@t is a temporal phase existing at temporal regions t. The relation has_state is functional and signifies that all such temporally qualified continuants are uniquely associated with their basic anchor continuant."@en ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000108 ;
            owl:someValuesFrom obo:BFO_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0000070 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000004 [ a owl:Class ;
                                owl:complementOf pmd:PMD_0000068 ] ) ] ],
        obo:BFO_0000004 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000004 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000108 ;
                        owl:someValuesFrom obo:BFO_0000008 ] [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0000070 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:BFO_0000004 [ a owl:Class ;
                                            owl:complementOf pmd:PMD_0000068 ] ) ] ] ) ] ;
    skos:definition "A temporally qualified continuant is a continuant that, by reference to a determinate temporal region, is such as to possess its properties only for so long as that period obtains, being otherwise in its essentiality unchanged."@en ;
    pmd:PMD_0001032 "https://github.com/materialdigital/core-ontology/issues/185" .

pmd:PMD_0000853 a owl:Class ;
    rdfs:label "kristallographische Textur"@de,
        "crystallographic texture"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:comment "typically observed through crystallographic analysis"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0000000 pmd:PMD_0020106 ) ] ],
        [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0000004 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( pmd:PMD_0000885 noes:NOES_0000008 ) ] ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000080 ;
                        owl:someValuesFrom noes:NOES_0000177 ] [ a owl:Restriction ;
                        owl:allValuesFrom noes:NOES_0000177 ;
                        owl:onProperty obo:RO_0000080 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom noes:NOES_0000177 ],
        obo:BFO_0000019,
        pmd:PMD_0020335,
        pmd:PMD_0023004,
        pmd:PMD_0023007 ;
    skos:definition "eine intensive Qualität, die die Anordnung und Ausrichtung der Körner in einem Polykristall beschreibt"@de,
        "an intensive quality describing the arrangement and orientation of grains in a polychrystal"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000927 a owl:Class ;
    rdfs:label "Trennen"@de,
        "separating"@en ;
    obo:IAO_0000119 "Official definition can be found in: DIN 8580:2003-9 Fertigungsverfahren, Page 4, 3.1.3 Trennen - Definition"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000055 ;
            owl:someValuesFrom pmd:PMD_0000592 ],
        pmd:PMD_0000833 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000833 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000055 ;
                        owl:someValuesFrom pmd:PMD_0000592 ] ) ] ;
    skos:definition "Ein Herstellungsprozess, bei dem die Bindung zwischen Objekten aufgehoben wird, was zu einer teilweisen oder vollständigen Verringerung der Kohäsion führt."@de,
        "A manufacturing process in which the bond between objects is broken, resulting in a partial or complete reduction in cohesion."@en ;
    skos:example "Disassembling, Removal"@en ;
    pmd:PMD_0050117 "Cutting"@en .

pmd:PMD_0025006 a owl:ObjectProperty ;
    rdfs:label "process attribute of"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    skos:definition "A relation between a process attribute and a process, which \"bears\" the attribute."@en ;
    skos:example "Tensile rate is a process attribute of tensile test"@en .

obo:BFO_0000029 a owl:Class ;
    rdfs:label "site"@en ;
    rdfs:subClassOf obo:BFO_0000141 ;
    skos:definition "(Elucidation) A site is a three-dimensional immaterial entity whose boundaries either (partially or wholly) coincide with the boundaries of one or more material entities or have locations determined in relation to some material entity"@en ;
    skos:example "A hole in a portion of cheese; a rabbit hole; the Grand Canyon; the Piazza San Marco; the kangaroo-joey-containing hole of a kangaroo pouch; your left nostril (a fiat part - the opening - of your left nasal cavity); the lumen of your gut; the hold of a ship; the interior of the trunk of your car; hole in an engineered floor joist"@en .

obo:BFO_0000055 a owl:ObjectProperty ;
    rdfs:label "realizes"@en ;
    obo:IAO_0000115 "Paraphrase of elucidation: a relation between a process and a realizable entity, where there is some material entity that is bearer of the realizable entity and participates in the process, and the realizable entity comes to be realized in the course of the process"@en ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range obo:BFO_0000017 ;
    skos:definition "(Elucidation) realizes is a relation between a process b and realizable entity c such that c inheres in some d & for all t, if b has participant d then c exists & the type instantiated by b is correlated with the type instantiated by c"@en ;
    skos:example "A balding process realizes a disposition to go bald; a studying process realizes a student role; a process of pumping blood realizes the pumping function of a heart"@en .

obo:COB_0000035 a owl:Class ;
    rdfs:label "completely executed planned process"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000055 ;
            owl:someValuesFrom obo:OBI_0000260 ],
        obo:COB_0000082 .

obo:IAO_0000027 a owl:Class ;
    rdfs:label "data entity"@en,
        "data item"@en ;
    obo:IAO_0000112 "Data items include counts of things, analyte concentrations, and statistical summaries."@en ;
    obo:IAO_0000115 "An information content entity that is intended to be a truthful statement about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements."@en,
        "An information content entity that is intended to be one or more truthful statement(s) about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements."@en ;
    obo:IAO_0000116 "2014-03-31: See discussion at http://odontomachus.wordpress.com/2014/03/30/aboutness-objects-propositions/",
        "2/2/2009 Alan and Bjoern discussing FACS run output data. This is a data item because it is about the cell population. Each element records an event and is typically further composed a set of measurment data items that record the fluorescent intensity stimulated by one of the lasers."@en,
        "2009-03-16: data item deliberatly ambiguous: we merged data set and datum to be one entity, not knowing how to define singular versus plural. So data item is more general than datum."@en,
        "2009-03-16: removed datum as alternative term as datum specifically refers to singular form, and is thus not an exact synonym."@en,
        """JAR: datum     -- well, this will be very tricky to define, but maybe some 
information-like stuff that might be put into a computer and that is 
meant, by someone, to denote and/or to be interpreted by some 
process... I would include lists, tables, sentences... I think I might 
defer to Barry, or to Brian Cantwell Smith

JAR: A data item is an approximately justified approximately true approximate belief"""@en ;
    rdfs:subClassOf obo:IAO_0000030 .

obo:OBI_0000299 a owl:ObjectProperty ;
    rdfs:label "has specified output"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000115 "The inverse property of is specified output of" ;
    obo:IAO_0000117 "PERSON: Bjoern Peters",
        "PERSON: Larry Hunter",
        "PERSON: Melanie Courtot",
        "PERSON: Alan Ruttenberg"@en ;
    rdfs:domain obo:COB_0000035 ;
    rdfs:subPropertyOf obo:RO_0000057 ;
    owl:inverseOf obo:OBI_0000312 .

pmd:PMD_0020353 a owl:Class ;
    rdfs:label "unclassified property"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Do not use this class directly. It will be deprecated in future releases." ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf pmd:PMD_0020265 ;
    skos:definition "a collection of to-be classifed SDCs"@en .

<urn:swrl:var#d> a swrl:Variable .

pmd:PMD_0000009 a owl:ObjectProperty ;
    rdfs:label "has process attribute"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range pmd:PMD_0000008 ;
    rdfs:seeAlso "has process attribute from OEO https://openenergyplatform.org/ontology/oeo/OEO_00000500"@en ;
    owl:inverseOf pmd:PMD_0025006 ;
    skos:definition "A relation between a process and a process attribute that depends on it."@en ;
    skos:example "Tensile testing process has process attribute tensile rate"@en .

noes:NOES_0000177 a owl:Class ;
    rdfs:label "grain population"@en ;
    rdfs:subClassOf obo:BFO_0000027 ;
    skos:definition "Grain population is a disconnected material aggregate which has crystallites ias parts.  Grain population represents grains which not necesserly spatially connected (unlike polycrystal) but share some collective quality, such as preffered crystallographic orientation."@en .

obo:BFO_0000017 a owl:Class ;
    rdfs:label "realizable entity"@en ;
    obo:IAO_0000112 "the disposition of this piece of metal to conduct electricity."@en,
        "the disposition of your blood to coagulate"@en,
        "the function of your reproductive organs"@en,
        "the role of being a doctor"@en,
        "the role of this boundary to delineate where Utah and Colorado meet"@en ;
    obo:IAO_0000115 "A specifically dependent continuant  that inheres in continuant  entities and are not exhibited in full at every time in which it inheres in an entity or group of entities. The exhibition or actualization of a realizable entity is a particular manifestation, functioning or process that occurs under certain circumstances."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000017 ;
            owl:onProperty obo:BFO_0000050 ],
        obo:BFO_0000020 ;
    owl:disjointWith obo:BFO_0000019 ;
    skos:definition "(Elucidation) A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region & which is of a type some instances of which are realized in processes of a correlated type"@en ;
    skos:example "The role of being a doctor; the role of this boundary to delineate where Utah and Colorado meet; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of this piece of metal to conduct electricity"@en .

obo:CHEBI_23367 a owl:Class ;
    rdfs:label "molecular entity" ;
    obo:IAO_0000115 "Any constitutionally or isotopically distinct atom, molecule, ion, ion pair, radical, radical ion, complex, conformer etc., identifiable as a separately distinguishable entity." ;
    rdfs:subClassOf obo:CHEBI_24431 .

obo:IAO_0000030 a owl:Class ;
    rdfs:label "information content entity",
        "information content entity"@en ;
    obo:IAO_0000112 "Examples of information content entites include journal articles, data, graphical layouts, and graphs.",
        "Examples of information content entites include journal articles, data, graphical layouts, and graphs."@en ;
    obo:IAO_0000115 "An information content entity is an entity that is generically dependent on some artifact and stands in relation of aboutness to some entity.",
        "A generically dependent continuant that is about some thing."@en ;
    obo:IAO_0000116 "2014-03-10: The use of \"thing\" is intended to be general enough to include universals and configurations (see https://groups.google.com/d/msg/information-ontology/GBxvYZCk1oc/-L6B5fSBBTQJ)."@en,
        "Pier: 'data, information or knowledge'. OR 'representation'"@en,
        """information_content_entity 'is_encoded_in' some digital_entity in obi before split (040907). information_content_entity 'is_encoded_in' some physical_document in obi before split (040907).

Previous. An information content entity is a non-realizable information entity that 'is encoded in' some digital or physical entity."""@en ;
    obo:IAO_0000119 "IAO",
        "OBI_0000142"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000136 ;
            owl:someValuesFrom obo:BFO_0000001 ],
        obo:BFO_0000031 .

pmd:PMD_0000592 a owl:Class ;
    rdfs:label "Trennen Funktion"@de,
        "cut function"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom pmd:PMD_0020339 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000079 ;
            owl:someValuesFrom pmd:PMD_0001998 ],
        obo:BFO_0000034,
        pmd:PMD_0020317,
        pmd:PMD_0020353 ;
    skos:altLabel "Schneidfunktion"@de ;
    skos:definition "Eine Funktion, die ausgeführt wird, um Materialien mit Schneidgeräten zu trennen oder zu teilen."@de,
        "A function performed to separate or divide materials using cutting devices."@en ;
    pmd:PMD_0000060 true .

obo:RO_0009006 a owl:ObjectProperty ;
    rdfs:label "assay measures characteristic"@en ;
    obo:IAO_0000112 "A mass measurement assay measures an material's mass characteristic. A radioactivity detection assay measures the amount of radiation (alpha, beta or gamma ray emmissions) coming from a material."@en ;
    obo:IAO_0000115 "A relation between an assay and a characteristic, in which the assay generates a data item which is a measure of a characteristic."@en ;
    rdfs:range obo:BFO_0000020 ;
    owl:inverseOf obo:RO_0009007 .

cryo:CRYO_0000012 a owl:Class ;
    rdfs:label "crystallographic direction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom cryo:CRYO_0000001 ],
        obo:BFO_0000142 ;
    skos:definition "Crystallographic direction is a fiat line which is part of a crystal lattice and which is denoted by Miller indices of a direction."@en .

cryo:CRYO_0000043 a owl:NamedIndividual ;
    rdfs:label "primitive"@en ;
    skos:altLabel "P" ;
    skos:definition "Primitive centering type is a centering type, where lattice points are located only on the corners of a unit cell, i.e., at coordinates (0,0,0)."@en .

pmd:PMD_0023004 a owl:Class ;
    rdfs:label "a portions property"@en ;
    rdfs:subClassOf pmd:PMD_0023003 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000052 ;
                        owl:someValuesFrom pmd:PMD_0000001 ] [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025999 ;
                        owl:someValuesFrom pmd:PMD_0000001 ] ) ] ;
    skos:definition "a 'property by bearer' that indicates that its bearer is a portion of matter"@en .

obo:RO_0000085 a owl:ObjectProperty ;
    rdfs:label "has function"@en ;
    obo:IAO_0000112 "this enzyme has function this catalysis function (more colloquially: this enzyme has this catalysis function)"@en ;
    obo:IAO_0000115 "a relation between an independent continuant (the bearer) and a function, in which the function specifically depends on the bearer for its existence"@en ;
    obo:IAO_0000116 "A bearer can have many functions, and its functions can exist for different periods of time, but none of its functions can exist when the bearer does not exist. A function need not be realized at all the times that the function exists."@en ;
    rdfs:domain obo:BFO_0000004 ;
    rdfs:range obo:BFO_0000034 ;
    rdfs:subPropertyOf obo:RO_0000053 .

obo:RO_0000053 a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has characteristic"@en ;
    obo:IAO_0000112 "this apple is bearer of this red color"@en,
        "this vase is bearer of this fragility"@en ;
    obo:IAO_0000115 "Inverse of characteristic_of"@en ;
    obo:IAO_0000116 "A bearer can have many dependents, and its dependents can exist for different periods of time, but none of its dependents can exist when the bearer does not exist."@en ;
    rdfs:range obo:BFO_0000020 .

obo:CHEBI_25585 a owl:Class ;
    rdfs:label "nonmetal atom" ;
    rdfs:subClassOf obo:CHEBI_33250 .

obo:RO_0000087 a owl:ObjectProperty ;
    rdfs:label "has role"@en ;
    obo:IAO_0000112 "this person has role this investigator role (more colloquially: this person has this role of investigator)"@en ;
    obo:IAO_0000115 "a relation between an independent continuant (the bearer) and a role, in which the role specifically depends on the bearer for its existence"@en ;
    obo:IAO_0000116 "A bearer can have many roles, and its roles can exist for different periods of time, but none of its roles can exist when the bearer does not exist. A role need not be realized at all the times that the role exists."@en ;
    rdfs:domain obo:BFO_0000004 ;
    rdfs:range obo:BFO_0000023 ;
    rdfs:subPropertyOf obo:RO_0000053 .

pmd:PMD_0000001 a owl:Class ;
    rdfs:label "portion of matter"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:comment """It is also representing a distinct physical or conceptual part of a material or substance.

The open energy ontology OEO defines portion of matter as a subclass of object aggregate, which implies countability. Our portion is not (precisely) countable and thus bearer of intensive properties."""@en,
        """Lome explanation for portion of matter: "What is a molecule cluster at the cellular level? Contrary to the molecular level, at the cellular level of granularity the boundary of each molecule is outside of the level of granular focus. What forms a discontinuous cluster of countable individual molecules and thus bona fide objects at the molecular level, is a continuous and non-countable molecular substance at coarser levels of
granularity. At these coarser levels, the individual molecules cannot be differentiated and demarcated anymore and the cluster as a whole possesses only fiat inner boundaries.\""""@en ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "A material entity that is not demarcated by any physical discontinuities. At some finer level of granularity it is an object aggregate, at some coarser level of granularity it is a fiat object part,but at this level of granularity it is neither."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000008 a owl:Class ;
    rdfs:label "process attribute"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "an attribute of a process" ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:comment """Process attribute for a process has a similar application to specifically dependened continuant (SDC) for an independent continuant (IC). Furthermore, process attribute describes how SDCs of some participants, i.e., ICs, change in a process. 

Specific rates, e.g., tensile rate, cooling rate, etc. should be added as  subclasses of this class."""@en ;
    rdfs:seeAlso "process attribute from OEO https://openenergyplatform.org/ontology/oeo/OEO_00030019"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0025006 ;
            owl:someValuesFrom obo:BFO_0000015 ],
        obo:BFO_0000003 ;
    owl:versionInfo "Renamed to avoid confusion with has characteristic object property"@en ;
    skos:altLabel "process characteristic"@en ;
    skos:definition "a process attribute is a dependent occurrent that existentially depends on a process."@en ;
    skos:example "Tensile rate in a tensile testing process. Cooling rate in a quenching process"@en ;
    pmd:PMD_0000060 true .

ex:ideal_alpha a noes:NOES_0000139 .

ex:ideal_cube a noes:NOES_0000058 .

ex:ideal_eta a noes:NOES_0000113 .

ex:ideal_gamma a noes:NOES_0000138 .

ex:ideal_goss a noes:NOES_0000064 .

ex:ideal_lambda a noes:NOES_0000112 .

ex:ideal_rotated_cube a noes:NOES_0000060 .

ex:ideal_rotated_goss a noes:NOES_0000071 .

obo:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    obo:IAO_0000112 "a chair"@en,
        "a heart"@en,
        "a leg"@en,
        "a molecule"@en,
        "a spatial region"@en,
        "an atom"@en,
        "an orchestra."@en,
        "an organism"@en,
        "the bottom right portion of a human torso"@en,
        "the interior of your mouth"@en ;
    obo:IAO_0000115 "b is an independent continuant = Def. b is a continuant which is such that there is no c and no t such that b s-depends_on c at t. (axiom label in BFO2 Reference: [017-002])"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000004 ;
            owl:onProperty obo:BFO_0000050 ],
        obo:BFO_0000002 ;
    owl:disjointWith obo:BFO_0000020,
        obo:BFO_0000031 ;
    skos:definition "b is an independent continuant =Def b is a continuant & there is no c such that b specifically depends on c or b generically depends on c"@en ;
    skos:example "An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra"@en .

obo:IAO_0000003 a owl:Class ;
    rdfs:label "measurement unit label"@en ;
    obo:IAO_0000112 "Examples of measurement unit labels are liters, inches, weight per volume."@en ;
    obo:IAO_0000115 "A measurement unit label is as a label that is part of a scalar measurement datum and denotes a unit of measure."@en ;
    obo:IAO_0000116 """2009-03-16: provenance: a term measurement unit was
proposed for OBI (OBI_0000176) , edited by Chris Stoeckert and
Cristian Cocos, and subsequently moved to IAO where the objective for
which the original term was defined was satisfied with the definition
of this, different, term."""@en,
        "2009-03-16: review of this term done during during the OBI workshop winter 2009 and the current definition was considered acceptable for use in OBI. If there is a need to modify this definition please notify OBI."@en ;
    rdfs:subClassOf obo:IAO_0000009 .

pmd:PMD_0000602 a owl:Class ;
    rdfs:label "Gerät"@de,
        "device"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf obo:BFO_0000030 ;
    skos:definition "Ein physisches oder virtuelles Objekt, das verwendet wird, um eine bestimmte Funktion oder Aufgabe auszuführen, häufig im Zusammenhang mit der Messung, Manipulation oder Analyse von Materialien."@de,
        "A device is an object that is designed to perform a specific function or task involving measurement, manipulation, processing, or analysis."@en ;
    pmd:PMD_0000060 true .

cryo:CRYO_0000168 a owl:ObjectProperty ;
    rdfs:label "denoted by family under cubic symmetry" ;
    rdfs:domain cryo:CRYO_0000041 ;
    rdfs:subPropertyOf cryo:CRYO_0000164 ;
    skos:definition "denoted by family under cubic symmetry is an object property between a crystallographic entity in cubic system, i.e., plane or direction, and the family of Miller indices."@en .

obo:BFO_0000001 a owl:Class ;
    rdfs:label "entity"@en ;
    obo:IAO_0000112 "Julius Caesar"@en,
        "Verdi’s Requiem"@en,
        "the Second World War"@en,
        "your body mass index"@en ;
    obo:IAO_0000116 "BFO 2 Reference: In all areas of empirical inquiry we encounter general terms of two sorts. First are general terms which refer to universals or types:animaltuberculosissurgical procedurediseaseSecond, are general terms used to refer to groups of entities which instantiate a given universal but do not correspond to the extension of any subuniversal of that universal because there is nothing intrinsic to the entities in question by virtue of which they – and only they – are counted as belonging to the given group. Examples are: animal purchased by the Emperortuberculosis diagnosed on a Wednesdaysurgical procedure performed on a patient from Stockholmperson identified as candidate for clinical trial #2056-555person who is signatory of Form 656-PPVpainting by Leonardo da VinciSuch terms, which represent what are called ‘specializations’ in [81"@en ;
    skos:definition "(Elucidation) An entity is anything that exists or has existed or will exist"@en ;
    skos:example "Julius Caesar; the Second World War; your body mass index; Verdi's Requiem"@en .

obo:BFO_0000003 a owl:Class ;
    rdfs:label "occurrent"@en ;
    obo:IAO_0000115 "An entity that has temporal parts and that happens, unfolds or develops through time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000003 ;
            owl:onProperty obo:BFO_0000050 ],
        obo:BFO_0000001 ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:BFO_0000002 ] ;
    skos:definition "(Elucidation) An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region"@en ;
    skos:example "As for process, history, process boundary, spatiotemporal region, zero-dimensional temporal region, one-dimensional temporal region, temporal interval, temporal instant."@en .

obo:BFO_0000020 a owl:Class ;
    rdfs:label "specifically dependent continuant"@en ;
    obo:IAO_0000112 "Reciprocal specifically dependent continuants: the function of this key to open this lock and the mutually dependent disposition of this lock: to be opened by this key"@en,
        "of one-sided specifically dependent continuants: the mass of this tomato"@en,
        "of relational dependent continuants (multiple bearers): John’s love for Mary, the ownership relation between John and this statue, the relation of authority between John and his subordinates."@en,
        "the disposition of this fish to decay"@en,
        "the function of this heart: to pump blood"@en,
        "the mutual dependence of proton donors and acceptors in chemical reactions [79"@en,
        "the mutual dependence of the role predator and the role prey as played by two organisms in a given interaction"@en,
        "the pink color of a medium rare piece of grilled filet mignon at its center"@en,
        "the role of being a doctor"@en,
        "the shape of this hole."@en,
        "the smell of this portion of mozzarella"@en ;
    obo:IAO_0000115 "b is a specifically dependent continuant = Def. b is a continuant & there is some independent continuant c which is not a spatial region and which is such that b s-depends_on c at every time t during the course of b’s existence. (axiom label in BFO2 Reference: [050-003])"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000020 ;
            owl:onProperty obo:BFO_0000050 ],
        obo:BFO_0000002 ;
    owl:disjointWith obo:BFO_0000031 ;
    skos:definition "b is a specifically dependent continuant =Def b is a continuant & there is some independent continuant c which is not a spatial region & which is such that b specifically depends on c"@en ;
    skos:example "(with multiple bearers) John's love for Mary; the ownership relation between John and this statue; the relation of authority between John and his subordinates"@en,
        "(with one bearer) The mass of this tomato; the pink colour of a medium rare piece of grilled filet mignon at its centre; the smell of this portion of mozzarella; the disposition of this fish to decay; the role of being a doctor; the function of this heart to pump blood; the shape of this hole"@en .

obo:IAO_0000115 a owl:AnnotationProperty ;
    rdfs:label "definition",
        "textual definition",
        "definition"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000115 "The official OBI definition, explaining the meaning of a class or property. Shall be Aristotelian, formalized and normalized. Can be augmented with colloquial definitions."@en,
        "The official definition, explaining the meaning of a class or property. Shall be Aristotelian, formalized and normalized. Can be augmented with colloquial definitions."@en ;
    obo:IAO_0000116 """2012-04-05: 
Barry Smith

The official OBI definition, explaining the meaning of a class or property: 'Shall be Aristotelian, formalized and normalized. Can be augmented with colloquial definitions'  is terrible.

Can you fix to something like:

A statement of necessary and sufficient conditions explaining the meaning of an expression referring to a class or property.

Alan Ruttenberg

Your proposed definition is a reasonable candidate, except that it is very common that necessary and sufficient conditions are not given. Mostly they are necessary, occasionally they are necessary and sufficient or just sufficient. Often they use terms that are not themselves defined and so they effectively can't be evaluated by those criteria. 

On the specifics of the proposed definition:

We don't have definitions of 'meaning' or 'expression' or 'property'. For 'reference' in the intended sense I think we use the term 'denotation'. For 'expression', I think we you mean symbol, or identifier. For 'meaning' it differs for class and property. For class we want documentation that let's the intended reader determine whether an entity is instance of the class, or not. For property we want documentation that let's the intended reader determine, given a pair of potential relata, whether the assertion that the relation holds is true. The 'intended reader' part suggests that we also specify who, we expect, would be able to understand the definition, and also generalizes over human and computer reader to include textual and logical definition. 

Personally, I am more comfortable weakening definition to documentation, with instructions as to what is desirable. 

We also have the outstanding issue of how to aim different definitions to different audiences. A clinical audience reading chebi wants a different sort of definition documentation/definition from a chemistry trained audience, and similarly there is a need for a definition that is adequate for an ontologist to work with."""@en,
        """2012-04-05: 
Barry Smith

The official OBI definition, explaining the meaning of a class or property: 'Shall be Aristotelian, formalized and normalized. Can be augmented with colloquial definitions'  is terrible.

Can you fix to something like:

A statement of necessary and sufficient conditions explaining the meaning of an expression referring to a class or property.

Alan Ruttenberg

Your proposed definition is a reasonable candidate, except that it is very common that necessary and sufficient conditions are not given. Mostly they are necessary, occasionally they are necessary and sufficient or just sufficient. Often they use terms that are not themselves defined and so they effectively can't be evaluated by those criteria. 

On the specifics of the proposed definition:

We don't have definitions of 'meaning' or 'expression' or 'property'. For 'reference' in the intended sense I think we use the term 'denotation'. For 'expression', I think we you mean symbol, or identifier. For 'meaning' it differs for class and property. For class we want documentation that let's the intended reader determine whether an entity is instance of the class, or not. For property we want documentation that let's the intended reader determine, given a pair of potential relata, whether the assertion that the relation holds is true. The 'intended reader' part suggests that we also specify who, we expect, would be able to understand the definition, and also generalizes over human and computer reader to include textual and logical definition. 

Personally, I am more comfortable weakening definition to documentation, with instructions as to what is desirable. 

We also have the outstanding issue of how to aim different definitions to different audiences. A clinical audience reading chebi wants a different sort of definition documentation/definition from a chemistry trained audience, and similarly there is a need for a definition that is adequate for an ontologist to work with.  """@en ;
    obo:IAO_0000117 "PERSON:Daniel Schober"@en ;
    obo:IAO_0000119 "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en .

cryo:CRYO_0000016 a owl:DatatypeProperty ;
    rdfs:label "has Miller indices"@en ;
    rdfs:domain cryo:CRYO_0000014 ;
    rdfs:range xsd:string ;
    skos:definition "has Miller indices is an annotation property to specify Miller indices of crystallographic plane, direction, or family of equivalent planes or directions"@en .

noes:NOES_0000067 a owl:ObjectProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:label "parallel to"@en ;
    rdfs:subPropertyOf noes:NOES_0000066 ;
    skos:definition "Parallel to is an object property which connect two or  more spatial regions that are parallel to each other"@en ;
    skos:example "normal direction (ND) of a rolled sheet is parallel to rolling plane RP."@en .

obo:BFO_0000027 a owl:Class ;
    rdfs:label "object aggregate"@en ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "(Elucidation) An object aggregate is a material entity consisting exactly of a plurality (≥1) of objects as member parts which together form a unit"@en ;
    skos:example "The aggregate of the musicians in a symphony orchestra and their instruments; the aggregate of bearings in a constant velocity axle joint; the nitrogen atoms in the atmosphere; a collection of cells in a blood biobank"@en .

obo:RO_0000057 a owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    obo:IAO_0000112 "this blood coagulation has participant this blood clot"@en,
        "this investigation has participant this investigator"@en,
        "this process has participant this input material (or this output material)"@en ;
    obo:IAO_0000115 "a relation between a process and a continuant, in which the continuant is somehow involved in the process"@en ;
    obo:IAO_0000116 "Has_participant is a primitive instance-level relation between a process, a continuant, and a time at which the continuant participates in some way in the process. The relation obtains, for example, when this particular process of oxygen exchange across this particular alveolar membrane has_participant this particular sample of hemoglobin at this particular time."@en ;
    rdfs:domain obo:BFO_0000003 ;
    rdfs:range obo:BFO_0000002 ;
    owl:propertyChainAxiom ( obo:BFO_0000051 obo:RO_0000057 ) .

obo:BFO_0000141 a owl:Class ;
    rdfs:label "immaterial entity"@en ;
    rdfs:subClassOf obo:BFO_0000004 ;
    skos:definition "b is an immaterial entity =Def b is an independent continuant which is such that there is no time t when it has a material entity as continuant part"@en ;
    skos:example "As for fiat point, fiat line, fiat surface, site"@en .

obo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    obo:IAO_0000115 "An independent continuant that is spatially extended whose identity is independent of that of other entities and can be maintained through time."@en ;
    obo:IAO_0000116 "Elucidation: An independent continuant that is spatially extended whose identity is independent of that of other entities and can be maintained through time."@en ;
    rdfs:subClassOf obo:BFO_0000004 ;
    owl:disjointWith obo:BFO_0000141 ;
    skos:definition "(Elucidation) A material entity is an independent continuant has some portion of matter as continuant part"@en ;
    skos:example "A human being; the undetached arm of a human being; an aggregate of human beings"@en .

obo:IAO_0000039 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has measurement unit label"@en ;
    rdfs:range obo:IAO_0000003 ;
    rdfs:subPropertyOf obo:BFO_0000051 .

cryo:CRYO_0000014 a owl:Class ;
    rdfs:label "Miller indices"@en ;
    rdfs:comment """TODO 
1. think if its actually 1D..
2. Review the definitions of sublcasses"""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "3"^^xsd:nonNegativeInteger ;
            owl:onProperty cryo:CRYO_0000016 ],
        obo:IAO_0000027 ;
    skos:definition "Miller indices is an information content entity which denotes crystallographic direction, crystallographic plane, or lattice point, i.e., defines their position in respect to the coordinate system of a crystal lattice, and has exactly 3 interger literals, namely h, k. and l."@en .

cryo:CRYO_0000020 a owl:Class ;
    rdfs:label "direction Miller indices"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000219 ;
            owl:someValuesFrom cryo:CRYO_0000012 ],
        cryo:CRYO_0000014 ;
    skos:definition "Direction Miller indices define the components of a sinlge vector in the given direction in a crystal's conventional unit cell. Usually, direction Miller indices are reduced to the lowest set of integers. Direction Miller indices must be written in square brackets, e.g., [hkl]."@en ;
    skos:example "[111]" .

cryo:CRYO_0000022 a owl:Class ;
    rdfs:label "plane Miller indices"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000219 ;
            owl:someValuesFrom cryo:CRYO_0000011 ],
        cryo:CRYO_0000014 ;
    skos:definition """Plane Miller indices define the reciprocals of the fractional intercepts the plane makes with the crystallographic axes, reduced to the lowest set of integers. 
For example, if a plane crosses [100] axis at 1/h, [010 ] axis at 1/k, and [001] axis at 1/l, then such plane is denoted as (hkl) plane. If a plane is parallel to one of the axes, then the corresponding Miller index is 0.
Plane Miller indices must be written in round brackets, e.g., (hkl)."""@en ;
    skos:example "(hkl)" .

obo:RO_0001025 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "located in"@en ;
    obo:IAO_0000112 "my brain is located in my head"@en,
        "this rat is located in this cage"@en ;
    obo:IAO_0000115 "a relation between two independent continuants, the target and the location, in which the target is entirely within the location"@en ;
    obo:IAO_0000116 "Location as a relation between instances: The primitive instance-level relation c located_in r at t reflects the fact that each continuant is at any given time associated with exactly one spatial region, namely its exact location. Following we can use this relation to define a further instance-level location relation - not between a continuant and the region which it exactly occupies, but rather between one continuant and another. c is located in c1, in this sense, whenever the spatial region occupied by c is part_of the spatial region occupied by c1.    Note that this relation comprehends both the relation of exact location between one continuant and another which obtains when r and r1 are identical (for example, when a portion of fluid exactly fills a cavity), as well as those sorts of inexact location relations which obtain, for example, between brain and head or between ovum and uterus"@en,
        "Most location relations will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/"@en ;
    rdfs:domain [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000004 [ a owl:Class ;
                        owl:complementOf obo:BFO_0000006 ] ) ],
        obo:BFO_0000004 ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000004 [ a owl:Class ;
                        owl:complementOf obo:BFO_0000006 ] ) ],
        obo:BFO_0000004 ;
    owl:propertyChainAxiom ( obo:RO_0001025 obo:BFO_0000050 ) .

cryo:CRYO_0000027 a owl:Class ;
    rdfs:label "lattice centering"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom cryo:CRYO_0000001 ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000080 ;
                        owl:someValuesFrom cryo:CRYO_0000001 ] [ a owl:Restriction ;
                        owl:onClass cryo:CRYO_0000036 ;
                        owl:onProperty pmd:PMD_0000077 ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ],
        [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0000077 ;
            owl:someValuesFrom cryo:CRYO_0000036 ],
        obo:BFO_0000019,
        pmd:PMD_0023041 ;
    skos:definition "Lattice centering is an intensive quality ofa crystal lattice which the geometric arrangement of lattice points in a unit cell. It is specified by one of the 4 lattice centering value."@en .

obo:RO_0000052 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "characteristic of"@en ;
    obo:IAO_0000112 "this fragility is a characteristic of this vase"@en,
        "this red color is a characteristic of this apple"@en ;
    obo:IAO_0000115 "a relation between a specifically dependent continuant (the characteristic) and any other entity (the bearer), in which the characteristic depends on the bearer for its existence."@en ;
    rdfs:comment "Note that this relation was previously called \"inheres in\", but was changed to be called \"characteristic of\" because BFO2 uses \"inheres in\" in a more restricted fashion. This relation differs from BFO2:inheres_in in two respects: (1) it does not impose a range constraint, and thus it allows qualities of processes, as well as of information entities, whereas BFO2 restricts inheres_in to only apply to independent continuants (2) it is declared functional, i.e. something can only be a characteristic of one thing." ;
    owl:inverseOf obo:RO_0000053 .

obo:BFO_0000015 a owl:Class ;
    rdfs:label "process"@en ;
    obo:IAO_0000115 "p is a process = Def. p is an occurrent that has temporal proper parts and for some time t, p s-depends_on some material entity at t. (axiom label in BFO2 Reference: [083-003])"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000015 obo:BFO_0000035 ) ] ;
            owl:onProperty obo:BFO_0000117 ],
        [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000015 ;
            owl:onProperty obo:BFO_0000132 ],
        obo:BFO_0000003 ;
    skos:altLabel "event"@en ;
    skos:definition "(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant"@en ;
    skos:example "An act of selling; the life of an organism; a process of sleeping; a process of cell-division; a beating of the heart; a process of meiosis; the taxiing of an aircraft; the programming of a computer"@en .

obo:BFO_0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    obo:IAO_0000112 "the ambient temperature of this portion of air"@en,
        "the color of a tomato"@en,
        "the length of the circumference of your waist"@en,
        "the mass of this piece of gold."@en,
        "the shape of your nose"@en,
        "the shape of your nostril"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000019 ;
            owl:onProperty obo:BFO_0000050 ],
        obo:BFO_0000020 ;
    skos:definition "(Elucidation) A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized"@en ;
    skos:example "The colour of a tomato; the ambient temperature of this portion of air; the length of the circumference of your waist; the shape of your nose; the shape of your nostril; the mass of this piece of gold"@en .

obo:RO_0002328 a owl:ObjectProperty ;
    rdfs:label "functionally related to"@en ;
    obo:IAO_0000115 "A grouping relationship for any relationship directly involving a function, or that holds because of a function of one of the related entities." ;
    obo:IAO_0000116 """This is the soft version of mathematical dependence. We would like to introduce oparator classes later (derivative, quotient, sum, difference, product) with appropriate properties for the terms.

difference === ('has minuend' only entity) and ('has subtrahend' only entity)
sum === 'has addend' some entity
product === 'has factor' some entity
quotient === ('has numerator' only entity) and ('has denominator' only entity)
derivative === ('has differential numerator' only entity) and ('has differential denominator' only entity)"""@en ;
    rdfs:seeAlso obo:RO_0002328 ;
    skos:definition "A grouping relationship for any relationship directly involving a function, or that holds because of a function of one of the related entities."@en .

obo:BFO_0000050 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "part of"@en ;
    obo:IAO_0000112 "my brain is part of my body (continuant parthood, two material entities)"@en,
        "my stomach cavity is part of my stomach (continuant parthood, immaterial entity is part of material entity)"@en,
        "this day is part of this year (occurrent parthood)"@en ;
    obo:IAO_0000115 "a core relation that holds between a part and its whole"@en ;
    obo:IAO_0000116 "Everything is part of itself. Any part of any part of a thing is itself part of that thing. Two distinct things cannot be part of each other."@en,
        "Occurrents are not subject to change and so parthood between occurrents holds for all the times that the part exists. Many continuants are subject to change, so parthood between continuants will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/"@en,
        """Parthood requires the part and the whole to have compatible classes: only an occurrent can be part of an occurrent; only a process can be part of a process; only a continuant can be part of a continuant; only an independent continuant can be part of an independent continuant; only an immaterial entity can be part of an immaterial entity; only a specifically dependent continuant can be part of a specifically dependent continuant; only a generically dependent continuant can be part of a generically dependent continuant. (This list is not exhaustive.)

A continuant cannot be part of an occurrent: use 'participates in'. An occurrent cannot be part of a continuant: use 'has participant'. A material entity cannot be part of an immaterial entity: use 'has location'. A specifically dependent continuant cannot be part of an independent continuant: use 'inheres in'. An independent continuant cannot be part of a specifically dependent continuant: use 'bearer of'."""@en ;
    owl:inverseOf obo:BFO_0000051 .

obo:RO_0002351 a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has member"@en ;
    obo:IAO_0000115 "has member is a mereological relation between a collection and an item." ;
    obo:IAO_0000119 "SIO" ;
    rdfs:subPropertyOf obo:BFO_0000051 .

pmd:PMD_0025999 a owl:ObjectProperty ;
    rdfs:label "relationale Qualität von"@de,
        "relational quality of"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 """The 'relational quality of' is more strict that 'quality of' from RO, since domain is 'relational quality'. The motivtion to introduce an object property for relational qualities is the following:
RO's 'quality of' is functional i.e., a->b, a->c => b=c. The functionality is relevant for most of the SDC -> IC triples, expect for relational qualities, which per definiton can be simultaneously inherited in >=2 ICs. Thus,  'relational quality of'  has the same intention to connect SDC to IC, however, without cardinality constraints."""@en ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    owl:propertyChainAxiom ( pmd:PMD_0025999 obo:BFO_0000050 ) ;
    skos:definition "eine Beziehung zwischen einer relationalen Qualität und einem unabhängigen Kontinuum (dem Träger), bei der die Existenz der Qualität speziell vom Träger abhängt"@de,
        "a relation between a relational quality and an independent continuant (the bearer), in which the quality specifically depends on the bearer for its existence"@en ;
    skos:example "mass proportion m is relational qualitiy of material, and the same mass proportion m is relational qualitiy of portion of iron"@en .

pmd:PMD_0000000 a owl:Class ;
    rdfs:label "Material"@de,
        "material"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:comment "Instances of Portions Of Matter whose shape is relevant for their dispostion to participate in a manufacturing process may be (subclasses of) objects that bear a 'blank role' in the context of the manufacturing process."@en,
        """Material is defined in terms of the three main perspectives that material specifications rely on: the structure of the material ("intensive quality"), the performance of the material ("behavoiral material property") and the processing the material must have undergone ("output of some process").

When defining specific materials/material taxonomies, these three aspects shall be taken into account in the aristotelian ("per genus et differentiam") as differentiation."""@en,
        "The sum of portions of matter of the same type form a portion of matter of that type."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000001 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000053 ;
                        owl:someValuesFrom obo:BFO_0000017 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000086 ;
                        owl:someValuesFrom obo:BFO_0000019 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002353 ;
                        owl:someValuesFrom obo:BFO_0000015 ] ) ] ;
    skos:altLabel "Portion of Material"@en ;
    skos:definition "A material is a portion of matter that may participate in some manufacturing process and whose shape is not relevant for its participation in the manufacturing process."@en ;
    pmd:PMD_0000060 true .

obo:RO_0000080 a owl:ObjectProperty ;
    rdfs:label "quality of"@en ;
    obo:IAO_0000112 "this red color is a quality of this apple"@en ;
    obo:IAO_0000115 "a relation between a quality and an independent continuant (the bearer), in which the quality specifically depends on the bearer for its existence"@en ;
    obo:IAO_0000116 "A quality inheres in its bearer at all times for which the quality exists."@en ;
    rdfs:comment "This relation is modeled after the BFO relation of the same name which was in BFO2, but is used in a more restricted sense - specifically, we model this relation as functional (inherited from characteristic-of). Note that this relation is now removed from BFO2020." ;
    rdfs:domain [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000019 [ a owl:Class ;
                        owl:complementOf obo:BFO_0000145 ] ) ] ;
    rdfs:subPropertyOf obo:RO_0000052 ;
    owl:inverseOf obo:RO_0000086 .

pmd:PMD_0000974 a owl:Class ;
    rdfs:label "Zugprüfverfahren"@de,
        "tensile testing process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom pmd:PMD_0000973 ],
        [ a owl:Restriction ;
            owl:onProperty obo:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000087 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:unionOf ( <https://w3id.org/pmd/tto/TTO_0000006> <https://w3id.org/pmd/tto/TTO_0000007> ) ] ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000030 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000087 ;
                                owl:someValuesFrom pmd:PMD_0000975 ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:OBI_0000299 ;
            owl:someValuesFrom <https://w3id.org/pmd/tto/TTO_0000008> ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000055 ;
            owl:someValuesFrom pmd:PMD_0000975 ],
        pmd:PMD_0000833,
        pmd:PMD_0000849 ;
    skos:definition "Ein Mechanische Eigenschaften Analyseverfahren, das die Reaktion eines Materials auf Zugkräfte bestimmt und seine Zugfestigkeit, Dehnung und seinen Elastizitätsmodul misst."@de,
        "A mechanical property analyzing process that determines a material's response to tensile forces, measuring its tensile strength, elongation, and Young's modulus."@en ;
    skos:example "Tensile testing of polymer films to ensure they can stretch without breaking in packaging applications"@en .

pmd:PMD_0000829 a owl:Class ;
    rdfs:label "Magnetische Elektrische Eigenschaften Analyseverfahren"@de,
        "magneto electrical property analyzing process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009006 ;
            owl:someValuesFrom pmd:PMD_0020312 ],
        obo:OBI_0000070 ;
    skos:definition "Eine Analyse, die die magnetischen und elektrischen Eigenschaften von Materialien untersucht, einschließlich Leitfähigkeit, Widerstand, Permittivität, Permeabilität und Magnetisierung."@de,
        "An assay that investigates the magnetic and electrical properties of materials, including conductivity, resistivity, permittivity, permeability, and magnetization."@en .

cryo:CRYO_0000001 a owl:Class ;
    rdfs:label "crystal lattice"@en ;
    rdfs:comment """TODO: 
1. check if located in is meant to be used this way
2. Is there a better alternative to has part?"""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0001015 ;
            owl:someValuesFrom pmd:PMD_0020003 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom cryo:CRYO_0000000 ],
        obo:BFO_0000029 ;
    skos:definition "Crystal lattice is a site which has unit cell as part and is location of a crystal. It represents a periodic array of points in space, which describe the arrangement of atoms or molecules in a crystal."@en .

cryo:CRYO_0000390 a owl:Class ;
    rdfs:label "lattice system"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass cryo:CRYO_0000392 ;
            owl:onProperty [ owl:inverseOf obo:OBI_0001927 ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000080 ;
                        owl:someValuesFrom cryo:CRYO_0000001 ] [ a owl:Restriction ;
                        owl:allValuesFrom cryo:CRYO_0000001 ;
                        owl:onProperty obo:RO_0000080 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf obo:OBI_0001927 ] ;
            owl:someValuesFrom cryo:CRYO_0000392 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom cryo:CRYO_0000001 ],
        obo:BFO_0000019,
        pmd:PMD_0023041 ;
    skos:altLabel "lattice type"@en ;
    skos:definition "lattice system is a quality of crystal lattice that defines its symmetry based on the 7 categories originating from its point group symmetries of their empty translational frameworks"@en .

obo:CHEBI_33521 a owl:Class ;
    rdfs:label "metal atom" ;
    obo:IAO_0000115 "An atom of an element that exhibits typical metallic properties, being typically shiny, with high electrical and thermal conductivity." ;
    rdfs:subClassOf obo:CHEBI_33250 .

pmd:PMD_0000663 a owl:Class ;
    rdfs:label "kristallit"@de,
        "crystallite"@en ;
    rdfs:subClassOf pmd:PMD_0020003 ;
    skos:altLabel "Korn"@de,
        "grain"@en ;
    skos:definition "A crystal grain is a crystal that is part of a polycrystal."@en ;
    pmd:PMD_0000060 true .

noes:NOES_0000160 a owl:Class ;
    rdfs:label "angle to rolling direction"@en ;
    rdfs:comment """TODO refine the axiom: 
1. Add reference frames for sample and material?
2. longitudinal direction as sublcass of fiat line?""" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025999 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( noes:NOES_0000031 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0001025 ;
                                            owl:someValuesFrom obo:BFO_0000030 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025999 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( noes:NOES_0000033 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0001025 ;
                                            owl:someValuesFrom pmd:PMD_0000000 ] ) ] ] ) ],
        pmd:PMD_0001035,
        pmd:PMD_0020309 ;
    skos:definition "Angle to rolling direction is a relational quality which characterizes the orientation of a sample cut from a rolled material in respect to the rolling direction (RD) of this material."@en ;
    skos:example "Sample cut at 30° to rolling direction of a annealed nonoriented electrical steel."@en .

noes:NOES_0000031 a owl:Class ;
    rdfs:label "longitudinal direction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom noes:NOES_0000094 ],
        [ a owl:Restriction ;
            owl:onProperty noes:NOES_0000067 ;
            owl:someValuesFrom noes:NOES_0000094 ],
        noes:NOES_0000001 ;
    skos:definition "Longitudinal direction is a rolled sheet direction along the dimension in which an anisotropic material property is measured. Longitudinal direction might be parallel to the rolling or transversal direction of a rolled material, and it is always normal to the rolling direction."@en .

obo:RO_0009007 a owl:ObjectProperty ;
    rdfs:label "characteristic measured by assay"@en ;
    obo:IAO_0000115 "Inverse of 'assay measures characteristic'"@en ;
    rdfs:domain obo:BFO_0000020 .

obo:OBI_0000293 a owl:ObjectProperty ;
    rdfs:label "has specified input"@en ;
    obo:IAO_0000112 "see is_input_of example_of_usage"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000115 "The inverse property of is specified input of" ;
    obo:IAO_0000116 "8/17/09: specified inputs of one process are not necessarily specified inputs of a larger process that it is part of. This is in contrast to how 'has participant' works." ;
    obo:IAO_0000117 "PERSON: Bjoern Peters",
        "PERSON: Larry Hunter",
        "PERSON: Melanie Coutot",
        "PERSON: Alan Ruttenberg"@en ;
    rdfs:domain obo:COB_0000035 ;
    rdfs:subPropertyOf obo:RO_0000057 ;
    owl:inverseOf obo:OBI_0000295 ;
    owl:propertyChainAxiom ( obo:OBI_0000293 obo:RO_0002351 ) .

pmd:PMD_0025998 a owl:ObjectProperty ;
    rdfs:label "hat relationale Qualität"@de,
        "has relational quality"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:domain obo:BFO_0000004 ;
    rdfs:range obo:BFO_0000145 ;
    owl:inverseOf pmd:PMD_0025999 ;
    owl:propertyChainAxiom ( obo:BFO_0000051 pmd:PMD_0025998 ) ;
    skos:definition "eine Beziehung zwischen einem unabhängigen Kontinuum (dem Träger) und einer relationalen Qualität, bei der die Qualität in ihrer Existenz speziell vom Träger abhängt"@de,
        "a relation between an independent continuant (the bearer) and a relational quality, in which the quality specifically depends on the bearer for its existence"@en ;
    skos:example "material has relational quality mass proportion m, and portion of iron has the same relational quality mass proportion m"@en .

obo:RO_0001015 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "location of"@en ;
    obo:IAO_0000112 "my head is the location of my brain"@en,
        "this cage is the location of this rat"@en ;
    obo:IAO_0000115 "a relation between two independent continuants, the location and the target, in which the target is entirely within the location"@en ;
    obo:IAO_0000116 "Most location relations will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/"@en ;
    owl:inverseOf obo:RO_0001025 .

obo:RO_0000086 a owl:ObjectProperty ;
    rdfs:label "has quality"@en ;
    obo:IAO_0000112 "this apple has quality this red color"@en ;
    obo:IAO_0000115 "a relation between an independent continuant (the bearer) and a quality, in which the quality specifically depends on the bearer for its existence"@en ;
    obo:IAO_0000116 "A bearer can have many qualities, and its qualities can exist for different periods of time, but none of its qualities can exist when the bearer does not exist."@en ;
    rdfs:range obo:BFO_0000019 ;
    rdfs:subPropertyOf obo:RO_0000053 .

obo:OBI_0001937 a owl:DatatypeProperty ;
    rdfs:label "has specified numeric value" ;
    obo:IAO_0000114 obo:IAO_0000120 ;
    obo:IAO_0000115 "A relation between a value specification and a number that quantifies it."@en ;
    obo:IAO_0000116 "A range of 'real' might be better than 'float'. For now we follow 'has measurement value' until we can consider technical issues with SPARQL queries and reasoning." ;
    obo:IAO_0000117 "PERSON: James A. Overton" ;
    obo:IAO_0000119 "OBI" ;
    rdfs:domain obo:OBI_0001933 ;
    rdfs:subPropertyOf obo:OBI_0002135 .

obo:BFO_0000051 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has part"@en ;
    obo:IAO_0000112 "my body has part my brain (continuant parthood, two material entities)"@en,
        "my stomach has part my stomach cavity (continuant parthood, material entity has part immaterial entity)"@en,
        "this year has part this day (occurrent parthood)"@en ;
    obo:IAO_0000115 "a core relation that holds between a whole and its part"@en ;
    obo:IAO_0000116 "Everything has itself as a part. Any part of any part of a thing is itself part of that thing. Two distinct things cannot have each other as a part."@en,
        "Occurrents are not subject to change and so parthood between occurrents holds for all the times that the part exists. Many continuants are subject to change, so parthood between continuants will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/"@en,
        """Parthood requires the part and the whole to have compatible classes: only an occurrent have an occurrent as part; only a process can have a process as part; only a continuant can have a continuant as part; only an independent continuant can have an independent continuant as part; only a specifically dependent continuant can have a specifically dependent continuant as part; only a generically dependent continuant can have a generically dependent continuant as part. (This list is not exhaustive.)

A continuant cannot have an occurrent as part: use 'participates in'. An occurrent cannot have a continuant as part: use 'has participant'. An immaterial entity cannot have a material entity as part: use 'location of'. An independent continuant cannot have a specifically dependent continuant as part: use 'bearer of'. A specifically dependent continuant cannot have an independent continuant as part: use 'inheres in'."""@en ;
    rdfs:subPropertyOf obo:BFO_0000051 .

obo:BFO_0000030 a owl:Class ;
    rdfs:label "object"@en ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "(Elucidation) An object is a material entity which manifests causal unity & is of a type instances of which are maximal relative to the sort of causal unity manifested"@en ;
    skos:example "An organism; a fish tank; a planet; a laptop; a valve; a block of marble; an ice cube"@en .

pmd:PMD_0020140 a owl:Class ;
    rdfs:label "portion of pure chemical element"@en ;
    rdfs:subClassOf obo:CHEBI_60003 ;
    skos:definition "A portion of pure chemical element is a pure substance composed of multiple atoms, which are all of the same kind."@en .

obo:IAO_0000122 a owl:NamedIndividual ;
    rdfs:label "ready for release"@en ;
    obo:IAO_0000115 "Class has undergone final review, is ready for use, and will be included in the next release. Any class lacking \"ready_for_release\" should be considered likely to change place in hierarchy, have its definition refined, or be obsoleted in the next release.  Those classes deemed \"ready_for_release\" will also derived from a chain of ancestor classes that are also \"ready_for_release.\""@en .

noes:NOES_0000141 a owl:Class ;
    rdfs:label "misorentation angle"@en ;
    rdfs:subClassOf pmd:PMD_0001035 ;
    skos:definition "misorientation angle is a relational quality that characterizes an angle between a crystallite in a microstructure and a reference crystallite with the ideal orientation of the specified crystallographic texture fiber or component. It is often used to determine if a crystallite contributes to this specific texture."@en ;
    skos:example "9° misorientation between a crystallite with <hkl>{uvw} orientation and <100>{001} cube texture component."@en .

obo:UO_0000185 a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "degree" ;
    obo:IAO_0000115 "A plane angle unit which is equal to 1/360 of a full rotation or 1.7453310^[-2] rad." ;
    rdfs:subClassOf obo:UO_1000185 .

pmd:PMD_0000077 a owl:ObjectProperty ;
    rdfs:label "specified by value"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subPropertyOf pmd:PMD_0000004 ;
    skos:definition "A relation between an entity and a value specification which is about this entity."@en .

obo:OBI_0001931 a owl:Class ;
    rdfs:label "scalar value specification" ;
    obo:IAO_0000114 obo:IAO_0000123 ;
    obo:IAO_0000115 "A value specification that consists of two parts: a numeral and a unit label"@en ;
    obo:IAO_0000117 "PERSON:Bjoern Peters" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty obo:OBI_0001937 ],
        obo:OBI_0001933 .

[] a owl:Axiom ;
    oboInOwl:hasDbXref "Wikipedia:Wikipedia" ;
    owl:annotatedProperty obo:IAO_0000115 ;
    owl:annotatedSource obo:UO_0000190 ;
    owl:annotatedTarget "A dimensionless unit which denotes an amount or magnitude of one quantity relative to another." .

[] a owl:AllDisjointClasses ;
    owl:members ( noes:NOES_0000135 noes:NOES_0000144 noes:NOES_0000151 noes:NOES_0000167 ) .

[] a owl:AllDisjointClasses ;
    owl:members ( obo:BFO_0000009 obo:BFO_0000018 obo:BFO_0000026 obo:BFO_0000028 ) .

[] a owl:Axiom ;
    rdfs:comment "\"occurrent part of\" is not a BFO2020 temporalized relation. It just restricts the domain and range to \"occurrent\". That's why is should be OK to make it sub property of RO \"part of\"" ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource obo:BFO_0000132 ;
    owl:annotatedTarget obo:BFO_0000050 .

[] a owl:Axiom ;
    oboInOwl:hasDbXref "UOB:LKSR" ;
    owl:annotatedProperty obo:IAO_0000115 ;
    owl:annotatedSource obo:UO_0010006 ;
    owl:annotatedTarget "A dimensionless ratio unit which, given a pair of quantities a and b, for which b is a multiple of a, denotes b by giving the multiplier (coefficient) c for a to result in b." .

[] a owl:Axiom ;
    oboInOwl:hasDbXref "NIST:NIST" ;
    owl:annotatedProperty obo:IAO_0000115 ;
    owl:annotatedSource obo:UO_0000017 ;
    owl:annotatedTarget "A length unit which is equal to one millionth of a meter or 10^[-6] m." .

[] a owl:Axiom ;
    oboInOwl:hasDbXref "Wikipedia:Wikipedia" ;
    owl:annotatedProperty obo:IAO_0000115 ;
    owl:annotatedSource obo:UO_0000187 ;
    owl:annotatedTarget "A dimensionless ratio unit which denotes numbers as fractions of 100." .

[] a owl:AllDisjointClasses ;
    owl:members ( pmd:PMD_0020288 pmd:PMD_0020289 pmd:PMD_0020290 pmd:PMD_0020291 pmd:PMD_0020292 pmd:PMD_0020293 pmd:PMD_0020294 pmd:PMD_0020295 pmd:PMD_0020296 ) .

[] a owl:Axiom ;
    oboInOwl:hasDbXref "NIST:NIST" ;
    owl:annotatedProperty obo:IAO_0000115 ;
    owl:annotatedSource obo:UO_0000110 ;
    owl:annotatedTarget "A pressure unit which is equal to the pressure or stress on a surface caused by a force of 1 newton spread over a surface of 1 m^[2]." .

[] a owl:Axiom ;
    rdfs:comment "Mechanical view on stress"@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource pmd:PMD_0080108 ;
