                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023003"/>
        <rdfs:label xml:lang="en">a portions property</rdfs:label>
        <skos:definition xml:lang="en">a &apos;property by bearer&apos; that indicates that its bearer is a portion of matter</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023007 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023007">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023003"/>
        <rdfs:label xml:lang="en">an object aggregates property</rdfs:label>
        <skos:definition xml:lang="en">a &apos;property by bearer&apos; that indicates that its bearer is an object aggregate</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023041 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023041">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023003"/>
        <rdfs:label xml:lang="en">a sites property</rdfs:label>
        <skos:definition xml:lang="en">a &apos;property by bearer&apos; that indicates that its bearer is a site</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0025018 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0025018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000145"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Kamilla Zaripova</obo:IAO_0000117>
        <rdfs:label xml:lang="en">geometric relational quality</rdfs:label>
        <rdfs:label xml:lang="de">geometrische relationale Qualität</rdfs:label>
        <skos:definition xml:lang="en">Geometric relational quality is a relational quality describing the geometric relation between two or more independent continuants.</skos:definition>
        <skos:definition xml:lang="de">Geometrische Beziehungsqualität ist eine Beziehungsqualität, die die geometrische Beziehung zwischen zwei oder mehr unabhängigen Kontinuen beschreibt.</skos:definition>
        <skos:example xml:lang="en">Elongation of a specimen after a tensile step, i.e., the specimen before and after the test. Angle between a rolling direction of a rolled material and the longitudinal side of a specimen.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000000 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <rdfs:label xml:lang="en">unit cell</rdfs:label>
        <skos:definition xml:lang="en">Unit cell is a site which is a part of a crystal lattice and represents the smallest volume, from which the lattice can be constructed by translational displacements. Unit cell is characterized by the length of its sides and their angular relations.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001015"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">TODO: 
1. check if located in is meant to be used this way
2. Is there a better alternative to has part?</rdfs:comment>
        <rdfs:label xml:lang="en">crystal lattice</rdfs:label>
        <skos:definition xml:lang="en">Crystal lattice is a site which has unit cell as part and is location of a crystal. It represents a periodic array of points in space, which describe the arrangement of atoms or molecules in a crystal.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000011 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000146"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">crystallographic plane</rdfs:label>
        <skos:definition xml:lang="en">Crystallographic plane is a fiat surface which is part of a crystal lattice and which is denoted by Miller indices of a plane.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000012 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000142"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">crystallographic direction</rdfs:label>
        <skos:definition xml:lang="en">Crystallographic direction is a fiat line which is part of a crystal lattice and which is denoted by Miller indices of a direction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000014 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000016"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">TODO 
1. think if its actually 1D..
2. Review the definitions of sublcasses</rdfs:comment>
        <rdfs:label xml:lang="en">Miller indices</rdfs:label>
        <skos:definition xml:lang="en">Miller indices is an information content entity which denotes crystallographic direction, crystallographic plane, or lattice point, i.e., defines their position in respect to the coordinate system of a crystal lattice, and has exactly 3 interger literals, namely h, k. and l.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000020 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000020">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000014"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000219"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">direction Miller indices</rdfs:label>
        <skos:definition xml:lang="en">Direction Miller indices define the components of a sinlge vector in the given direction in a crystal&apos;s conventional unit cell. Usually, direction Miller indices are reduced to the lowest set of integers. Direction Miller indices must be written in square brackets, e.g., [hkl].</skos:definition>
        <skos:example>[111]</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000021 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000021">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000014"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000219"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">family of directions Miller indices</rdfs:label>
        <skos:definition>&lt;111&gt;</skos:definition>
        <skos:definition xml:lang="en">Set of directions Miller indices define the components of symmetrically equivalent directions in a crystal lattice. Set of directions Miller indices must be written as &lt;hkl&gt;.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000022 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000022">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000014"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000219"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">plane Miller indices</rdfs:label>
        <skos:definition xml:lang="en">Plane Miller indices define the reciprocals of the fractional intercepts the plane makes with the crystallographic axes, reduced to the lowest set of integers. 
For example, if a plane crosses [100] axis at 1/h, [010 ] axis at 1/k, and [001] axis at 1/l, then such plane is denoted as (hkl) plane. If a plane is parallel to one of the axes, then the corresponding Miller index is 0.
Plane Miller indices must be written in round brackets, e.g., (hkl).</skos:definition>
        <skos:example>(hkl)</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000023 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000023">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000014"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000219"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">family of planes Miller indices</rdfs:label>
        <skos:definition xml:lang="en">Set of planes Miller indices define set of symmetrically equivalent planes. Set of planes must be written in curly brackets, e.g., {hkl}.</skos:definition>
        <skos:example>{111}</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000028 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000028">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000029"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000030"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000031"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000032"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000034"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000035"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000391"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <rdfs:label xml:lang="en">crystal system value</rdfs:label>
        <skos:definition xml:lang="en">crystal system value is a categorical value specification which describes the grouping of
crystal system  based on the rotational and mirror symmetries of their actual atomic arrangements in the  crystal. The specific values are triclinic, monoclinic, orthorhombic, tetragonal, trigonal, hexagonal, and cubic.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000036 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000036">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000043"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000044"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000045"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000046"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <rdfs:label xml:lang="en">lattice centering value</rdfs:label>
        <skos:definition xml:lang="en">Lattice centering value is a categorical value specification which describes th geometric arrangement of lattice points in a unit cell with one of the values: primitive, body centered, face centered, base centered.</skos:definition>
    </owl:Class>
    


