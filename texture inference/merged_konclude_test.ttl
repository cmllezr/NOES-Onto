    skos:definition "Bravais lattice orthorhombic body-centered is a crystal lattice with orthorhombic lattice system and  body-centered lattice centering."@en .

cryo:CRYO_0000133 a owl:Class ;
    rdfs:label "bravais lattice orthorhombic face-centered"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000086 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( cryo:CRYO_0000027 [ a owl:Restriction ;
                                owl:hasValue cryo:CRYO_0000045 ;
                                owl:onProperty pmd:PMD_0000077 ] ) ] ],
        cryo:CRYO_0000382 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cryo:CRYO_0000001 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000086 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( cryo:CRYO_0000027 [ a owl:Restriction ;
                                            owl:hasValue cryo:CRYO_0000045 ;
                                            owl:onProperty pmd:PMD_0000077 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000086 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                            owl:hasValue cryo:CRYO_0000031 ;
                                            owl:onProperty pmd:PMD_0000077 ] ) ] ] ) ] ;
    skos:definition "Bravais lattice orthorhombic face-centered is a crystal lattice with orthorhombic lattice system and face-centered lattice centering."@en .

cryo:CRYO_0000134 a owl:Class ;
    rdfs:label "bravais lattice cubic face-centered"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
