AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020172> "sheet"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020172> "A plate is a thin rectangular object that may bear a semi finished product role. At the same time it is a material."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020172> <http://purl.obolibrary.org/obo/BFO_0000030>)

# Class: <https://w3id.org/pmd/co/PMD_0020173> (billet)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020173> "billet"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020173> "A billet is a relatively compact object that may bear a semi finished product role. At the same time it is a material."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020173> <http://purl.obolibrary.org/obo/BFO_0000030>)

# Class: <https://w3id.org/pmd/co/PMD_0020174> (foil)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020174> "foil"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020174> "A plate is a very thin rectangular object that may bear a semi finished product role. At the same time it may be a material."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020174> <http://purl.obolibrary.org/obo/BFO_0000030>)

# Class: <https://w3id.org/pmd/co/PMD_0020175> (coil (coiled sheet))

AnnotationAssertion(rdfs:comment <https://w3id.org/pmd/co/PMD_0020175> "Coils may have several sheets that are joined together."@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020175> "coil (coiled sheet)"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020175> "A coil is an object that has part some sheets or foils. At the same time it may be a material."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020175> <http://purl.obolibrary.org/obo/BFO_0000030>)

# Class: <https://w3id.org/pmd/co/PMD_0020176> (plate)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020176> "plate"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020176> "A plate is a thick rectangular object that may bear a semi finished product role. At the same time it may be a material."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020176> <http://purl.obolibrary.org/obo/BFO_0000030>)

# Class: <https://w3id.org/pmd/co/PMD_0020177> (bar)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020177> "bar"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020177> "A bar is a long object with rectangular section that may bear a semi finished product role. At the same time it may be a material."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020177> <http://purl.obolibrary.org/obo/BFO_0000030>)

# Class: <https://w3id.org/pmd/co/PMD_0020178> (rod)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020178> "rod"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020178> "A rod is a long object with oval or round section that may bear a semi finished product role. At the same time it may be a material."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020178> <http://purl.obolibrary.org/obo/BFO_0000030>)

# Class: <https://w3id.org/pmd/co/PMD_0020179> (wire (semi finished product))

AnnotationAssertion(rdfs:comment <https://w3id.org/pmd/co/PMD_0020179> "This class does not include cables or other compound structures."@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020179> "wire (semi finished product)"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020179> "A wire is a long and somewhat flexible object that may bear a semi finished product role. At the same time it is a material."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020179> <http://purl.obolibrary.org/obo/BFO_0000030>)

# Class: <https://w3id.org/pmd/co/PMD_0020180> (tube)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020180> "tube"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020180> "A tube is a long object with a hollow section and moderate wall thickness that may bear a semi finished product role. At the same time it may be a material."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020180> <http://purl.obolibrary.org/obo/BFO_0000030>)

# Class: <https://w3id.org/pmd/co/PMD_0020181> (pipe)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020181> "pipe"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020181> "A tube is a long object with a hollow section and pronounced wall thickness that may bear a semi finished product role. At the same time it may be a material."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020181> <http://purl.obolibrary.org/obo/BFO_0000030>)

# Class: <https://w3id.org/pmd/co/PMD_0020182> (profile (semi finished product))

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020182> "profile (semi finished product)"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020182> "A profile is a long object with determined section shape that may bear a semi finished product role. At the same time it may be a material."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020182> <http://purl.obolibrary.org/obo/BFO_0000030>)

# Class: <https://w3id.org/pmd/co/PMD_0020197> (lattice point)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020197> "lattice point"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020197> "A lattice point is a fiat point that represents a position in a crystal lattice at which structural entities are regularly arranged."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020197> <http://purl.obolibrary.org/obo/BFO_0000147>)

# Class: <https://w3id.org/pmd/co/PMD_0020198> (interstitial site)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020198> "interstitial site"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020198> "An interstitial site is a site that is located between regular lattice points in a crystal structure."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020198> <http://purl.obolibrary.org/obo/BFO_0000029>)

# Class: <https://w3id.org/pmd/co/PMD_0020200> (force)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0020200> "PERSON: Philipp von Hartrott")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <https://w3id.org/pmd/co/PMD_0020200> "Old definition: Force is a reciprocal relation realized between two objects where the other object exerts the same force with opposite sign onto the first. Force may be responsible for changes in velocity and/or deformation of objects.")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020200> "force"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020200> "A force is an entity that consists of a reciprocal interaction between two objects and is realized as equal and opposite influences capable of changing motion or causing deformation."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020200> <https://w3id.org/pmd/co/PMD_0020311>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020200> <https://w3id.org/pmd/co/PMD_0020317>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020200> ObjectSomeValuesFrom(<https://w3id.org/pmd/co/PMD_0025999> <http://purl.obolibrary.org/obo/BFO_0000030>))

# Class: <https://w3id.org/pmd/co/PMD_0020205> (Defektrolle)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0020205> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0020205> "PERSON: Philipp von Hartrott")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020205> "Defektrolle"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020205> "defect role"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020205> "A defect role is a role of an independent continuant C indicating that C may affect a material entity E's ability to realize a function. C is continuant part of E."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020205> "Eine Defektrolle ist eine Rolle eines unabhängigen Kontinuums C, die darauf hinweist, dass C die Fähigkeit einer materiellen Entität E, eine Funktion zu realisieren, beeinträchtigen kann. C ist fortlaufender Teil von E."@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0020205> "A crack in an structural member may affect its ability to carry a load."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020205> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020205> <http://purl.obolibrary.org/obo/BFO_0000017>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020205> <https://w3id.org/pmd/co/PMD_0020335>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020205> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000081> <http://purl.obolibrary.org/obo/BFO_0000001>))

# Class: <https://w3id.org/pmd/co/PMD_0020207> (amount of substance)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0020207> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0020207> "PERSON: Philipp von Hartrott")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020207> "Stoffmenge"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020207> "amount of substance"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020207> "Amount of substance n is a molar proportion when the whole is an object aggregate N, which has avogadro number objects (of same type) as parts (n = N/N_A)."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020207> "Die Menge der Substanz n ist ein molarer Anteil, wenn das Ganze ein Objektaggregat N ist, das Avogadro-Anzahlobjekte (gleicher Art) als Teile hat (n = N/N_A)."@de)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020207> <https://w3id.org/pmd/co/PMD_0020103>)

# Class: <https://w3id.org/pmd/co/PMD_0020210> (elemental crystal)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020210> "elemental crystal"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020210> "a crystal that consists of exactly one atomic species"@en)
EquivalentClasses(<https://w3id.org/pmd/co/PMD_0020210> ObjectExactCardinality(1 <http://purl.obolibrary.org/obo/RO_0002351> <https://w3id.org/pmd/co/PMD_0020140>))
SubClassOf(<https://w3id.org/pmd/co/PMD_0020210> <https://w3id.org/pmd/co/PMD_0020003>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020210> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002351> <https://w3id.org/pmd/co/PMD_0020140>))

# Class: <https://w3id.org/pmd/co/PMD_0020213> (grain boundary)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <https://w3id.org/pmd/co/PMD_0020213> "the part of a grain that is close to the grain boundary and possibly characterized by disorder is a fiat object part (grain surface layer)"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020213> "grain boundary"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020213> "A grain boundary is a fiat surface that separates adjacent grains in a polycrystalline material and is characterized by structural discontinuity."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020213> <http://purl.obolibrary.org/obo/BFO_0000146>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0020213> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002350> ObjectIntersectionOf(<https://w3id.org/pmd/co/PMD_0020003> ObjectSomeValuesFrom(<https://w3id.org/pmd/co/PMD_0025998> <https://w3id.org/pmd/co/PMD_0020241>))))
SubClassOf(<https://w3id.org/pmd/co/PMD_0020213> ObjectExactCardinality(2 <http://purl.obolibrary.org/obo/RO_0002350> ObjectIntersectionOf(<https://w3id.org/pmd/co/PMD_0020003> ObjectSomeValuesFrom(<https://w3id.org/pmd/co/PMD_0025998> <https://w3id.org/pmd/co/PMD_0020241>))))

