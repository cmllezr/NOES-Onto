ns2:IAO_0000027 a owl:Class ;
    rdfs:label "data entity"@en,
        "data item"@en ;
    ns2:IAO_0000112 "Data items include counts of things, analyte concentrations, and statistical summaries."@en ;
    ns2:IAO_0000115 "An information content entity that is intended to be a truthful statement about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements."@en,
        "An information content entity that is intended to be one or more truthful statement(s) about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements."@en ;
    ns2:IAO_0000116 "2014-03-31: See discussion at http://odontomachus.wordpress.com/2014/03/30/aboutness-objects-propositions/",
        "2/2/2009 Alan and Bjoern discussing FACS run output data. This is a data item because it is about the cell population. Each element records an event and is typically further composed a set of measurment data items that record the fluorescent intensity stimulated by one of the lasers."@en,
        "2009-03-16: data item deliberatly ambiguous: we merged data set and datum to be one entity, not knowing how to define singular versus plural. So data item is more general than datum."@en,
        "2009-03-16: removed datum as alternative term as datum specifically refers to singular form, and is thus not an exact synonym."@en,
        """JAR: datum     -- well, this will be very tricky to define, but maybe some 
information-like stuff that might be put into a computer and that is 
meant, by someone, to denote and/or to be interpreted by some 
process... I would include lists, tables, sentences... I think I might 
defer to Barry, or to Brian Cantwell Smith

JAR: A data item is an approximately justified approximately true approximate belief"""@en ;
    rdfs:subClassOf ns2:IAO_0000030 .

ns2:IAO_0000120 a owl:NamedIndividual ;
    rdfs:label "metadata complete"@en ;
    ns2:IAO_0000115 "Class has all its metadata, but is either not guaranteed to be in its final location in the asserted IS_A hierarchy or refers to another class that is not complete."@en .

ns2:OBI_0001927 a owl:ObjectProperty ;
    rdfs:label "specifies value of" ;
    ns2:IAO_0000114 ns2:IAO_0000123 ;
    ns2:IAO_0000115 "A relation between a value specification and an entity which the specification is about."@en ;
    rdfs:domain ns2:OBI_0001933 ;
    rdfs:subPropertyOf ns2:IAO_0000136 ;
    owl:inverseOf ns1:PMD_0000077 .

ns2:RO_0000081 a owl:ObjectProperty ;
    rdfs:label "role of"@en ;
    ns2:IAO_0000112 "this investigator role is a role of this person"@en ;
    ns2:IAO_0000115 "a relation between a role and an independent continuant (the bearer), in which the role specifically depends on the bearer for its existence"@en ;
    ns2:IAO_0000116 "A role inheres in its bearer at all times for which the role exists, however the role need not be realized at all the times that the role exists."@en ;
    rdfs:comment "This relation is modeled after the BFO relation of the same name which was in BFO2, but is used in a more restricted sense - specifically, we model this relation as functional (inherited from characteristic-of). Note that this relation is now removed from BFO2020." ;
    rdfs:subPropertyOf ns2:RO_0000052 ;
    owl:inverseOf ns2:RO_0000087 .

ns2:RO_0002353 a owl:ObjectProperty ;
    rdfs:label "output of"@en ;
    ns2:IAO_0000115 "inverse of has output" ;
    rdfs:subPropertyOf ns2:RO_0000056,
        ns2:RO_0002328 .

ns1:PMD_0000004 a owl:ObjectProperty ;
    rdfs:label "is subject of"@en ;
    ns2:IAO_0000114 ns2:IAO_0000122 ;
    ns2:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    skos:definition "Inverse of 'is about'."@en .

ns1:PMD_0020003 a owl:Class ;
    rdfs:label "crystal"@en ;
    ns2:IAO_0000114 ns2:IAO_0000122 ;
    ns2:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:RO_0000086 ;
            owl:someValuesFrom ns1:PMD_0000591 ],
        ns2:BFO_0000030 ;
    skos:definition "A crystal is an object that has a quality \"crystal structure\"."@en ;
    ns1:PMD_0000060 true .

ns1:PMD_0020132 a owl:Class ;
    rdfs:label "spatial extend"@en ;
    ns2:IAO_0000114 ns2:IAO_0000122 ;
    ns2:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( ns2:BFO_0000019 [ a owl:Restriction ;
                        owl:onProperty ns2:RO_0000080 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( ns2:BFO_0000024 ns2:BFO_0000027 ns2:BFO_0000029 ns2:BFO_0000030 ns2:BFO_0000140 ) ] ] ) ] ;
    skos:definition "Dimension quality is a quality of a material entity that pertains to its measurable spatial extent, such as length, area, or volume"@en ;
    skos:example "the wall thickness of a steel pipe is a dimension quality functionally related to its pressure resistance"@en ;
    ns1:PMD_0000060 true .

ns1:PMD_0020259 a owl:Class ;
    rdfs:label "chemical property"@en ;
    rdfs:subClassOf ns1:PMD_0020265 ;
    skos:definition "a property that is commonly associated with the domain of chemistry"@en .

ns1:PMD_0020365 a owl:Class ;
    rdfs:label "per volume property"@en ;
    ns2:IAO_0000116 "TODO axiom wrong"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:RO_0002328 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:PMD_0020150 [ a owl:Restriction ;
                                owl:onProperty ns1:PMD_0000077 ;
                                owl:someValuesFrom ns2:OBI_0001931 ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns2:RO_0002328 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns2:BFO_0000001 [ a owl:Restriction ;
                                owl:onProperty ns2:RO_0000086 ;
                                owl:someValuesFrom ns1:PMD_0020150 ] ) ] ],
        ns1:PMD_0023001 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns2:RO_0002328 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns2:BFO_0000001 [ a owl:Restriction ;
                                owl:onProperty ns2:RO_0000086 ;
                                owl:someValuesFrom ns1:PMD_0020150 ] ) ] ] ;
    skos:definition "a quotient where the denominator is a volume"@en .

ns1:PMD_0020366 a owl:Class ;
    rdfs:label "per mass property"@en ;
    ns2:IAO_0000116 "TODO axiom wrong"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:RO_0002328 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns2:BFO_0000001 [ a owl:Restriction ;
                                owl:onProperty ns2:RO_0000086 ;
                                owl:someValuesFrom ns1:PMD_0020133 ] ) ] ],
        ns1:PMD_0023001 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns2:RO_0002328 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns2:BFO_0000001 [ a owl:Restriction ;
                                owl:onProperty ns2:RO_0000086 ;
                                owl:someValuesFrom ns1:PMD_0020133 ] ) ] ] ;
    skos:definition "a quotient where the denominator is the mass of the bearer"@en .

cryo:CRYO_0000041 a owl:Class ;
    rdfs:label "crystallographic entity in cubic system"@en ;
    rdfs:comment "Note that this class is not meant for instantiation but is needed for formulation of other logical axioms and inferences." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasSelf true ;
            owl:onProperty cryo:CRYO_0000170 ],
        ns2:BFO_0000141 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( ns2:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty ns2:BFO_0000050 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000001 [ a owl:Restriction ;
                                                        owl:onProperty ns2:RO_0000086 ;
                                                        owl:someValuesFrom [ a owl:Class ;
                                                                owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                                            owl:hasValue cryo:CRYO_0000035 ;
                                                                            owl:onProperty ns1:PMD_0000077 ] ) ] ] ) ] ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( ns2:BFO_0000141 [ a owl:Restriction ;
                                    owl:onProperty ns2:RO_0000086 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                                        owl:hasValue cryo:CRYO_0000035 ;
                                                        owl:onProperty ns1:PMD_0000077 ] ) ] ] ) ] ) ] ;
    skos:definition "Crystallographic entity in cubic system is an immaterial entity that either itself has cubic lattice system or is a part of crystal lattice with cubic lattice system."@en .

cryo:CRYO_0000392 a owl:Class ;
    rdfs:label "lattice system value"@en ;
    rdfs:subClassOf ns2:OBI_0001930 ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cryo:CRYO_0000029 cryo:CRYO_0000030 cryo:CRYO_0000031 cryo:CRYO_0000032 cryo:CRYO_0000033 cryo:CRYO_0000034 cryo:CRYO_0000035 ) ] ;
    skos:definition """lattice system value is a categorical value specification which describes the grouping of
lattice system based on the point group symmetries of their empty translational frameworks. The specific values are triclinic, monoclinic, orthorhombic, tetragonal, rhombohedral, hexagonal, and cubic."""@en .

:NOES_0000001 a owl:Class ;
    rdfs:label "rolled sheet direction"@en ;
    rdfs:comment """TODO: 
which determines the directions in a sheet material in respect to the rolling direction. Rolled sheet direction is a part of material or object."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:RO_0001025 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns2:BFO_0000030 ns1:PMD_0000000 ) ] ],
        ns2:BFO_0000142 ;
    skos:definition "Rolled sheet direction is a fiat line which is part of rolled material's intrinsic reference frame."@en .

:NOES_0000031 a owl:Class ;
    rdfs:label "longitudinal direction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:BFO_0000050 ;
            owl:someValuesFrom :NOES_0000094 ],
        [ a owl:Restriction ;
            owl:onProperty :NOES_0000067 ;
            owl:someValuesFrom :NOES_0000094 ],
        :NOES_0000001 ;
    skos:definition "Longitudinal direction is a rolled sheet direction along the dimension in which an anisotropic material property is measured. Longitudinal direction might be parallel to the rolling or transversal direction of a rolled material, and it is always normal to the rolling direction."@en .

:NOES_0000066 a owl:ObjectProperty ;
    rdfs:label "geometrically related"@en ;
    rdfs:comment "This object property is not intended to be used between intances."@en ;
    rdfs:domain ns2:BFO_0000004 ;
    rdfs:range ns2:BFO_0000004 ;
    skos:definition "Geometrically related is a top-level object property to describe geometrical relations between different spatial regions"@en .

ns2:BFO_0000006 a owl:Class ;
    rdfs:label "spatial region"@en ;
    rdfs:subClassOf ns2:BFO_0000141 ;
    skos:definition "(Elucidation) A spatial region is a continuant entity that is a continuant part of the spatial projection of a portion of spacetime at a given time"@en ;
    skos:example "As for zero-dimensional spatial region, one-dimensional spatial region, two-dimensional spatial region, three-dimensional spatial region"@en .

ns2:BFO_0000016 a owl:Class ;
    rdfs:label "disposition"@en ;
    ns2:IAO_0000112 "an atom of element X has the disposition to decay to an atom of element Y"@en,
        "certain people have a predisposition to colon cancer"@en,
        "children are innately disposed to categorize objects in certain ways."@en,
        "the cell wall is disposed to filter chemicals in endocytosis and exocytosis"@en ;
    ns2:IAO_0000116 "BFO 2 Reference: Dispositions exist along a strength continuum. Weaker forms of disposition are realized in only a fraction of triggering cases. These forms occur in a significant number of cases of a similar type."@en ;
    rdfs:subClassOf ns2:BFO_0000017 ;
    owl:disjointWith ns2:BFO_0000023 ;
    skos:altLabel "internally-grounded realizable entity"@en ;
    skos:definition "(Elucidation) A disposition b is a realizable entity such that if b ceases to exist then its bearer is physically changed & b's realization occurs when and because this bearer is in some special physical circumstances & this realization occurs in virtue of the bearer's physical make-up"@en ;
    skos:example "An atom of element X has the disposition to decay to an atom of element Y; the cell wall is disposed to transport cellular material through endocytosis and exocytosis; certain people have a predisposition to colon cancer; children are innately disposed to categorize objects in certain ways"@en .

ns2:BFO_0000023 a owl:Class ;
    rdfs:label "role"@en ;
    ns2:IAO_0000112 "John’s role of husband to Mary is dependent on Mary’s role of wife to John, and both are dependent on the object aggregate comprising John and Mary as member parts joined together through the relational quality of being married."@en,
        "the priest role"@en,
        "the role of a boundary to demarcate two neighboring administrative territories"@en,
        "the role of a building in serving as a military target"@en,
        "the role of a stone in marking a property boundary"@en,
        "the role of subject in a clinical trial"@en,
        "the student role"@en ;
    ns2:IAO_0000115 "A realizable entity  the manifestation of which brings about some result or end that is not essential to a continuant  in virtue of the kind of thing that it is but that can be served or participated in by that kind of continuant  in some kinds of natural, social or institutional contexts."@en ;
    ns2:IAO_0000116 "BFO 2 Reference: One major family of examples of non-rigid universals involves roles, and ontologies developed for corresponding administrative purposes may consist entirely of representatives of entities of this sort. Thus ‘professor’, defined as follows,b instance_of professor at t =Def. there is some c, c instance_of professor role & c inheres_in b at t.denotes a non-rigid universal and so also do ‘nurse’, ‘student’, ‘colonel’, ‘taxpayer’, and so forth. (These terms are all, in the jargon of philosophy, phase sortals.) By using role terms in definitions, we can create a BFO conformant treatment of such entities drawing on the fact that, while an instance of professor may be simultaneously an instance of trade union member, no instance of the type professor role is also (at any time) an instance of the type trade union member role (any more than any instance of the type color is at any time an instance of the type length).If an ontology of employment positions should be defined in terms of roles following the above pattern, this enables the ontology to do justice to the fact that individuals instantiate the corresponding universals –  professor, sergeant, nurse – only during certain phases in their lives."@en ;
    rdfs:subClassOf ns2:BFO_0000017 ;
    skos:altLabel "externally-grounded realizable entity"@en ;
    skos:definition "(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be & b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed"@en ;
    skos:example "The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a boundary to demarcate two neighbouring administrative territories; the role of a building in serving as a military target"@en .

ns2:BFO_0000142 a owl:Class ;
    rdfs:label "fiat line"@en ;
    rdfs:subClassOf ns2:BFO_0000140 ;
    skos:definition "(Elucidation) A fiat line is a one-dimensional continuant fiat boundary that is continuous"@en ;
    skos:example "The Equator; all geopolitical boundaries; all lines of latitude and longitude; the median sulcus of your tongue; the line separating the outer surface of the mucosa of the lower lip from the outer surface of the skin of the chin"@en .

ns2:BFO_0000145 a owl:Class ;
    rdfs:label "relational quality"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:PMD_0025999 ;
            owl:someValuesFrom ns2:BFO_0000002 ],
        ns2:BFO_0000019 ;
    skos:definition "b is a relational quality =Def b is a quality & there exists c and d such that c and d are not identical & b specifically depends on c & b specifically depends on d"@en ;
    skos:example "A marriage bond; an instance of love; an obligation between one person and another"@en .

ns2:CHEBI_59999 a owl:Class ;
    rdfs:label "chemical substance" ;
    ns2:IAO_0000115 "A chemical substance is a portion of matter of constant composition, composed of molecular entities of the same type or of different types." ;
    rdfs:comment "Frequently used for fluidic portions of matter and/or in the context of chemical reactions. Boundary to material not always sharp."@en ;
    rdfs:subClassOf ns2:CHEBI_24431,
        ns1:PMD_0000001 .

ns2:IAO_0000102 a owl:Class ;
    rdfs:label "data about an ontology part"@en ;
    ns2:IAO_0000115 "Data about an ontology part is a data item about a part of an ontology, for example a term"@en ;
    rdfs:subClassOf ns2:IAO_0000027 .

ns2:IAO_0000136 a owl:ObjectProperty ;
    rdfs:label "is about"@en ;
    ns2:IAO_0000112 "This document is about information artifacts and their representations"@en ;
    ns2:IAO_0000115 "A (currently) primitive relation that relates an information artifact to an entity."@en ;
    ns2:IAO_0000116 """7/6/2009 Alan Ruttenberg. Following discussion with Jonathan Rees, and introduction of "mentions" relation. Weaken the is_about relationship to be primitive. 

We will try to build it back up by elaborating the various subproperties that are more precisely defined.

Some currently missing phenomena that should be considered "about" are predications - "The only person who knows the answer is sitting beside me" , Allegory, Satire, and other literary forms that can be topical without explicitly mentioning the topic."""@en ;
    ns2:IAO_0000119 "Smith, Ceusters, Ruttenberg, 2000 years of philosophy"@en ;
    rdfs:domain ns2:IAO_0000030 ;
    owl:inverseOf <https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000226>,
        ns1:PMD_0000004 .

ns2:RO_0000057 a owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    ns2:IAO_0000112 "this blood coagulation has participant this blood clot"@en,
        "this investigation has participant this investigator"@en,
        "this process has participant this input material (or this output material)"@en ;
    ns2:IAO_0000115 "a relation between a process and a continuant, in which the continuant is somehow involved in the process"@en ;
    ns2:IAO_0000116 "Has_participant is a primitive instance-level relation between a process, a continuant, and a time at which the continuant participates in some way in the process. The relation obtains, for example, when this particular process of oxygen exchange across this particular alveolar membrane has_participant this particular sample of hemoglobin at this particular time."@en ;
    rdfs:domain ns2:BFO_0000003 ;
    rdfs:range ns2:BFO_0000002 ;
    owl:propertyChainAxiom ( ns2:BFO_0000051 ns2:RO_0000057 ) .

ns1:PMD_0020142 a owl:Class ;
    rdfs:label "Energie"@de,
        "energy"@en ;
    ns2:IAO_0000114 ns2:IAO_0000122 ;
    ns2:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    ns2:IAO_0000119 <http://openenergy-platform.org/ontology/oeo/OEO_00000150> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:RO_0000080 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns2:BFO_0000024 ns2:BFO_0000027 ns2:BFO_0000030 ) ] ],
        ns2:BFO_0000019,
        ns1:PMD_0020353 ;
    skos:definition "an extensive quality of material entities which manifests as a capacity to perform work (such as causing motion or the interaction of molecules)"@en ;
    ns1:PMD_0000060 true .

ns1:PMD_0020227 a owl:Class ;
    rdfs:label "gelöste Rolle"@de,
        "solute role"@en ;
    ns2:IAO_0000114 ns2:IAO_0000122 ;
    ns2:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:RO_0000081 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns2:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty ns2:BFO_0000050 ;
                                owl:someValuesFrom ns1:PMD_0020229 ] ) ] ],
        ns1:PMD_0020259 ;
    owl:disjointWith ns1:PMD_0020228 ;
    skos:definition "Rolle einer Entität, die in einer Lösung in geringer Konzentration vorhanden ist"@de,
        "role of an entity that is present in minor concentration in a solution"@en .

ns1:PMD_0020228 a owl:Class ;
    rdfs:label "Lösungsmittelrolle"@de,
        "solvent role"@en ;
    ns2:IAO_0000114 ns2:IAO_0000122 ;
    ns2:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:RO_0000081 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns2:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty ns2:BFO_0000050 ;
                                owl:someValuesFrom ns1:PMD_0020229 ] ) ] ],
        ns1:PMD_0020259 ;
    skos:definition "Rolle einer Entität, die in einer Lösung in großer Konzentration vorhanden ist"@de,
        "role of an entity that is present in major concentration in a solution"@en .

ns1:PMD_0020229 a owl:Class ;
    rdfs:label "solution"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:RO_0002351 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns2:CHEBI_60003 [ a owl:Restriction ;
                                owl:onProperty ns2:RO_0000087 ;
                                owl:someValuesFrom ns1:PMD_0020228 ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns2:RO_0002351 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns2:CHEBI_60003 [ a owl:Restriction ;
                                owl:onProperty ns2:RO_0000087 ;
                                owl:someValuesFrom ns1:PMD_0020227 ] ) ] ],
        ns1:PMD_0000001 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns2:RO_0002351 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns2:CHEBI_60003 [ a owl:Restriction ;
                                            owl:onProperty ns2:RO_0000087 ;
                                            owl:someValuesFrom ns1:PMD_0020227 ] ) ] ] [ a owl:Restriction ;
                        owl:onClass [ a owl:Class ;
                                owl:intersectionOf ( ns2:CHEBI_60003 [ a owl:Restriction ;
                                            owl:onProperty ns2:RO_0000087 ;
                                            owl:someValuesFrom ns1:PMD_0020228 ] ) ] ;
                        owl:onProperty ns2:RO_0002351 ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ;
    skos:definition "A portion of matter that is homogeneous, made up of at least two entity types, one playing the role of sovlent and the others playing the role of solute"@en .

ns1:PMD_0020313 a owl:Class ;
    rdfs:label "thermodynamic property"@en ;
    rdfs:subClassOf ns1:PMD_0020265 ;
    skos:definition "a property that is commonly associated with the domain of thermodynamics"@en .

ns1:PMD_0020364 a owl:Class ;
    rdfs:label "per count property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:RO_0002328 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns2:BFO_0000001 [ a owl:Restriction ;
                                owl:onProperty ns2:RO_0000086 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( ns1:PMD_0020367 [ a owl:Restriction ;
                                                    owl:onProperty ns1:PMD_0000077 ;
                                                    owl:someValuesFrom ns2:OBI_0001931 ] ) ] ] ) ] ],
        ns1:PMD_0023001 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:PMD_0023001 [ a owl:Restriction ;
                        owl:onProperty ns2:RO_0002328 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns2:BFO_0000001 [ a owl:Restriction ;
                                            owl:onProperty ns2:RO_0000086 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( ns1:PMD_0020367 [ a owl:Restriction ;
                                                                owl:onProperty ns1:PMD_0000077 ;
                                                                owl:someValuesFrom ns2:OBI_0001931 ] ) ] ] ) ] ] ) ] ;
    skos:definition "a quotient with a denominator that has is a count"@en .

ns1:PMD_0080116 a owl:Class ;
    rdfs:label "potential"@en ;
    ns2:IAO_0000117 "Philipp von Hartrott" ;
    rdfs:comment "Every potential in physics is the same mathematical object — a partial derivative of energy with respect to its conjugate extensive quantity. The differences are only in which extensive quality you're considering."@en ;
    rdfs:subClassOf _:Nc545769bb8514b9c82e4dc47f3dddfd7,
        ns2:BFO_0000019 ;
    skos:definition "a partial derivative of energy with respect to its conjugate extensive quantity"@en ;
    ns1:PMD_0000060 true .

