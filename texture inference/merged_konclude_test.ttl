qudt:Unit a owl:Class ;
    rdfs:label "Unit" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> ;
    skos:definition """A unit of measure, or unit, is a particular quantity value that has been chosen as a scale for measuring other quantities the same kind (more generally of equivalent dimension). 
For example, the meter is a quantity of length that has been rigorously defined and standardized by the BIPM (International Board of Weights and Measures).  Any measurement of the length can be expressed as a number multiplied by the unit meter. 
More formally, the value of a physical quantity Q with respect to a unit (U) is expressed as the scalar multiple of a real number (n) and U, as  $Q = nU$."""@en .

<http://qudt.org/vocab/unit/PER-MOL> a qudt:Unit,
        owl:NamedIndividual .

xsd:string a rdfs:Datatype .

<https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000226> a owl:ObjectProperty ;
    rdfs:label "is subject of"@en ;
    rdfs:comment "inverse of the relation 'is about'" ;
    skos:altLabel "is described by" .

<https://orcid.org/0009-0003-1503-4422> rdfs:label "Kamilla Zaripova" .

pmd:PMD_0000057 a owl:Class ;
    rdfs:label "Schmelzfunktion"@de,
        "melting function"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000054 ;
    skos:definition "Eine Schmelzfunktion ist eine Heizfunktion, die es einem Gerät oder System ermöglicht, den Phasenübergang eines festen Materials in eine Flüssigkeit einzuleiten oder aufrechtzuerhalten, indem seine Temperatur über den Schmelzpunkt angehoben wird."@de,
        "A heating function that, when realized, enables a device or system to initiate or sustain the phase transition of a solid material into a liquid by raising its temperature above the melting point."@en ;
    skos:example "The function of an induction coil in a furnace to heat metal until it melts."@en .

pmd:PMD_0000534 a owl:Class ;
    rdfs:label "blank role"@en ;
    obo:IAO_0000119 "“Blank.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/blank. Accessed 25 Nov. 2022."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000081 ;
            owl:someValuesFrom obo:BFO_0000030 ],
        pmd:PMD_0020254,
        pmd:PMD_0020317 ;
    skos:definition "Role of an object, which is realized in a manufacturing process"@en ;
    skos:example "Some object, which at the same time may be a portion of material, which to be made into something by a further operation."@en .

pmd:PMD_0000547 a owl:Class ;
    rdfs:label "Änderung des Aggregatzustandes"@de,
        "change of aggregate state"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0020136 ;
    skos:definition "eine Phasenumwandlung (Phasenänderung), die den kollektiven Zustand von Teilchen in einem Teil der Materie betrifft"@de,
        "a phase transformation (change of phase) involving the collective state of particles in portion of matter"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000552 a owl:Class ;
    rdfs:label "Analyseverfahren für die chemische Zusammensetzung"@de,
        "chemical composition analyzing process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009006 ;
            owl:someValuesFrom pmd:PMD_0000551 ],
        pmd:PMD_0000957 ;
    skos:definition "Ein Struktur Eigenschaften Analyseverfahren, das die chemische Zusammensetzung eines Materials bestimmt, indem es dessen Bestandteile und Verbindungen identifiziert und quantifiziert."@de,
        "A structural property analyzing process that determines the chemical composition of a material by identifying and quantifying its constituent elements and compounds."@en .

pmd:PMD_0000561 a owl:Class ;
    rdfs:label "Reinigungsgerät"@de,
        "cleaning device"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000602 ;
    skos:definition "Ein Gerät zum Entfernen von Verunreinigungen von Materialien oder Oberflächen."@de,
        "A device used for removing contaminants from materials or surfaces."@en .

pmd:PMD_0000596 a owl:Class ;
    rdfs:label "Verformung"@de,
        "deformation"@en ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:comment "According to the modelling pattern we use TQCs to represent the participants properties before and after the process"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( pmd:PMD_0000068 [ a owl:Restriction ;
                                owl:onProperty obo:BFO_0000108 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:BFO_0000202 [ a owl:Restriction ;
                                                    owl:onProperty obo:BFO_0000063 ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( obo:BFO_0000202 [ a owl:Restriction ;
                                                                        owl:onProperty [ owl:inverseOf obo:BFO_0000108 ] ;
                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                owl:intersectionOf ( pmd:PMD_0000068 [ a owl:Restriction ;
                                                                                            owl:onProperty obo:RO_0000086 ;
                                                                                            owl:someValuesFrom pmd:PMD_0020132 ] ) ] ] ) ] ] ) ] ] [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000086 ;
                                owl:someValuesFrom pmd:PMD_0020132 ] ) ] ],
        obo:BFO_0000015 ;
    skos:definition "a process that changes the 'dimension quality' of a participant. It excludes translations and rotations."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000597 a owl:Class ;
    rdfs:label "mass density"@en ;
    rdfs:subClassOf pmd:PMD_0023043 ;
    skos:definition "fundamental property of matter representing the mass of a portion of matter per unit volume"@en .

pmd:PMD_0000619 a owl:Class ;
    rdfs:label "electric potential"@en ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002328 ;
            owl:someValuesFrom pmd:PMD_0080022 ],
        pmd:PMD_0080116 ;
    skos:definition "an extensvie quality describing the amount of work needed to move a unit charge from a reference point to a specific location in an electric field."@en .

pmd:PMD_0000636 a owl:Class ;
    rdfs:label "extensometer"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    obo:IAO_0000119 "“Extensometer.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/extensometer. Accessed 5 Dec. 2022."@en ;
    rdfs:subClassOf pmd:PMD_0000602 ;
    skos:definition "A device for measuring minute deformations of test specimens caused by tension, compression, bending, or twisting."@en .

pmd:PMD_0000639 a owl:Class ;
    rdfs:label "ferrous metal"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom pmd:PMD_0020026 ],
        pmd:PMD_0000852 ;
    skos:definition "metal that has iron as primary constituent"@en .

pmd:PMD_0000649 a owl:Class ;
    rdfs:label "Zugdruckumformen"@de,
        "forming under compressive and tensile conditions"@en ;
    obo:IAO_0000119 "Official definition can be found in: DIN 8584-1"@en ;
    dcterms:source "Offizielle Definition findet man in: DIN 8584-1"@de ;
    rdfs:subClassOf pmd:PMD_0000646 ;
    skos:definition "Ein Umform Prozess, bei dem sowohl Zug- als auch Druckkräfte auf ein Material ausgeübt werden."@de,
        "A forming process that involves applying both tensile and compressive forces to a material."@en ;
    skos:example "Stripping, Deep Drawing, Spinning"@en .

pmd:PMD_0000650 a owl:Class ;
    rdfs:label "Druckumformen"@de,
        "forming under compressive conditions"@en ;
    obo:IAO_0000119 "Official definition can be found in: DIN 8583-1"@en ;
    dcterms:source "Offizielle Definition findet man in: DIN 8583-1"@de ;
    rdfs:subClassOf pmd:PMD_0000646 ;
    skos:definition "Ein Umform Prozess, bei dem Materialien unter Druck verformt werden. Er wird üblicherweise bei Techniken wie Walzen und  Gesenkformen eingesetzt, bei denen Metall durch Druck in Form gebracht wird."@de,
        "A forming process that involves deforming materials under compressive forces, commonly used in techniques like rolling and die forming where metal is shaped by applying pressure."@en ;
    skos:example "Rolling, Coining"@en .

pmd:PMD_0000780 a owl:Class ;
    rdfs:label "Wärmebehandlungsgerät"@de,
        "heat treatment device"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000085 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( pmd:PMD_0000054 pmd:PMD_0000055 ) ] ],
        pmd:PMD_0000602 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000602 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000085 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( pmd:PMD_0000054 pmd:PMD_0000055 ) ] ] ) ] ;
    skos:definition "Ein Gerät zur Behandlung von Materialien durch Erwärmungs- und Abkühlungsprozesse zur Veränderung ihrer Eigenschaften."@de,
        "A device used for treating materials through heating and cooling processes to alter their properties."@en .

pmd:PMD_0000820 a owl:Class ;
    rdfs:label "Kraftmessdose"@de,
        "load cell"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    obo:IAO_0000119 "https://en.wikipedia.org/wiki/Load_cell"@en ;
    rdfs:subClassOf pmd:PMD_0000602 ;
    skos:definition "A device that converts mechanical force into a measurable signal by sensing the physical deformation of a structural element."@en .

pmd:PMD_0000826 a owl:Class ;
    rdfs:label "Magnetisieren"@de,
        "magnetizing"@en ;
    obo:IAO_0000119 "https://industrylist.com/glossar/stoffeigenschaften-aendern/magnetisieren/"@de ;
    rdfs:subClassOf pmd:PMD_0000550 ;
    skos:definition "Ein Stoffeigenschaft Ändern Prozess, bei dem ferromagnetische Stoffe einem äußeren Magnetfeld ausgesetzt werden wodurch der Stoff magnetische Eigenschaften übernimmt."@de,
        "A changing properties of material process in which ferromagnetic materials are exposed to an external magnetic field, causing the material to take on magnetic properties."@en ;
    skos:example "Static Magnetization, Pulse Magnetization."@en .

pmd:PMD_0000875 a owl:Class ;
    rdfs:label "Optische Mikroskopie"@de,
        "optical microscopy"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000856 ;
    skos:definition "Ein Mikroskopieverfahren, das sichtbares Licht und Linsen verwendet, um eine Probe zu vergrößern und abzubilden, und weit verbreitet zur Untersuchung der Mikrostruktur und Morphologie von Materialien ist."@de,
        "A microscopy process that uses visible light and lenses to magnify and image a specimen, widely used for examining the microstructure and morphology of materials."@en ;
    skos:example "An example is Light Microscopy."@en .

pmd:PMD_0000890 a owl:Class ;
    rdfs:label "connected material entity aggregate"@en ;
    rdfs:subClassOf obo:BFO_0000027 ;
    skos:definition "An object aggregate that is a mereological sum of separate material entities, which adhere to one another through chemical bonds or physical junctions that go beyond gravity."@en ;
    skos:example "the atoms of a molecule, the molecules forming the membrane of a cell, the epidermis in a human body"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000891 a owl:Class ;
    rdfs:label "disconnected material entity aggregate"@en ;
    rdfs:subClassOf obo:BFO_0000027 ;
    skos:definition "An object aggregate that is a mereological sum of scattered (i.e. spatially separated) material entities, which do not adhere to one another through chemical bonds or physical junctions but, instead, relate to one another merely on grounds of metric proximity. The material entities are separated from one another through space or through other material entities that do not belong to the group."@en ;
    skos:example "a heap of stones, a colony of honeybees, a group of synapses, the trees of a forest, the canopy of a forest, the fish of a shoal, a group of commuters on the subway, the patients in a hospital"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000896 a owl:Class ;
    rdfs:label "Druck"@de,
        "pressure"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:comment "The pressure is commonly measured in Pascals."@en ;
    rdfs:subClassOf pmd:PMD_0023043 ;
    skos:definition "eine intensive Qualität, die die Kraft beschreibt, die pro Flächeneinheit in oder auf ein Material ausgeübt wird."@de,
        "a quality describing the force exerted per unit area in or on a material."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0000899 a owl:Class ;
    rdfs:label "Urformen"@de,
        "primary shaping"@en ;
    obo:IAO_0000119 "Offizielle Definition findet man in: DIN 8580:2003-9 Fertigungsverfahren, Seite 4, 3.1.1 Urformen - Definition"@de,
        "Official definition can be found in: DIN 8580:2003-9 Fertigungsverfahren, Page 4, 3.1.1 Urformen - Definition"@en ;
    rdfs:subClassOf pmd:PMD_0000833 ;
    skos:altLabel "Primary Forming"@en ;
    skos:definition "Ein Herstellungsprozess, der aus formlosem Stoff durch das Herstellen von Kohäsion ein definiertes Werkstück schafft, wobei die charakteristischen Eigenschaften des Materials im Endprodukt sichtbar werden."@de,
        "A manufacturing process that creates a defined workpiece from shapeless material by producing cohesion, whereby the characteristic properties of the material become visible in the end product."@en ;
    skos:example "Casting, Sintering"@en .

pmd:PMD_0000906 a owl:Class ;
    rdfs:label "Urformen Aus Dem Flüssigen Zustand"@de,
        "primary shaping from the liquid state"@en ;
    rdfs:subClassOf pmd:PMD_0000899 ;
    skos:definition "Ein Urformprozess, der das Formen von Materialien aus einem flüssigen Zustand beinhaltet."@de,
        "A primary shaping process that involves forming materials from a liquid state."@en ;
    skos:example "Casting of molten metal into molds."@en .

pmd:PMD_0000945 a owl:Class ;
    rdfs:label "Spektroskopie Verfahren"@de,
        "spectroscopy process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0009006 ;
            owl:someValuesFrom pmd:PMD_0025001 ],
        pmd:PMD_0000957 ;
    skos:definition "Ein Struktur Eigenschaften Analyseverfahren, das die Wechselwirkung von elektromagnetischer Strahlung mit Materie misst, um die Zusammensetzung, Struktur und physikalischen Eigenschaften von Materialien zu bestimmen."@de,
        "A structural property analyzing process that measures the interaction of electromagnetic radiation with matter to determine e.g. the composition, structure, and other properties of materials."@en .

pmd:PMD_0000968 a owl:Class ;
    rdfs:label "Temperaturänderungswerkzeug"@de,
        "temperature change device"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000602 ;
    skos:definition "Diese Entität beschreibt allgemein jedes Werkzeug, das zur Änderung und Einstellung der Temperatur eines materiellen Objekts oder der Umgebung verwendet wird, z. B. einen Ofen und Kühlmittel."@de,
        "A device that is used for the alteration and adjustment of the temperature of a tangible object or the environment, e.g., a furnace and cooling media."@en .

pmd:PMD_0000973 a owl:Class ;
    rdfs:label "Zugprüfmaschine"@de,
        "tensile testing machine"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000051 ;
                        owl:someValuesFrom pmd:PMD_0000636 ] [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000051 ;
                        owl:someValuesFrom pmd:PMD_0000820 ] ) ],
        pmd:PMD_0000602 ;
    skos:definition "Ein Gerät zur Prüfung der Zugfestigkeit und Dehnung von Materialien durch Anwendung einer Dehnkraft."@de,
        "A device used to test the tensile strength and elongation of materials by applying a stretching force."@en .

pmd:PMD_0000992 a owl:Class ;
    rdfs:label "time series"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf pmd:PMD_0000501 ;
    skos:definition "A time series is a 1-D information content entity defined by a sequence of data points collected or recorded at successive time intervals, used for analyzing temporal properties or trends."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0001029 a owl:ObjectProperty ;
    rdfs:label "antwortet mit"@de,
        "responds with"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:domain obo:BFO_0000017 ;
    skos:definition "Die realisierbare Entität muss durch einen Reiz „stimuliert“ werden, um mit der Reaktion zu reagieren. Der Träger der realisierbaren Entität muss sowohl an der Stimulation als auch an der Reaktion teilnehmen."@de,
        "The realizable entity must be \"stimulated\" by some Stimulus in order to respond with the Response. The bearer of the realizable entity must participate in Stimulation as well as in Response."@en .

pmd:PMD_0001998 a owl:Class ;
    rdfs:label "cutting device"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0000602 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000085 ;
                        owl:someValuesFrom pmd:PMD_0000592 ] ) ] ;
    skos:definition "A device designed to cut, slice, divide, or sever objects."@en .

pmd:PMD_0020026 a owl:Class ;
    rdfs:label "portion of iron"@en ;
    rdfs:comment "A Portion Of Matter that consists of only Iron atoms."@en ;
    rdfs:subClassOf pmd:PMD_0020140 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0020140 [ a owl:Restriction ;
                        owl:allValuesFrom obo:CHEBI_18248 ;
                        owl:onProperty obo:BFO_0000051 ] ) ] ;
    skos:definition "A 'portion of iron' is a 'Poriton Of Pure Substance' that 'consists of' only chebi:iron atom."@en .

pmd:PMD_0020050 a owl:Class ;
    rdfs:label "portion of silicon"@en ;
    rdfs:comment "A Portion Of Matter that consists of only silicon atoms."@en ;
    rdfs:subClassOf pmd:PMD_0020140 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0020140 [ a owl:Restriction ;
                        owl:allValuesFrom obo:CHEBI_27573 ;
                        owl:onProperty obo:BFO_0000051 ] ) ] ;
    skos:definition "A 'portion of silicon' is a 'portion of pure chemical element' that 'consists of' only chebi:silicon atom."@en .

pmd:PMD_0020096 a owl:Class ;
    rdfs:label "steel"@en ;
    rdfs:subClassOf pmd:PMD_0000639 ;
    skos:definition "ferrous metal that consists of iron and carbon and possibly other alloying elements (and possibly impurities)"@en .

pmd:PMD_0020106 a owl:Class ;
    rdfs:label "polycrystal"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom pmd:PMD_0000663 ],
        pmd:PMD_0000890 ;
    skos:altLabel "Polycrystalline structure"@en ;
    skos:definition "A polycrystal is a connected material entity aggregate that consists of multiple crystal grains joined through crystallographic interfaces."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020112 a owl:Class ;
    rdfs:label "Korngrößenverteilung"@de,
        "OBSOLETE grain size distribution"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    obo:IAO_0100001 obo:STATO_0000225 ;
    owl:deprecated true ;
    skos:definition "Eine intensive Qualität, die das Objektaggregat (Körner) auf niedrigerer Längenskala beschreibt, das Teil des Materials ist."@de,
        "An intensive quality describing the lower length scale object aggregate (grains) that is part of the material."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020136 a owl:Class ;
    rdfs:label "phase transformation"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:comment "The number of phases involved can vary as well as the mechanisms involved can be different."@en ;
    rdfs:subClassOf obo:BFO_0000015 ;
    skos:definition "A thermodynamic phase transformation is a process in/of a thermodynamic system, that involves the transformation of phases of the system to other phases."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020138 a owl:Class ;
    rdfs:label "lot"@en ;
    rdfs:subClassOf obo:BFO_0000027 ;
    skos:definition "A lot is an object aggregate whose parts are output of the same production process."@en .

pmd:PMD_0020149 a owl:Class ;
    rdfs:label "metastable phase"@en ;
    rdfs:comment "The stability of a phase can only be evaluated in the context of a (possibly unknown) phase transformation process."@en ;
    rdfs:subClassOf pmd:PMD_0020000 ;
    skos:definition "A metastable phase phase_trans is a phase that has a \"pmd:disposition of a phase to transform\" disp_trans and disp_trans is realized in a \"pmd:phase transformation\" proc_trans and proc_trans has participant sys_trans and sys_trans has part phase_trans."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020151 a owl:Class ;
    rdfs:label "innere Energie"@de,
        "internal energy"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    rdfs:subClassOf pmd:PMD_0020142,
        pmd:PMD_0023000 ;
    skos:definition "Innere Energie ist eine universelle umfassende Qualität, die das Potenzial des Trägers zur Arbeit festlegt."@de,
        "Internal energy is a universal extensive quality that specifies the bearers potential to do work."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0020161 a owl:Class ;
    rdfs:label "thermodynamische Aktivität"@de,
        "activity (thermodynamic)"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
    obo:IAO_0000119 """old defintion: 
Activity (a_X) is a relational property between a chemical species X and a non-ideal solution. a_X is a measure of the effective concentration of a chemical species X in the non-ideal solution, accounting for interactions between particles. It is defined as the product of the concentration and an activity coefficient, where the activity coefficient corrects for non-ideal behavior.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:CHEBI_60003 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000087 ;
                                owl:someValuesFrom pmd:PMD_0020227 ] [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002350 ;
                                owl:someValuesFrom pmd:PMD_0020229 ] ) ] ],
        obo:BFO_0000019,
        pmd:PMD_0020313,
        pmd:PMD_0023004 ;
    skos:definition "Thermodynamische Aktivität ist eine Beziehungsqualität, die zwischen einer chemischen Spezies und einer nicht idealen Lösung innewohnt und die effektive Konzentration der Spezies darstellt, die für Partikelwechselwirkungen verantwortlich ist."@de,
        "Thermodynamic activity is a relational quality that inheres between a chemical species and a non-ideal solution and represents the effective concentration of the species accounting for particle interactions."@en .

pmd:PMD_0020166 a owl:Class ;
    rdfs:label "heat (metallurgy)"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0020139 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000087 ;
                        owl:someValuesFrom pmd:PMD_0000534 ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0001001 ;
                        owl:someValuesFrom pmd:PMD_0000852 ] ) ] ;
    skos:definition "A heat is a fixed amount of metallic alloy that may be input to some manufacturing process."@en .

pmd:PMD_0020170 a owl:Class ;
    rdfs:label "Bramme"@de,
        "ingot"@en ;
    rdfs:comment "The ingot may be hot rolled after casting..."@en ;
    rdfs:subClassOf obo:BFO_0000030 ;
    skos:definition "An ingot is an object that has a thick section and may bear a semi finished product role and that is the specified output of a casting process. At the same time it is a material."@en .

pmd:PMD_0020172 a owl:Class ;
    rdfs:label "sheet"@en ;
    rdfs:subClassOf obo:BFO_0000030 ;
    skos:definition "A plate is a thin rectangular object that may bear a semi finished product role. At the same time it is a material."@en .

pmd:PMD_0020173 a owl:Class ;
    rdfs:label "billet"@en ;
    rdfs:subClassOf obo:BFO_0000030 ;
    skos:definition "A billet is a relatively compact object that may bear a semi finished product role. At the same time it is a material."@en .

pmd:PMD_0020174 a owl:Class ;
    rdfs:label "foil"@en ;
    rdfs:subClassOf obo:BFO_0000030 ;
    skos:definition "A plate is a very thin rectangular object that may bear a semi finished product role. At the same time it may be a material."@en .

pmd:PMD_0020175 a owl:Class ;
    rdfs:label "coil (coiled sheet)"@en ;
    rdfs:comment "Coils may have several sheets that are joined together."@en ;
    rdfs:subClassOf obo:BFO_0000030 ;
    skos:definition "A coil is an object that has part some sheets or foils. At the same time it may be a material."@en .

pmd:PMD_0020176 a owl:Class ;
    rdfs:label "plate"@en ;
    rdfs:subClassOf obo:BFO_0000030 ;
    skos:definition "A plate is a thick rectangular object that may bear a semi finished product role. At the same time it may be a material."@en .

pmd:PMD_0020177 a owl:Class ;
    rdfs:label "bar"@en ;
    rdfs:subClassOf obo:BFO_0000030 ;
    skos:definition "A bar is a long object with rectangular section that may bear a semi finished product role. At the same time it may be a material."@en .

pmd:PMD_0020178 a owl:Class ;
    rdfs:label "rod"@en ;
    rdfs:subClassOf obo:BFO_0000030 ;
    skos:definition "A rod is a long object with oval or round section that may bear a semi finished product role. At the same time it may be a material."@en .

pmd:PMD_0020179 a owl:Class ;
    rdfs:label "wire (semi finished product)"@en ;
    rdfs:comment "This class does not include cables or other compound structures."@en ;
    rdfs:subClassOf obo:BFO_0000030 ;
    skos:definition "A wire is a long and somewhat flexible object that may bear a semi finished product role. At the same time it is a material."@en .

pmd:PMD_0020180 a owl:Class ;
    rdfs:label "tube"@en ;
    rdfs:subClassOf obo:BFO_0000030 ;
    skos:definition "A tube is a long object with a hollow section and moderate wall thickness that may bear a semi finished product role. At the same time it may be a material."@en .

pmd:PMD_0020181 a owl:Class ;
    rdfs:label "pipe"@en ;
    rdfs:subClassOf obo:BFO_0000030 ;
    skos:definition "A tube is a long object with a hollow section and pronounced wall thickness that may bear a semi finished product role. At the same time it may be a material."@en .

pmd:PMD_0020182 a owl:Class ;
    rdfs:label "profile (semi finished product)"@en ;
    rdfs:subClassOf obo:BFO_0000030 ;
    skos:definition "A profile is a long object with determined section shape that may bear a semi finished product role. At the same time it may be a material."@en .

pmd:PMD_0020258 a owl:Class ;
    rdfs:label "failure"@en ;
    rdfs:subClassOf obo:BFO_0000035 ;
    skos:definition "a process boundary at which a function of a participant ceases to exist"@en .

pmd:PMD_0020307 a owl:Class ;
    rdfs:label "bulk property"@en ;
    rdfs:subClassOf pmd:PMD_0023003 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000052 ;
                        owl:someValuesFrom pmd:PMD_0000538 ] [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025999 ;
                        owl:someValuesFrom pmd:PMD_0000538 ] ) ] ;
    skos:definition "a 'property by bearer' that indicates that its bearer is a bulk"@en .

pmd:PMD_0020308 a owl:Class ;
    rdfs:label "surface property"@en ;
    rdfs:subClassOf pmd:PMD_0023003 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000052 ;
                        owl:someValuesFrom pmd:PMD_0000965 ] [ a owl:Restriction ;
                        owl:onProperty pmd:PMD_0025999 ;
                        owl:someValuesFrom pmd:PMD_0000965 ] ) ] ;
    skos:definition "a a 'property by bearer' that indicates that its bearer is a surface"@en .

pmd:PMD_0020319 a owl:Class ;
    rdfs:label "extensive property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000024 obo:BFO_0000027 obo:BFO_0000029 obo:BFO_0000030 obo:BFO_0000140 ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0002328 ;
            owl:someValuesFrom pmd:PMD_0023000 ],
        pmd:PMD_0023002 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000052 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( obo:BFO_0000024 obo:BFO_0000027 obo:BFO_0000029 obo:BFO_0000030 obo:BFO_0000140 ) ] ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002328 ;
                        owl:someValuesFrom pmd:PMD_0023000 ] ) ] ;
    skos:definition "a facetted property that is characteristic of some object or object aggregate or fiat object part and that changes with bearers makeup."@en .

pmd:PMD_0020331 a owl:Class ;
    rdfs:label "normal stress"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0080108 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002328 ;
                        owl:someValuesFrom pmd:PMD_0020332 ] ) ] ;
    skos:definition "the stress due to normal foce"@en .

pmd:PMD_0020339 a owl:Class ;
    rdfs:label "fission"@en ;
    rdfs:subClassOf obo:BFO_0000015 ;
    skos:definition "a process of separating one entity into multiple"@en .

pmd:PMD_0020352 a owl:Class ;
    rdfs:label "elastic strain energy"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000080 ;
            owl:someValuesFrom pmd:PMD_0000000 ],
        [ a owl:Class ;
            owl:unionOf ( pmd:PMD_0020364 pmd:PMD_0020366 pmd:PMD_0020369 ) ],
        obo:BFO_0000019,
        pmd:PMD_0020335,
        pmd:PMD_0023004 ;
    skos:definition "energy stored in elastic deformation"@en ;
    skos:example "A spring with spring constant k = 200 N/m is compressed by x = 0.1 m and then stores 1J"@en .

pmd:PMD_0020369 a owl:Class ;
    rdfs:label "per mol property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002328 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000001 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000086 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( pmd:PMD_0020367 [ a owl:Restriction ;
                                                    owl:hasValue pmd:PMD_0020368 ;
                                                    owl:onProperty pmd:PMD_0000077 ] ) ] ] ) ] ],
        pmd:PMD_0020364 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0023001 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0002328 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:BFO_0000001 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000086 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( pmd:PMD_0020367 [ a owl:Restriction ;
                                                                owl:hasValue pmd:PMD_0020368 ;
                                                                owl:onProperty pmd:PMD_0000077 ] ) ] ] ) ] ] ) ] ;
    skos:definition "a per count with the count of Avogadro-number"@en .

pmd:PMD_0020380 a owl:Class ;
    rdfs:label "multiaxial strain"@en ;
    rdfs:subClassOf pmd:PMD_0080029 ;
    skos:definition "the 3D strain as represented by a tensor"@en .

pmd:PMD_0023035 a owl:Class ;
    rdfs:label "aggregated property"@en ;
    obo:IAO_0000116 "the axioms do not allow for differentiation of the subclasses, see comment in 'functionally related to'"@en ;
    rdfs:subClassOf pmd:PMD_0023002 ;
    skos:definition "a facetted property that aggregates/condenses multiple values of members of an object aggregate"@en .

pmd:PMD_0025005 a owl:Class ;
    rdfs:label "3D"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf obo:IAO_0000027 ;
    skos:definition "A three-dimensional data item is a representation or analysis, commonly applied in studying material properties in its volume or describing a dependency of one variable on two other variables."@en ;
    skos:example "Orientation distribution function (ODF), potential energy landscape"@en .

pmd:PMD_0025007 a owl:Class ;
    rdfs:label "frequency"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf pmd:PMD_0000008 ;
    skos:definition "Frequency is a process attribute which characterizes the rate per second of oscillation or vibration."@en ;
    skos:example "Frequency of electromagnetic wave, Frequency of sound wave."@en .

pmd:PMD_0025010 a owl:Class ;
    rdfs:label "Heizung"@de,
        "heating"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf pmd:PMD_0000549 ;
    skos:definition "Erwärmung ist eine Temperaturänderung, die dem Temperaturanstieg im System oder Objekt entspricht."@de,
        "Heating is a change of temperature which corresponds to the increase of temperature in the system or object."@en .

pmd:PMD_0025011 a owl:Class ;
    rdfs:label "Kühlung"@de,
        "cooling"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf pmd:PMD_0000549 ;
    skos:definition "Kühlung ist eine Temperaturänderung, die einem Temperaturabfall im System oder Objekt entspricht."@de,
        "Cooling is a change of temperature which corresponds to the decrease of temperature in the system or object."@en .

pmd:PMD_0025012 a owl:Class ;
    rdfs:label "analytical calculation"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf pmd:PMD_0000583 ;
    skos:definition "Analytical calculation is a computing process which has value specification or measurement datum as a specified output. It applies a closed-form mathematical expression or formula to a set it specified inputs (value specifications) without requiring stochastic sampling, iterative numerical solving, or data-driven training."@en .

pmd:PMD_0025018 a owl:Class ;
    rdfs:label "geometrische relationale Qualität"@de,
        "geometric relational quality"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf obo:BFO_0000145 ;
    skos:definition "Geometrische Beziehungsqualität ist eine Beziehungsqualität, die die geometrische Beziehung zwischen zwei oder mehr unabhängigen Kontinuen beschreibt."@de,
        "Geometric relational quality is a relational quality describing the geometric relation between two or more independent continuants."@en ;
    skos:example "Elongation of a specimen after a tensile step, i.e., the specimen before and after the test. Angle between a rolling direction of a rolled material and the longitudinal side of a specimen."@en .

pmd:PMD_0025020 a owl:Class ;
    rdfs:label "single fatigue testing process"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
    rdfs:subClassOf pmd:PMD_0000849 ;
    skos:definition "Mechanical property analyzing process that is an occurent part of a fatigue testing process (S-N testing process). A single fatigue testing process assesses how many cycles a material can withstand under the given loading."@en .

pmd:PMD_0025029 a owl:Class ;
    rdfs:label "reducing agent role"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000081 ;
            owl:someValuesFrom pmd:PMD_0000001 ],
        obo:BFO_0000017,
        pmd:PMD_0020335,
        pmd:PMD_0023004 ;
    skos:definition "an object or a portion of matter with reducing agent role is oxidized,  i.e., gives up electrons, thus leading to metal reduction, i.e., gain of electrons, in a chemical reaction."@en ;
    skos:example "Carbon in a smelting of an ore" .

pmd:PMD_0050000 a owl:Class ;
    rdfs:label "Bindung"@de,
        "atomic bond"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Markus Schilling" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:PMD_0025999 ;
            owl:someValuesFrom obo:CHEBI_33250 ],
        pmd:PMD_0020353 ;
    skos:definition "Eine Bindung ist eine relationale Qualität, die die Kraftwechselwirkung zwischen Atomen beschreibt."@de,
        "A bond is a relational quality describing the force interaction between atoms."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0050002 a owl:Class ;
    rdfs:label "metallische Bindung"@de,
        "metallic bond"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Markus Schilling" ;
    obo:IAO_0000119 <https://www.thoughtco.com/metallic-bond-definition-properties-and-examples-4117948> ;
    rdfs:subClassOf pmd:PMD_0050000 ;
    skos:definition "Eine Metallbindung ist eine Bindung, die zwischen Metallatomen entsteht, wobei Elektronen in einem „Meer“ von Elektronen geteilt werden, die sich frei um die Metallionen bewegen. Diese Art der Bindung verleiht Metallen ihre charakteristischen Eigenschaften wie Leitfähigkeit und Formbarkeit."@de,
        "A metallic bond is a bond that forms between metal atoms, where electrons are shared in a \"sea\" of electrons that move freely around the metal ions. This type of bonding gives metals their characteristic properties such as conductivity and malleability."@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0050155 a owl:Class ;
    rdfs:label "Form"@de,
        "shape"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Markus Schilling" ;
    obo:IAO_0000119 "“Shape.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/shape. Accessed 13 Jan. 2023." ;
    rdfs:subClassOf pmd:PMD_0020353 ;
    skos:definition "Das sichtbare Ausstattungsmerkmal (räumliche Form oder Kontur) eines bestimmten Objektes oder einer Art von Objekt."@de,
        "Extemsive quality, the visible makeup characteristic (spatial form or contour) of a particular item or kind of item."@en .

pmd:PMD_0050156 a owl:Class ;
    rdfs:label "Geometrische Form"@de,
        "geometry shape"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000117 "PERSON: Markus Schilling" ;
    obo:IAO_0000119 "DIN EN ISO 6892-1:2019" ;
    rdfs:subClassOf pmd:PMD_0050155 ;
    skos:definition "Dieses Konzept beschreibt die geometrischen Abmessungen und das Erscheinungsbild (Form und Abmaße) einer Probe, eines Prüfkörpers oder eines Prüfstücks, wie sie üblicherweise durch eine entsprechende Norm definiert sind. Dementsprechend ist der angegebene Formwert in Übereinstimmung mit der definierenden Norm anzugeben, z. B. \"Zugprüfstück Form 1 gemäß Anhang B der Zugversuchsnorm\"."@de,
        "This concept describes the geometric dimensions and appearance (shape and dimensions) of a sample, specimen, or test piece as usually defined by a corresponding standard. Accordingly, the shape value given is in accordance with the defining standard, e.g., ‘tensile test piece shape 1 in accordance with annex B of the tensile test standard’."@en .

pmd:PMD_0080022 a owl:Class ;
    rdfs:label "elektrische Ladung"@de,
        "electric charge"@en ;
    obo:IAO_0000117 "PERSON: Thomas Hanke" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( pmd:PMD_0020312 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000080 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( obo:BFO_0000027 obo:BFO_0000030 ) ] ] ) ],
        obo:BFO_0000019 ;
    skos:definition "Electric charge refers to the physical property of matter causing it to experience a force when placed in an electromagnetic field"@en ;
    skos:example "A capacitor stores 10 µC of electric charge at a voltage of 5 V"@en .

pmd:PMD_0080034 a owl:Class ;
    rdfs:label "elastische Deformation"@de,
        "elastic strain"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Necessary and sufficient conditions for 'elastic strain' have not yet been formalized. The term is defined as a specific subtype of 'strain'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Plasticity_(physics)."@en ;
    obo:IAO_0000117 "PERSON: Thomas Hanke" ;
    obo:IAO_0000119 <https://en.wikipedia.org/wiki/Plasticity_(physics)> ;
    rdfs:subClassOf pmd:PMD_0080029 ;
    skos:altLabel "elastische Verformung"@de,
        "elastic deformation"@en ;
    skos:definition "Bei der elastischen Dehnung handelt es sich um eine Dehnungsqualität eines Materialgebildes, die durch eine reversible Verformung gekennzeichnet ist, die bei Wegnahme der aufgebrachten Last verschwindet"@de,
        "Elastic strain is a strain quality of a material entity characterized by reversible deformation that disappears upon removal of the applied load"@en ;
    skos:example "Steel loaded to 200 MPa exhibits an elastic strain of about 0.001, fully recovered upon unloading"@en ;
    pmd:PMD_0000060 true .

pmd:PMD_0080035 a owl:Class ;
    rdfs:label "plastische Deformation"@de,
        "plastic strain"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000116 "Necessary and sufficient conditions for 'plastic strain' have not yet been formalized. The term is defined as a specific subtype of 'strain'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Plasticity_(physics)."@en ;
    obo:IAO_0000117 "PERSON: Thomas Hanke" ;
    obo:IAO_0000119 <https://en.wikipedia.org/wiki/Plasticity_(physics)> ;
    rdfs:subClassOf pmd:PMD_0080029 ;
    skos:altLabel "plastische Verformung"@de,
        "plastic deformation"@en ;
    skos:definition "Plastische Deformation beschreibt die dauerhafte Verformung, die auftritt, wenn ein Material einer Belastung ausgesetzt wird, die über seine elastische Grenze hinausgeht"@de,
        "Plastic strain describes permanent deformation occurring when a material is subjected to stress beyond its elastic limit"@en ;
    skos:example "After exceeding yield strength, a steel rod undergoes 5 % plastic strain that remains after unloading"@en ;
    pmd:PMD_0000060 true .

cryo:CRYO_0000000 a owl:Class ;
    rdfs:label "unit cell"@en ;
    rdfs:subClassOf obo:BFO_0000029 ;
    skos:definition "Unit cell is a site which is a part of a crystal lattice and represents the smallest volume, from which the lattice can be constructed by translational displacements. Unit cell is characterized by the length of its sides and their angular relations."@en .

cryo:CRYO_0000050 a owl:ObjectProperty ;
    rdfs:label "is tetragonal"@en ;
    rdfs:subPropertyOf cryo:CRYO_0000053 ;
    skos:definition "is tetragonal is a object property  for the inference of family of directions/planes Miller indices notation under tetragonal symmetry. The class crystallographic entity in tetragonal system carries a Self restriction \"is tetragonal\""@en .

cryo:CRYO_0000054 a owl:ObjectProperty ;
    rdfs:label "is triclinic"@de ;
    rdfs:subPropertyOf cryo:CRYO_0000053 ;
    skos:definition "is triclinic is a object property  for the inference of family of directions/planes Miller indices notation under triclinic symmetry. The class crystallographic entity in triclinic system carries a Self restriction \"is triclinic\""@en .

cryo:CRYO_0000055 a owl:ObjectProperty ;
    rdfs:label "is monoclinic"@de ;
    rdfs:subPropertyOf cryo:CRYO_0000053 ;
    skos:definition "is monoclinic is a object property  for the inference of family of directions/planes Miller indices notation under monoclinic symmetry. The class crystallographic entity in monoclinic system carries a Self restriction \"is monoclinic\""@en .

cryo:CRYO_0000056 a owl:ObjectProperty ;
    rdfs:label "is orthorhombic"@de ;
    rdfs:subPropertyOf cryo:CRYO_0000053 ;
    skos:definition "is orthorhombic is a object property  for the inference of family of directions/planes Miller indices notation under orthorhombic symmetry. The class crystallographic entity in orthorhombic system carries a Self restriction \"is orthorhombic\""@en .

cryo:CRYO_0000057 a owl:ObjectProperty ;
    rdfs:label "is rhombohedral"@de ;
    rdfs:subPropertyOf cryo:CRYO_0000053 ;
    skos:definition "is rhombohedral is a object property  for the inference of family of directions/planes Miller indices notation under rhombohedral symmetry. The class crystallographic entity in rhombohedral system carries a Self restriction \"is rhombohedral\""@en .

cryo:CRYO_0000058 a owl:ObjectProperty ;
    rdfs:label "is hexagonal"@de ;
    rdfs:subPropertyOf cryo:CRYO_0000053 ;
    skos:definition "is hexagonal is a object property  for the inference of family of directions/planes Miller indices notation under hexagonal symmetry. The class crystallographic entity in hexagonal system carries a Self restriction \"is hexagonal\""@en .

