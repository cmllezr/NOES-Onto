AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020111> "true"^^xsd:boolean)

# Individual: <https://w3id.org/pmd/co/PMD_0020117> (aggregate state solid)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020117> "aggregate state solid"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020117> "A state where the bonds between entities transmit shear forces."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020117> "true"^^xsd:boolean)

# Individual: <https://w3id.org/pmd/co/PMD_0020118> (aggregate state liquid)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020118> "aggregate state liquid"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020118> "A state where the bonds of the entities transmit no shear force."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020118> "true"^^xsd:boolean)

# Individual: <https://w3id.org/pmd/co/PMD_0020119> (aggregate state gaseous)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020119> "aggregate state gaseous"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020119> "A state where the entities have no bonding."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020119> "true"^^xsd:boolean)

# Individual: <https://w3id.org/pmd/co/PMD_0020120> (aggregate state plasma)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020120> "aggregate state plasma"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020120> "An aggregate state where the entities are atom nuclei and have no bonds."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020120> "true"^^xsd:boolean)

# Individual: <https://w3id.org/pmd/co/PMD_0020121> (aggregate state atom gas)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020121> "aggregate state atom gas"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020121> "A gaseous state where the gas entities are atoms."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020121> "true"^^xsd:boolean)

# Individual: <https://w3id.org/pmd/co/PMD_0020122> (aggregate state supercritical fluid)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020122> "aggregate state supercritical fluid"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020122> "A state with strong bindings between entities that do not transmit shear force."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020122> "true"^^xsd:boolean)

# Individual: <https://w3id.org/pmd/co/PMD_0020123> (aggregate state mesomorphic)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020123> "aggregate state mesomorphic"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020123> "A state where some bonds transmit shear stresses and some do not."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020123> "true"^^xsd:boolean)

# Individual: <https://w3id.org/pmd/co/PMD_0020124> (aggregate state suprafluid)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020124> "aggregate state suprafluid"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020124> "A state with frictionless binding that transmits no shear force between entities."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020124> "true"^^xsd:boolean)

# Individual: <https://w3id.org/pmd/co/PMD_0020125> (aggregate state suprasolid)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020125> "aggregate state suprasolid"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020125> "A state that exhibits suprafluid and solid properties."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0020125> "true"^^xsd:boolean)

# Individual: <https://w3id.org/pmd/co/PMD_0020217> (short range order)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020217> "short range order"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020217> "periodic arrangement of structural features up to a few entities"@en)

# Individual: <https://w3id.org/pmd/co/PMD_0020218> (medium range order)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020218> "medium range order"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020218> "periodic arrangement of structural features of many entities"@en)

# Individual: <https://w3id.org/pmd/co/PMD_0020219> (long range order)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020219> "long range order"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020219> "periodic arrangement of structural features of virtually all entities"@en)

# Individual: <https://w3id.org/pmd/co/PMD_0020242> (no range order)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020242> "no range order"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0020242> "no periodic arrangement of structural features of entites"@en)

# Individual: <https://w3id.org/pmd/cryo/CRYO_0000029> (triclinic)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000029> "triclinic"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000029> "Triclinic crystal system is a crystal system with only translational symmetry."@en)

# Individual: <https://w3id.org/pmd/cryo/CRYO_0000030> (monoclinic)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000030> "monoclinic"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000030> "Monoclinic crystal system is a crystal system with one twofold rotation axis or one mirror plane."@en)

# Individual: <https://w3id.org/pmd/cryo/CRYO_0000031> (orthorhombic)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000031> "orthorhombic"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000031> "Orthorhombic crystal system is a crystal system with three twofold rotation axes or one twofold rotation axis and two mirror planes"@en)

# Individual: <https://w3id.org/pmd/cryo/CRYO_0000032> (tetragonal)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000032> "tetragonal"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000032> "Tetragonal crystal system is a crystal system with one fourfold rotation axis."@en)

# Individual: <https://w3id.org/pmd/cryo/CRYO_0000033> (rhombohedral)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000033> "rhombohedral"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/cryo/CRYO_0000033> "trigonal"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000033> "Rhombohedral ( trigonal) crystal system is a crystal system with one threefold rotation axis."@en)

# Individual: <https://w3id.org/pmd/cryo/CRYO_0000034> (hexagonal)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000034> "hexagonal"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000034> "Hexagonal crystal system is a crystal system with one sixfold rotation axis."@en)

# Individual: <https://w3id.org/pmd/cryo/CRYO_0000035> (cubic)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/cryo/CRYO_0000035> "cubic"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/cryo/CRYO_0000035> "Cubic crystal system is a crystal system with fourfold rotation axes."@en)

