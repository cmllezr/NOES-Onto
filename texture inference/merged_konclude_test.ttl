                                            owl:hasValue cryo:CRYO_0000043 ;
                                            owl:onProperty pmd:PMD_0000077 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000086 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( cryo:CRYO_0000390 [ a owl:Restriction ;
                                            owl:hasValue cryo:CRYO_0000034 ;
                                            owl:onProperty pmd:PMD_0000077 ] ) ] ] ) ] ;
    skos:definition "Bravais lattice hexagonal primitive is a crystal lattice with hexagonal lattice system and primitive lattice centering."@en .

cryo:CRYO_0000138 a owl:Class ;
    rdfs:label "bravais lattice rhombohedral primitive"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000086 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( cryo:CRYO_0000027 [ a owl:Restriction ;
                                owl:hasValue cryo:CRYO_0000043 ;
                                owl:onProperty pmd:PMD_0000077 ] ) ] ],
        cryo:CRYO_0000384 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cryo:CRYO_0000001 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000086 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( cryo:CRYO_0000027 [ a owl:Restriction ;
                                            owl:hasValue cryo:CRYO_0000043 ;
